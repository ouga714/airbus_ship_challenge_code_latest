# Train/Val
# -----------------------------

@torch.no_grad()
def validate(model: nn.Module, loader: DataLoader, device: torch.device,
             thr_list: List[float], iou_thrs: List[float], min_area: int,
             log_fp, max_images: int = -1) -> Dict[str, float]:
    model.eval()
    bce = nn.BCEWithLogitsLoss()

    total_loss = 0.0
    n_batches = 0

    thr_f2_sum = {thr: 0.0 for thr in thr_list}
    thr_cnt = {thr: 0 for thr in thr_list}

    t0 = time.time()
    n_images_done = 0

    for batch in loader:
        x, y, _ = batch
        x = x.to(device, non_blocking=True)
        y = y.to(device, non_blocking=True)

        logits = model(x)
        loss = bce(logits, y) + dice_loss_with_logits(logits, y)
        total_loss += float(loss.item())
        n_batches += 1

        probs = torch.sigmoid(logits).detach().cpu().numpy()
        gts = y.detach().cpu().numpy()

        B = probs.shape[0]
        for i in range(B):
            p = probs[i, 0]
            gt01 = (gts[i, 0] > 0.5).astype(np.uint8)

            for thr in thr_list:
                f2 = kaggle_instance_f2_avg(p, gt01, thr=float(thr), iou_thrs=iou_thrs, min_area=min_area)
                thr_f2_sum[thr] += f2
                thr_cnt[thr] += 1

            n_images_done += 1
            if max_images > 0 and n_images_done >= max_images:
                break
        if max_images > 0 and n_images_done >= max_images:
            break

    val_loss = total_loss / max(1, n_batches)

    best_thr = None
    best_f2 = -1.0
    for thr in thr_list:
        if thr_cnt[thr] == 0:
            continue
        mean_f2 = thr_f2_sum[thr] / float(thr_cnt[thr])
        if mean_f2 > best_f2:
            best_f2 = mean_f2
            best_thr = float(thr)

    dt = time.time() - t0
    log_line(log_fp, f"{now_str()} [VAL] images={n_images_done} val_loss={val_loss:.6f} best_thr={best_thr} best_f2={best_f2:.6f} dt={dt:.1f}s")

    if best_thr is None:
        best_thr = float(thr_list[len(thr_list)//2])
        best_f2 = 0.0

    return {
        "val_loss": float(val_loss),
        "best_thr": float(best_thr),
        "best_f2": float(best_f2),
    }


def train_one_epoch(model: nn.Module, loader: DataLoader, device: torch.device,
                    optimizer: torch.optim.Optimizer, log_fp) -> float:
    model.train()
    bce = nn.BCEWithLogitsLoss()

    total = 0.0
    n = 0
    t0 = time.time()

    for it, batch in enumerate(loader):
        x, y, _ = batch
        x = x.to(device, non_blocking=True)
        y = y.to(device, non_blocking=True)

        optimizer.zero_grad(set_to_none=True)
        logits = model(x)
        loss = bce(logits, y) + dice_loss_with_logits(logits, y)
        loss.backward()
        optimizer.step()

        total += float(loss.item())
        n += 1

        if (it + 1) % 50 == 0:
            dt = time.time() - t0
            log_line(log_fp, f"{now_str()} [TRAIN] iter={it+1}/{len(loader)} loss={total/max(1,n):.6f} dt={dt:.1f}s")

    return total / max(1, n)


def save_checkpoint(path: str, model: nn.Module, optimizer: torch.optim.Optimizer, epoch: int, meta: Dict, log_fp) -> None:
    tmp = path + ".tmp"
    torch.save({
        "epoch": epoch,
        "state_dict": model.state_dict(),
        "optimizer": optimizer.state_dict(),
        "meta": meta,
    }, tmp)
    os.replace(tmp, path)
    log_line(log_fp, f"{now_str()} [SAVE] checkpoint saved: {path}")


def checkpoint_health_check(ckpt_path: str, model: nn.Module, log_fp) -> None:
    ckpt = torch.load(ckpt_path, map_location="cpu")
    sd = ckpt["state_dict"] if isinstance(ckpt, dict) and "state_dict" in ckpt else ckpt

    missing, unexpected = model.load_state_dict(sd, strict=False)
    keys = list(sd.keys())

    has_up4 = any(("up4" in k) for k in keys)
    has_head = any(("head" in k) for k in keys)
    has_center = any(("center" in k) for k in keys)

    log_line(log_fp, f"{now_str()} [CKPT] health path={ckpt_path}")
    log_line(log_fp, f"{now_str()} [CKPT] keys={len(keys)} has_center={has_center} has_up4={has_up4} has_head={has_head}")
    log_line(log_fp, f"{now_str()} [CKPT] missing={len(missing)} unexpected={len(unexpected)}")

    if not (has_up4 and has_head and has_center):
        raise RuntimeError("Checkpoint health check failed: decoder/head keys not found (possible backbone-only save).")


# -----------------------------
# Main
# -----------------------------

def parse_args():
    ap = argparse.ArgumentParser()

    ap.add_argument("--cuda_visible_devices", type=str, default="0")
    ap.add_argument("--data_dir", type=str, required=True)
    ap.add_argument("--run_dir", type=str, required=True)
    ap.add_argument("--seed", type=int, default=42)

    ap.add_argument("--train_total", type=int, default=50000)
    ap.add_argument("--train_pos_frac", type=float, default=0.5)
    ap.add_argument("--val_ratio", type=float, default=0.15)
    ap.add_argument("--val_pos_frac", type=float, default=0.5)

    ap.add_argument("--batch_size", type=int, default=8)
    ap.add_argument("--num_workers", type=int, default=4)
    ap.add_argument("--lr", type=float, default=3e-4)
    ap.add_argument("--weight_decay", type=float, default=1e-4)

    ap.add_argument("--stage1_epochs", type=int, default=3)
    ap.add_argument("--stage2_epochs", type=int, default=3)
    ap.add_argument("--stage3_epochs", type=int, default=6)
    ap.add_argument("--stage4_epochs", type=int, default=6)

    ap.add_argument("--stage1_img_size", type=int, default=384)
    ap.add_argument("--stage2_img_size", type=int, default=384)
    ap.add_argument("--ms_sizes", type=str, default="384,512,640,768")
    ap.add_argument("--final_img_size", type=int, default=768)

    ap.add_argument("--mix_ratio", type=str, default="2,3,5")
    ap.add_argument("--thr_list", type=str, default="0.25,0.30,0.35,0.40,0.45,0.50,0.55,0.60,0.65,0.70")

    ap.add_argument("--patience", type=int, default=5)
    ap.add_argument("--min_delta", type=float, default=1e-4)

    ap.add_argument("--min_area", type=int, default=10)
    ap.add_argument("--val_max_images", type=int, default=-1)

    ap.add_argument("--pretrained_backbone", type=int, default=1)
    return ap.parse_args()


def main():
    args = parse_args()

    # GPU selection via arg (no export required by user)
    os.environ["CUDA_VISIBLE_DEVICES"] = str(args.cuda_visible_devices)

    if not HAS_CV2:
        print("[FATAL] cv2 (opencv-python) is required.", file=sys.stderr)
        sys.exit(1)
    if not HAS_ALB:
        print("[FATAL] albumentations is required.", file=sys.stderr)
        sys.exit(1)

    ensure_dir(args.run_dir)
    log_path = os.path.join(args.run_dir, "log_global.txt")
    meta_path = os.path.join(args.run_dir, "meta.json")
    best_thr_path = os.path.join(args.run_dir, "best_thresholds.json")

    with open(log_path, "a", encoding="utf-8") as log_fp:
        log_line(log_fp, f"{now_str()} [INIT] =========================")
        log_line(log_fp, f"{now_str()} [INIT] CUDA_VISIBLE_DEVICES={os.environ.get('CUDA_VISIBLE_DEVICES')}")
        log_line(log_fp, f"{now_str()} [INIT] HAS_CV2={HAS_CV2} HAS_ALB={HAS_ALB}")

        set_seed(args.seed)

        device = torch.device("cuda:0" if torch.cuda.is_available() else "cpu")
        log_line(log_fp, f"{now_str()} [INIT] device={device}")

        train_dir = os.path.join(args.data_dir, "train_v2")
        csv_path = os.path.join(args.data_dir, "train_ship_segmentations_v2.csv")
        if not os.path.isdir(train_dir):
            raise FileNotFoundError(f"train_v2 not found: {train_dir}")
        if not os.path.isfile(csv_path):
            raise FileNotFoundError(f"CSV not found: {csv_path}")

        log_line(log_fp, f"{now_str()} [DATA] reading CSV: {csv_path}")
        rle_map = read_csv_ship_masks(csv_path)

        all_ids = [fn for fn in os.listdir(train_dir) if fn.lower().endswith(".jpg")]
        all_ids.sort()

        pos_ids, neg_ids = [], []
        for img_id in all_ids:
            if len(rle_map.get(img_id, [])) > 0:
                pos_ids.append(img_id)
            else:
                neg_ids.append(img_id)

        log_line(log_fp, f"{now_str()} [DATA] all={len(all_ids)} pos={len(pos_ids)} neg={len(neg_ids)} pos_rate={len(pos_ids)/max(1,len(all_ids)):.4f}")
        if len(pos_ids) == 0 or len(neg_ids) == 0:
            raise RuntimeError("pos_ids or neg_ids is empty. Check CSV parsing and train_v2 listing.")

        rng = np.random.RandomState(args.seed)

        val_total = int(round(args.train_total * float(args.val_ratio)))
        val_pos_n = int(round(val_total * float(args.val_pos_frac)))
        val_neg_n = val_total - val_pos_n

        val_pos_ids = rng.choice(pos_ids, size=val_pos_n, replace=(len(pos_ids) < val_pos_n))
        val_neg_ids = rng.choice(neg_ids, size=val_neg_n, replace=(len(neg_ids) < val_neg_n))
        val_ids_set = set(val_pos_ids.tolist()) | set(val_neg_ids.tolist())

        train_pos_pool = [x for x in pos_ids if x not in val_ids_set] or pos_ids
        train_neg_pool = [x for x in neg_ids if x not in val_ids_set] or neg_ids

        log_line(log_fp, f"{now_str()} [SPLIT] train_pos_pool={len(train_pos_pool)} train_neg_pool={len(train_neg_pool)} val_total={val_total} val_pos={val_pos_n} val_neg={val_neg_n}")

        val_items = [SampleItem(img_id=x, is_pos=1) for x in val_pos_ids] + [SampleItem(img_id=x, is_pos=0) for x in val_neg_ids]
        rng.shuffle(val_items)

        ms_sizes = [int(x) for x in args.ms_sizes.split(",") if x.strip() != ""]
        mix_ratio = tuple(int(x) for x in args.mix_ratio.split(","))
        if len(mix_ratio) != 3:
            raise ValueError("--mix_ratio must be 3 integers: affine,color,normal")

        thr_list = [float(x) for x in args.thr_list.split(",") if x.strip() != ""]
        if len(thr_list) == 0:
            raise ValueError("thr_list is empty")

        iou_thrs = [round(x, 2) for x in np.arange(0.50, 0.96, 0.05).tolist()]

        train_items = make_epoch_items(train_pos_pool, train_neg_pool, args.train_total, args.train_pos_frac, rng)

        train_ds = AirbusCurriculumDataset(
            img_dir=train_dir,
            rle_map=rle_map,
            items=train_items,
            stage="stage1",
            img_size=args.stage1_img_size,
            ms_sizes=None,
            mix_ratio=mix_ratio,
            seed=args.seed,
        )

        # Validation fixed to final size for stable thresholding
        val_ds = AirbusCurriculumDataset(
            img_dir=train_dir,
            rle_map=rle_map,
            items=val_items,
            stage="stage4",
            img_size=args.final_img_size,
            ms_sizes=None,
            mix_ratio=mix_ratio,
            seed=args.seed + 999,
        )

        train_loader = DataLoader(
            train_ds, batch_size=args.batch_size, shuffle=False,
            num_workers=args.num_workers, pin_memory=True, drop_last=True
        )
        val_loader = DataLoader(
            val_ds, batch_size=max(1, args.batch_size // 2), shuffle=False,
            num_workers=args.num_workers, pin_memory=True, drop_last=False
        )

        model = UNetResNet34(pretrained=(args.pretrained_backbone == 1)).to(device)
        optimizer = torch.optim.AdamW(model.parameters(), lr=args.lr, weight_decay=args.weight_decay)

        meta = vars(args).copy()
        meta.update({
            "created": now_str(),
            "device": str(device),
            "train_dir": train_dir,
            "csv_path": csv_path,
            "pos_ids": len(pos_ids),
            "neg_ids": len(neg_ids),
            "val_total": val_total,
            "iou_thrs": iou_thrs,
        })
        with open(meta_path, "w", encoding="utf-8") as f:
            json.dump(meta, f, indent=2, ensure_ascii=False)
        log_line(log_fp, f"{now_str()} [INIT] meta saved: {meta_path}")

        # Curriculum schedule:
        #   stage1: crop, minimal geom
        #   stage2: crop + color
        #   stage3: multiscale + mixture affine/color/normal
        #   stage4: fixed final 768
        schedule = []
        schedule += [("stage1", args.stage1_img_size, None)] * max(0, args.stage1_epochs)
        schedule += [("stage2", args.stage2_img_size, None)] * max(0, args.stage2_epochs)
        schedule += [("stage3", args.final_img_size, ms_sizes)] * max(0, args.stage3_epochs)
        schedule += [("stage4", args.final_img_size, None)] * max(0, args.stage4_epochs)

        best_val_loss = float("inf")
        best_val_f2 = -1.0
        best_epoch_loss = -1
        best_epoch_f2 = -1

        patience = int(args.patience)
        min_delta = float(args.min_delta)
        bad_epochs = 0

        for epoch, (stage, stage_size, stage_ms) in enumerate(schedule, start=1):
            # Re-sample epoch items to realize "augmentation increases effective data"
            train_items = make_epoch_items(train_pos_pool, train_neg_pool, args.train_total, args.train_pos_frac, rng)
            train_ds.set_items(train_items)

            if stage == "stage3":
                train_ds.set_stage(stage="stage3", img_size=stage_size, ms_sizes=stage_ms)
            else:
                train_ds.set_stage(stage=stage, img_size=stage_size, ms_sizes=None)

            log_line(log_fp, f"{now_str()} [EPOCH] epoch={epoch}/{len(schedule)} stage={stage}")

            tr_loss = train_one_epoch(model, train_loader, device, optimizer, log_fp)
            log_line(log_fp, f"{now_str()} [EPOCH] epoch={epoch} train_loss={tr_loss:.6f}")

            val_out = validate(
                model, val_loader, device,
                thr_list=thr_list,
                iou_thrs=iou_thrs,
                min_area=int(args.min_area),
                log_fp=log_fp,
                max_images=int(args.val_max_images),
            )
            val_loss = val_out["val_loss"]
            best_thr = val_out["best_thr"]
            val_f2 = val_out["best_f2"]

            thr_payload = {
                "epoch": epoch,
                "stage": stage,
                "best_thr": best_thr,
                "best_f2": val_f2,
                "thr_list": thr_list,
                "iou_thrs": iou_thrs,
                "min_area": int(args.min_area),
                "val_max_images": int(args.val_max_images),
                "timestamp": now_str(),
            }
            with open(best_thr_path, "w", encoding="utf-8") as f:
                json.dump(thr_payload, f, indent=2, ensure_ascii=False)
            log_line(log_fp, f"{now_str()} [SAVE] best_thresholds.json updated: {best_thr_path}")

            last_ckpt = os.path.join(args.run_dir, "last.pt")
            save_checkpoint(
                last_ckpt, model, optimizer, epoch,
                meta={"stage": stage, "train_loss": tr_loss, "val_loss": val_loss, "val_f2": val_f2, "best_thr": best_thr},
                log_fp=log_fp
            )
            checkpoint_health_check(last_ckpt, model, log_fp)

            improved = (val_loss < (best_val_loss - min_delta))
            if improved:
                best_val_loss = val_loss
                best_epoch_loss = epoch
                bad_epochs = 0

                best_loss_ckpt = os.path.join(args.run_dir, "best_by_valloss.pt")
                save_checkpoint(
                    best_loss_ckpt, model, optimizer, epoch,
                    meta={"stage": stage, "train_loss": tr_loss, "val_loss": val_loss, "val_f2": val_f2, "best_thr": best_thr},
                    log_fp=log_fp
                )
                checkpoint_health_check(best_loss_ckpt, model, log_fp)
                log_line(log_fp, f"{now_str()} [BEST] best_val_loss={best_val_loss:.6f} epoch={best_epoch_loss}")
            else:
                bad_epochs += 1
                log_line(log_fp, f"{now_str()} [ES] no improvement bad_epochs={bad_epochs}/{patience} best_val_loss={best_val_loss:.6f} epoch={best_epoch_loss}")

            if val_f2 > best_val_f2:
                best_val_f2 = val_f2
                best_epoch_f2 = epoch

                best_f2_ckpt = os.path.join(args.run_dir, "best_by_valf2.pt")
                save_checkpoint(
                    best_f2_ckpt, model, optimizer, epoch,
                    meta={"stage": stage, "train_loss": tr_loss, "val_loss": val_loss, "val_f2": val_f2, "best_thr": best_thr},
                    log_fp=log_fp
                )
                checkpoint_health_check(best_f2_ckpt, model, log_fp)
                log_line(log_fp, f"{now_str()} [BEST] best_val_f2={best_val_f2:.6f} epoch={best_epoch_f2}")

            if bad_epochs >= patience:
                log_line(log_fp, f"{now_str()} [STOP] Early-stopping: val_loss saturated. best_val_loss={best_val_loss:.6f} epoch={best_epoch_loss}")
                break

        log_line(log_fp, f"{now_str()} [DONE] best_by_valloss: epoch={best_epoch_loss} val_loss={best_val_loss:.6f}")
        log_line(log_fp, f"{now_str()} [DONE] best_by_valf2  : epoch={best_epoch_f2} val_f2={best_val_f2:.6f}")
        log_line(log_fp, f"{now_str()} [DONE] run_dir={args.run_dir}")


if __name__ == "__main__":
    main()
