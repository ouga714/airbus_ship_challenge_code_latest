# -----------------------------
# RLE decode (Kaggle Airbus)
# -----------------------------

def rle_decode(rle: str, shape: Tuple[int, int]) -> np.ndarray:
    """
    Decode run-length encoding into a binary mask.
    Airbus: 1-indexed, column-major (Fortran order).
    shape: (H, W)
    """
    if rle is None or rle == "":
        return np.zeros(shape, dtype=np.uint8)

    s = rle.strip().split()
    if len(s) < 2:
        return np.zeros(shape, dtype=np.uint8)

    starts = np.asarray(s[0::2], dtype=np.int64) - 1
    lengths = np.asarray(s[1::2], dtype=np.int64)
    ends = starts + lengths

    h, w = shape
    img = np.zeros(h * w, dtype=np.uint8)
    for lo, hi in zip(starts, ends):
        if lo < 0:
            lo = 0
        if hi > img.size:
            hi = img.size
        if hi > lo:
            img[lo:hi] = 1

    img = img.reshape((w, h), order="F").T
    return img


