def read_csv_ship_masks(csv_path: str) -> Dict[str, List[str]]:
    """
    Parse train_ship_segmentations_v2.csv without pandas.
    Returns: ImageId -> list of non-empty RLEs
    """
    d: Dict[str, List[str]] = {}
    with open(csv_path, "r", encoding="utf-8") as f:
        header = f.readline()
        if "ImageId" not in header or "EncodedPixels" not in header:
            raise ValueError("CSV header mismatch: expected ImageId,EncodedPixels")
        for line in f:
            line = line.rstrip("\n")
            if line == "":
                continue
            parts = line.split(",", 1)
            if len(parts) != 2:
                continue
            img_id = parts[0]
            rle = parts[1]
            if img_id not in d:
                d[img_id] = []
            if rle is None or rle.strip() == "":
                continue
            d[img_id].append(rle)
    return d


def build_gt_mask(img_id: str, rle_map: Dict[str, List[str]], shape_hw=(768, 768)) -> np.ndarray:
    rles = rle_map.get(img_id, [])
    if len(rles) == 0:
        return np.zeros(shape_hw, dtype=np.uint8)
    m = np.zeros(shape_hw, dtype=np.uint8)
    for r in rles:
        m |= rle_decode(r, shape_hw)
    return (m > 0).astype(np.uint8)


# -----------------------------
# Kaggle-like instance F2 metric
# -----------------------------

def mask_to_instances_cc(mask01: np.ndarray, min_area: int = 10) -> List[np.ndarray]:
    """
    Convert binary mask to instances via connected components.
    Returns list of boolean masks.
    """
    if mask01.dtype != np.uint8:
        mask01 = mask01.astype(np.uint8)
    if mask01.max() == 0:
        return []
    if not HAS_CV2:
        raise RuntimeError("cv2 is required for connected components instance extraction.")
    num_labels, labels, stats, _ = cv2.connectedComponentsWithStats(mask01, connectivity=8)
    inst = []
    for k in range(1, num_labels):
        area = int(stats[k, cv2.CC_STAT_AREA])
        if area < min_area:
            continue
        inst.append(labels == k)
    return inst


def iou_mask(a: np.ndarray, b: np.ndarray) -> float:
    inter = np.logical_and(a, b).sum()
    if inter == 0:
        return 0.0
    union = np.logical_or(a, b).sum()
    return float(inter) / float(union + 1e-9)


def match_instances_greedy(pred_insts: List[np.ndarray], gt_insts: List[np.ndarray], iou_thr: float) -> Tuple[int, int, int]:
    """
    Greedy matching by IoU.
    Returns (tp, fp, fn)
    """
    if len(pred_insts) == 0 and len(gt_insts) == 0:
        return (0, 0, 0)
    if len(pred_insts) == 0:
        return (0, 0, len(gt_insts))
    if len(gt_insts) == 0:
        return (0, len(pred_insts), 0)

    ious = np.zeros((len(pred_insts), len(gt_insts)), dtype=np.float32)
    for i, pm in enumerate(pred_insts):
        for j, gm in enumerate(gt_insts):
            ious[i, j] = iou_mask(pm, gm)

    tp = 0
    used_p = set()
    used_g = set()
    while True:
        best = -1.0
        bi = -1
        bj = -1
        for i in range(ious.shape[0]):
            if i in used_p:
                continue
            for j in range(ious.shape[1]):
                if j in used_g:
                    continue
                v = float(ious[i, j])
                if v > best:
                    best = v
                    bi = i
                    bj = j
        if bi < 0 or bj < 0 or best < iou_thr:
            break
        used_p.add(bi)
        used_g.add(bj)
        tp += 1

    fp = len(pred_insts) - tp
    fn = len(gt_insts) - tp
    return (tp, fp, fn)


def f2_from_counts(tp: int, fp: int, fn: int) -> float:
    denom = (5 * tp + 4 * fn + fp)
    if denom <= 0:
        return 1.0 if (tp == 0 and fp == 0 and fn == 0) else 0.0
    return (5.0 * tp) / float(denom)


def kaggle_instance_f2_avg(pred_prob: np.ndarray, gt_mask01: np.ndarray, thr: float,
                           iou_thrs: List[float], min_area: int = 10) -> float:
    """
    Per-image Kaggle-like instance F2 averaged over IoU thresholds.
    """
    pred_bin = (pred_prob >= thr).astype(np.uint8)
    pred_insts = mask_to_instances_cc(pred_bin, min_area=min_area)
    gt_insts = mask_to_instances_cc(gt_mask01.astype(np.uint8), min_area=min_area)

    f2s = []
    for t in iou_thrs:
        tp, fp, fn = match_instances_greedy(pred_insts, gt_insts, iou_thr=float(t))
        f2s.append(f2_from_counts(tp, fp, fn))
    return float(np.mean(f2s)) if len(f2s) > 0 else 0.0


# -----------------------------
# Model: ResNet34-UNet
# -----------------------------

class ConvRelu(nn.Module):
    def __init__(self, in_ch, out_ch, k=3, p=1):
        super().__init__()
        self.conv = nn.Conv2d(in_ch, out_ch, kernel_size=k, padding=p, bias=False)
        self.bn = nn.BatchNorm2d(out_ch)
        self.act = nn.ReLU(inplace=True)

    def forward(self, x):
        return self.act(self.bn(self.conv(x)))


class UpBlock(nn.Module):
    def __init__(self, in_ch, skip_ch, out_ch):
        super().__init__()
        self.up = nn.Upsample(scale_factor=2, mode="bilinear", align_corners=False)
        self.c1 = ConvRelu(in_ch + skip_ch, out_ch)
        self.c2 = ConvRelu(out_ch, out_ch)

    def forward(self, x, skip):
        x = self.up(x)
        if x.shape[-2:] != skip.shape[-2:]:
            x = F.interpolate(x, size=skip.shape[-2:], mode="bilinear", align_corners=False)
        x = torch.cat([x, skip], dim=1)
        x = self.c1(x)
        x = self.c2(x)
        return x


class UNetResNet34(nn.Module):
    def __init__(self, pretrained: bool = True):
        super().__init__()
        weights = torchvision.models.ResNet34_Weights.IMAGENET1K_V1 if pretrained else None
        enc = resnet34(weights=weights)

        self.enc0 = nn.Sequential(enc.conv1, enc.bn1, enc.relu)   # /2
        self.pool = enc.maxpool                                   # /4
        self.enc1 = enc.layer1                                     # /4
        self.enc2 = enc.layer2                                     # /8
        self.enc3 = enc.layer3                                     # /16
        self.enc4 = enc.layer4                                     # /32

        self.center = nn.Sequential(ConvRelu(512, 512), ConvRelu(512, 512))
        self.up4 = UpBlock(512, 256, 256)
        self.up3 = UpBlock(256, 128, 128)
        self.up2 = UpBlock(128, 64, 64)
        self.up1 = UpBlock(64, 64, 64)

        self.head = nn.Conv2d(64, 1, kernel_size=1)

    def forward(self, x):
        x0 = self.enc0(x)              # /2
        x1 = self.enc1(self.pool(x0))  # /4
        x2 = self.enc2(x1)             # /8
        x3 = self.enc3(x2)             # /16
        x4 = self.enc4(x3)             # /32
        c = self.center(x4)            # /32

        d4 = self.up4(c, x3)
        d3 = self.up3(d4, x2)
        d2 = self.up2(d3, x1)
        d1 = self.up1(d2, x0)

        out = F.interpolate(d1, size=x.shape[-2:], mode="bilinear", align_corners=False)
        return self.head(out)


# -----------------------------
# Loss: BCE + Dice
# -----------------------------

def dice_loss_with_logits(logits: torch.Tensor, targets: torch.Tensor, eps: float = 1e-6) -> torch.Tensor:
    probs = torch.sigmoid(logits)
    probs = probs.view(probs.size(0), -1)
    targets = targets.view(targets.size(0), -1)
    inter = (probs * targets).sum(dim=1)
    union = probs.sum(dim=1) + targets.sum(dim=1)
    dice = (2.0 * inter + eps) / (union + eps)
    return (1.0 - dice).mean()


