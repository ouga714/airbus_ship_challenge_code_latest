@dataclass
class SampleItem:
    img_id: str
    is_pos: int  # 1 or 0


def make_epoch_items(pos_ids: List[str], neg_ids: List[str], total: int, pos_frac: float, rng: np.random.RandomState) -> List[SampleItem]:
    pos_n = int(round(total * pos_frac))
    neg_n = total - pos_n
    pos_sel = rng.choice(pos_ids, size=pos_n, replace=(len(pos_ids) < pos_n))
    neg_sel = rng.choice(neg_ids, size=neg_n, replace=(len(neg_ids) < neg_n))
    items = [SampleItem(img_id=x, is_pos=1) for x in pos_sel] + [SampleItem(img_id=x, is_pos=0) for x in neg_sel]
    rng.shuffle(items)
    return items


class AirbusCurriculumDataset(Dataset):
    def __init__(self,
                 img_dir: str,
                 rle_map: Dict[str, List[str]],
                 items: List[SampleItem],
                 stage: str,
                 img_size: int,
                 ms_sizes: Optional[List[int]],
                 mix_ratio: Tuple[int, int, int],
                 seed: int):
        super().__init__()
        if not HAS_CV2:
            raise RuntimeError("cv2 is required.")
        if not HAS_ALB:
            raise RuntimeError("albumentations is required.")

        self.img_dir = img_dir
        self.rle_map = rle_map
        self.items = items
        self.stage = stage
        self.img_size = img_size
        self.ms_sizes = ms_sizes
        self.mix_ratio = mix_ratio
        self.seed = seed

        self.crop_mode = (stage in ["stage1", "stage2"])
        self.crop_size = img_size

        a, c, n = mix_ratio
        s = a + c + n
        self.p_affine = a / s
        self.p_color = c / s
        self.p_normal = n / s

        self._build_transforms()

    def _build_transforms(self):
        self.mean = (0.485, 0.456, 0.406)
        self.std = (0.229, 0.224, 0.225)

        def normalize():
            return A.Normalize(mean=self.mean, std=self.std, max_pixel_value=255.0)

        self.t_stage1 = A.Compose([
            A.Resize(self.img_size, self.img_size, interpolation=cv2.INTER_LINEAR),
            A.HorizontalFlip(p=0.5),
            normalize(),
        ])

        self.t_stage2 = A.Compose([
            A.Resize(self.img_size, self.img_size, interpolation=cv2.INTER_LINEAR),
            A.HorizontalFlip(p=0.5),
            A.RandomBrightnessContrast(brightness_limit=0.15, contrast_limit=0.15, p=0.8),
            A.RandomGamma(gamma_limit=(90, 110), p=0.3),
            A.HueSaturationValue(hue_shift_limit=8, sat_shift_limit=12, val_shift_limit=8, p=0.4),
            A.ImageCompression(quality_lower=75, quality_upper=100, p=0.15),
            normalize(),
        ])

        self.t_affine = lambda sz: A.Compose([
            A.Resize(sz, sz, interpolation=cv2.INTER_LINEAR),
            A.HorizontalFlip(p=0.5),
            A.VerticalFlip(p=0.2),
            A.ShiftScaleRotate(
                shift_limit=0.05, scale_limit=0.10, rotate_limit=15,
                border_mode=cv2.BORDER_REFLECT_101, p=1.0
            ),
            normalize(),
        ])

        self.t_color = lambda sz: A.Compose([
            A.Resize(sz, sz, interpolation=cv2.INTER_LINEAR),
            A.HorizontalFlip(p=0.5),
            A.RandomBrightnessContrast(brightness_limit=0.18, contrast_limit=0.18, p=0.85),
            A.RandomGamma(gamma_limit=(85, 115), p=0.35),
            A.HueSaturationValue(hue_shift_limit=10, sat_shift_limit=16, val_shift_limit=10, p=0.45),
            A.GaussianBlur(blur_limit=(3, 5), p=0.15),
            A.ImageCompression(quality_lower=70, quality_upper=100, p=0.20),
            normalize(),
        ])

        self.t_normal = lambda sz: A.Compose([
            A.Resize(sz, sz, interpolation=cv2.INTER_LINEAR),
            A.HorizontalFlip(p=0.5),
            normalize(),
        ])

        self.t_stage4 = A.Compose([
            A.Resize(self.img_size, self.img_size, interpolation=cv2.INTER_LINEAR),
            A.HorizontalFlip(p=0.5),
            normalize(),
        ])

    def set_items(self, items: List[SampleItem]) -> None:
        self.items = items

    def set_stage(self, stage: str, img_size: int, ms_sizes: Optional[List[int]] = None) -> None:
        self.stage = stage
        self.img_size = img_size
        self.ms_sizes = ms_sizes
        self.crop_mode = (stage in ["stage1", "stage2"])
        self.crop_size = img_size
        self._build_transforms()

    def __len__(self) -> int:
        return len(self.items)

    def _read_image(self, img_id: str) -> np.ndarray:
        p = os.path.join(self.img_dir, img_id)
        img = cv2.imread(p, cv2.IMREAD_COLOR)
        if img is None:
            raise FileNotFoundError(f"Failed to read image: {p}")
        return cv2.cvtColor(img, cv2.COLOR_BGR2RGB)

    def _get_gt_mask(self, img_id: str) -> np.ndarray:
        return build_gt_mask(img_id, self.rle_map, shape_hw=(768, 768))

    def _random_crop_around_ship(self, img: np.ndarray, mask01: np.ndarray, out_size: int, rng: np.random.RandomState) -> Tuple[np.ndarray, np.ndarray]:
        h, w = mask01.shape
        if mask01.max() > 0:
            ys, xs = np.where(mask01 > 0)
            k = rng.randint(0, len(xs))
            cx = int(xs[k])
            cy = int(ys[k])
        else:
            cx = rng.randint(0, w)
            cy = rng.randint(0, h)

        half = out_size // 2
        x0 = cx - half
        y0 = cy - half
        x1 = x0 + out_size
        y1 = y0 + out_size

        if x0 < 0:
            x1 -= x0
            x0 = 0
        if y0 < 0:
            y1 -= y0
            y0 = 0
        if x1 > w:
            x0 -= (x1 - w)
            x1 = w
        if y1 > h:
            y0 -= (y1 - h)
            y1 = h

        x0 = max(0, x0)
        y0 = max(0, y0)
        x1 = min(w, x1)
        y1 = min(h, y1)

        crop_img = img[y0:y1, x0:x1].copy()
        crop_m = mask01[y0:y1, x0:x1].copy()

        ch, cw = crop_m.shape
        if ch != out_size or cw != out_size:
            pad_y = out_size - ch
            pad_x = out_size - cw
            top = pad_y // 2
            bottom = pad_y - top
            left = pad_x // 2
            right = pad_x - left
            crop_img = cv2.copyMakeBorder(crop_img, top, bottom, left, right, borderType=cv2.BORDER_REFLECT_101)
            crop_m = cv2.copyMakeBorder(crop_m, top, bottom, left, right, borderType=cv2.BORDER_CONSTANT, value=0)

        return crop_img, crop_m

    def __getitem__(self, idx: int):
        item = self.items[idx]
        img = self._read_image(item.img_id)
        gt = self._get_gt_mask(item.img_id)

        rng = np.random.RandomState(self.seed + idx * 9973)

        if self.crop_mode:
            img, gt = self._random_crop_around_ship(img, gt, out_size=self.crop_size, rng=rng)

        sz = self.img_size
        if self.stage == "stage3" and self.ms_sizes and len(self.ms_sizes) > 0:
            sz = int(self.ms_sizes[rng.randint(0, len(self.ms_sizes))])

        if self.stage == "stage1":
            aug = self.t_stage1(image=img, mask=gt)
        elif self.stage == "stage2":
            aug = self.t_stage2(image=img, mask=gt)
        elif self.stage == "stage3":
            r = float(rng.rand())
            if r < self.p_affine:
                aug = self.t_affine(sz)(image=img, mask=gt)
            elif r < (self.p_affine + self.p_color):
                aug = self.t_color(sz)(image=img, mask=gt)
            else:
                aug = self.t_normal(sz)(image=img, mask=gt)
        elif self.stage == "stage4":
            aug = self.t_stage4(image=img, mask=gt)
        else:
            raise ValueError(f"Unknown stage: {self.stage}")

        x = aug["image"]
        y = aug["mask"]

        x = np.transpose(x, (2, 0, 1)).astype(np.float32)
        y = (y > 0).astype(np.float32)[None, :, :]

        return torch.from_numpy(x), torch.from_numpy(y), item.img_id


