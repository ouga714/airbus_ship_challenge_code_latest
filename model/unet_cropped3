def load_airbus_csv(csv_path: str) -> Dict[str, List[str]]:
    id2rles: Dict[str, List[str]] = {}
    with open(csv_path, "r", newline="") as f:
        reader = csv.reader(f)
        header = next(reader, None)
        if header is None:
            return id2rles
        try:
            idx_id = header.index("ImageId")
        except Exception:
            idx_id = 0
        try:
            idx_rle = header.index("EncodedPixels")
        except Exception:
            idx_rle = 1

        for row in reader:
            if not row:
                continue
            if len(row) <= max(idx_id, idx_rle):
                continue
            img_id = row[idx_id].strip()
            rle = row[idx_rle].strip() if row[idx_rle] is not None else ""
            if img_id == "":
                continue
            if rle == "":
                continue
            id2rles.setdefault(img_id, []).append(rle)
    return id2rles


# -------------------------
# Split (directory-based ALL ids, stratified by pos/neg)
# -------------------------
def stratified_split_ids(
    all_ids: List[str],
    pos_set: set,
    train_total: int,
    val_total: int,
    test_total: int,
    train_pos_frac: float,
    val_pos_frac: float,
    test_pos_frac: float,
    seed: int,
) -> Tuple[List[str], List[str], List[str]]:
    rng = random.Random(seed)

    pos_ids = [x for x in all_ids if x in pos_set]
    neg_ids = [x for x in all_ids if x not in pos_set]
    rng.shuffle(pos_ids)
    rng.shuffle(neg_ids)

    def take_split(total: int, pos_frac: float, pos_pool: List[str], neg_pool: List[str]) -> List[str]:
        pos_n = int(round(total * pos_frac))
        pos_n = min(pos_n, len(pos_pool))
        neg_n = total - pos_n
        neg_n = min(neg_n, len(neg_pool))
        if pos_n + neg_n < total:
            extra = total - (pos_n + neg_n)
            extra = min(extra, max(0, len(pos_pool) - pos_n))
            pos_n += extra
        out = pos_pool[:pos_n] + neg_pool[:neg_n]
        del pos_pool[:pos_n]
        del neg_pool[:neg_n]
        rng.shuffle(out)
        return out

    pos_pool = pos_ids[:]
    neg_pool = neg_ids[:]

    train_ids = take_split(train_total, train_pos_frac, pos_pool, neg_pool)
    val_ids   = take_split(val_total,   val_pos_frac,   pos_pool, neg_pool)
    test_ids  = take_split(test_total,  test_pos_frac,  pos_pool, neg_pool)

    s_tr, s_va, s_te = set(train_ids), set(val_ids), set(test_ids)
    assert len(s_tr & s_va) == 0 and len(s_tr & s_te) == 0 and len(s_va & s_te) == 0, "Split leakage detected"
    return train_ids, val_ids, test_ids


# -------------------------
# Image / mask processing
# -------------------------
def pil_load_rgb(path: str) -> Image.Image:
    im = Image.open(path)
    if im.mode != "RGB":
        im = im.convert("RGB")
    return im

def pil_to_tensor_normalized(im: Image.Image) -> torch.Tensor:
    arr = np.asarray(im).astype(np.float32) / 255.0
    x = torch.from_numpy(arr).permute(2,0,1).contiguous()
    mean = torch.tensor(IMAGENET_MEAN, dtype=x.dtype).view(3,1,1)
    std  = torch.tensor(IMAGENET_STD,  dtype=x.dtype).view(3,1,1)
    x = (x - mean) / std
    return x

def mask_to_tensor(mask: np.ndarray) -> torch.Tensor:
    t = torch.from_numpy(mask.astype(np.float32))[None, ...]
    return t

def pad_to_square(im: Image.Image, fill: Tuple[int,int,int]=(0,0,0)) -> Tuple[Image.Image, Tuple[int,int,int,int]]:
    w, h = im.size
    if w == h:
        return im, (0,0,0,0)
    side = max(w, h)
    new = Image.new("RGB", (side, side), fill)
    left = (side - w)//2
    top  = (side - h)//2
    new.paste(im, (left, top))
    pad = (left, top, side - w - left, side - h - top)
    return new, pad

def pad_mask_to_square(mask: np.ndarray) -> np.ndarray:
    h, w = mask.shape
    if h == w:
        return mask
    side = max(h, w)
    out = np.zeros((side, side), dtype=mask.dtype)
    left = (side - w)//2
    top  = (side - h)//2
    out[top:top+h, left:left+w] = mask
    return out

def resize_mask_nearest(mask: np.ndarray, size: int) -> np.ndarray:
    m = Image.fromarray((mask*255).astype(np.uint8))
    m = m.resize((size, size), resample=Image.NEAREST)
    arr = (np.asarray(m) > 127).astype(np.uint8)
    return arr

def center_crop_with_pad(im: Image.Image, cx: float, cy: float, crop: int, fill=(0,0,0)) -> Image.Image:
    w, h = im.size
    half = crop / 2.0
    x0 = int(round(cx - half))
    y0 = int(round(cy - half))
    x1 = x0 + crop
    y1 = y0 + crop

    out = Image.new("RGB", (crop, crop), fill)
    src_x0 = max(0, x0); src_y0 = max(0, y0)
    src_x1 = min(w, x1); src_y1 = min(h, y1)
    if src_x1 <= src_x0 or src_y1 <= src_y0:
        return out
    patch = im.crop((src_x0, src_y0, src_x1, src_y1))
    dst_x0 = src_x0 - x0
    dst_y0 = src_y0 - y0
    out.paste(patch, (dst_x0, dst_y0))
    return out

def crop_mask_with_pad(mask: np.ndarray, cx: float, cy: float, crop: int) -> np.ndarray:
    h, w = mask.shape
    half = crop / 2.0
    x0 = int(round(cx - half))
    y0 = int(round(cy - half))
    x1 = x0 + crop
    y1 = y0 + crop
    out = np.zeros((crop, crop), dtype=np.uint8)
    src_x0 = max(0, x0); src_y0 = max(0, y0)
    src_x1 = min(w, x1); src_y1 = min(h, y1)
    if src_x1 <= src_x0 or src_y1 <= src_y0:
        return out
    patch = mask[src_y0:src_y1, src_x0:src_x1]
    dst_x0 = src_x0 - x0
    dst_y0 = src_y0 - y0
    out[dst_y0:dst_y0+patch.shape[0], dst_x0:dst_x0+patch.shape[1]] = patch
    return out


# -------------------------
# Connected components (instances)
# -------------------------
def connected_components(mask01: np.ndarray) -> Tuple[int, np.ndarray]:
    if mask01.dtype != np.uint8:
        mask01 = mask01.astype(np.uint8)
    if mask01.max() == 0:
        return 1, np.zeros_like(mask01, dtype=np.int32)

    if _HAS_CV2:
        n, labels = cv2.connectedComponents(mask01, connectivity=8)
        return n, labels.astype(np.int32)

    if _HAS_SCIPY:
        labels, n = ndi.label(mask01.astype(bool))
        return n+1, labels.astype(np.int32)

    labels = mask01.astype(np.int32)
    labels[labels > 0] = 1
    return 2, labels


# -------------------------
# Losses
# -------------------------
def focal_loss_with_logits(
    logits: torch.Tensor,
    targets: torch.Tensor,
    alpha: float = 0.25,
    gamma: float = 2.0,
    reduction: str = "mean",
    eps: float = 1e-6,
) -> torch.Tensor:
    targets = targets.float()
    bce = F.binary_cross_entropy_with_logits(logits, targets, reduction="none")
    pt = torch.exp(-bce).clamp(min=eps, max=1.0 - eps)
    alpha_t = targets * alpha + (1.0 - targets) * (1.0 - alpha)
    loss = alpha_t * ((1.0 - pt) ** gamma) * bce
    if reduction == "mean":
        return loss.mean()
    if reduction == "sum":
        return loss.sum()
    if reduction == "none":
        return loss
    raise ValueError(f"Unknown reduction: {reduction}")

def dice_loss_from_probs(
    probs: torch.Tensor,
    targets: torch.Tensor,
    eps: float = 1e-6,
    reduction: str = "mean",
) -> torch.Tensor:
    targets = targets.float()
    B = probs.shape[0]
    p = probs.view(B, -1)
    t = targets.view(B, -1)
    inter = (p * t).sum(dim=1)
    denom = p.sum(dim=1) + t.sum(dim=1)
    dice = (2.0 * inter + eps) / (denom + eps)
    loss = 1.0 - dice
    if reduction == "mean":
        return loss.mean()
    if reduction == "sum":
        return loss.sum()
    if reduction == "none":
        return loss
    raise ValueError(f"Unknown reduction: {reduction}")


# -------------------------
# Simple U-Net
# -------------------------
class ConvBNReLU(nn.Module):
    def __init__(self, in_ch: int, out_ch: int):
        super().__init__()
        self.conv = nn.Sequential(
            nn.Conv2d(in_ch, out_ch, 3, padding=1, bias=False),
            nn.BatchNorm2d(out_ch),
            nn.ReLU(inplace=True),
            nn.Conv2d(out_ch, out_ch, 3, padding=1, bias=False),
            nn.BatchNorm2d(out_ch),
            nn.ReLU(inplace=True),
        )
    def forward(self, x):
        return self.conv(x)

class UNet(nn.Module):
    def __init__(self, in_ch: int=3, base: int=32):
        super().__init__()
        self.enc1 = ConvBNReLU(in_ch, base)
        self.pool1 = nn.MaxPool2d(2)
        self.enc2 = ConvBNReLU(base, base*2)
        self.pool2 = nn.MaxPool2d(2)
        self.enc3 = ConvBNReLU(base*2, base*4)
        self.pool3 = nn.MaxPool2d(2)
        self.enc4 = ConvBNReLU(base*4, base*8)
        self.pool4 = nn.MaxPool2d(2)

        self.bottleneck = ConvBNReLU(base*8, base*16)

        self.up4 = nn.ConvTranspose2d(base*16, base*8, 2, stride=2)
        self.dec4 = ConvBNReLU(base*16, base*8)
        self.up3 = nn.ConvTranspose2d(base*8, base*4, 2, stride=2)
        self.dec3 = ConvBNReLU(base*8, base*4)
        self.up2 = nn.ConvTranspose2d(base*4, base*2, 2, stride=2)
        self.dec2 = ConvBNReLU(base*4, base*2)
        self.up1 = nn.ConvTranspose2d(base*2, base, 2, stride=2)
        self.dec1 = ConvBNReLU(base*2, base)

        self.out = nn.Conv2d(base, 1, 1)

    def forward(self, x):
        e1 = self.enc1(x)
        e2 = self.enc2(self.pool1(e1))
        e3 = self.enc3(self.pool2(e2))
        e4 = self.enc4(self.pool3(e3))
        b  = self.bottleneck(self.pool4(e4))

        d4 = self.up4(b)
        d4 = torch.cat([d4, e4], dim=1)
        d4 = self.dec4(d4)

        d3 = self.up3(d4)
        d3 = torch.cat([d3, e3], dim=1)
        d3 = self.dec3(d3)

        d2 = self.up2(d3)
        d2 = torch.cat([d2, e2], dim=1)
        d2 = self.dec2(d2)

        d1 = self.up1(d2)
        d1 = torch.cat([d1, e1], dim=1)
        d1 = self.dec1(d1)

        logits = self.out(d1)
        return logits


