def parse_int_list(s: str) -> List[int]:
    s = s.strip().strip('"').strip("'")
    if not s:
        return []
    parts = [p.strip() for p in s.split(",") if p.strip()]
    out = []
    for p in parts:
        if p.isdigit():
            out.append(int(p))
        else:
            out.append(int(float(p)))
    return out

def parse_float_list(s: str) -> List[float]:
    s = s.strip().strip('"').strip("'")
    if not s:
        return []
    parts = [p.strip() for p in s.split(",") if p.strip()]
    out = []
    for p in parts:
        out.append(float(p))
    return out


