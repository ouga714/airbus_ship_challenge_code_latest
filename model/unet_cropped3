def save_checkpoint(
    path: str,
    model: nn.Module,
    optimizer: torch.optim.Optimizer,
    epoch: int,
    meta: Dict,
) -> None:
    ckpt = {
        "epoch": epoch,
        "model": model.state_dict(),
        "optimizer": optimizer.state_dict(),
        "meta": meta,
    }
    torch.save(ckpt, path)

def main():
    args = build_argparser().parse_args()
    ensure_dir(args.run_dir)
    ensure_dir(os.path.join(args.run_dir, "ckpt"))

    with open(os.path.join(args.run_dir, "args.json"), "w") as f:
        json.dump(vars(args), f, indent=2)

    set_seed(args.seed)

    data_dir = resolve_dataset_root(args.data_dir)
    train_img_dir = os.path.join(data_dir, "train_v2")
    csv_path = os.path.join(data_dir, "train_ship_segmentations_v2.csv")

    print(f"{now_ts()} [INIT] resolved_data_dir={data_dir}")
    print(f"{now_ts()} [INIT] loading id2rles from CSV")
    id2rles = load_airbus_csv(csv_path)

    print(f"{now_ts()} [INIT] listing ALL_TRAIN_IDS from train_v2 directory (CSV起点禁止)")
    all_ids = list_image_ids(train_img_dir)
    pos_set = set(id2rles.keys())
    pos_ids_all = [x for x in all_ids if x in pos_set]
    neg_ids_all = [x for x in all_ids if x not in pos_set]
    pos_rate = len(pos_ids_all) / max(1, len(all_ids))
    print(f"{now_ts()} [INIT] all={len(all_ids)} pos={len(pos_ids_all)} neg={len(neg_ids_all)} pos_rate={pos_rate:.4f}")

    print(f"{now_ts()} [SPLIT] stratified split train/val/test")
    train_ids, val_ids, test_ids = stratified_split_ids(
        all_ids=all_ids,
        pos_set=pos_set,
        train_total=args.train_total,
        val_total=args.val_total,
        test_total=args.test_total,
        train_pos_frac=args.train_pos_frac,
        val_pos_frac=args.val_pos_frac,
        test_pos_frac=args.test_pos_frac,
        seed=args.seed,
    )

    train_pos_ids = [x for x in train_ids if x in pos_set]
    random.Random(args.seed).shuffle(train_pos_ids)
    ph1_n = min(args.phase1_pos_only_n, len(train_pos_ids))
    phase1_pos_ids = train_pos_ids[:ph1_n]
    print(f"{now_ts()} [PH1] phase1_pos_ids={len(phase1_pos_ids)} from TRAIN positives only (no leakage)")

    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print(f"{now_ts()} [ENV] device={device}, torch={torch.__version__}, cuda={torch.version.cuda}")

    ph1_ms = parse_int_list(args.phase1_multiscale)
    ph2_ms = parse_int_list(args.phase2_multiscale)
    thr_list = parse_float_list(args.val_thr_list)
    if not thr_list:
        thr_list = [0.5]

    model = UNet(in_ch=3, base=args.unet_base).to(device)

    # -------------------
    # Phase1
    # -------------------
    print(f"{now_ts()} [PH1] building dataset/loader")
    ds_ph1_train = Phase1ShipCropDataset(
        img_dir=train_img_dir,
        id2rles=id2rles,
        pos_ids=phase1_pos_ids,
        crop_size=args.phase1_crop,
        margin=args.phase1_margin,
        min_occ=args.phase1_min_occ,
        multiscale=ph1_ms,
        out_size=args.phase1_crop,
        max_tries=40,
    )
    dl_ph1_train = make_loader(ds_ph1_train, args.phase1_bs, args.num_workers, args.pin_memory, shuffle=True)
    opt1 = torch.optim.AdamW(model.parameters(), lr=args.phase1_lr, weight_decay=1e-4)

    es = ESState()
    best_f2 = -1.0
    best_epoch = -1
    best_thr = float(thr_list[0])
    best_ckpt = ""

    print(f"{now_ts()} [PH1] start training")
    ph1_log = []
    for e in range(1, args.phase1_epochs + 1):
        tr = train_one_epoch(
            model=model,
            loader=dl_ph1_train,
            optimizer=opt1,
            device=device,
            focal_alpha=args.focal_alpha,
            focal_gamma=args.focal_gamma,
            dice_weight=args.dice_weight,
            grad_clip=args.grad_clip,
            accum_steps=max(1, args.phase1_accum),
            pbar_desc=f"PH1 Train E{e:03d}",
        )

        valres = validate_kaggle_metric(
            model=model,
            ids=val_ids,
            img_dir=train_img_dir,
            id2rles=id2rles,
            device=device,
            infer_size=args.val_infer_size,
            thr_list=thr_list,
            min_area=args.min_area,
            max_images=args.val_max_images,
        )

        cur_f2 = float(valres["best_f2"])
        cur_thr = float(valres["best_thr"])

        # early stopping on Kaggle-F2 saturation (higher better)
        es.ema_prev = ema_update(es.ema_prev, cur_f2, args.es_ema_alpha)
        es.ema_hist.append(es.ema_prev)

        do_stop = False
        if e >= args.es_min_epochs and len(es.ema_hist) >= args.es_window:
            win = es.ema_hist[-args.es_window:]
            slope = slope_last_window(win)  # positive slope means improving
            if slope < args.es_slope_eps:
                es.bad_count += 1
            else:
                es.bad_count = 0
            if es.bad_count >= args.es_patience:
                do_stop = True
        else:
            slope = 0.0

        meta = {
            "phase": 1,
            "epoch": e,
            "train": tr,
            "val_kaggle": valres,
            "val_best_f2": cur_f2,
            "val_best_thr": cur_thr,
            "val_ema": es.ema_prev,
            "val_ema_slope": slope,
            "es_bad_count": es.bad_count,
            "best_f2": best_f2,
            "best_epoch": best_epoch,
            "best_thr": best_thr,
        }
        ckpt_path = os.path.join(args.run_dir, "ckpt", f"ph1_epoch{e:03d}.pt")
        save_checkpoint(ckpt_path, model, opt1, e, meta)

        if cur_f2 > best_f2:
            best_f2 = cur_f2
            best_epoch = e
            best_thr = cur_thr
            best_ckpt = os.path.join(args.run_dir, "ckpt", "best_ph1.pt")
            save_checkpoint(best_ckpt, model, opt1, e, meta)

        ph1_log.append({
            "phase": 1,
            "epoch": e,
            "train_loss": tr["loss"],
            "val_best_f2": cur_f2,
            "val_best_thr": cur_thr,
            "val_ema": es.ema_prev,
            "val_ema_slope": slope,
            "es_bad": es.bad_count,
            "best_f2": best_f2,
            "best_epoch": best_epoch,
            "best_thr": best_thr,
        })

        print(
            f"{now_ts()} [PH1][E{e:03d}] "
            f"train_loss={tr['loss']:.6f} "
            f"val_kaggleF2={cur_f2:.6f} best_thr={cur_thr:.3f} "
            f"ema={es.ema_prev:.6f} slope={slope:.6g} es_bad={es.bad_count}/{args.es_patience} "
            f"bestF2={best_f2:.6f}@{best_epoch} (thr={best_thr:.3f})"
        )

        if do_stop:
            print(f"{now_ts()} [PH1] early-stopping: val Kaggle-F2 saturated (patience={args.es_patience})")
            break

    with open(os.path.join(args.run_dir, "ph1_log.json"), "w") as f:
        json.dump(ph1_log, f, indent=2)

    if best_ckpt and os.path.isfile(best_ckpt):
        print(f"{now_ts()} [PH2] loading best PH1 ckpt: {best_ckpt}")
        ck = torch.load(best_ckpt, map_location="cpu")
        model.load_state_dict(ck["model"], strict=True)

    # -------------------
    # Phase2
    # -------------------
    print(f"{now_ts()} [PH2] building dataset/loader")
    ds_ph2_train = Phase2FullDataset(
        img_dir=train_img_dir,
        id2rles=id2rles,
        ids=train_ids,
        out_size=args.phase2_size,
        multiscale=ph2_ms,
    )
    dl_ph2_train = make_loader(ds_ph2_train, args.phase2_bs, args.num_workers, args.pin_memory, shuffle=True)
    opt2 = torch.optim.AdamW(model.parameters(), lr=args.phase2_lr, weight_decay=1e-4)

    es = ESState()
    best_f2_ph2 = -1.0
    best_epoch_ph2 = -1
    best_thr_ph2 = float(thr_list[0])
    best_ckpt_ph2 = ""

    print(f"{now_ts()} [PH2] start training")
    ph2_log = []
    for e in range(1, args.phase2_epochs + 1):
        tr = train_one_epoch(
            model=model,
            loader=dl_ph2_train,
            optimizer=opt2,
            device=device,
            focal_alpha=args.focal_alpha,
            focal_gamma=args.focal_gamma,
            dice_weight=args.dice_weight,
            grad_clip=args.grad_clip,
            accum_steps=max(1, args.phase2_accum),
            pbar_desc=f"PH2 Train E{e:03d}",
        )

        valres = validate_kaggle_metric(
            model=model,
            ids=val_ids,
            img_dir=train_img_dir,
            id2rles=id2rles,
            device=device,
            infer_size=args.val_infer_size,
            thr_list=thr_list,
            min_area=args.min_area,
            max_images=args.val_max_images,
        )

        cur_f2 = float(valres["best_f2"])
        cur_thr = float(valres["best_thr"])

        es.ema_prev = ema_update(es.ema_prev, cur_f2, args.es_ema_alpha)
        es.ema_hist.append(es.ema_prev)

        do_stop = False
        if e >= args.es_min_epochs and len(es.ema_hist) >= args.es_window:
            win = es.ema_hist[-args.es_window:]
            slope = slope_last_window(win)
            if slope < args.es_slope_eps:
                es.bad_count += 1
            else:
                es.bad_count = 0
            if es.bad_count >= args.es_patience:
                do_stop = True
        else:
            slope = 0.0

        meta = {
            "phase": 2,
            "epoch": e,
            "train": tr,
            "val_kaggle": valres,
            "val_best_f2": cur_f2,
            "val_best_thr": cur_thr,
            "val_ema": es.ema_prev,
            "val_ema_slope": slope,
            "es_bad_count": es.bad_count,
            "best_f2": best_f2_ph2,
            "best_epoch": best_epoch_ph2,
            "best_thr": best_thr_ph2,
        }
        ckpt_path = os.path.join(args.run_dir, "ckpt", f"ph2_epoch{e:03d}.pt")
        save_checkpoint(ckpt_path, model, opt2, e, meta)

        if cur_f2 > best_f2_ph2:
            best_f2_ph2 = cur_f2
            best_epoch_ph2 = e
            best_thr_ph2 = cur_thr
            best_ckpt_ph2 = os.path.join(args.run_dir, "ckpt", "best_ph2.pt")
            save_checkpoint(best_ckpt_ph2, model, opt2, e, meta)

        ph2_log.append({
            "phase": 2,
            "epoch": e,
            "train_loss": tr["loss"],
            "val_best_f2": cur_f2,
            "val_best_thr": cur_thr,
            "val_ema": es.ema_prev,
            "val_ema_slope": slope,
            "es_bad": es.bad_count,
            "best_f2": best_f2_ph2,
            "best_epoch": best_epoch_ph2,
            "best_thr": best_thr_ph2,
        })

        print(
            f"{now_ts()} [PH2][E{e:03d}] "
            f"train_loss={tr['loss']:.6f} "
            f"val_kaggleF2={cur_f2:.6f} best_thr={cur_thr:.3f} "
            f"ema={es.ema_prev:.6f} slope={slope:.6g} es_bad={es.bad_count}/{args.es_patience} "
            f"bestF2={best_f2_ph2:.6f}@{best_epoch_ph2} (thr={best_thr_ph2:.3f})"
        )

        if do_stop:
            print(f"{now_ts()} [PH2] early-stopping: val Kaggle-F2 saturated (patience={args.es_patience})")
            break

    with open(os.path.join(args.run_dir, "ph2_log.json"), "w") as f:
        json.dump(ph2_log, f, indent=2)

    if best_ckpt_ph2 and os.path.isfile(best_ckpt_ph2):
        print(f"{now_ts()} [DONE] best PH2 ckpt: {best_ckpt_ph2}")
        ck = torch.load(best_ckpt_ph2, map_location="cpu")
        model.load_state_dict(ck["model"], strict=True)
        torch.save(model.state_dict(), os.path.join(args.run_dir, "best_model_state_dict.pt"))

    # -------------------
    # Kaggle test inference
    # -------------------
    if args.infer_kaggle_test:
        use_thr = args.infer_thr
        if args.infer_best_thr and best_thr_ph2 > 0:
            use_thr = best_thr_ph2
        print(f"{now_ts()} [INFER] using thr={use_thr:.3f} (best_thr_ph2={best_thr_ph2:.3f})")
        infer_kaggle_test(
            model=model,
            data_dir=data_dir,
            run_dir=args.run_dir,
            device=device,
            infer_size=args.infer_size,
            thr=use_thr,
            min_area=args.min_area,
            vis_n=args.infer_vis_n,
        )

    summary = {
        "data_dir": data_dir,
        "train_total": len(train_ids),
        "val_total": len(val_ids),
        "test_total": len(test_ids),
        "best_ph1_kaggle_f2": best_f2,
        "best_ph1_epoch": best_epoch,
        "best_ph1_thr": best_thr,
        "best_ph2_kaggle_f2": best_f2_ph2,
        "best_ph2_epoch": best_epoch_ph2,
        "best_ph2_thr": best_thr_ph2,
        "has_cv2": _HAS_CV2,
        "has_scipy": _HAS_SCIPY,
    }
    with open(os.path.join(args.run_dir, "summary.json"), "w") as f:
        json.dump(summary, f, indent=2)

    print(f"{now_ts()} [DONE] wrote summary.json")


if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        print(f"{now_ts()} [FATAL] {type(e).__name__}: {e}")
        traceback.print_exc()
        sys.exit(1)
