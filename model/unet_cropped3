# Datasets
# -------------------------
class Phase1ShipCropDataset(Dataset):
    def __init__(
        self,
        img_dir: str,
        id2rles: Dict[str, List[str]],
        pos_ids: List[str],
        crop_size: int,
        margin: float,
        min_occ: float,
        multiscale: List[int],
        out_size: int,
        max_tries: int = 30,
    ):
        self.img_dir = img_dir
        self.id2rles = id2rles
        self.pos_ids = pos_ids
        self.crop_size = crop_size
        self.margin = float(margin)
        self.min_occ = float(min_occ)
        self.multiscale = multiscale[:] if multiscale else [crop_size]
        self.out_size = out_size
        self.max_tries = max_tries

    def __len__(self):
        return len(self.pos_ids)

    def __getitem__(self, idx: int):
        img_id = self.pos_ids[idx]
        img_path = os.path.join(self.img_dir, img_id)
        im = pil_load_rgb(img_path)
        rles = self.id2rles.get(img_id, [])
        mask = union_mask_from_rles(rles, shape=(768,768))

        crop = random.choice(self.multiscale)

        ys, xs = np.where(mask > 0)
        if len(xs) == 0:
            cx = 768/2
            cy = 768/2
        else:
            x0, x1 = xs.min(), xs.max()
            y0, y1 = ys.min(), ys.max()
            bw = x1 - x0 + 1
            bh = y1 - y0 + 1
            x0 = int(max(0, math.floor(x0 - bw * self.margin)))
            x1 = int(min(767, math.ceil(x1 + bw * self.margin)))
            y0 = int(max(0, math.floor(y0 - bh * self.margin)))
            y1 = int(min(767, math.ceil(y1 + bh * self.margin)))
            cx = (x0 + x1) / 2.0
            cy = (y0 + y1) / 2.0

        best_im = None
        best_m  = None
        best_occ = -1.0
        for _ in range(self.max_tries):
            jx = random.uniform(-0.10, 0.10) * crop
            jy = random.uniform(-0.10, 0.10) * crop
            cim = center_crop_with_pad(im, cx + jx, cy + jy, crop)
            cm  = crop_mask_with_pad(mask, cx + jx, cy + jy, crop)
            occ = float(cm.sum()) / float(crop * crop)
            if occ > best_occ:
                best_occ, best_im, best_m = occ, cim, cm
            if occ >= self.min_occ:
                break

        if best_im is None or best_m is None:
            best_im = center_crop_with_pad(im, cx, cy, crop)
            best_m = crop_mask_with_pad(mask, cx, cy, crop)

        if crop != self.out_size:
            best_im = best_im.resize((self.out_size, self.out_size), resample=Image.BILINEAR)
            best_m = resize_mask_nearest(best_m, self.out_size)

        x = pil_to_tensor_normalized(best_im)
        y = mask_to_tensor(best_m)
        return x, y, img_id


class Phase2FullDataset(Dataset):
    def __init__(
        self,
        img_dir: str,
        id2rles: Dict[str, List[str]],
        ids: List[str],
        out_size: int,
        multiscale: List[int],
    ):
        self.img_dir = img_dir
        self.id2rles = id2rles
        self.ids = ids
        self.out_size = out_size
        self.multiscale = multiscale[:] if multiscale else [out_size]

    def __len__(self):
        return len(self.ids)

    def __getitem__(self, idx: int):
        img_id = self.ids[idx]
        img_path = os.path.join(self.img_dir, img_id)
        im = pil_load_rgb(img_path)
        rles = self.id2rles.get(img_id, [])
        mask = union_mask_from_rles(rles, shape=(768,768))

        im_sq, _pad = pad_to_square(im)
        m_sq = pad_mask_to_square(mask)

        s = random.choice(self.multiscale)
        im_sq = im_sq.resize((s, s), resample=Image.BILINEAR)
        m_sq = resize_mask_nearest(m_sq, s)

        if s != self.out_size:
            im_sq = im_sq.resize((self.out_size, self.out_size), resample=Image.BILINEAR)
            m_sq = resize_mask_nearest(m_sq, self.out_size)

        x = pil_to_tensor_normalized(im_sq)
        y = mask_to_tensor(m_sq)
        return x, y, img_id


# -------------------------
# Kaggle metric (Instance F2 over IoU thresholds sweep)
# -------------------------
IOU_THRESHOLDS = [0.50 + 0.05*i for i in range(10)]  # 0.50..0.95

def mask_iou(a: np.ndarray, b: np.ndarray) -> float:
    # a,b: uint8 {0,1}
    inter = int((a & b).sum())
    if inter == 0:
        return 0.0
    union = int((a | b).sum())
    return float(inter) / float(union + 1e-9)

def match_iou_greedy(iou_mat: np.ndarray, thr: float) -> int:
    """
    iou_mat: (Np, Ng)
    returns TP count under 1-to-1 matching using greedy best-pair selection.
    """
    if iou_mat.size == 0:
        return 0
    Np, Ng = iou_mat.shape
    used_p = np.zeros(Np, dtype=np.uint8)
    used_g = np.zeros(Ng, dtype=np.uint8)
    tp = 0
    # flatten all pairs, sort by iou desc
    pairs = []
    for i in range(Np):
        for j in range(Ng):
            v = iou_mat[i, j]
            if v >= thr:
                pairs.append((v, i, j))
    if not pairs:
        return 0
    pairs.sort(key=lambda x: x[0], reverse=True)
    for v, i, j in pairs:
        if used_p[i] or used_g[j]:
            continue
        used_p[i] = 1
        used_g[j] = 1
        tp += 1
    return tp

def f2_from_counts(tp: int, fp: int, fn: int, eps: float=1e-9) -> float:
    # F2 = 5TP / (5TP + 4FN + FP)
    return (5.0 * tp) / (5.0 * tp + 4.0 * fn + 1.0 * fp + eps)

def score_image_kaggle_f2(pred_insts: List[np.ndarray], gt_insts: List[np.ndarray]) -> float:
    """
    Kaggle-style: mean over IoU thresholds 0.50..0.95 of instance F2 under 1-to-1 matching.
    """
    Np = len(pred_insts)
    Ng = len(gt_insts)
    if Np == 0 and Ng == 0:
        return 1.0  # correct empty
    if Np == 0 and Ng > 0:
        return 0.0
    if Np > 0 and Ng == 0:
        return 0.0

    # IoU matrix
    iou_mat = np.zeros((Np, Ng), dtype=np.float32)
    for i in range(Np):
        for j in range(Ng):
            iou_mat[i, j] = mask_iou(pred_insts[i], gt_insts[j])

    scores = []
    for thr in IOU_THRESHOLDS:
        tp = match_iou_greedy(iou_mat, thr)
        fp = Np - tp
        fn = Ng - tp
        scores.append(f2_from_counts(tp, fp, fn))
    return float(np.mean(scores))


# -------------------------
# Inference helpers (prob -> instances)
# -------------------------
def instances_from_prob(prob: np.ndarray, thr: float, min_area: int, max_instances: int = 60) -> List[np.ndarray]:
    bin01 = (prob >= thr).astype(np.uint8)
    n, labels = connected_components(bin01)
    if n <= 1:
        return []
    comps = []
    for k in range(1, n):
        m = (labels == k).astype(np.uint8)
        area = int(m.sum())
        if area >= min_area:
            comps.append((area, m))
    comps.sort(key=lambda x: x[0], reverse=True)

    insts = []
    claimed = np.zeros_like(bin01, dtype=np.uint8)
    for area, m in comps[:max_instances]:
        m2 = (m & (1 - claimed)).astype(np.uint8)
        if int(m2.sum()) < min_area:
            continue
        claimed |= m2
        insts.append(m2)
    return insts

@torch.no_grad()
def infer_prob_map(model: nn.Module, x: torch.Tensor) -> torch.Tensor:
    model.eval()
    logits = model(x)
    return torch.sigmoid(logits)


# -------------------------
# Early stopping by saturation (EMA + slope)
# -------------------------
def ema_update(prev: Optional[float], x: float, alpha: float) -> float:
    if prev is None:
        return x
    return alpha * x + (1.0 - alpha) * prev

def slope_last_window(xs: List[float]) -> float:
    n = len(xs)
    if n <= 1:
        return 0.0
    x = np.arange(n, dtype=np.float64)
    y = np.array(xs, dtype=np.float64)
    x_mean = x.mean()
    y_mean = y.mean()
    denom = ((x - x_mean)**2).sum()
    if denom <= 0:
        return 0.0
    slope = ((x - x_mean)*(y - y_mean)).sum() / denom
    return float(slope)

@dataclass
class ESState:
    ema_prev: Optional[float] = None
    ema_hist: List[float] = None
    bad_count: int = 0
    def __post_init__(self):
        if self.ema_hist is None:
            self.ema_hist = []


# -------------------------
# Training / Validation
# -------------------------
def make_loader(ds: Dataset, bs: int, num_workers: int, pin_memory: int, shuffle: bool) -> DataLoader:
    return DataLoader(
        ds,
        batch_size=bs,
        shuffle=shuffle,
        num_workers=num_workers,
        pin_memory=bool(pin_memory),
        drop_last=False,
    )

def _get_pbar(it, desc: str):
    if tqdm is None:
        return it
    return tqdm(it, desc=desc, leave=False)

def train_one_epoch(
    model: nn.Module,
    loader: DataLoader,
    optimizer: torch.optim.Optimizer,
    device: torch.device,
    focal_alpha: float,
    focal_gamma: float,
    dice_weight: float,
    grad_clip: float,
    accum_steps: int,
    pbar_desc: str,
) -> Dict[str, float]:
    model.train()
    optimizer.zero_grad(set_to_none=True)

    loss_sum = 0.0
    n_batches = 0

    it = _get_pbar(loader, pbar_desc)
    for step, batch in enumerate(it):
        x, y, _img_ids = batch
        x = x.to(device, non_blocking=True)
        y = y.to(device, non_blocking=True).clamp_(0.0, 1.0)

        logits = model(x)
        probs = torch.sigmoid(logits)

        loss_f = focal_loss_with_logits(logits, y, alpha=focal_alpha, gamma=focal_gamma, reduction="mean")
        loss_d = dice_loss_from_probs(probs, y, eps=1e-6, reduction="mean")
        loss = loss_f + dice_weight * loss_d

        if not torch.isfinite(loss):
            optimizer.zero_grad(set_to_none=True)
            continue

        (loss / float(accum_steps)).backward()

        if (step + 1) % accum_steps == 0:
            if grad_clip > 0:
                torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=grad_clip)
            optimizer.step()
            optimizer.zero_grad(set_to_none=True)

        loss_sum += float(loss.item())
        n_batches += 1

        if tqdm is not None:
            it.set_postfix(loss=loss_sum/max(1,n_batches))

    if n_batches > 0 and (n_batches % accum_steps) != 0:
        if grad_clip > 0:
            torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=grad_clip)
        optimizer.step()
        optimizer.zero_grad(set_to_none=True)

    avg_loss = loss_sum / max(1, n_batches)
    return {"loss": avg_loss}

@torch.no_grad()
def validate_kaggle_metric(
    model: nn.Module,
    ids: List[str],
    img_dir: str,
    id2rles: Dict[str, List[str]],
    device: torch.device,
    infer_size: int,
    thr_list: List[float],
    min_area: int,
    max_images: int = 0,
) -> Dict[str, object]:
    """
    Heavy validation: compute Kaggle F2 (IoU sweep) on image list.
    Optionally sweep probability thresholds and pick best.
    """
    if not thr_list:
        thr_list = [0.5]

    # accum: image-level average
    thr2sum = {thr: 0.0 for thr in thr_list}
    n_img = 0

    it = _get_pbar(ids, "ValKaggleF2")
    for k, img_id in enumerate(it):
        if max_images > 0 and k >= max_images:
            break

        img_path = os.path.join(img_dir, img_id)
        im = pil_load_rgb(img_path)

        # GT instances
        gt_insts = instance_masks_from_rles(id2rles.get(img_id, []), shape=(768,768))

        # model inference
        im_sq, _ = pad_to_square(im)
        im_sq = im_sq.resize((infer_size, infer_size), resample=Image.BILINEAR)
        x = pil_to_tensor_normalized(im_sq)[None, ...].to(device)

        prob = infer_prob_map(model, x)[0,0].detach().cpu().numpy().astype(np.float32)  # infer_size x infer_size

        # upsample back to 768
        prob_up = Image.fromarray((prob*255).astype(np.uint8)).resize((768,768), resample=Image.BILINEAR)
        prob_up = (np.asarray(prob_up).astype(np.float32) / 255.0).clip(0,1)

        # evaluate each thr
        for thr in thr_list:
            pred_insts = instances_from_prob(prob_up, thr=thr, min_area=min_area, max_instances=60)
            s = score_image_kaggle_f2(pred_insts, gt_insts)
            thr2sum[thr] += float(s)

        n_img += 1
        if tqdm is not None:
            # show current best
            cur = {thr: thr2sum[thr]/max(1,n_img) for thr in thr_list}
            best_thr = max(cur.keys(), key=lambda t: cur[t])
            it.set_postfix(best_thr=best_thr, best_f2=cur[best_thr])

    thr2mean = {thr: thr2sum[thr]/max(1,n_img) for thr in thr_list}
    best_thr = max(thr2mean.keys(), key=lambda t: thr2mean[t])
    best_f2 = float(thr2mean[best_thr])

    return {
        "n_images": n_img,
        "thr2mean": thr2mean,
        "best_thr": float(best_thr),
        "best_f2": best_f2,
    }


