def list_image_ids(img_dir: str) -> List[str]:
    ids = []
    for fn in os.listdir(img_dir):
        lf = fn.lower()
        if lf.endswith(".jpg") or lf.endswith(".jpeg") or lf.endswith(".png"):
            ids.append(fn)
    ids.sort()
