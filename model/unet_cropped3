def resolve_dataset_root(user_data_dir: str) -> str:
    user_data_dir = os.path.abspath(user_data_dir)

    candidates = [
        user_data_dir,
        os.path.join(user_data_dir, "airbus-ship-detection"),
        os.path.join(user_data_dir, "airbus_ship_detection"),
        os.path.dirname(__file__),
        os.path.abspath(os.path.join(os.path.dirname(__file__), "..")),
    ]
    seen = set()
    cand2 = []
    for c in candidates:
        c = os.path.abspath(c)
        if c not in seen:
            seen.add(c)
            cand2.append(c)
    candidates = cand2

    def _valid(root: str) -> bool:
        return (
            os.path.isdir(os.path.join(root, "train_v2")) and
            os.path.isdir(os.path.join(root, "test_v2")) and
            os.path.isfile(os.path.join(root, "train_ship_segmentations_v2.csv")) and
            os.path.isfile(os.path.join(root, "sample_submission_v2.csv"))
        )

    for c in candidates:
        if _valid(c):
            return c

    for c in candidates:
        if not os.path.isdir(c):
            continue
        try:
            subs = os.listdir(c)
        except Exception:
            continue
        for sub in subs:
            r = os.path.join(c, sub)
            if _valid(r):
                return r

    raise AssertionError(
        "Could not resolve dataset root. Tried:\n" + "\n".join(candidates) +
        "\nExpected: train_v2/, test_v2/, train_ship_segmentations_v2.csv, sample_submission_v2.csv"
    )


# -------------------------
# RLE (Kaggle Airbus)
# -------------------------
def rle_decode(rle: str, shape: Tuple[int, int] = (768, 768)) -> np.ndarray:
    if rle is None:
        return np.zeros(shape, dtype=np.uint8)
    rle = rle.strip()
    if rle == "":
        return np.zeros(shape, dtype=np.uint8)

    s = list(map(int, rle.split()))
    starts = s[0::2]
    lengths = s[1::2]
    starts = np.asarray(starts) - 1
    ends = starts + np.asarray(lengths)

    img = np.zeros(shape[0] * shape[1], dtype=np.uint8)
    for st, en in zip(starts, ends):
        img[st:en] = 1
    return img.reshape(shape, order="F")

def rle_encode(mask: np.ndarray) -> str:
    if mask.dtype != np.uint8:
        mask = mask.astype(np.uint8)
    if mask.max() == 0:
        return ""
    pixels = mask.reshape(-1, order="F")
    pixels = np.concatenate([[0], pixels, [0]])
    changes = np.where(pixels[1:] != pixels[:-1])[0] + 1
    runs = changes.copy()
    runs[1::2] -= runs[0::2]
    return " ".join(str(x) for x in runs)

def union_mask_from_rles(rles: List[str], shape: Tuple[int,int]=(768,768)) -> np.ndarray:
    if not rles:
        return np.zeros(shape, dtype=np.uint8)
    m = np.zeros(shape, dtype=np.uint8)
    for r in rles:
        if r and r.strip():
            m |= rle_decode(r, shape)
    return m

def instance_masks_from_rles(rles: List[str], shape: Tuple[int,int]=(768,768)) -> List[np.ndarray]:
    out = []
    for r in rles:
        if r and r.strip():
            out.append(rle_decode(r, shape).astype(np.uint8))
    return out


