def write_submission_from_probs(
    out_csv_path: str,
    template_csv_path: str,
    imgid2inst_rles: Dict[str, List[str]],
) -> None:
    rows_out = []
    with open(template_csv_path, "r", newline="") as f:
        reader = csv.reader(f)
        header = next(reader, None)
        if header is None:
            raise RuntimeError("Empty template csv")
        rows_out.append(header)
        for row in reader:
            if not row:
                continue
            img_id = row[0].strip()
            rles = imgid2inst_rles.get(img_id, [])
            if len(rles) == 0:
                rows_out.append([img_id, ""])
            else:
                for r in rles:
                    rows_out.append([img_id, r])

    with open(out_csv_path, "w", newline="") as f:
        writer = csv.writer(f)
        writer.writerows(rows_out)

@torch.no_grad()
def infer_kaggle_test(
    model: nn.Module,
    data_dir: str,
    run_dir: str,
    device: torch.device,
    infer_size: int,
    thr: float,
    min_area: int,
    vis_n: int,
) -> str:
    test_dir = os.path.join(data_dir, "test_v2")
    template = os.path.join(data_dir, "sample_submission_v2.csv")
    out_csv = os.path.join(run_dir, "submission.csv")
    vis_dir = os.path.join(run_dir, "vis_kaggle_test")
    ensure_dir(vis_dir)

    ids = list_image_ids(test_dir)
    print(f"{now_ts()} [INFER] kaggle test images={len(ids)}")

    imgid2rles: Dict[str, List[str]] = {}
    saved_vis = 0

    for img_id in _get_pbar(ids, "KaggleTestInfer"):
        img_path = os.path.join(test_dir, img_id)
        im = pil_load_rgb(img_path)

        im_sq, _ = pad_to_square(im)
        im_sq = im_sq.resize((infer_size, infer_size), resample=Image.BILINEAR)
        x = pil_to_tensor_normalized(im_sq)[None, ...].to(device)

        prob = infer_prob_map(model, x)[0,0].detach().cpu().numpy().astype(np.float32)

        prob_up = Image.fromarray((prob*255).astype(np.uint8)).resize((768,768), resample=Image.BILINEAR)
        prob_up = (np.asarray(prob_up).astype(np.float32) / 255.0).clip(0,1)

        insts = instances_from_prob(prob_up, thr=thr, min_area=min_area, max_instances=60)
        rles = [rle_encode(m) for m in insts if m.sum() > 0]
        imgid2rles[img_id] = rles

        if saved_vis < vis_n and (len(rles) > 0):
            uni = np.zeros((768,768), dtype=np.uint8)
            for m in insts:
                uni |= m
            rgb_np = np.asarray(im)
            ov = rgb_np.copy()
            ov[...,0] = np.clip(ov[...,0] + uni*140, 0, 255)
            cat = np.concatenate([rgb_np, ov], axis=1)
            Image.fromarray(cat).save(os.path.join(vis_dir, f"vis_{saved_vis:04d}_{img_id}.png"))
            saved_vis += 1

    write_submission_from_probs(out_csv, template, imgid2rles)
    print(f"{now_ts()} [INFER] wrote {out_csv}")
    return out_csv


