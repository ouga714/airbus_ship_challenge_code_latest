def run_phase(
    phase_dir: str,
    phase_name: str,
    model: nn.Module,
    init_ckpt_path: Optional[str],
    train_ids: List[str],
    val_ids: List[str],
    img_dir: str,
    id2rles: Dict[str, List[str]],
    phase_cfg: PhaseConfig,
    loss_cfg: LossConfig,
    es_cfg: ESConfig,
    device: torch.device,
    lr: float,
    weight_decay: float,
    epochs: int,
    batch_size: int,
    num_workers: int,
    log_every: int,
) -> str:
    ensure_dir(phase_dir)
    log_path = os.path.join(phase_dir, "log.txt")

    def log(msg: str) -> None:
        line = f"{now_str()} {msg}"
        print(line)
        with open(log_path, "a") as f:
            f.write(line + "\n")

    if init_ckpt_path is not None:
        sd = torch.load(init_ckpt_path, map_location=device)
        model.load_state_dict(sd, strict=True)
        log(f"[init] loaded={init_ckpt_path} sha1_1mb={sha1_first_1mb(init_ckpt_path)}")

    train_ds = AirbusDataset(img_dir=img_dir, ids=train_ids, id2rles=id2rles, phase=phase_cfg)
    val_ds = AirbusDataset(
        img_dir=img_dir,
        ids=val_ids,
        id2rles=id2rles,
        phase=PhaseConfig(
            name="val",
            img_size=phase_cfg.img_size,  # match phase size for val_loss stability
            crop_size=None,               # NO ship crop on val
            ship_only=False,
            min_occ=0.0,
            ship_crop_ratio=0.0,
            ship_crop_trials=0,
            ship_crop_jitter=0,
            aug=False
        )
    )

    train_loader = DataLoader(
        train_ds, batch_size=batch_size, shuffle=True,
        num_workers=num_workers, pin_memory=True, drop_last=True
    )
    val_loader = DataLoader(
        val_ds, batch_size=max(1, batch_size), shuffle=False,
        num_workers=num_workers, pin_memory=True, drop_last=False
    )

    optimizer = optim.AdamW(model.parameters(), lr=lr, weight_decay=weight_decay)
    es = LossPlateauES(es_cfg)

    meta = {
        "phase_name": phase_name,
        "time_start": now_str(),
        "init_ckpt_path": init_ckpt_path,
        "phase_cfg": vars(phase_cfg),
        "loss_cfg": vars(loss_cfg),
        "es_cfg": vars(es_cfg),
        "optim": {"lr": lr, "weight_decay": weight_decay},
        "epochs_max": epochs,
        "batch_size": batch_size,
        "num_workers": num_workers,
        "train_ids_n": len(train_ids),
        "val_ids_n": len(val_ids),
    }
    write_json(os.path.join(phase_dir, "meta.json"), meta)

    last_model_path = os.path.join(phase_dir, "last_model.pt")
    phase_end_path = os.path.join(phase_dir, "phase_end_model.pt")

    for epoch in range(1, epochs + 1):
        t0 = time.time()
        tr = run_one_epoch_train(model, train_loader, optimizer, device, loss_cfg, log_every=log_every)
        va = run_one_epoch_val(model, val_loader, device, loss_cfg)
        dt = time.time() - t0

        log(f"[epoch {epoch:03d}] train_loss={tr['loss_total']:.6f} (bce={tr['loss_bce']:.6f}, tv={tr['loss_tversky']:.6f}) | "
            f"val_loss={va['loss_total']:.6f} (bce={va['loss_bce']:.6f}, tv={va['loss_tversky']:.6f}) | time={dt:.1f}s")

        torch.save(model.state_dict(), last_model_path)

        stop = es.step(val_loss=float(va["loss_total"]), epoch=epoch)
        write_json(os.path.join(phase_dir, "loss_history.json"), {
            "history": es.history(),
            "plateau_count": es.plateau_count,
            "stop_reason": es.stop_reason,
        })

        if stop:
            log(f"[early_stop] reason={es.stop_reason} epoch={epoch} plateau_count={es.plateau_count}")
            break

    torch.save(model.state_dict(), phase_end_path)

    meta["time_end"] = now_str()
    meta["stop_reason"] = es.stop_reason
    meta["epochs_ran"] = len(es.val_losses)
    write_json(os.path.join(phase_dir, "meta.json"), meta)

    log(f"[save] last_model.pt={last_model_path} sha1_1mb={sha1_first_1mb(last_model_path)}")
    log(f"[save] phase_end_model.pt={phase_end_path} sha1_1mb={sha1_first_1mb(phase_end_path)}")
    return phase_end_path


