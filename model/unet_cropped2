# ----------------------------
# RLE encode/decode (Airbus format)
# - 1-indexed starts
# - column-major (Fortran order)
# ----------------------------

def rle_decode(rle: str, h: int, w: int) -> np.ndarray:
    """
    Returns mask (h, w) uint8 in {0,1}
    """
    if rle is None or rle == "":
        return np.zeros((h, w), dtype=np.uint8)

    s = rle.strip().split()
    starts = np.asarray(s[0::2], dtype=np.int64) - 1
    lengths = np.asarray(s[1::2], dtype=np.int64)

    ends = starts + lengths
    flat = np.zeros(h * w, dtype=np.uint8)
    for st, en in zip(starts, ends):
        flat[st:en] = 1

    # column-major to (h, w)
    mask = flat.reshape((w, h), order="F").T
    return mask


def rle_encode(mask: np.ndarray) -> str:
    """
    mask: (h, w) uint8/bool {0,1}
    Returns Airbus RLE (column-major, 1-indexed)
    """
    if mask.dtype != np.uint8:
        mask = mask.astype(np.uint8)
    h, w = mask.shape
    # Flatten in column-major
    flat = mask.T.reshape(-1, order="F")
    # Pad zeros at both ends
    padded = np.concatenate([[0], flat, [0]])
    changes = np.where(padded[1:] != padded[:-1])[0]
    if len(changes) == 0:
        return ""
    runs = changes + 1
    runs[1::2] = runs[1::2] - runs[0::2]
    return " ".join(str(x) for x in runs)


# ----------------------------
# CSV parsing (NO pandas)
# ----------------------------

def load_id2rles(csv_path: str) -> Dict[str, List[str]]:
    """
    Build mapping from ImageId -> list of RLEs (POS only; empty rle rows ignored)
    """
    id2rles: Dict[str, List[str]] = {}
    with open(csv_path, "r", newline="") as f:
        reader = csv.DictReader(f)
        for row in reader:
            img_id = row["ImageId"]
            rle = row["EncodedPixels"]
            if rle is None or rle == "":
                continue
            id2rles.setdefault(img_id, []).append(rle)
    return id2rles


def build_full_mask_from_rles(rles: List[str], h: int, w: int) -> np.ndarray:
    if not rles:
        return np.zeros((h, w), dtype=np.uint8)
    m = np.zeros((h, w), dtype=np.uint8)
    for r in rles:
        m |= rle_decode(r, h, w)
    m = (m > 0).astype(np.uint8)
    return m


# ----------------------------
# Geometry helpers
# ----------------------------

def mask_to_bbox(mask: np.ndarray) -> Optional[Tuple[int, int, int, int]]:
    """
    mask: (H,W) {0,1}
    returns bbox (x0,y0,x1,y1) inclusive-exclusive or None if empty
    """
    ys, xs = np.where(mask > 0)
    if len(xs) == 0:
        return None
    x0, x1 = int(xs.min()), int(xs.max()) + 1
    y0, y1 = int(ys.min()), int(ys.max()) + 1
    return (x0, y0, x1, y1)


def clamp(v: int, lo: int, hi: int) -> int:
    return max(lo, min(hi, v))


def make_ship_crop(
    img: Image.Image,
    mask: np.ndarray,
    crop_size: int,
    min_occ: float,
    max_trials: int,
    jitter: int,
) -> Tuple[Image.Image, np.ndarray, float]:
    """
    Ship-centric crop around bbox with occupancy constraint.
    NOTE: occ here is bbox_area_in_crop / crop_area (not exact mask area).
    If constraint can't be met, returns best attempt (highest occ).
    """
    w, h = img.size
    bbox = mask_to_bbox(mask)
    if bbox is None:
        # fallback: random crop
        x0 = random.randint(0, max(0, w - crop_size))
        y0 = random.randint(0, max(0, h - crop_size))
        crop_img = img.crop((x0, y0, x0 + crop_size, y0 + crop_size))
        crop_mask = mask[y0:y0 + crop_size, x0:x0 + crop_size]
        return crop_img, crop_mask, 0.0

    bx0, by0, bx1, by1 = bbox
    crop_area = float(crop_size * crop_size)

    best = None
    best_occ = -1.0

    for _ in range(max_trials):
        cx = (bx0 + bx1) // 2 + random.randint(-jitter, jitter)
        cy = (by0 + by1) // 2 + random.randint(-jitter, jitter)

        x0 = clamp(cx - crop_size // 2, 0, max(0, w - crop_size))
        y0 = clamp(cy - crop_size // 2, 0, max(0, h - crop_size))

        crop_mask = mask[y0:y0 + crop_size, x0:x0 + crop_size]
        bb = mask_to_bbox(crop_mask)
        if bb is None:
            occ = 0.0
        else:
            x0b, y0b, x1b, y1b = bb
            occ = float((x1b - x0b) * (y1b - y0b)) / crop_area

        if occ > best_occ:
            crop_img = img.crop((x0, y0, x0 + crop_size, y0 + crop_size))
            best = (crop_img, crop_mask.copy(), occ)
            best_occ = occ

        if occ >= min_occ:
            break

    assert best is not None
    return best


# ----------------------------
# Light augmentation (shape-safe)
# ----------------------------

def apply_augmentations(img: Image.Image, mask: np.ndarray, do_aug: bool) -> Tuple[Image.Image, np.ndarray]:
    if not do_aug:
        return img, mask

    # Random horizontal/vertical flips
    if random.random() < 0.5:
        img = TF.hflip(img)
        mask = np.ascontiguousarray(np.fliplr(mask))
    if random.random() < 0.2:
        img = TF.vflip(img)
        mask = np.ascontiguousarray(np.flipud(mask))

    # Mild brightness/contrast
    if random.random() < 0.5:
        b = 0.9 + 0.2 * random.random()
        img = ImageEnhance.Brightness(img).enhance(b)
    if random.random() < 0.5:
        c = 0.9 + 0.2 * random.random()
        img = ImageEnhance.Contrast(img).enhance(c)

    return img, mask


