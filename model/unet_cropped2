def stratified_sample(ids: List[str], k: int, seed: int) -> List[str]:
    rng = random.Random(seed)
    if k >= len(ids):
        return list(ids)
    return rng.sample(ids, k)


def make_val_split(
    pos_ids: List[str],
    neg_ids: List[str],
    val_total: int,
    val_pos_frac: float,
    seed: int,
) -> Tuple[List[str], List[str], List[str]]:
    val_pos = int(round(val_total * val_pos_frac))
    val_pos = min(val_pos, len(pos_ids))
    val_neg = val_total - val_pos
    val_neg = min(val_neg, len(neg_ids))
    val_total = val_pos + val_neg

    rng = random.Random(seed)

    pos_shuf = list(pos_ids)
    neg_shuf = list(neg_ids)
    rng.shuffle(pos_shuf)
    rng.shuffle(neg_shuf)

    val_ids = pos_shuf[:val_pos] + neg_shuf[:val_neg]
    rem_pos = pos_shuf[val_pos:]
    rem_neg = neg_shuf[val_neg:]
    rng.shuffle(val_ids)
    return val_ids, rem_pos, rem_neg


def write_json(path: str, obj: dict) -> None:
    with open(path, "w") as f:
        json.dump(obj, f, indent=2, ensure_ascii=False)


