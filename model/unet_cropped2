    ap.add_argument("--vis_n", type=int, default=200)
    ap.add_argument("--cam_alpha", type=float, default=0.45)

    ap.add_argument("--log_every", type=int, default=50)

    args = ap.parse_args()
    set_seed(args.seed)

    data_dir = args.data_dir
    run_dir = args.run_dir
    ensure_dir(run_dir)

    # Paths
    train_dir = os.path.join(data_dir, "train_v2")
    test_dir = os.path.join(data_dir, "test_v2")
    csv_path = os.path.join(data_dir, "train_ship_segmentations_v2.csv")
    sample_sub = os.path.join(data_dir, "sample_submission_v2.csv")

    # Validate
    for p in [train_dir, test_dir, csv_path, sample_sub]:
        if not os.path.exists(p):
            raise FileNotFoundError(p)

    # Build population
    all_train_ids = list_image_ids(train_dir)
    id2rles = load_id2rles(csv_path)
    pos_ids = sorted(list(set(id2rles.keys()) & set(all_train_ids)))
    neg_ids = sorted(list(set(all_train_ids) - set(pos_ids)))

    print(f"{now_str()} ALL={len(all_train_ids)} POS={len(pos_ids)} NEG={len(neg_ids)} pos_rate={len(pos_ids)/max(1,len(all_train_ids)):.4f}")
    write_json(os.path.join(run_dir, "dataset_stats.json"), {
        "all": len(all_train_ids),
        "pos": len(pos_ids),
        "neg": len(neg_ids),
        "pos_rate": float(len(pos_ids) / max(1, len(all_train_ids))),
    })

    # Fixed val split
    val_ids, rem_pos, rem_neg = make_val_split(
        pos_ids=pos_ids, neg_ids=neg_ids,
        val_total=args.val_total, val_pos_frac=args.val_pos_frac,
        seed=args.seed
    )

    # Phase pools
    phase1_train_ids = list(rem_pos)  # ship-only: POS only
    phase2_train_ids = list(rem_pos)  # ship-only: POS only

    phase3_total = int(args.phase3_train_total)
    phase3_pos = int(round(phase3_total * args.phase3_pos_frac))
    phase3_neg = phase3_total - phase3_pos
    phase3_pos = min(phase3_pos, len(rem_pos))
    phase3_neg = min(phase3_neg, len(rem_neg))

    if phase3_pos + phase3_neg < phase3_total:
        deficit = phase3_total - (phase3_pos + phase3_neg)
        extra_neg = min(deficit, len(rem_neg) - phase3_neg)
        phase3_neg += extra_neg
        deficit -= extra_neg
        extra_pos = min(deficit, len(rem_pos) - phase3_pos)
        phase3_pos += extra_pos
        deficit -= extra_pos
        if deficit > 0:
            print(f"[WARN] Could not reach phase3_total={phase3_total}; using {phase3_pos+phase3_neg} due to pool limits.")

    phase3_pos_ids = stratified_sample(rem_pos, phase3_pos, seed=args.seed + 1001)
    phase3_neg_ids = stratified_sample(rem_neg, phase3_neg, seed=args.seed + 2002)
    phase3_train_ids = phase3_pos_ids + phase3_neg_ids
    random.Random(args.seed + 3003).shuffle(phase3_train_ids)

    splits = {
        "seed": args.seed,
        "val_total": args.val_total,
        "val_pos_frac": args.val_pos_frac,
        "val_ids": val_ids,
        "phase1_train_pos_ids": phase1_train_ids,
        "phase2_train_pos_ids": phase2_train_ids,
        "phase3_train_ids": phase3_train_ids,
        "phase3_train_total": len(phase3_train_ids),
        "phase3_pos": int(sum([1 for x in phase3_train_ids if x in id2rles])),
        "phase3_neg": int(sum([1 for x in phase3_train_ids if x not in id2rles])),
    }
    write_json(os.path.join(run_dir, "splits.json"), splits)

    print(f"{now_str()} VAL={len(val_ids)} | P1_train(POS)={len(phase1_train_ids)} | "
          f"P3_train={len(phase3_train_ids)} (pos={splits['phase3_pos']}, neg={splits['phase3_neg']})")

    # Device
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print(f"{now_str()} device={device} torch={torch.__version__} torchvision={torchvision.__version__}")

    # Model (U-Net r101)
    model = build_model().to(device)

    # Grad-CAM target: encoder.layer4 output (best practical target for ResNet)
    gradcam = None
    try:
        gradcam = GradCAM(model=model, target_module=model.enc_layer4)
        print(f"{now_str()} Grad-CAM enabled: target=model.enc_layer4")
    except Exception as e:
        print(f"{now_str()} [WARN] Grad-CAM init failed: {e}. Continue without CAM.")
        gradcam = None

    loss_cfg = LossConfig(
        w_bce=args.w_bce, w_tv=args.w_tv,
        pos_weight=args.pos_weight,
        tv_alpha=args.tv_alpha, tv_beta=args.tv_beta
    )

    # ---------------- Phase 1 ----------------
    phase1_dir = os.path.join(run_dir, "phase1_shiponly_occHigh")
    p1 = PhaseConfig(
        name="phase1",
        img_size=args.phase1_img,
        crop_size=args.phase1_crop,
        ship_only=True,
        min_occ=args.phase1_min_occ,
        ship_crop_ratio=1.0,
        ship_crop_trials=30,
        ship_crop_jitter=16,
        aug=True,
    )
    es1 = ESConfig(
        ema_alpha=args.es_ema_alpha,
        window=args.es1_window,
        slope_eps=args.es1_slope_eps,
        patience=args.es1_patience,
        min_epochs=args.es1_min_epochs,
    )
    ckpt1 = run_phase(
        phase_dir=phase1_dir,
        phase_name="phase1",
        model=model,
        init_ckpt_path=None,
        train_ids=phase1_train_ids,
        val_ids=val_ids,
        img_dir=train_dir,
        id2rles=id2rles,
        phase_cfg=p1,
        loss_cfg=loss_cfg,
        es_cfg=es1,
        device=device,
        lr=args.phase1_lr,
        weight_decay=args.phase1_wd,
        epochs=args.phase1_epochs,
        batch_size=args.phase1_bs,
        num_workers=args.num_workers,
        log_every=args.log_every,
    )

    # ---------------- Phase 2 ----------------
    phase2_dir = os.path.join(run_dir, "phase2_imgUp_occLow")
    p2 = PhaseConfig(
        name="phase2",
        img_size=args.phase2_img,
        crop_size=args.phase2_crop,
        ship_only=True,
        min_occ=args.phase2_min_occ,
        ship_crop_ratio=1.0,
        ship_crop_trials=25,
        ship_crop_jitter=24,
        aug=True,
    )
    es2 = ESConfig(
        ema_alpha=args.es_ema_alpha,
        window=args.es2_window,
        slope_eps=args.es2_slope_eps,
        patience=args.es2_patience,
        min_epochs=args.es2_min_epochs,
    )
    ckpt2 = run_phase(
        phase_dir=phase2_dir,
        phase_name="phase2",
        model=model,
        init_ckpt_path=ckpt1,
        train_ids=phase2_train_ids,
        val_ids=val_ids,
        img_dir=train_dir,
        id2rles=id2rles,
        phase_cfg=p2,
        loss_cfg=loss_cfg,
        es_cfg=es2,
        device=device,
        lr=args.phase2_lr,
        weight_decay=args.phase2_wd,
        epochs=args.phase2_epochs,
        batch_size=args.phase2_bs,
        num_workers=args.num_workers,
        log_every=args.log_every,
    )

    # ---------------- Phase 3 ----------------
    phase3_dir = os.path.join(run_dir, "phase3_full50k")
    p3 = PhaseConfig(
        name="phase3",
        img_size=args.phase3_img,
        crop_size=args.phase3_shipcrop_crop,  # used only when ship_crop_ratio > 0
        ship_only=False,
        min_occ=args.phase3_shipcrop_min_occ,
        ship_crop_ratio=args.phase3_shipcrop_ratio,
        ship_crop_trials=20,
        ship_crop_jitter=28,
        aug=True,
    )
    es3 = ESConfig(
        ema_alpha=args.es_ema_alpha,
        window=args.es3_window,
        slope_eps=args.es3_slope_eps,
        patience=args.es3_patience,
        min_epochs=args.es3_min_epochs,
    )
    ckpt3 = run_phase(
        phase_dir=phase3_dir,
        phase_name="phase3",
        model=model,
        init_ckpt_path=ckpt2,
        train_ids=phase3_train_ids,
        val_ids=val_ids,
        img_dir=train_dir,
        id2rles=id2rles,
        phase_cfg=p3,
        loss_cfg=loss_cfg,
        es_cfg=es3,
        device=device,
        lr=args.phase3_lr,
        weight_decay=args.phase3_wd,
        epochs=args.phase3_epochs,
        batch_size=args.phase3_bs,
        num_workers=args.num_workers,
        log_every=args.log_every,
    )

    # Load phase3 end model for inference
    model.load_state_dict(torch.load(ckpt3, map_location=device), strict=True)

    # Threshold scan on val
    thr = 0.05
    thr_scan_result = None
    if int(args.thr_scan) == 1:
        thr_list = np.linspace(args.thr_min, args.thr_max, args.thr_steps).tolist()
        val_ds_for_thr = AirbusDataset(
            img_dir=train_dir,
            ids=val_ids,
            id2rles=id2rles,
            phase=PhaseConfig(
                name="val_thr",
                img_size=args.phase3_img,
                crop_size=None,
                ship_only=False,
                min_occ=0.0,
                ship_crop_ratio=0.0,
                ship_crop_trials=0,
                ship_crop_jitter=0,
                aug=False,
            )
        )
        val_loader_thr = DataLoader(val_ds_for_thr, batch_size=1, shuffle=False,
                                    num_workers=args.num_workers, pin_memory=True)
        thr_scan_result = scan_threshold_f2(model, val_loader_thr, device, thr_list)
        thr = float(thr_scan_result["best_thr"])
        write_json(os.path.join(run_dir, "thr_scan_phase3_val.json"), thr_scan_result)
        print(f"{now_str()} [thr_scan] best_thr={thr:.5f} best_f2={thr_scan_result['best_f2']:.6f}")

    # Inference + submission + vis(+Grad-CAM)
    submission_path = os.path.join(run_dir, "submission.csv")
    vis_dir = os.path.join(run_dir, "vis_test") if int(args.save_vis) == 1 else None
    infer_test_and_make_submission(
        model=model,
        gradcam=gradcam,
        test_dir=test_dir,
        sample_sub_path=sample_sub,
        out_csv_path=submission_path,
        device=device,
        img_size=args.phase3_img,
        thr=thr,
        min_area=args.min_area,
        vis_dir=vis_dir,
        vis_n=args.vis_n,
        cam_alpha=float(args.cam_alpha),
    )

    # Final meta
    final_meta = {
        "time_end": now_str(),
        "run_dir": run_dir,
        "seed": args.seed,
        "model": "UNet(ResNet101-encoder) + GradCAM(target=enc_layer4)",
        "phase1_end_ckpt": ckpt1,
        "phase2_end_ckpt": ckpt2,
        "phase3_end_ckpt": ckpt3,
        "thr_scan_result": thr_scan_result,
        "inference_thr": float(thr),
        "submission_path": submission_path,
        "vis_dir": vis_dir,
        "note": "Early stopping is loss-plateau based (EMA+slope), NOT best-based. best_model.pt is not used.",
    }
    write_json(os.path.join(run_dir, "final_meta.json"), final_meta)
    print(f"{now_str()} DONE -> {run_dir}")

    if gradcam is not None:
        gradcam.close()


if __name__ == "__main__":
    main()
