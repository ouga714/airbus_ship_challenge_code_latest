def parse_args() -> argparse.Namespace:
    p = argparse.ArgumentParser()

    p.add_argument("--mode", type=str, default="all", choices=["split", "train", "infer", "all"])
    p.add_argument("--data_dir", type=str, required=True)
    p.add_argument("--run_dir", type=str, required=True)
    p.add_argument("--seed", type=int, default=42)

    # splits
    p.add_argument("--train_pos", type=int, default=50000)
    p.add_argument("--val_total", type=int, default=30000)
    p.add_argument("--val_pos_rate", type=float, default=0.221)
    p.add_argument("--ptest_total", type=int, default=3000)
    p.add_argument("--ptest_pos_rate", type=float, default=-1.0)  # -1 => use val_pos_rate

    # training
    p.add_argument("--phase1_epochs", type=int, default=6)
    p.add_argument("--phase2_epochs", type=int, default=4)
    p.add_argument("--phase1_bs", type=int, default=4)
    p.add_argument("--phase2_bs", type=int, default=1)
    p.add_argument("--lr", type=float, default=2e-4)
    p.add_argument("--weight_decay", type=float, default=1e-4)
    p.add_argument("--max_grad_norm", type=float, default=0.0)
    p.add_argument("--num_workers", type=int, default=4)

    # loss
    p.add_argument("--tversky_alpha", type=float, default=0.3)
    p.add_argument("--tversky_beta", type=float, default=0.7)
    p.add_argument("--emb_dim", type=int, default=16)
    p.add_argument("--emb_weight", type=float, default=1.0)
    p.add_argument("--near_mode", type=str, default="soft", choices=["soft", "hard"])
    p.add_argument("--near_sigma_px", type=float, default=140.0)
    p.add_argument("--near_min_weight", type=float, default=0.05)

    # phase2 multi-scale
    p.add_argument("--ms_sizes", type=str, default="640,704,768,832,896")

    # detector
    p.add_argument("--detector_ckpt", type=str, default="")
    p.add_argument("--detector_expected_sha1_first1mb", type=str, default="")
    p.add_argument("--det_gate", type=int, default=1)
    p.add_argument("--det_thr", type=float, default=0.004130961839109659)

    # inference
    p.add_argument("--infer_size", type=int, default=768)
    p.add_argument("--tta_hflip", type=int, default=1)
    p.add_argument("--tta_vflip", type=int, default=0)
    p.add_argument("--fg_thr", type=float, default=0.05)
    p.add_argument("--min_area", type=int, default=50)
    p.add_argument("--big_cc_area", type=int, default=600)

    p.add_argument("--dbscan_eps", type=float, default=0.6)
    p.add_argument("--dbscan_min_samples", type=int, default=30)
    p.add_argument("--spatial_weight", type=float, default=0.02)

    p.add_argument("--nms_iou_thr", type=float, default=0.50)
    p.add_argument("--max_instances_per_image", type=int, default=15)

    # vis
    p.add_argument("--save_vis", type=int, default=1)
    p.add_argument("--vis_max_images", type=int, default=200)

    return p.parse_args()


def main() -> None:
    args = parse_args()
    seed_all(args.seed)

    data_dir = Path(args.data_dir)
    run_dir = Path(args.run_dir)
    run_dir.mkdir(parents=True, exist_ok=True)

    # open log
    global _GLOBAL_LOG_F
    _GLOBAL_LOG_F = open(str(run_dir / "log_global.txt"), "a", encoding="utf-8")

    log("==== START ====")
    log(f"args = {vars(args)}")

    # env checks
    if not _HAS_SKLEARN:
        raise RuntimeError("scikit-learn is required for DBSCAN. Please install it in the environment.")
    if not (_HAS_CV2 or _HAS_SCIPY):
        raise RuntimeError("Either opencv-python-headless (cv2) or scipy is required for connected components/morphology.")

    train_img_dir = data_dir / "train_v2"
    test_img_dir = data_dir / "test_v2"
    train_csv = data_dir / "train_ship_segmentations_v2.csv"
    sample_csv = data_dir / "sample_submission_v2.csv"

    if not train_img_dir.exists():
        raise FileNotFoundError(f"Missing train_v2 dir: {train_img_dir}")
    if not test_img_dir.exists():
        raise FileNotFoundError(f"Missing test_v2 dir: {test_img_dir}")
    if not train_csv.exists():
        raise FileNotFoundError(f"Missing train_ship_segmentations_v2.csv: {train_csv}")
    if not sample_csv.exists():
        raise FileNotFoundError(f"Missing sample_submission_v2.csv: {sample_csv}")

    # device
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    log(f"device = {device}")

    # load id2rles
    log("Loading CSV id2rles ...")
    id2rles = load_id2rles(train_csv)
    log(f"train images in csv (pos only) = {len(id2rles)}")

    # list all train ids from directory (critical)
    all_train_ids = sorted([p.name for p in train_img_dir.glob("*.jpg")])
    log(f"train images (dir-based) = {len(all_train_ids)}")

    # make / load splits
    splits_path = run_dir / "splits.json"
    if args.mode in ["split", "train", "infer", "all"]:
        if args.mode == "split" or (not splits_path.exists()):
            log("Creating splits ...")
            ptest_pos_rate = None if args.ptest_pos_rate < 0 else float(args.ptest_pos_rate)
            splits = make_splits(
                all_train_ids=all_train_ids,
                id2rles=id2rles,
                seed=args.seed,
                train_pos=int(args.train_pos),
                val_total=int(args.val_total),
                val_pos_rate=float(args.val_pos_rate),
                ptest_total=int(args.ptest_total),
                ptest_pos_rate=ptest_pos_rate
            )
            with open(splits_path, "w", encoding="utf-8") as f:
                json.dump(splits, f, indent=2)
            log(f"Saved splits: {splits_path} ({splits_path.stat().st_size/1e6:.2f}MB)")
            log(f"[Split Summary] {splits['counts']}")
        else:
            log(f"Loading existing splits: {splits_path}")
            with open(splits_path, "r", encoding="utf-8") as f:
                splits = json.load(f)
            log(f"[Split Summary] {splits['counts']}")

    if args.mode == "split":
        log("Split-only mode done.")
        log("==== END ====")
        return

    # build datasets
    ms_sizes = [int(x) for x in args.ms_sizes.split(",") if x.strip() != ""]
    train_ids = splits["ids"]["train"]
    val_ids = splits["ids"]["val"]
    ptest_ids = splits["ids"]["ptest"]

    # Phase1 datasets (fixed 768)
    ds_train_p1 = AirbusDataset(train_img_dir, train_ids, id2rles, out_size=768, multi_scale=False, augment=True)
    ds_val = AirbusDataset(train_img_dir, val_ids, id2rles, out_size=768, multi_scale=False, augment=False)
    ds_ptest = AirbusDataset(train_img_dir, ptest_ids, id2rles, out_size=768, multi_scale=False, augment=False)

    dl_train_p1 = DataLoader(ds_train_p1, batch_size=args.phase1_bs, shuffle=True,
                             num_workers=args.num_workers, pin_memory=True, collate_fn=collate_fn)
    dl_val = DataLoader(ds_val, batch_size=2, shuffle=False,
                        num_workers=max(1, args.num_workers//2), pin_memory=True, collate_fn=collate_fn)
    dl_ptest = DataLoader(ds_ptest, batch_size=1, shuffle=False,
                          num_workers=max(1, args.num_workers//2), pin_memory=True, collate_fn=collate_fn)

    # Phase2 datasets (multi-scale)
    ds_train_p2 = AirbusDataset(train_img_dir, train_ids, id2rles, out_size=768, multi_scale=True, ms_sizes=ms_sizes, augment=True)
    dl_train_p2 = DataLoader(ds_train_p2, batch_size=args.phase2_bs, shuffle=True,
                             num_workers=args.num_workers, pin_memory=True, collate_fn=collate_fn)

    # model
    model = UNetResNet34(emb_dim=args.emb_dim, pretrained=True).to(device)

    # optimizer
    optimizer = optim.AdamW(model.parameters(), lr=args.lr, weight_decay=args.weight_decay)

    # detector (optional but recommended)
    detector = None
    det_gate = bool(int(args.det_gate))
    if args.detector_ckpt and args.detector_ckpt.strip() != "":
        detector = load_detector_checked(
            detector_ckpt_path=args.detector_ckpt,
            device=device,
            expected_sha1_first1mb=args.detector_expected_sha1_first1mb
        )
    else:
        log("[WARN] detector_ckpt not provided. det_gate will be disabled.")
        det_gate = False

    # train
    ckpt_path = run_dir / "best_model.pt"
    meta_path = run_dir / "meta.json"

    best_val_f2 = -1.0
    best_epoch = -1
    best_phase = "none"

    if args.mode in ["train", "all"]:
        log("==== TRAIN PHASE1 (fixed 768) ====")
        for ep in range(args.phase1_epochs):
            log(f"Phase1 epoch {ep+1}/{args.phase1_epochs}")
            tr = train_one_epoch(
                model=model, loader=dl_train_p1, optimizer=optimizer, device=device,
                tversky_alpha=args.tversky_alpha, tversky_beta=args.tversky_beta,
                emb_dim=args.emb_dim,
                near_mode=args.near_mode, near_sigma_px=args.near_sigma_px, near_min_weight=args.near_min_weight,
                emb_weight=args.emb_weight, max_grad_norm=args.max_grad_norm
            )
            log(f"[Phase1][train] {tr}")

            # eval (union pixel metrics for sanity)
            ev = eval_union_metrics(model, dl_val, device, fg_thr=args.fg_thr)
            log(f"[Phase1][val] {ev}")

            if ev["f2"] > best_val_f2:
                best_val_f2 = ev["f2"]
                best_epoch = ep + 1
                best_phase = "phase1"
                torch.save({
                    "model": model.state_dict(),
                    "optimizer": optimizer.state_dict(),
                    "best_val_f2": best_val_f2,
                    "best_epoch": best_epoch,
                    "best_phase": best_phase,
                    "args": vars(args),
                    "splits": splits
                }, ckpt_path)
                with open(meta_path, "w", encoding="utf-8") as f:
                    json.dump({
                        "best_val_f2": best_val_f2,
                        "best_epoch": best_epoch,
                        "best_phase": best_phase,
                        "fg_thr": args.fg_thr
                    }, f, indent=2)
                log(f"[CKPT] saved best_model.pt (best_val_f2={best_val_f2:.6f})")

        log("==== TRAIN PHASE2 (multi-scale) ====")
        for ep in range(args.phase2_epochs):
            log(f"Phase2 epoch {ep+1}/{args.phase2_epochs}")
            tr = train_one_epoch(
                model=model, loader=dl_train_p2, optimizer=optimizer, device=device,
                tversky_alpha=args.tversky_alpha, tversky_beta=args.tversky_beta,
                emb_dim=args.emb_dim,
                near_mode=args.near_mode, near_sigma_px=args.near_sigma_px, near_min_weight=args.near_min_weight,
                emb_weight=args.emb_weight, max_grad_norm=args.max_grad_norm
            )
            log(f"[Phase2][train] {tr}")

            ev = eval_union_metrics(model, dl_val, device, fg_thr=args.fg_thr)
            log(f"[Phase2][val] {ev}")

            if ev["f2"] > best_val_f2:
                best_val_f2 = ev["f2"]
                best_epoch = ep + 1
                best_phase = "phase2"
                torch.save({
                    "model": model.state_dict(),
                    "optimizer": optimizer.state_dict(),
                    "best_val_f2": best_val_f2,
                    "best_epoch": best_epoch,
                    "best_phase": best_phase,
                    "args": vars(args),
                    "splits": splits
                }, ckpt_path)
                with open(meta_path, "w", encoding="utf-8") as f:
                    json.dump({
                        "best_val_f2": best_val_f2,
                        "best_epoch": best_epoch,
                        "best_phase": best_phase,
                        "fg_thr": args.fg_thr
                    }, f, indent=2)
                log(f"[CKPT] saved best_model.pt (best_val_f2={best_val_f2:.6f})")

    # load best checkpoint for inference
    if ckpt_path.exists():
        log(f"Loading best model ckpt: {ckpt_path}")
        ckpt = torch.load(str(ckpt_path), map_location="cpu")
        sd = ckpt["model"] if isinstance(ckpt, dict) and "model" in ckpt else ckpt
        model.load_state_dict(sd, strict=True)
    else:
        log("[WARN] best_model.pt not found. Using current in-memory weights for inference.")

    # inference
    if args.mode in ["infer", "all"]:
        infer_dir = run_dir / "inference"
        infer_dir.mkdir(parents=True, exist_ok=True)

        # --- ptest inference (RLE saved + vis) ---
        log("==== INFER on PTEST (holdout) ====")
        out_ptest = run_inference_on_ids(
            model=model, detector=detector,
            img_dir=train_img_dir,
            ids=ptest_ids,
            out_dir=infer_dir,
            device=device,
            infer_size=args.infer_size,
            tta_hflip=bool(args.tta_hflip),
            tta_vflip=bool(args.tta_vflip),
            det_gate=det_gate,
            det_thr=args.det_thr,
            fg_thr=args.fg_thr,
            min_area=args.min_area,
            big_cc_area=args.big_cc_area,
            dbscan_eps=args.dbscan_eps,
            dbscan_min_samples=args.dbscan_min_samples,
            spatial_weight=args.spatial_weight,
            nms_iou_thr=args.nms_iou_thr,
            max_instances_per_image=args.max_instances_per_image,
            save_vis=bool(args.save_vis),
            vis_max_images=args.vis_max_images,
            tag="ptest",
            use_template_order=None
        )

        # --- Kaggle test inference using sample_submission order ---
        log("==== INFER on TEST_V2 (Kaggle) ====")
        template_ids: List[str] = []
        with open(sample_csv, "r", newline="") as f:
            rr = csv.DictReader(f)
            for row in rr:
                template_ids.append(row["ImageId"])
        log(f"sample_submission template rows = {len(template_ids)}")

        out_test = run_inference_on_ids(
            model=model, detector=detector,
            img_dir=test_img_dir,
            ids=[],
            out_dir=infer_dir,
            device=device,
            infer_size=args.infer_size,
            tta_hflip=bool(args.tta_hflip),
            tta_vflip=bool(args.tta_vflip),
            det_gate=det_gate,
            det_thr=args.det_thr,
            fg_thr=args.fg_thr,
            min_area=args.min_area,
            big_cc_area=args.big_cc_area,
            dbscan_eps=args.dbscan_eps,
            dbscan_min_samples=args.dbscan_min_samples,
            spatial_weight=args.spatial_weight,
            nms_iou_thr=args.nms_iou_thr,
            max_instances_per_image=args.max_instances_per_image,
            save_vis=bool(args.save_vis),
            vis_max_images=args.vis_max_images,
            tag="testv2",
            use_template_order=template_ids
        )

        log(f"[DONE] ptest_submission = {out_ptest}")
        log(f"[DONE] test_submission  = {out_test}")

    log("==== END ====")


if __name__ == "__main__":
    main()
