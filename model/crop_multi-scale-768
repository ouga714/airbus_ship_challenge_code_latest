def binary_open_close(mask01: np.ndarray, k: int = 3, do_open: bool = True, do_close: bool = True) -> np.ndarray:
    """
    mask01: uint8 {0,1}
    """
    if k <= 1:
        return mask01
    if _HAS_CV2:
        ker = np.ones((k, k), np.uint8)
        m = (mask01 * 255).astype(np.uint8)
        if do_open:
            m = cv2.morphologyEx(m, cv2.MORPH_OPEN, ker)
        if do_close:
            m = cv2.morphologyEx(m, cv2.MORPH_CLOSE, ker)
        return (m > 0).astype(np.uint8)
    if _HAS_SCIPY:
        # approximate open/close via binary erosion/dilation
        structure = np.ones((k, k), dtype=bool)
        m = mask01.astype(bool)
        if do_open:
            m = ndi.binary_opening(m, structure=structure)
        if do_close:
            m = ndi.binary_closing(m, structure=structure)
        return m.astype(np.uint8)
    # fallback: no-op
    return mask01


def connected_components(mask01: np.ndarray) -> Tuple[int, np.ndarray, List[Tuple[int, int, int, int, int]]]:
    """
    Returns:
      n_cc (excluding background),
      labels (H,W) int32, background=0,
      stats list for each component id=1..n_cc: (x,y,w,h,area)
    """
    H, W = mask01.shape
    if _HAS_CV2:
        num, labels, stats, _centroids = cv2.connectedComponentsWithStats((mask01 > 0).astype(np.uint8), connectivity=8)
        # num includes background=0
        out_stats: List[Tuple[int, int, int, int, int]] = []
        for cid in range(1, num):
            x, y, w, h, area = stats[cid].tolist()
            out_stats.append((x, y, w, h, area))
        return num - 1, labels.astype(np.int32), out_stats

    if _HAS_SCIPY:
        labels, num = ndi.label(mask01 > 0)
        out_stats = []
        for cid in range(1, num + 1):
            ys, xs = np.where(labels == cid)
            if xs.size == 0:
                continue
            x0, x1 = int(xs.min()), int(xs.max())
            y0, y1 = int(ys.min()), int(ys.max())
            area = int(xs.size)
            out_stats.append((x0, y0, x1 - x0 + 1, y1 - y0 + 1, area))
        return num, labels.astype(np.int32), out_stats

    # fallback: treat whole mask as one component
    area = int(mask01.sum())
    labels = (mask01 > 0).astype(np.int32)
    if area == 0:
        return 0, labels, []
    ys, xs = np.where(mask01 > 0)
    x0, x1 = int(xs.min()), int(xs.max())
    y0, y1 = int(ys.min()), int(ys.max())
    return 1, labels, [(x0, y0, x1 - x0 + 1, y1 - y0 + 1, area)]


def filter_min_area(mask01: np.ndarray, min_area: int) -> np.ndarray:
    if min_area <= 1:
        return mask01
    n, labels, stats = connected_components(mask01)
    if n == 0:
        return mask01
    keep = np.zeros_like(mask01, dtype=np.uint8)
    for cid, st in enumerate(stats, start=1):
        x, y, w, h, area = st
        if area >= min_area:
            keep[labels == cid] = 1
    return keep


# -----------------------------
# Crop Curriculum (Mixture-of-Crops + phase schedule)
# -----------------------------
class CropCurriculum:
    """
    Phase schedule tied to total_epochs:
      - Phase 1: fixed-size training (shape acquisition)        -> p_pos high
      - Phase 2: multi-scale training (robustification)         -> p_neg and ctx increase
      - Phase 3: distribution return (match inference setting)  -> ctx high, scale range narrow or fixed

    This component only decides crop type + crop size + (optionally) hard-neg selection hook.
    """

    def __init__(self, total_epochs: int,
                 phase1_frac: float = 0.25,
                 phase2_frac: float = 0.55):
        self.total_epochs = max(1, int(total_epochs))
        self.phase1_frac = float(phase1_frac)
        self.phase2_frac = float(phase2_frac)

    def _phase(self, epoch: int) -> int:
        # epoch: 0-index
        t = epoch / max(1, self.total_epochs - 1)
        if t < self.phase1_frac:
            return 1
        if t < self.phase1_frac + self.phase2_frac:
            return 2
        return 3

    def policy(self, epoch: int) -> Dict:
        ph = self._phase(epoch)
        if ph == 1:
            return dict(p_pos=0.60, p_neg=0.25, crop_sizes=(256, 384, 512),
                        jitter=0.20, max_ship_frac=5e-4, tag=f"PH1")
        if ph == 2:
            return dict(p_pos=0.45, p_neg=0.30, crop_sizes=(384, 512, 768),
                        jitter=0.20, max_ship_frac=5e-4, tag=f"PH2")
        return dict(p_pos=0.30, p_neg=0.30, crop_sizes=(512, 768),
                    jitter=0.15, max_ship_frac=5e-4, tag=f"PH3")


def crop_random(img: Image.Image, mask_u8: np.ndarray, s: int) -> Tuple[Image.Image, np.ndarray]:
    W, H = img.size
    if W < s or H < s:
        img2 = img.resize((s, s), Image.BILINEAR)
        m2 = Image.fromarray(mask_u8).resize((s, s), Image.NEAREST)
        return img2, np.array(m2, dtype=np.uint8)
    if W == s and H == s:
        return img, mask_u8
    x0 = random.randint(0, W - s)
    y0 = random.randint(0, H - s)
    img_c = img.crop((x0, y0, x0 + s, y0 + s))
    m_c = Image.fromarray(mask_u8).crop((x0, y0, x0 + s, y0 + s))
    return img_c, np.array(m_c, dtype=np.uint8)


def crop_ship_centered(img: Image.Image, mask_u8: np.ndarray, s: int, jitter: float) -> Optional[Tuple[Image.Image, np.ndarray]]:
    bb = mask_to_bbox(mask_u8)
    if bb is None:
        return None
    x0, y0, x1, y1 = bb
    cx = 0.5 * (x0 + x1)
    cy = 0.5 * (y0 + y1)
    W, H = img.size
    jx = (random.random() * 2 - 1) * (s * jitter)
    jy = (random.random() * 2 - 1) * (s * jitter)
    cx2, cy2 = cx + jx, cy + jy
    x0c = int(round(cx2 - s / 2))
    y0c = int(round(cy2 - s / 2))
    x0c = clip_int(x0c, 0, W - s)
    y0c = clip_int(y0c, 0, H - s)
    img_c = img.crop((x0c, y0c, x0c + s, y0c + s))
    m_c = Image.fromarray(mask_u8).crop((x0c, y0c, x0c + s, y0c + s))
    m_u = np.array(m_c, dtype=np.uint8)
    # final guard
    if m_u.max() == 0:
        return None
    return img_c, m_u


def crop_shipfree(img: Image.Image, mask_u8: np.ndarray, s: int, max_ship_frac: float, tries: int = 25) -> Tuple[Image.Image, np.ndarray]:
    for _ in range(tries):
        img_c, m_u = crop_random(img, mask_u8, s)
        if float(m_u.mean()) <= float(max_ship_frac):
            return img_c, m_u
    return crop_random(img, mask_u8, s)


# -----------------------------
# Multi-scale jitter
# -----------------------------
def multiscale_resize(img: Image.Image, mask_u8: np.ndarray, base_size: int, scale: float) -> Tuple[Image.Image, np.ndarray]:
    """
    Resize (base_size, base_size) then apply scale about it (still square).
    """
    s = int(round(base_size * scale))
    s = max(64, min(1024, s))  # guard
    img2 = img.resize((s, s), Image.BILINEAR)
    m2 = Image.fromarray(mask_u8).resize((s, s), Image.NEAREST)
    return img2, np.array(m2, dtype=np.uint8)


