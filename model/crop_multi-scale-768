def sha1_first_1mb(path: str) -> str:
    h = hashlib.sha1()
    with open(path, "rb") as f:
        h.update(f.read(1024 * 1024))
    return h.hexdigest()


def read_csv_rows(path: str) -> List[Dict[str, str]]:
    rows: List[Dict[str, str]] = []
    with open(path, "r", newline="") as f:
        reader = csv.DictReader(f)
        for r in reader:
            rows.append(r)
    return rows


def rle_decode(rle: str, shape_hw: Tuple[int, int]) -> np.ndarray:
    """
    Airbus RLE: runs are 1-indexed, column-major order.
    shape_hw: (H,W)
    """
    if rle is None or rle == "" or (isinstance(rle, float) and math.isnan(rle)):
        return np.zeros(shape_hw, dtype=np.uint8)
    s = rle.strip().split()
    if len(s) < 2:
        return np.zeros(shape_hw, dtype=np.uint8)
    starts = np.asarray(s[0::2], dtype=np.int64) - 1
    lengths = np.asarray(s[1::2], dtype=np.int64)
    ends = starts + lengths

    H, W = shape_hw
    img = np.zeros(H * W, dtype=np.uint8)
    for lo, hi in zip(starts, ends):
        if lo < 0:
            lo = 0
        if hi > img.size:
            hi = img.size
        img[lo:hi] = 1
    # column-major -> reshape (W,H) then transpose to (H,W)
    return img.reshape((W, H)).T


def mask_to_bbox(mask_u8: np.ndarray) -> Optional[Tuple[int, int, int, int]]:
    ys, xs = np.where(mask_u8 > 0)
    if xs.size == 0:
        return None
    x0, x1 = int(xs.min()), int(xs.max())
    y0, y1 = int(ys.min()), int(ys.max())
    return x0, y0, x1, y1


def clip_int(v: int, lo: int, hi: int) -> int:
    if v < lo:
        return lo
    if v > hi:
        return hi
    return v


