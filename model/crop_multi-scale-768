    device = torch.device(args.device if torch.cuda.is_available() and args.device.startswith("cuda") else "cpu")

    # model
    model = UNet(in_ch=3, base_ch=32).to(device)
    optimizer = torch.optim.AdamW(model.parameters(), lr=args.lr, weight_decay=args.wd)

    # datasets
    curriculum = CropCurriculum(total_epochs=args.epochs, phase1_frac=args.phase1_frac, phase2_frac=args.phase2_frac)
    ds_train = AirbusSegDataset(
        img_dir=train_img_dir, id2rles=id2rles, image_ids=train_ids,
        train=True, base_size=args.base_size, curriculum=curriculum, total_epochs=args.epochs,
        normalize=True, corrupt_ok=True
    )
    # val is fixed-context (no crop curriculum)
    ds_val = AirbusSegDataset(
        img_dir=train_img_dir, id2rles=id2rles, image_ids=val_ids,
        train=False, base_size=args.base_size, curriculum=None, total_epochs=args.epochs,
        normalize=True, corrupt_ok=True
    )

    dl_train = DataLoader(ds_train, batch_size=args.bs, shuffle=True, num_workers=args.num_workers,
                          pin_memory=True, drop_last=True, collate_fn=collate_skip_corrupt)
    dl_val = DataLoader(ds_val, batch_size=1, shuffle=False, num_workers=max(1, args.num_workers // 2),
                        pin_memory=True, drop_last=False, collate_fn=collate_skip_corrupt)

    best_f2 = -1.0
    best_thr = 0.05
    best_epoch = -1
    best_path = os.path.join(args.run_dir, "best_model.pt")
    last_path = os.path.join(args.run_dir, "last_model.pt")
    meta_path = os.path.join(args.run_dir, "meta.json")

    thr_list = np.linspace(args.thr_min, args.thr_max, args.thr_num).tolist()

    if args.mode in ["train", "all"]:
        for epoch in range(args.epochs):
            ds_train.set_epoch(epoch)
            ds_train.reset_counters()

            # decide phase / multiscale policy
            pol = curriculum.policy(epoch)
            tag = pol["tag"]
            # Phase2: wide multiscale; Phase3: narrow (or you can disable by setting ms_min_phase3=ms_max_phase3=1.0)
            # Phase1: multiscale off
            # Determine phase id via tag
            if tag == "PH1":
                do_ms = False
                ms_min, ms_max = 1.0, 1.0
                tv_w = float(args.loss_tv_w_phase1)
            elif tag == "PH2":
                do_ms = True
                ms_min, ms_max = float(args.ms_min), float(args.ms_max)
                tv_w = float(args.loss_tv_w_phase2)
            else:
                # PH3
                do_ms = True if (abs(args.ms_max_phase3 - 1.0) > 1e-6 or abs(args.ms_min_phase3 - 1.0) > 1e-6) else False
                ms_min, ms_max = float(args.ms_min_phase3), float(args.ms_max_phase3)
                tv_w = float(args.loss_tv_w_phase3)

            log(f"{now_str()} ---- epoch {epoch+1}/{args.epochs} phase={tag} do_ms={do_ms} ms=({ms_min:.3f},{ms_max:.3f}) tv_w={tv_w:.3f}")

            tr = run_epoch_train(
                model=model, loader=dl_train, device=device, optimizer=optimizer,
                epoch=epoch, total_epochs=args.epochs,
                base_size=args.base_size, do_multiscale=do_ms, ms_min=ms_min, ms_max=ms_max,
                loss_bce_w=float(args.loss_bce_w),
                loss_tversky_w=tv_w,
                tv_alpha=float(args.tv_alpha), tv_beta=float(args.tv_beta),
                log_every=50
            )

            ctr = ds_train.get_counters()
            log(f"{now_str()} [train] epoch={epoch+1} loss={tr['loss']:.6f} sec={tr['sec']:.1f} "
                f"crop_tags={ctr['tag_counts']} crop_sizes={ctr['size_counts']}")

            # val threshold tune (full pipeline)
            val_best = evaluate_on_val(
                model=model, loader=dl_val, device=device, base_size=args.base_size,
                thr_list=thr_list, morph_k=int(args.morph_k), min_area=int(args.min_area),
                do_open=bool(args.do_open), do_close=bool(args.do_close)
            )
            log(f"{now_str()} [val] best_thr={val_best['thr']:.4f} f2={val_best['f2']:.6f} "
                f"f1={val_best['f1']:.6f} iou={val_best['iou']:.6f} "
                f"prec={val_best['precision']:.6f} rec={val_best['recall']:.6f} fp_cc_avg={val_best['fp_cc_avg']:.2f}")

            # save last
            torch.save(model.state_dict(), last_path)

            # update best
            if val_best["f2"] > best_f2:
                best_f2 = float(val_best["f2"])
                best_thr = float(val_best["thr"])
                best_epoch = epoch + 1
                torch.save(model.state_dict(), best_path)

            meta = {
                "best_f2": best_f2,
                "best_thr": best_thr,
                "best_epoch": best_epoch,
                "last_epoch": epoch + 1,
                "base_size": int(args.base_size),
                "morph_k": int(args.morph_k),
                "min_area": int(args.min_area),
                "do_open": int(args.do_open),
                "do_close": int(args.do_close),
                "tv_alpha": float(args.tv_alpha),
                "tv_beta": float(args.tv_beta),
                "loss_bce_w": float(args.loss_bce_w),
                "loss_tv_w_phase1": float(args.loss_tv_w_phase1),
                "loss_tv_w_phase2": float(args.loss_tv_w_phase2),
                "loss_tv_w_phase3": float(args.loss_tv_w_phase3),
                "ms_min": float(args.ms_min),
                "ms_max": float(args.ms_max),
                "ms_min_phase3": float(args.ms_min_phase3),
                "ms_max_phase3": float(args.ms_max_phase3),
            }
            with open(meta_path, "w") as f:
                json.dump(meta, f, indent=2)

        log(f"{now_str()} ==== TRAIN DONE ====")
        log(f"{now_str()} best_epoch={best_epoch} best_f2={best_f2:.6f} best_thr={best_thr:.6f}")
        log(f"{now_str()} best_path={best_path}")
        log(f"{now_str()} last_path={last_path}")

    # inference
    if args.mode in ["infer", "all"] and int(args.infer_test) == 1:
        # load best
        if os.path.exists(best_path):
            model.load_state_dict(torch.load(best_path, map_location=device))
            log(f"{now_str()} loaded best model: {best_path}")
        else:
            log(f"{now_str()} WARNING: best_model not found, using current weights")

        # read meta thr if exists
        if os.path.exists(meta_path):
            with open(meta_path, "r") as f:
                meta = json.load(f)
            thr = float(meta.get("best_thr", best_thr))
        else:
            thr = best_thr

        vis_dir = os.path.join(args.run_dir, "inference", "vis_testv2") if int(args.vis) == 1 else None
        out_csv = os.path.join(args.run_dir, "submission.csv")

        infer_test_and_make_submission(
            model=model, device=device,
            test_dir=test_img_dir,
            out_csv=out_csv,
            base_size=int(args.base_size),
            thr=float(thr),
            morph_k=int(args.morph_k),
            min_area=int(args.min_area),
            do_open=bool(args.do_open),
            do_close=bool(args.do_close),
            tta=bool(args.tta),
            vis_dir=vis_dir,
            gradcam=bool(args.gradcam)
        )
        log(f"{now_str()} ==== INFER DONE ====")

    log(f"{now_str()} ==== END ====")


if __name__ == "__main__":
    main()
