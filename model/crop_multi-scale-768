def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--mode", type=str, default="all", choices=["train", "infer", "all"])
    ap.add_argument("--data_dir", type=str, required=True,
                    help="Dataset root. Must contain train_v2, test_v2, train_ship_segmentations_v2.csv, sample_submission_v2.csv")
    ap.add_argument("--run_dir", type=str, required=True)
    ap.add_argument("--seed", type=int, default=42)
    ap.add_argument("--device", type=str, default="cuda")

    # split sizes
    ap.add_argument("--train_total", type=int, default=50000)
    ap.add_argument("--val_total", type=int, default=30000)
    ap.add_argument("--val_pos_rate", type=float, default=0.221)

    # training sizes / phases
    ap.add_argument("--base_size", type=int, default=768)
    ap.add_argument("--epochs", type=int, default=40)
    ap.add_argument("--phase1_frac", type=float, default=0.25)
    ap.add_argument("--phase2_frac", type=float, default=0.55)

    # multi-scale settings (Phase2 default)
    ap.add_argument("--ms_min", type=float, default=0.67)
    ap.add_argument("--ms_max", type=float, default=1.33)
    ap.add_argument("--ms_min_phase3", type=float, default=0.90)
    ap.add_argument("--ms_max_phase3", type=float, default=1.10)

    # optimizer
    ap.add_argument("--lr", type=float, default=2e-4)
    ap.add_argument("--wd", type=float, default=1e-4)
    ap.add_argument("--bs", type=int, default=4)
    ap.add_argument("--num_workers", type=int, default=4)

    # loss weights
    ap.add_argument("--loss_bce_w", type=float, default=1.0)
    ap.add_argument("--loss_tv_w_phase1", type=float, default=0.0)
    ap.add_argument("--loss_tv_w_phase2", type=float, default=0.3)
    ap.add_argument("--loss_tv_w_phase3", type=float, default=0.3)
    ap.add_argument("--tv_alpha", type=float, default=0.6)
    ap.add_argument("--tv_beta", type=float, default=0.4)

    # val tune
    ap.add_argument("--thr_min", type=float, default=0.02)
    ap.add_argument("--thr_max", type=float, default=0.20)
    ap.add_argument("--thr_num", type=int, default=25)
    ap.add_argument("--morph_k", type=int, default=3)
    ap.add_argument("--min_area", type=int, default=50)
    ap.add_argument("--do_open", type=int, default=1)
    ap.add_argument("--do_close", type=int, default=1)

    # infer
    ap.add_argument("--infer_test", type=int, default=1)
    ap.add_argument("--tta", type=int, default=1)
    ap.add_argument("--vis", type=int, default=1)
    ap.add_argument("--gradcam", type=int, default=1)
    ap.add_argument("--vis_cap", type=int, default=200)

    args = ap.parse_args()

    set_seed(args.seed)
    ensure_dir(args.run_dir)
    log_path = os.path.join(args.run_dir, "log_global.txt")

    def log(s: str):
        print(s)
        with open(log_path, "a") as f:
            f.write(s + "\n")

    log(f"{now_str()} ==== START: Airbus UNet + Crop Curriculum (HADES) ====")
    log(f"{now_str()} run_dir={args.run_dir}")
    log(f"{now_str()} data_dir={args.data_dir}")
    log(f"{now_str()} seed={args.seed}")
    log(f"{now_str()} base_size={args.base_size} epochs={args.epochs}")
    log(f"{now_str()} backends: cv2={_HAS_CV2} scipy={_HAS_SCIPY}")

    data_dir = args.data_dir
    train_img_dir = os.path.join(data_dir, "train_v2")
    test_img_dir = os.path.join(data_dir, "test_v2")
    train_csv = os.path.join(data_dir, "train_ship_segmentations_v2.csv")
    sample_sub = os.path.join(data_dir, "sample_submission_v2.csv")

    for p in [train_img_dir, test_img_dir, train_csv, sample_sub]:
        if not os.path.exists(p):
            log(f"{now_str()} ERROR: missing path: {p}")
            sys.exit(1)

    id2rles, all_ids, pos_ids = build_id2rles_and_ids(train_img_dir, train_csv)
    pos_rate = len(pos_ids) / max(1, len(all_ids))
    log(f"{now_str()} ALL images={len(all_ids)} pos={len(pos_ids)} pos_rate={pos_rate:.4f}")

    # split
    train_ids, val_ids = stratified_sample_train_val(
        all_ids=all_ids,
