# Split builder
# -----------------------------
def build_id2rles_and_ids(train_img_dir: str, train_csv: str) -> Tuple[Dict[str, List[str]], List[str], List[str]]:
    """
    Returns:
      id2rles: positives only (ImageId -> [RLE...])
      all_ids: ALL images from directory (pos+neg)
      pos_ids: IDs with at least one RLE
    """
    all_ids = sorted([p.name for p in Path(train_img_dir).glob("*.jpg")])
    rows = read_csv_rows(train_csv)
    id2rles: Dict[str, List[str]] = {}
    for r in rows:
        image_id = r["ImageId"]
        rle = r["EncodedPixels"]
        if rle is None:
            continue
        if image_id not in id2rles:
            id2rles[image_id] = []
        if rle != "":
            id2rles[image_id].append(rle)

    pos_set = set(id2rles.keys())
    pos_ids = [x for x in all_ids if x in pos_set]
    return id2rles, all_ids, pos_ids


def stratified_sample_train_val(all_ids: List[str],
                                pos_ids: List[str],
                                train_total: int,
                                val_total: int,
                                val_pos_rate: float,
                                seed: int) -> Tuple[List[str], List[str]]:
    """
    Build train and val splits without overlap.
    - Train: sample train_total images (stratified by pos/neg, using observed pos rate in all_ids).
    - Val: sample val_total images from remaining, with desired val_pos_rate (if <=0, use natural rate).
    """
    rng = random.Random(seed)
    all_set = set(all_ids)
    pos_set = set(pos_ids)
    neg_ids = [x for x in all_ids if x not in pos_set]
    rng.shuffle(pos_ids)
    rng.shuffle(neg_ids)

    # Train: keep natural pos rate from ALL unless user wants to cap by providing train_total and pos exposure later in sampler.
    n_train = min(train_total, len(all_ids))
    n_pos_train = int(round(n_train * (len(pos_ids) / max(1, len(all_ids)))))
    n_pos_train = min(n_pos_train, len(pos_ids))
    n_neg_train = n_train - n_pos_train
    n_neg_train = min(n_neg_train, len(neg_ids))

    train_ids = pos_ids[:n_pos_train] + neg_ids[:n_neg_train]
    rng.shuffle(train_ids)

    remaining = [x for x in all_ids if x not in set(train_ids)]
    rem_pos = [x for x in remaining if x in pos_set]
    rem_neg = [x for x in remaining if x not in pos_set]
    rng.shuffle(rem_pos)
    rng.shuffle(rem_neg)

    n_val = min(val_total, len(remaining))
    if val_pos_rate is None or val_pos_rate <= 0:
        n_pos_val = int(round(n_val * (len(rem_pos) / max(1, len(remaining)))))
    else:
        n_pos_val = int(round(n_val * float(val_pos_rate)))
    n_pos_val = min(n_pos_val, len(rem_pos))
    n_neg_val = n_val - n_pos_val
    n_neg_val = min(n_neg_val, len(rem_neg))

    val_ids = rem_pos[:n_pos_val] + rem_neg[:n_neg_val]
    rng.shuffle(val_ids)

    return train_ids, val_ids


