@torch.no_grad()
def to_uint8_img(arr01: np.ndarray) -> Image.Image:
    arr = np.clip(arr01 * 255.0, 0, 255).astype(np.uint8)
    return Image.fromarray(arr)


def gradcam_for_unet(model: UNet, x: torch.Tensor, device: torch.device, target_mask01: Optional[torch.Tensor] = None) -> np.ndarray:
    """
    Compute Grad-CAM heatmap from model.dec1 feature map.
    target: mean logit over (target_mask==1) if provided, else over predicted positive pixels.
    Returns: heatmap in [0,1], shape (H,W)
    """
    model.eval()
    for p in model.parameters():
        p.requires_grad_(True)

    x = x.to(device)
    logits = model(x)  # (1,1,H,W)
    feat = model._cam_feat  # (1,C,h,w) at same res as logits (after dec1) typically
    if feat is None:
        return np.zeros((x.shape[-2], x.shape[-1]), dtype=np.float32)
    feat.retain_grad()

    with torch.no_grad():
        prob = torch.sigmoid(logits)
        if target_mask01 is None:
            tmask = (prob >= 0.5).float()
        else:
            tmask = target_mask01.float().to(device)
        # avoid empty target
        if tmask.sum() < 1:
            tmask = torch.ones_like(tmask)

    # scalar target: mean logit on target region
    target = (logits * tmask).sum() / (tmask.sum() + 1e-6)

    model.zero_grad(set_to_none=True)
    target.backward(retain_graph=False)

    grad = feat.grad  # (1,C,H,W)
    w = grad.mean(dim=(2, 3), keepdim=True)  # (1,C,1,1)
    cam = (w * feat).sum(dim=1, keepdim=False)  # (1,H,W)
    cam = F.relu(cam)
    cam = cam[0]
    cam = cam - cam.min()
    cam = cam / (cam.max() + 1e-9)
    return cam.detach().cpu().numpy().astype(np.float32)


def overlay_heatmap_on_rgb(rgb_u8: np.ndarray, heat01: np.ndarray, alpha: float = 0.45) -> np.ndarray:
    """
    rgb_u8: HxWx3
    heat01: HxW in [0,1]
    Creates a red-ish overlay without external colormap deps.
    """
    h = np.clip(heat01, 0, 1)
    overlay = rgb_u8.astype(np.float32).copy()
    red = np.zeros_like(overlay)
    red[..., 0] = 255.0
    overlay = (1 - alpha) * overlay + alpha * (h[..., None] * red + (1 - h[..., None]) * overlay)
    return np.clip(overlay, 0, 255).astype(np.uint8)


def overlay_mask(rgb_u8: np.ndarray, mask01: np.ndarray, alpha: float = 0.35) -> np.ndarray:
    overlay = rgb_u8.astype(np.float32).copy()
    color = np.zeros_like(overlay)
    color[..., 1] = 255.0  # green
    m = (mask01 > 0).astype(np.float32)
    overlay = (1 - alpha * m[..., None]) * overlay + (alpha * m[..., None]) * color
    return np.clip(overlay, 0, 255).astype(np.uint8)


# -----------------------------
# Train / Eval / Infer
# -----------------------------
def run_epoch_train(model: nn.Module,
                    loader: DataLoader,
                    device: torch.device,
                    optimizer: torch.optim.Optimizer,
                    epoch: int,
                    total_epochs: int,
                    base_size: int,
                    do_multiscale: bool,
                    ms_min: float,
                    ms_max: float,
                    loss_bce_w: float,
                    loss_tversky_w: float,
                    tv_alpha: float,
                    tv_beta: float,
                    log_every: int = 50) -> Dict[str, float]:

    model.train()
    t0 = time.time()
    losses = []

    # decide multi-scale policy
    # Phase2: do_multiscale True; Phase3: you may still do narrow scale or fixed; controlled by caller.
    for it, batch in enumerate(loader):
        x = batch["x"]  # (B,3,H,W) H varies by crop_size
        y = batch["y"]  # (B,1,H,W)

        # optional multi-scale: resize batch to scaled size then random-crop/pad to base_size if needed
        # Here: we will resize each sample to a new square size (s = base_size*scale), then center-crop/pad to base_size.
        if do_multiscale:
            scale = random.uniform(ms_min, ms_max)
            s = int(round(base_size * scale))
            s = max(128, min(1024, s))
            # resize each sample to s then random crop to base_size
            xs = []
            ys = []
            for i in range(x.size(0)):
                xi = x[i:i+1]  # 1,3,h,w
                yi = y[i:i+1]
                xi2 = F.interpolate(xi, size=(s, s), mode="bilinear", align_corners=False)
                yi2 = F.interpolate(yi, size=(s, s), mode="nearest")
                if s > base_size:
                    x0 = random.randint(0, s - base_size)
                    y0 = random.randint(0, s - base_size)
                    xi3 = xi2[:, :, y0:y0+base_size, x0:x0+base_size]
                    yi3 = yi2[:, :, y0:y0+base_size, x0:x0+base_size]
                elif s < base_size:
                    pad = base_size - s
                    p0 = random.randint(0, pad)
                    p1 = pad - p0
                    # pad (left,right,top,bottom)
                    xi3 = F.pad(xi2, (p0, p1, p0, p1), mode="constant", value=0.0)
                    yi3 = F.pad(yi2, (p0, p1, p0, p1), mode="constant", value=0.0)
                else:
                    xi3, yi3 = xi2, yi2
                xs.append(xi3)
                ys.append(yi3)
            x = torch.cat(xs, dim=0)
            y = torch.cat(ys, dim=0)

        x = x.to(device, non_blocking=True)
        y = y.to(device, non_blocking=True)

        optimizer.zero_grad(set_to_none=True)
        logits = model(x)

        lb = bce_logits_loss(logits, y)
        lt = torch.tensor(0.0, device=device)
        if loss_tversky_w > 0:
            lt = tversky_loss_from_logits(logits, y, alpha=tv_alpha, beta=tv_beta)

        loss = loss_bce_w * lb + loss_tversky_w * lt
        loss.backward()
        optimizer.step()

        losses.append(float(loss.detach().cpu().item()))
        if (it + 1) % log_every == 0:
            print(f"{now_str()} [train] epoch={epoch+1}/{total_epochs} iter={it+1}/{len(loader)} "
                  f"loss={np.mean(losses[-log_every:]):.6f} "
                  f"(bce={float(lb.detach().cpu()):.6f}, tv={float(lt.detach().cpu()):.6f})")

    dt = time.time() - t0
    return {"loss": float(np.mean(losses)) if losses else 0.0, "sec": float(dt)}


@torch.no_grad()
def predict_prob_map(model: nn.Module, x: torch.Tensor, device: torch.device) -> np.ndarray:
    model.eval()
    x = x.to(device)
    logits = model(x)
    prob = torch.sigmoid(logits)[0, 0].detach().cpu().numpy().astype(np.float32)
    return prob


@torch.no_grad()
def evaluate_on_val(model: nn.Module,
                    loader: DataLoader,
                    device: torch.device,
                    base_size: int,
                    thr_list: List[float],
                    morph_k: int,
                    min_area: int,
                    do_open: bool,
                    do_close: bool) -> Dict:
    """
    Evaluate thresholds by running full inference (fixed base_size) + postprocess.
    Returns best threshold by F2 (pixel-level) and summary metrics at best_thr.
    """
    model.eval()
    # collect probs and gts per image (base_size)
    probs: List[np.ndarray] = []
    gts: List[np.ndarray] = []
    image_ids: List[str] = []

    for batch in loader:
        x = batch["x"]  # may be base_size if val dataset fixed
        y = batch["y"]
        # force to base_size
        if x.shape[-1] != base_size or x.shape[-2] != base_size:
            x = F.interpolate(x, size=(base_size, base_size), mode="bilinear", align_corners=False)
            y = F.interpolate(y, size=(base_size, base_size), mode="nearest")
        for i in range(x.size(0)):
            xi = x[i:i+1]
            yi = y[i, 0].detach().cpu().numpy().astype(np.uint8)
            prob = predict_prob_map(model, xi, device)
            probs.append(prob)
            gts.append(yi)
        image_ids.extend(batch["image_ids"])

    # scan thresholds
    best = None
    for thr in thr_list:
        agg = {"tp": 0.0, "fp": 0.0, "fn": 0.0, "tn": 0.0}
        fp_cc_total = 0.0
        for prob, gt in zip(probs, gts):
            pred = binarize_prob(prob, thr)
            if morph_k > 1:
                pred = binary_open_close(pred, k=morph_k, do_open=do_open, do_close=do_close)
            if min_area > 1:
                pred = filter_min_area(pred, min_area=min_area)

            pm = pixel_metrics(pred, gt)
            agg["tp"] += pm["tp"]; agg["fp"] += pm["fp"]; agg["fn"] += pm["fn"]; agg["tn"] += pm["tn"]

            # FP connected components count (proxy of background-texture noise)
            fp_mask = ((pred == 1) & (gt == 0)).astype(np.uint8)
            ncc, _lbl, _st = connected_components(fp_mask)
            fp_cc_total += float(ncc)

        prec = agg["tp"] / (agg["tp"] + agg["fp"] + 1e-9)
        rec = agg["tp"] / (agg["tp"] + agg["fn"] + 1e-9)
        f1 = (2 * prec * rec) / (prec + rec + 1e-9)
        iou = agg["tp"] / (agg["tp"] + agg["fp"] + agg["fn"] + 1e-9)
        f2 = fbeta(prec, rec, beta=2.0)

        cand = {
            "thr": float(thr),
            "precision": float(prec),
            "recall": float(rec),
            "f1": float(f1),
            "f2": float(f2),
            "iou": float(iou),
            "tp": float(agg["tp"]),
            "fp": float(agg["fp"]),
            "fn": float(agg["fn"]),
            "fp_cc_avg": float(fp_cc_total / max(1, len(probs))),
        }
        if (best is None) or (cand["f2"] > best["f2"]):
            best = cand

    assert best is not None
    best["n_val"] = int(len(probs))
    best["base_size"] = int(base_size)
    best["morph_k"] = int(morph_k)
    best["min_area"] = int(min_area)
    best["do_open"] = int(do_open)
    best["do_close"] = int(do_close)
    return best


def rle_encode(mask01: np.ndarray) -> str:
    """
    Encode binary mask into Airbus RLE (column-major, 1-indexed starts).
    mask01: HxW uint8 {0,1}
    """
    if mask01.sum() == 0:
        return ""
    # flatten in column-major
    pixels = mask01.T.flatten()
    # add sentinel
    pixels = np.concatenate([[0], pixels, [0]]).astype(np.uint8)
    runs = np.where(pixels[1:] != pixels[:-1])[0] + 1
    runs[1::2] = runs[1::2] - runs[0::2]
    return " ".join(str(x) for x in runs.tolist())


@torch.no_grad()
def infer_test_and_make_submission(model: nn.Module,
                                  device: torch.device,
                                  test_dir: str,
                                  out_csv: str,
                                  base_size: int,
                                  thr: float,
                                  morph_k: int,
                                  min_area: int,
                                  do_open: bool,
                                  do_close: bool,
                                  tta: bool,
                                  vis_dir: Optional[str],
                                  gradcam: bool) -> None:
    """
    Produce submission.csv (variable rows: one row per instance is NOT implemented here; this is union-mask submission).
    For your later pipeline, you can swap this to instance-per-row with splitting.
    """
    ensure_dir(os.path.dirname(out_csv))
    if vis_dir is not None:
        ensure_dir(vis_dir)

    test_ids = sorted([p.name for p in Path(test_dir).glob("*.jpg")])
    rows = [("ImageId", "EncodedPixels")]

    for i, image_id in enumerate(test_ids):
        p = os.path.join(test_dir, image_id)
        try:
            with Image.open(p) as im:
                im = im.convert("RGB")
        except Exception:
            # corrupted -> empty
            rows.append((image_id, ""))
            continue

        im0 = im.resize((base_size, base_size), Image.BILINEAR)
        x = torch.from_numpy(np.array(im0, dtype=np.uint8)).permute(2, 0, 1).float() / 255.0
        # normalize ImageNet
        mean = torch.tensor([0.485, 0.456, 0.406], dtype=torch.float32).view(3, 1, 1)
        std = torch.tensor([0.229, 0.224, 0.225], dtype=torch.float32).view(3, 1, 1)
        x = (x - mean) / std
        x = x.unsqueeze(0)

        def _infer_one(xx: torch.Tensor) -> np.ndarray:
            prob = predict_prob_map(model, xx, device)
            return prob

        prob = _infer_one(x)
        if tta:
            # simple H-flip TTA
            xh = torch.flip(x, dims=[3])
            prob_h = _infer_one(xh)
            prob_h = np.flip(prob_h, axis=1)  # flip back W axis
            prob = 0.5 * (prob + prob_h)

        pred = binarize_prob(prob, thr)
        if morph_k > 1:
            pred = binary_open_close(pred, k=morph_k, do_open=do_open, do_close=do_close)
        if min_area > 1:
            pred = filter_min_area(pred, min_area=min_area)

        # encode (base_size mask). Kaggle expects original 768? Actually the data is 768.
        # If base_size != 768, resize back to 768 for RLE.
        if base_size != 768:
            pred768 = Image.fromarray((pred * 255).astype(np.uint8)).resize((768, 768), Image.NEAREST)
            pred = (np.array(pred768, dtype=np.uint8) > 0).astype(np.uint8)

        rle = rle_encode(pred)
        rows.append((image_id, rle))

        if vis_dir is not None and (i < 200):  # cap
            rgb = np.array(im0, dtype=np.uint8)
            ov_mask = overlay_mask(rgb, binarize_prob(prob, thr), alpha=0.35)
            if gradcam:
                # compute grad-cam on base_size input
                cam = gradcam_for_unet(model, x, device=device, target_mask01=None)
                ov_cam = overlay_heatmap_on_rgb(rgb, cam, alpha=0.45)
            else:
                ov_cam = rgb

            # concat horizontally: original | pred overlay | cam overlay
            cat = np.concatenate([rgb, ov_mask, ov_cam], axis=1)
            Image.fromarray(cat).save(os.path.join(vis_dir, f"{image_id}"))

        if (i + 1) % 500 == 0:
            print(f"{now_str()} [infer] {i+1}/{len(test_ids)} done")

    with open(out_csv, "w", newline="") as f:
        w = csv.writer(f)
        w.writerows(rows)
    print(f"{now_str()} wrote submission: {out_csv}")


