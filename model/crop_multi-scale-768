# Dataset
# -----------------------------
class AirbusSegDataset(Dataset):
    def __init__(self,
                 img_dir: str,
                 id2rles: Dict[str, List[str]],
                 image_ids: List[str],
                 train: bool,
                 base_size: int,
                 curriculum: Optional[CropCurriculum],
                 total_epochs: int,
                 normalize: bool = True,
                 corrupt_ok: bool = True):
        self.img_dir = img_dir
        self.id2rles = id2rles
        self.image_ids = image_ids
        self.train = train
        self.base_size = int(base_size)
        self.curriculum = curriculum
        self.total_epochs = int(total_epochs)
        self.normalize = normalize
        self.corrupt_ok = corrupt_ok
        self.epoch = 0

        # ImageNet mean/std (float32)
        self.mean = torch.tensor([0.485, 0.456, 0.406], dtype=torch.float32).view(3, 1, 1)
        self.std = torch.tensor([0.229, 0.224, 0.225], dtype=torch.float32).view(3, 1, 1)

        # stats counters (for logging)
        self._tag_counts = {"POS": 0, "NEG": 0, "CTX": 0}
        self._size_counts: Dict[int, int] = {}

    def set_epoch(self, epoch: int) -> None:
        self.epoch = int(epoch)

    def reset_counters(self) -> None:
        self._tag_counts = {"POS": 0, "NEG": 0, "CTX": 0}
        self._size_counts = {}

    def get_counters(self) -> Dict:
        return {"tag_counts": dict(self._tag_counts), "size_counts": dict(self._size_counts)}

    def __len__(self) -> int:
        return len(self.image_ids)

    def _load_image(self, image_id: str) -> Optional[Image.Image]:
        p = os.path.join(self.img_dir, image_id)
        try:
            with Image.open(p) as im:
                im = im.convert("RGB")
            return im
        except Exception:
            if self.corrupt_ok:
                return None
            raise

    def _build_mask(self, image_id: str, hw: Tuple[int, int]) -> np.ndarray:
        H, W = hw
        rles = self.id2rles.get(image_id, [])
        if not rles:
            return np.zeros((H, W), dtype=np.uint8)
        m = np.zeros((H, W), dtype=np.uint8)
        for rle in rles:
            m |= rle_decode(rle, (H, W))
        return m.astype(np.uint8)

    def _to_tensor(self, img: Image.Image, mask_u8: np.ndarray) -> Tuple[torch.Tensor, torch.Tensor]:
        # to float32 CHW in [0,1]
        x = torch.from_numpy(np.array(img, dtype=np.uint8)).permute(2, 0, 1).float() / 255.0
        y = torch.from_numpy(mask_u8.astype(np.float32)).unsqueeze(0)  # 1,H,W
        if self.normalize:
            x = (x - self.mean) / self.std
        return x, y

    def __getitem__(self, idx: int) -> Dict:
        image_id = self.image_ids[idx]
        img = self._load_image(image_id)
        if img is None:
            # corrupted -> return a harmless sample (all-zero)
            # (Trainer will still work; you can also choose to skip by collate.)
            s = self.base_size
            dummy = Image.fromarray(np.zeros((s, s, 3), dtype=np.uint8))
            mask = np.zeros((s, s), dtype=np.uint8)
            x, y = self._to_tensor(dummy, mask)
            return {"image_id": image_id, "x": x, "y": y, "tag": "CORRUPT", "crop_size": s}

        # base resize (make it square at base_size for consistent crop logic)
        img0 = img.resize((self.base_size, self.base_size), Image.BILINEAR)
        mask0 = self._build_mask(image_id, (self.base_size, self.base_size))  # already base_size

        tag = "CTX"
        crop_size = self.base_size

        if self.train and self.curriculum is not None:
            pol = self.curriculum.policy(self.epoch)
            crop_size = random.choice(pol["crop_sizes"])
            ship_frac = float(mask0.mean())
            u = random.random()

            if ship_frac > 0 and u < pol["p_pos"]:
                out = crop_ship_centered(img0, mask0, crop_size, jitter=float(pol["jitter"]))
                if out is not None:
                    imgc, maskc = out
                    tag = "POS"
                else:
                    imgc, maskc = crop_random(img0, mask0, crop_size)
                    tag = "CTX"
            elif u < pol["p_pos"] + pol["p_neg"]:
                imgc, maskc = crop_shipfree(img0, mask0, crop_size, max_ship_frac=float(pol["max_ship_frac"]))
                tag = "NEG"
            else:
                imgc, maskc = crop_random(img0, mask0, crop_size)
                tag = "CTX"

            # multi-scale jitter is applied later (trainer) only for Phase2 (to keep this dataset simpler)

            self._tag_counts[tag] = self._tag_counts.get(tag, 0) + 1
            self._size_counts[crop_size] = self._size_counts.get(crop_size, 0) + 1
        else:
            imgc, maskc = img0, mask0

        x, y = self._to_tensor(imgc, maskc)
        return {"image_id": image_id, "x": x, "y": y, "tag": tag, "crop_size": int(crop_size)}


def collate_skip_corrupt(batch: List[Dict]) -> Dict:
    good = [b for b in batch if b.get("tag") != "CORRUPT"]
    if len(good) == 0:
        # fallback: keep one corrupt to avoid DataLoader crash
        good = batch[:1]
    x = torch.stack([b["x"] for b in good], dim=0)
    y = torch.stack([b["y"] for b in good], dim=0)
    image_ids = [b["image_id"] for b in good]
    tags = [b.get("tag", "UNK") for b in good]
    crop_sizes = [int(b.get("crop_size", 0)) for b in good]
    return {"image_ids": image_ids, "x": x, "y": y, "tags": tags, "crop_sizes": crop_sizes}


# -----------------------------
# Simple U-Net
# -----------------------------
class ConvBlock(nn.Module):
    def __init__(self, in_ch: int, out_ch: int):
        super().__init__()
        self.net = nn.Sequential(
            nn.Conv2d(in_ch, out_ch, 3, padding=1, bias=False),
            nn.BatchNorm2d(out_ch),
            nn.ReLU(inplace=True),
            nn.Conv2d(out_ch, out_ch, 3, padding=1, bias=False),
            nn.BatchNorm2d(out_ch),
            nn.ReLU(inplace=True),
        )

    def forward(self, x):
        return self.net(x)


class UNet(nn.Module):
    def __init__(self, in_ch: int = 3, base_ch: int = 32):
        super().__init__()
        self.enc1 = ConvBlock(in_ch, base_ch)
        self.pool1 = nn.MaxPool2d(2)
        self.enc2 = ConvBlock(base_ch, base_ch * 2)
        self.pool2 = nn.MaxPool2d(2)
        self.enc3 = ConvBlock(base_ch * 2, base_ch * 4)
        self.pool3 = nn.MaxPool2d(2)
        self.enc4 = ConvBlock(base_ch * 4, base_ch * 8)
        self.pool4 = nn.MaxPool2d(2)

        self.bottleneck = ConvBlock(base_ch * 8, base_ch * 16)

        self.up4 = nn.ConvTranspose2d(base_ch * 16, base_ch * 8, 2, stride=2)
        self.dec4 = ConvBlock(base_ch * 16, base_ch * 8)
        self.up3 = nn.ConvTranspose2d(base_ch * 8, base_ch * 4, 2, stride=2)
        self.dec3 = ConvBlock(base_ch * 8, base_ch * 4)
        self.up2 = nn.ConvTranspose2d(base_ch * 4, base_ch * 2, 2, stride=2)
        self.dec2 = ConvBlock(base_ch * 4, base_ch * 2)
        self.up1 = nn.ConvTranspose2d(base_ch * 2, base_ch, 2, stride=2)
        self.dec1 = ConvBlock(base_ch * 2, base_ch)

        self.out = nn.Conv2d(base_ch, 1, 1)

        # for Grad-CAM (use last decoder conv features)
        self._cam_feat = None
        self.dec1.register_forward_hook(self._hook_feat)

    def _hook_feat(self, module, inp, out):
        self._cam_feat = out

    def forward(self, x):
        e1 = self.enc1(x)
        e2 = self.enc2(self.pool1(e1))
        e3 = self.enc3(self.pool2(e2))
        e4 = self.enc4(self.pool3(e3))
        b = self.bottleneck(self.pool4(e4))

        d4 = self.up4(b)
        d4 = torch.cat([d4, e4], dim=1)
        d4 = self.dec4(d4)

        d3 = self.up3(d4)
        d3 = torch.cat([d3, e3], dim=1)
        d3 = self.dec3(d3)

        d2 = self.up2(d3)
        d2 = torch.cat([d2, e2], dim=1)
        d2 = self.dec2(d2)

        d1 = self.up1(d2)
        d1 = torch.cat([d1, e1], dim=1)
        d1 = self.dec1(d1)

        logits = self.out(d1)
        return logits


# -----------------------------
# Losses
# -----------------------------
def bce_logits_loss(logits: torch.Tensor, targets: torch.Tensor) -> torch.Tensor:
    # logits: (B,1,H,W), targets: (B,1,H,W) float 0/1
    return F.binary_cross_entropy_with_logits(logits, targets)


def tversky_loss_from_logits(logits: torch.Tensor, targets: torch.Tensor, alpha: float, beta: float, eps: float = 1e-6) -> torch.Tensor:
    prob = torch.sigmoid(logits)
    # flatten
    p = prob.view(prob.size(0), -1)
    t = targets.view(targets.size(0), -1)
    tp = (p * t).sum(dim=1)
    fp = (p * (1 - t)).sum(dim=1)
    fn = ((1 - p) * t).sum(dim=1)
    ti = (tp + eps) / (tp + alpha * fp + beta * fn + eps)
    return (1 - ti).mean()


def dice_from_logits(logits: torch.Tensor, targets: torch.Tensor, eps: float = 1e-6) -> torch.Tensor:
    prob = torch.sigmoid(logits)
    p = prob.view(prob.size(0), -1)
    t = targets.view(targets.size(0), -1)
    inter = (p * t).sum(dim=1)
    denom = p.sum(dim=1) + t.sum(dim=1)
    dice = (2 * inter + eps) / (denom + eps)
    return dice.mean()


# -----------------------------
# Metrics
# -----------------------------
def binarize_prob(prob: np.ndarray, thr: float) -> np.ndarray:
    return (prob >= thr).astype(np.uint8)


def pixel_metrics(pred01: np.ndarray, gt01: np.ndarray) -> Dict[str, float]:
    pred = pred01.astype(np.uint8)
    gt = gt01.astype(np.uint8)
    tp = int(((pred == 1) & (gt == 1)).sum())
    fp = int(((pred == 1) & (gt == 0)).sum())
    fn = int(((pred == 0) & (gt == 1)).sum())
    tn = int(((pred == 0) & (gt == 0)).sum())

    prec = tp / (tp + fp + 1e-9)
    rec = tp / (tp + fn + 1e-9)
    f1 = (2 * prec * rec) / (prec + rec + 1e-9)
    iou = tp / (tp + fp + fn + 1e-9)
    return {
        "tp": float(tp), "fp": float(fp), "fn": float(fn), "tn": float(tn),
        "precision": float(prec), "recall": float(rec), "f1": float(f1), "iou": float(iou),
        "pred_pos": float(pred.sum()), "gt_pos": float(gt.sum())
    }


def fbeta(prec: float, rec: float, beta: float) -> float:
    b2 = beta * beta
    return (1 + b2) * prec * rec / (b2 * prec + rec + 1e-9)


