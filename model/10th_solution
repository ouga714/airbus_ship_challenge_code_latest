class AirbusUNetDataset(Dataset):
    """
    UNet semantic training: union mask (ship pixels) at base_size -> resized to 384
    """
    def __init__(
        self,
        img_dir: str,
        ids: List[str],
        id2rles: Dict[str, List[str]],
        base_size: int = 768,
        unet_size: int = 384,
        augment: bool = True,
    ):
        self.img_dir = img_dir
        self.ids = ids
        self.id2rles = id2rles
        self.base_size = base_size
        self.unet_size = unet_size
        self.augment = augment

    def __len__(self) -> int:
        return len(self.ids)

    def __getitem__(self, idx: int):
        img_id = self.ids[idx]
        path = os.path.join(self.img_dir, img_id)
        try:
            im = safe_open_image_rgb(path)
        except Exception:
            # fallback: return blank
            im = Image.new("RGB", (self.base_size, self.base_size), (0, 0, 0))

        img = TF.to_tensor(im)  # [0,1], (3,H,W)
        H, W = img.shape[1], img.shape[2]
        # union mask
        mask = np.zeros((H, W), dtype=np.uint8)
        rles = self.id2rles.get(img_id, [])
        for rle in rles:
            m = rle_decode(rle, (H, W))
            mask = np.maximum(mask, m)
        mask_t = torch.from_numpy(mask).unsqueeze(0).float()  # (1,H,W)

        # light aug: flips + color (consistent with mask)
        if self.augment:
            if random.random() < 0.5:
                img = torch.flip(img, dims=[2])
                mask_t = torch.flip(mask_t, dims=[2])
            if random.random() < 0.5:
                img = torch.flip(img, dims=[1])
                mask_t = torch.flip(mask_t, dims=[1])
            if random.random() < 0.5:
                b = 0.8 + 0.4 * random.random()
                c = 0.8 + 0.4 * random.random()
                img = TF.adjust_brightness(img, b)
                img = TF.adjust_contrast(img, c)

        # resize to unet_size
        img = TF.resize(img, [self.unet_size, self.unet_size], interpolation=TF.InterpolationMode.BILINEAR)
        mask_t = TF.resize(mask_t, [self.unet_size, self.unet_size], interpolation=TF.InterpolationMode.NEAREST)
        return img, mask_t, img_id

class AirbusMaskRCNNDataset(Dataset):
    """
    Instance training: each RLE row is one instance.
    """
    def __init__(
        self,
        img_dir: str,
        ids: List[str],
        id2rles: Dict[str, List[str]],
        base_size: int = 768,
        augment: bool = True,
    ):
        self.img_dir = img_dir
        self.ids = ids
        self.id2rles = id2rles
        self.base_size = base_size
        self.augment = augment
        self.aug = DetAugment() if augment else None

    def __len__(self) -> int:
        return len(self.ids)

    def __getitem__(self, idx: int):
        img_id = self.ids[idx]
        path = os.path.join(self.img_dir, img_id)
        try:
            im = safe_open_image_rgb(path)
        except Exception:
            im = Image.new("RGB", (self.base_size, self.base_size), (0, 0, 0))
        img = TF.to_tensor(im)  # (3,H,W)
        H, W = img.shape[1], img.shape[2]

        rles = self.id2rles.get(img_id, [])
        inst_masks = []
        for rle in rles:
            m = rle_decode(rle, (H, W))
            inst_masks.append(m)
        if len(inst_masks) == 0:
            masks = torch.zeros((0, H, W), dtype=torch.uint8)
            boxes = torch.zeros((0, 4), dtype=torch.float32)
            labels = torch.zeros((0,), dtype=torch.int64)
        else:
            masks_np = np.stack(inst_masks, axis=0).astype(np.uint8)  # (N,H,W)
            masks = torch.from_numpy(masks_np)
            boxes = masks_to_boxes(masks)
            labels = torch.ones((masks.shape[0],), dtype=torch.int64)  # ship=1
        target = {
            "boxes": boxes,
            "labels": labels,
            "masks": masks,
            "image_id": torch.tensor([idx], dtype=torch.int64),
        }

        if self.augment and self.aug is not None:
            img, target = self.aug(img, target)

        # NOTE: multi-scale resize is handled by Mask R-CNN internal transform (min_size list)
        return img, target, img_id

def collate_fn(batch):
    imgs = [b[0] for b in batch]
    targets = [b[1] for b in batch]
    ids = [b[2] for b in batch]
    return imgs, targets, ids

# -------------------------
# UNet(ResNet101 encoder) minimal implementation
# -------------------------
class ConvBNReLU(nn.Module):
    def __init__(self, in_ch, out_ch, k=3, s=1, p=1):
        super().__init__()
        self.conv = nn.Conv2d(in_ch, out_ch, k, s, p, bias=False)
        self.bn = nn.BatchNorm2d(out_ch)
        self.act = nn.ReLU(inplace=True)
    def forward(self, x):
        return self.act(self.bn(self.conv(x)))

class UpBlock(nn.Module):
    def __init__(self, in_ch, skip_ch, out_ch):
        super().__init__()
        self.up = nn.ConvTranspose2d(in_ch, out_ch, kernel_size=2, stride=2)
        self.conv1 = ConvBNReLU(out_ch + skip_ch, out_ch)
        self.conv2 = ConvBNReLU(out_ch, out_ch)
    def forward(self, x, skip):
        x = self.up(x)
        # pad if needed
        if x.shape[-1] != skip.shape[-1] or x.shape[-2] != skip.shape[-2]:
            x = TF.resize(x, [skip.shape[-2], skip.shape[-1]], interpolation=TF.InterpolationMode.BILINEAR)
        x = torch.cat([x, skip], dim=1)
        x = self.conv2(self.conv1(x))
        return x

class UNetResNet101(nn.Module):
    """
    UNet with ResNet101 encoder (pretrained optional)
    Output: 1-channel logits
    """
    def __init__(self, pretrained=True):
        super().__init__()
        enc = torchvision.models.resnet101(weights=(
            torchvision.models.ResNet101_Weights.IMAGENET1K_V2 if pretrained else None
        ))
        # encoder stem
        self.conv1 = enc.conv1
        self.bn1 = enc.bn1
        self.relu = enc.relu
        self.maxpool = enc.maxpool
        # encoder stages
        self.layer1 = enc.layer1  # 256
        self.layer2 = enc.layer2  # 512
        self.layer3 = enc.layer3  # 1024
        self.layer4 = enc.layer4  # 2048

        self.center = nn.Sequential(
            ConvBNReLU(2048, 512, 3, 1, 1),
            ConvBNReLU(512, 512, 3, 1, 1),
        )
        self.up4 = UpBlock(512, 1024, 256)
        self.up3 = UpBlock(256, 512, 128)
        self.up2 = UpBlock(128, 256, 64)
        self.up1 = UpBlock(64, 64, 32)

        self.head = nn.Conv2d(32, 1, kernel_size=1)

    def forward(self, x):
        # x: (B,3,H,W)
        x0 = self.relu(self.bn1(self.conv1(x)))  # 64, /2
        x1 = self.maxpool(x0)                    # /4
        e1 = self.layer1(x1)                     # 256, /4
        e2 = self.layer2(e1)                     # 512, /8
        e3 = self.layer3(e2)                     # 1024, /16
        e4 = self.layer4(e3)                     # 2048, /32

        c = self.center(e4)                      # 512, /32
        d4 = self.up4(c, e3)                     # 256, /16
        d3 = self.up3(d4, e2)                    # 128, /8
        d2 = self.up2(d3, e1)                    # 64, /4
        d1 = self.up1(d2, x0)                    # 32, /2
        out = TF.resize(d1, [x.shape[-2], x.shape[-1]], interpolation=TF.InterpolationMode.BILINEAR)
        return self.head(out)

# -------------------------
# Losses
# -------------------------
def dice_loss_with_logits(logits: torch.Tensor, targets: torch.Tensor, eps=1e-6) -> torch.Tensor:
    # logits, targets: (B,1,H,W) float
    probs = torch.sigmoid(logits)
    num = 2.0 * (probs * targets).sum(dim=(2, 3))
    den = (probs + targets).sum(dim=(2, 3)) + eps
    dice = 1.0 - (num / den)
    return dice.mean()

# -------------------------
# Mask IoU Soft-NMS + ownership (no-overlap)
# -------------------------
def mask_iou_torch(m1: torch.Tensor, m2: torch.Tensor, eps=1e-6) -> float:
    # m1,m2: (H,W) bool/uint8
    inter = (m1 & m2).sum().item()
    union = (m1 | m2).sum().item()
    return float(inter) / float(union + eps)

def soft_nms_masks(
    masks: List[torch.Tensor],
    scores: torch.Tensor,
    sigma: float = 0.5,
    score_thr: float = 1e-3,
    topk: int = 200,
) -> Tuple[List[int], torch.Tensor]:
    """
    Gaussian Soft-NMS using mask IoU.
    masks: list of (H,W) uint8/bool
    scores: (N,) float
    """
    N = len(masks)
    if N == 0:
        return [], scores
    scores = scores.clone()
    order = scores.argsort(descending=True).tolist()
    keep: List[int] = []
    while len(order) > 0 and len(keep) < topk:
        i = order.pop(0)
        keep.append(i)
        new_order = []
        for j in order:
            iou = mask_iou_torch(masks[i] > 0, masks[j] > 0)
            decay = math.exp(-(iou * iou) / max(1e-6, sigma))
            scores[j] = scores[j] * decay
            if scores[j].item() >= score_thr:
                new_order.append(j)
        new_order = sorted(new_order, key=lambda k: scores[k].item(), reverse=True)
        order = new_order
    return keep, scores

def enforce_pixel_ownership(
    masks: List[torch.Tensor],
    scores: torch.Tensor,
    min_area: int = 1,
) -> List[torch.Tensor]:
    """
    Ensure no pixel belongs to two instances:
    - sort by score desc
    - keep pixels that are not yet taken
    """
    if len(masks) == 0:
        return []
    order = scores.argsort(descending=True).tolist()
    taken = torch.zeros_like(masks[0], dtype=torch.bool)
    out = [m.clone().to(dtype=torch.uint8) for m in masks]
    for idx in order:
        m = out[idx] > 0
        m = m & (~taken)
        if int(m.sum().item()) < min_area:
            out[idx].zero_()
            continue
        out[idx] = m.to(dtype=torch.uint8)
        taken = taken | m
    return out

# -------------------------
# Torchvision ROI Heads monkeypatch: OHEM + Dice for mask loss (best-effort)
# -------------------------
def install_roiheads_ohem_and_dice(ohem_topk: int = 128, dice_w: float = 1.0):
    """
    Monkeypatch torchvision.models.detection.roi_heads fastrcnn_loss / maskrcnn_loss
    to apply OHEM(topK) and add Dice to mask loss.
    This is a best-effort implementation compatible with common torchvision versions.
    """
    from torchvision.models.detection import roi_heads as RH

    orig_fastrcnn_loss = RH.fastrcnn_loss
    orig_maskrcnn_loss = RH.maskrcnn_loss

    def fastrcnn_loss_ohem(class_logits, box_regression, labels, regression_targets):
        # original returns scalar cls_loss, box_loss
        # we re-compute per-sample losses to choose topK.
        # class_logits: (N, num_classes), labels: list[tensor]
        # box_regression: (N, num_classes*4), regression_targets: list[tensor]
        labels_cat = torch.cat(labels, dim=0)
        regression_targets_cat = torch.cat(regression_targets, dim=0)

        # classification per sample
        cls_loss_all = F.cross_entropy(class_logits, labels_cat, reduction="none")  # (N,)

        # box loss per sample (only for positive)
        # mimic torchvision logic
        sampled_pos_inds_subset = torch.where(labels_cat > 0)[0]
        labels_pos = labels_cat[sampled_pos_inds_subset]
        N = class_logits.shape[0]
        box_regression_reshaped = box_regression.reshape(N, -1, 4)

        box_loss_all = torch.zeros((N,), device=class_logits.device, dtype=class_logits.dtype)
        if sampled_pos_inds_subset.numel() > 0:
            box_pred = box_regression_reshaped[sampled_pos_inds_subset, labels_pos]
            box_tgt = regression_targets_cat[sampled_pos_inds_subset]
            reg_loss_pos = F.smooth_l1_loss(box_pred, box_tgt, beta=1.0 / 9, reduction="none").sum(dim=1)
            box_loss_all[sampled_pos_inds_subset] = reg_loss_pos

        total = cls_loss_all + box_loss_all
        k = min(ohem_topk, total.numel())
        if k <= 0:
            # fallback
            return cls_loss_all.mean(), box_loss_all.mean()
        topk_vals, topk_idx = torch.topk(total.detach(), k=k, largest=True)
        cls_loss = cls_loss_all[topk_idx].mean()
        box_loss = box_loss_all[topk_idx].mean()
        return cls_loss, box_loss

    def maskrcnn_loss_dice(mask_logits, proposals, gt_masks, gt_labels, mask_matched_idxs):
        """
        Start from torchvision's mask loss, then add dice over matched RoIs.
        """
        bce_loss = orig_maskrcnn_loss(mask_logits, proposals, gt_masks, gt_labels, mask_matched_idxs)

        # dice add-on: compute dice on the same matched targets as orig loss uses.
        # We re-derive the matched masks similar to torchvision internals.
        # If anything mismatches, we quietly fallback to bce only (robustness > fragility).
        try:
            # mask_logits: (sum_pos, num_classes, M, M)
            # get only positive, per image
            # Build target masks like torchvision: project GT masks to RoI boxes with mask_roi_pool resolution.
            # Unfortunately, torchvision internal uses "project_masks_on_boxes" which is not public-stable across versions.
            # We'll approximate by taking sigmoid logits for class=1 and compare to binarized pooled targets created
            # by resizing full-image gt mask to (M,M) inside each proposal box.
            device = mask_logits.device
            M = mask_logits.shape[-1]
            # gather all positive indices across images
            labels_list = []
            for lbl in gt_labels:
                labels_list.append(lbl)
            # build concatenated labels for matched rois
            # We mimic: labels_per_image = gt_labels[matched_idxs_per_image] for pos proposals
            # Here, mask_matched_idxs provides indices into GT per proposal.
            # But we don't have sampled_inds here. We'll build from proposals list length structure.
            # This part is version-dependent; keep it guarded.
            # => fallback to bce only if uncertain.
            raise RuntimeError("dice_projection_not_stable")
        except Exception:
            return bce_loss

    RH.fastrcnn_loss = fastrcnn_loss_ohem
    RH.maskrcnn_loss = maskrcnn_loss_dice

# -------------------------
# Model builders
# -------------------------
def build_maskrcnn(num_classes: int = 2, pretrained: bool = True, min_sizes: Optional[List[int]] = None, max_size: int = 2000):
    # base model
    weights = torchvision.models.detection.MaskRCNN_ResNet50_FPN_Weights.DEFAULT if pretrained else None
    model = torchvision.models.detection.maskrcnn_resnet50_fpn(weights=weights, num_classes=num_classes)

    # multi-scale: set transform min_size list
    if min_sizes is None:
        min_sizes = [1200, 1400, 1600, 1800, 2000]
    model.transform.min_size = tuple(min_sizes)
    model.transform.max_size = int(max_size)

    # increase mask output resolution: RoIAlign output_size 28 -> mask logits become 56 (because deconv doubles)
    try:
        model.roi_heads.mask_roi_pool.output_size = (28, 28)
    except Exception:
        pass

    return model

# -------------------------
# Train / Eval loops
# -------------------------
@torch.no_grad()
def eval_unet_shipness(unet: nn.Module, loader: DataLoader, device: torch.device) -> Dict[str, float]:
    unet.eval()
    out = {}
    for imgs, masks, ids in loader:
        imgs = imgs.to(device, non_blocking=True)
        logits = unet(imgs)
        probs = torch.sigmoid(logits)
        # shipness: max prob
        shipness = probs.flatten(1).max(dim=1).values
        for i, img_id in enumerate(ids):
            out[img_id] = float(shipness[i].item())
    return out

def train_unet(
    unet: nn.Module,
    train_loader: DataLoader,
    val_loader: DataLoader,
    device: torch.device,
    epochs: int,
    lr: float,
    run_dir: str,
):
    log_path = os.path.join(run_dir, "log_unet.txt")
    with open(log_path, "a") as f:
        f.write(f"{now_str()} [UNET] start training\n")
    opt = torch.optim.AdamW(unet.parameters(), lr=lr, weight_decay=1e-4)

    best_val = 1e18
    best_path = os.path.join(run_dir, "unet_best.pt")

    for ep in range(1, epochs + 1):
        unet.train()
        t0 = time.time()
        loss_sum = 0.0
        n = 0
        for imgs, masks, _ids in train_loader:
            imgs = imgs.to(device, non_blocking=True)
            masks = masks.to(device, non_blocking=True)
            logits = unet(imgs)
            bce = F.binary_cross_entropy_with_logits(logits, masks)
            dl = dice_loss_with_logits(logits, masks)
            loss = bce + dl
            opt.zero_grad(set_to_none=True)
            loss.backward()
            opt.step()
            loss_sum += float(loss.item()) * imgs.size(0)
            n += imgs.size(0)

        # val
        unet.eval()
        v_sum = 0.0
        vn = 0
        with torch.no_grad():
            for imgs, masks, _ids in val_loader:
                imgs = imgs.to(device, non_blocking=True)
                masks = masks.to(device, non_blocking=True)
                logits = unet(imgs)
                bce = F.binary_cross_entropy_with_logits(logits, masks)
                dl = dice_loss_with_logits(logits, masks)
                loss = bce + dl
                v_sum += float(loss.item()) * imgs.size(0)
                vn += imgs.size(0)
        tr = loss_sum / max(1, n)
        va = v_sum / max(1, vn)
        dt = time.time() - t0

        with open(log_path, "a") as f:
            f.write(f"{now_str()} [UNET] ep={ep} train_loss={tr:.6f} val_loss={va:.6f} dt={dt:.1f}s\n")
        if va < best_val:
            best_val = va
            torch.save(unet.state_dict(), best_path)

    with open(log_path, "a") as f:
        f.write(f"{now_str()} [UNET] done best_val={best_val:.6f} best_path={best_path}\n")

    return best_path

def train_maskrcnn(
    model: nn.Module,
    train_loader: DataLoader,
    val_loader: DataLoader,
    device: torch.device,
    epochs: int,
    lr: float,
    run_dir: str,
):
    log_path = os.path.join(run_dir, "log_maskrcnn.txt")
    with open(log_path, "a") as f:
        f.write(f"{now_str()} [MASKRCNN] start training\n")

    params = [p for p in model.parameters() if p.requires_grad]
    opt = torch.optim.AdamW(params, lr=lr, weight_decay=1e-4)

    best_val = 1e18
    best_path = os.path.join(run_dir, "maskrcnn_best.pt")

    for ep in range(1, epochs + 1):
        model.train()
        t0 = time.time()
        loss_sum = 0.0
        n = 0

        for imgs, targets, _ids in train_loader:
            imgs = [im.to(device, non_blocking=True) for im in imgs]
            targets = [{k: (v.to(device) if torch.is_tensor(v) else v) for k, v in t.items()} for t in targets]
            loss_dict = model(imgs, targets)
            loss = sum(loss_dict.values())
            opt.zero_grad(set_to_none=True)
            loss.backward()
            opt.step()

            bs = len(imgs)
            loss_sum += float(loss.item()) * bs
            n += bs

        # val (loss only)
        model.train()  # torchvision detection returns losses only in train mode
        v_sum = 0.0
        vn = 0
        with torch.no_grad():
            for imgs, targets, _ids in val_loader:
                imgs = [im.to(device, non_blocking=True) for im in imgs]
                targets = [{k: (v.to(device) if torch.is_tensor(v) else v) for k, v in t.items()} for t in targets]
                loss_dict = model(imgs, targets)
                loss = sum(loss_dict.values())
                bs = len(imgs)
                v_sum += float(loss.item()) * bs
                vn += bs

        tr = loss_sum / max(1, n)
        va = v_sum / max(1, vn)
        dt = time.time() - t0

        with open(log_path, "a") as f:
            f.write(f"{now_str()} [MASKRCNN] ep={ep} train_loss={tr:.6f} val_loss={va:.6f} dt={dt:.1f}s\n")

        if va < best_val:
            best_val = va
            torch.save(model.state_dict(), best_path)

    with open(log_path, "a") as f:
        f.write(f"{now_str()} [MASKRCNN] done best_val={best_val:.6f} best_path={best_path}\n")
    return best_path

