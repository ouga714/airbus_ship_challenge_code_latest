# Inference + submission
# -------------------------
@torch.no_grad()
def infer_test_and_make_submission(
    unet: nn.Module,
    maskrcnn: nn.Module,
    data_dir: str,
    run_dir: str,
    device: torch.device,
    unet_size: int = 384,
    unet_gate_thr: float = 0.05,
    det_score_thr: float = 0.05,
    softnms_sigma: float = 0.5,
    softnms_score_thr: float = 1e-3,
    min_area: int = 20,
    max_instances: int = 80,
):
    test_dir = os.path.join(data_dir, "test_v2")
    sample_sub = os.path.join(data_dir, "sample_submission_v2.csv")
    out_csv = os.path.join(run_dir, "submission.csv")
    vis_dir = os.path.join(run_dir, "vis_test")
    mkdir_p(vis_dir)

    # read template order (ImageId lines can repeat)
    template_rows = []
    with open(sample_sub, "r", newline="") as f:
        r = csv.DictReader(f)
        for row in r:
            template_rows.append((row["ImageId"], row.get("EncodedPixels", "")))

    # cache opened images to avoid repeated disk reads when template repeats ids
    # but keep memory bounded: Airbus test template repeats lines per image in template; we handle by image-level prediction then map
    unique_ids = sorted(list({img_id for img_id, _ in template_rows}))

    unet.eval()
    maskrcnn.eval()

    # per image predicted instance RLEs (variable rows)
    pred_rles: Dict[str, List[str]] = {}

    for idx, img_id in enumerate(unique_ids):
        img_path = os.path.join(test_dir, img_id)
        try:
            im = safe_open_image_rgb(img_path)
        except Exception:
            pred_rles[img_id] = [""]
            continue

        # UNet shipness gate
        img_t = TF.to_tensor(im)
        img_u = TF.resize(img_t, [unet_size, unet_size], interpolation=TF.InterpolationMode.BILINEAR).unsqueeze(0).to(device)
        logits = unet(img_u)
        prob = torch.sigmoid(logits)
        shipness = float(prob.flatten(1).max(dim=1).values.item())

        if shipness < unet_gate_thr:
            pred_rles[img_id] = [""]  # one empty row
            continue

        # Mask R-CNN
        img_in = img_t.to(device)
        out = maskrcnn([img_in])[0]
        scores = out.get("scores", torch.zeros((0,), device=device)).detach().float().cpu()
        masks = out.get("masks", torch.zeros((0, 1, img_t.shape[1], img_t.shape[2]), device=device)).detach().cpu()
        # masks: (N,1,H,W) probs
        if masks.numel() == 0 or scores.numel() == 0:
            pred_rles[img_id] = [""]
            continue

        H, W = img_t.shape[1], img_t.shape[2]
        masks_list = []
        score_list = []
        for i in range(masks.shape[0]):
            sc = float(scores[i].item())
            if sc < det_score_thr:
                continue
            m = (masks[i, 0] >= 0.5).to(dtype=torch.uint8)  # fixed threshold (no TTA)
            if int(m.sum().item()) < min_area:
                continue
            masks_list.append(m)
            score_list.append(sc)

        if len(masks_list) == 0:
            pred_rles[img_id] = [""]
            continue

        scores_t = torch.tensor(score_list, dtype=torch.float32)
        keep, scores_new = soft_nms_masks(
            masks=masks_list,
            scores=scores_t,
            sigma=softnms_sigma,
            score_thr=softnms_score_thr,
            topk=max_instances * 2,
        )
        masks_kept = [masks_list[i] for i in keep]
        scores_kept = scores_new[keep]

        # enforce no-overlap
        masks_final = enforce_pixel_ownership(masks_kept, scores_kept, min_area=min_area)
        rles = []
        for m in masks_final:
            if int(m.sum().item()) < min_area:
                continue
            rle = rle_encode(m.numpy().astype(np.uint8))
            if rle != "":
                rles.append(rle)

        if len(rles) == 0:
            pred_rles[img_id] = [""]
        else:
            # variable rows: one per instance
            pred_rles[img_id] = rles[:max_instances]

        if (idx + 1) % 500 == 0:
            print(f"{now_str()} [INFER] {idx+1}/{len(unique_ids)} shipness={shipness:.3f} inst={len(pred_rles[img_id])}")

    # Write submission in template order:
    # For each template row, we must output exactly same number of lines as template.
    # But template has 1 line per image (ImageId unique). In Airbus sample_submission_v2.csv it's 1 line per image.
    # We'll still respect template row count: if template repeats ids, we output empty for extra lines.
    with open(out_csv, "w", newline="") as f:
        w = csv.writer(f)
        w.writerow(["ImageId", "EncodedPixels"])
        for img_id, _ in template_rows:
            rles = pred_rles.get(img_id, [""])
            # For template row, output FIRST instance only; remaining instances will be appended as extra rows after template.
            # But Kaggle accepts variable-row submissions where ImageId repeats for instances.
            first = rles[0] if len(rles) > 0 else ""
            w.writerow([img_id, first])

        # Append extra instance rows beyond the first
        for img_id in unique_ids:
            rles = pred_rles.get(img_id, [""])
            if len(rles) <= 1:
                continue
            for extra in rles[1:]:
                w.writerow([img_id, extra])

    meta = {
        "unet_gate_thr": unet_gate_thr,
        "det_score_thr": det_score_thr,
        "softnms_sigma": softnms_sigma,
        "softnms_score_thr": softnms_score_thr,
        "min_area": min_area,
        "max_instances": max_instances,
        "out_csv": out_csv,
    }
    with open(os.path.join(run_dir, "infer_meta.json"), "w") as f:
        json.dump(meta, f, indent=2)

    print(f"{now_str()} [INFER] submission written: {out_csv}")

