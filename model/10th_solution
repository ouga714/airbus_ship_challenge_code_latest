def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--mode", type=str, default="all",
                    choices=["all", "split", "train_unet", "train_maskrcnn", "infer_test"])
    ap.add_argument("--data_dir", type=str, required=True)
    ap.add_argument("--run_dir", type=str, required=True)
    ap.add_argument("--seed", type=int, default=42)

    # dataset sizing
    ap.add_argument("--train_total", type=int, default=70000)
    ap.add_argument("--train_pos_frac", type=float, default=0.40)
    ap.add_argument("--val_total", type=int, default=15000)
    ap.add_argument("--val_pos_frac", type=float, default=0.221)  # global pos rate ~0.221

    # unet
    ap.add_argument("--unet_size", type=int, default=384)
    ap.add_argument("--unet_epochs", type=int, default=6)
    ap.add_argument("--unet_lr", type=float, default=2e-4)
    ap.add_argument("--unet_gate_thr", type=float, default=0.05)
    ap.add_argument("--unet_pretrained", type=int, default=1)

    # maskrcnn
    ap.add_argument("--maskrcnn_epochs", type=int, default=10)
    ap.add_argument("--maskrcnn_lr", type=float, default=2e-4)
    ap.add_argument("--maskrcnn_pretrained", type=int, default=1)
    ap.add_argument("--min_sizes", type=str, default="1200,1400,1600,1800,2000")
    ap.add_argument("--max_size", type=int, default=2000)
    ap.add_argument("--ohem_topk", type=int, default=128)

    # loaders
    ap.add_argument("--bs_unet", type=int, default=16)
    ap.add_argument("--bs_det", type=int, default=1)
    ap.add_argument("--num_workers", type=int, default=4)

    # infer params
    ap.add_argument("--det_score_thr", type=float, default=0.05)
    ap.add_argument("--softnms_sigma", type=float, default=0.5)
    ap.add_argument("--softnms_score_thr", type=float, default=1e-3)
    ap.add_argument("--min_area", type=int, default=20)
    ap.add_argument("--max_instances", type=int, default=80)

    args = ap.parse_args()

    mkdir_p(args.run_dir)
    set_seed(args.seed)

    # device: user requested CUDA=1. We assume you launch with CUDA_VISIBLE_DEVICES=1
    # Then device is cuda:0 inside the process.
    device = torch.device("cuda:0" if torch.cuda.is_available() else "cpu")

    # paths
    train_img_dir = os.path.join(args.data_dir, "train_v2")
    csv_path = os.path.join(args.data_dir, "train_ship_segmentations_v2.csv")

    if not os.path.isdir(train_img_dir):
        raise FileNotFoundError(f"train_v2 not found: {train_img_dir}")
    if not os.path.isfile(csv_path):
        raise FileNotFoundError(f"csv not found: {csv_path}")

    print(f"{now_str()} ==== START: UNet384 + MaskRCNN (intern-winter) ====")
    print(f"{now_str()} run_dir={args.run_dir}")
    print(f"{now_str()} data_dir={args.data_dir}")
    print(f"{now_str()} device={device}")

    # load metadata
    id2rles = load_id2rles(csv_path)
    all_ids = list_image_ids(train_img_dir)
    total_all = len(all_ids)
    total_pos = sum(1 for i in all_ids if i in id2rles)
    print(f"{now_str()} ALL images={total_all} pos={total_pos} neg={total_all-total_pos} pos_rate={total_pos/max(1,total_all):.4f}")

    splits_path = os.path.join(args.run_dir, "splits.json")

    # split
    if args.mode in ["all", "split"] or (args.mode == "all" and not os.path.isfile(splits_path)):
        sampled, st = stratified_sample_ids(
            all_ids, id2rles, total=args.train_total + args.val_total,
            pos_frac=args.train_pos_frac, seed=args.seed
        )
        train_ids, val_ids, st2 = split_train_val(
            sampled, id2rles, val_total=args.val_total, val_pos_frac=args.val_pos_frac, seed=args.seed + 1
        )
        splits = {
            "seed": args.seed,
            "train_total_requested": args.train_total,
            "val_total_requested": args.val_total,
            "sampled_stats": st,
            "split_stats": st2,
            "train_ids": train_ids,
            "val_ids": val_ids,
        }
        with open(splits_path, "w") as f:
            json.dump(splits, f, indent=2)
        print(f"{now_str()} splits saved: {splits_path}")
        print(f"{now_str()} split_stats: {st2}")

    if not os.path.isfile(splits_path):
        raise RuntimeError("splits.json missing; run with --mode split or --mode all")

    with open(splits_path, "r") as f:
        splits = json.load(f)
    train_ids = splits["train_ids"]
    val_ids = splits["val_ids"]

    # train UNet
    unet_ckpt = os.path.join(args.run_dir, "unet_best.pt")
    if args.mode in ["all", "train_unet"]:
        unet = UNetResNet101(pretrained=bool(args.unet_pretrained)).to(device)

        ds_tr = AirbusUNetDataset(train_img_dir, train_ids, id2rles, unet_size=args.unet_size, augment=True)
        ds_va = AirbusUNetDataset(train_img_dir, val_ids, id2rles, unet_size=args.unet_size, augment=False)
        dl_tr = DataLoader(ds_tr, batch_size=args.bs_unet, shuffle=True, num_workers=args.num_workers, pin_memory=True, drop_last=True)
        dl_va = DataLoader(ds_va, batch_size=args.bs_unet, shuffle=False, num_workers=args.num_workers, pin_memory=True)

        best_path = train_unet(
            unet=unet,
            train_loader=dl_tr,
            val_loader=dl_va,
            device=device,
            epochs=args.unet_epochs,
            lr=args.unet_lr,
            run_dir=args.run_dir,
        )
        unet_ckpt = best_path
        print(f"{now_str()} UNet best: {best_path} sha1_1mb={sha1_first1mb(best_path)}")

    # train Mask R-CNN
    mask_ckpt = os.path.join(args.run_dir, "maskrcnn_best.pt")
    if args.mode in ["all", "train_maskrcnn"]:
        # Install OHEM hooks (best-effort)
        install_roiheads_ohem_and_dice(ohem_topk=args.ohem_topk, dice_w=1.0)

        min_sizes = [int(x) for x in args.min_sizes.split(",") if x.strip() != ""]
        model = build_maskrcnn(
            num_classes=2,
            pretrained=bool(args.maskrcnn_pretrained),
            min_sizes=min_sizes,
            max_size=args.max_size,
        ).to(device)

        ds_tr = AirbusMaskRCNNDataset(train_img_dir, train_ids, id2rles, augment=True)
        ds_va = AirbusMaskRCNNDataset(train_img_dir, val_ids, id2rles, augment=False)
        dl_tr = DataLoader(ds_tr, batch_size=args.bs_det, shuffle=True, num_workers=args.num_workers, pin_memory=True, collate_fn=collate_fn)
        dl_va = DataLoader(ds_va, batch_size=args.bs_det, shuffle=False, num_workers=args.num_workers, pin_memory=True, collate_fn=collate_fn)

        best_path = train_maskrcnn(
            model=model,
            train_loader=dl_tr,
            val_loader=dl_va,
            device=device,
            epochs=args.maskrcnn_epochs,
            lr=args.maskrcnn_lr,
            run_dir=args.run_dir,
        )
        mask_ckpt = best_path
        print(f"{now_str()} MaskRCNN best: {best_path} sha1_1mb={sha1_first1mb(best_path)}")

    # infer test & submission
    if args.mode in ["all", "infer_test"]:
        # load UNet
        unet = UNetResNet101(pretrained=False).to(device)
        if os.path.isfile(unet_ckpt):
            unet.load_state_dict(torch.load(unet_ckpt, map_location=device))
        else:
            print(f"{now_str()} [WARN] UNet ckpt missing -> shipness gate may be meaningless: {unet_ckpt}")

        # load Mask R-CNN
        install_roiheads_ohem_and_dice(ohem_topk=args.ohem_topk, dice_w=1.0)
        min_sizes = [int(x) for x in args.min_sizes.split(",") if x.strip() != ""]
        model = build_maskrcnn(
            num_classes=2,
            pretrained=False,
            min_sizes=min_sizes,
            max_size=args.max_size,
        ).to(device)
        if os.path.isfile(mask_ckpt):
            model.load_state_dict(torch.load(mask_ckpt, map_location=device))
        else:
            print(f"{now_str()} [WARN] MaskRCNN ckpt missing: {mask_ckpt}")

        infer_test_and_make_submission(
            unet=unet,
            maskrcnn=model,
            data_dir=args.data_dir,
            run_dir=args.run_dir,
            device=device,
            unet_size=args.unet_size,
            unet_gate_thr=args.unet_gate_thr,
            det_score_thr=args.det_score_thr,
            softnms_sigma=args.softnms_sigma,
            softnms_score_thr=args.softnms_score_thr,
            min_area=args.min_area,
            max_instances=args.max_instances,
        )

    print(f"{now_str()} ==== DONE ====")

if __name__ == "__main__":
    main()
