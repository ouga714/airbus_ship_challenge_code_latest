# -------------------------
# RLE decode/encode (Airbus: column-major)
# -------------------------
def rle_decode(rle: str, shape: Tuple[int, int]) -> np.ndarray:
    """
    rle: "start length start length ..."
    shape: (H, W)
    Airbus uses column-major (Fortran order) with 1-indexed starts
    """
    h, w = shape
    mask = np.zeros(h * w, dtype=np.uint8)
    if rle is None or rle == "" or rle.strip() == "":
        return mask.reshape((h, w), order="F")
    s = rle.strip().split()
    starts = np.asarray(s[0::2], dtype=np.int64) - 1
    lengths = np.asarray(s[1::2], dtype=np.int64)
    ends = starts + lengths
    for lo, hi in zip(starts, ends):
        mask[lo:hi] = 1
    return mask.reshape((h, w), order="F")

def rle_encode(mask: np.ndarray) -> str:
    """
    mask: (H,W) {0,1} uint8
    output: column-major RLE, 1-indexed starts
    """
    if mask.dtype != np.uint8:
        mask = mask.astype(np.uint8)
    pixels = mask.reshape(-1, order="F")
    # add sentinel
    pixels = np.concatenate([[0], pixels, [0]])
    runs = np.where(pixels[1:] != pixels[:-1])[0] + 1
    runs[1::2] -= runs[0::2]
    if len(runs) == 0:
        return ""
    return " ".join(str(x) for x in runs)

def masks_to_boxes(masks: torch.Tensor) -> torch.Tensor:
    """
    masks: (N,H,W) uint8/bool
    returns boxes: (N,4) float (x1,y1,x2,y2)
    """
    if masks.numel() == 0:
        return torch.zeros((0, 4), dtype=torch.float32)
    N, H, W = masks.shape
    boxes = torch.zeros((N, 4), dtype=torch.float32)
    for i in range(N):
        ys, xs = torch.where(masks[i] > 0)
        if ys.numel() == 0:
            boxes[i] = torch.tensor([0, 0, 1, 1], dtype=torch.float32)
        else:
            x1 = xs.min().item()
            x2 = xs.max().item() + 1
            y1 = ys.min().item()
            y2 = ys.max().item() + 1
            boxes[i] = torch.tensor([x1, y1, x2, y2], dtype=torch.float32)
    return boxes

