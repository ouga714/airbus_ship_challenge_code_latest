def load_id2rles(csv_path: str) -> Dict[str, List[str]]:
    """
    Returns dict: ImageId -> list of RLEs (only non-empty)
    """
    id2rles: Dict[str, List[str]] = {}
    with open(csv_path, "r", newline="") as f:
        reader = csv.DictReader(f)
        # expects columns: ImageId, EncodedPixels
        for row in reader:
            img_id = row["ImageId"]
            rle = row["EncodedPixels"]
            if rle is None or rle.strip() == "":
                continue
            id2rles.setdefault(img_id, []).append(rle.strip())
    return id2rles

def stratified_sample_ids(
    all_ids: List[str],
    id2rles: Dict[str, List[str]],
    total: int,
    pos_frac: float,
    seed: int,
) -> Tuple[List[str], Dict[str, int]]:
    """
    Sample 'total' ids from all_ids with pos fraction ~ pos_frac.
    POS = id in id2rles (has at least one RLE)
    """
    rng = random.Random(seed)
    pos_ids = [i for i in all_ids if i in id2rles]
    neg_ids = [i for i in all_ids if i not in id2rles]
    rng.shuffle(pos_ids)
    rng.shuffle(neg_ids)

    pos_n = int(round(total * pos_frac))
    pos_n = min(pos_n, len(pos_ids))
    neg_n = total - pos_n
    neg_n = min(neg_n, len(neg_ids))
    # if neg shortage, fill with pos
    total_eff = pos_n + neg_n
    if total_eff < total:
        add = min(total - total_eff, len(pos_ids) - pos_n)
        pos_n += add

    sampled = pos_ids[:pos_n] + neg_ids[:neg_n]
    rng.shuffle(sampled)

    stats = {"total": len(sampled), "pos": pos_n, "neg": neg_n}
    return sampled, stats

def split_train_val(
    ids: List[str],
    id2rles: Dict[str, List[str]],
    val_total: int,
    val_pos_frac: float,
    seed: int,
) -> Tuple[List[str], List[str], Dict[str, int]]:
    """
    Make a val split disjoint from train (subset of ids)
    """
    rng = random.Random(seed)
    pos_ids = [i for i in ids if i in id2rles]
    neg_ids = [i for i in ids if i not in id2rles]
    rng.shuffle(pos_ids)
    rng.shuffle(neg_ids)

    val_pos_n = int(round(val_total * val_pos_frac))
    val_pos_n = min(val_pos_n, len(pos_ids))
    val_neg_n = val_total - val_pos_n
    val_neg_n = min(val_neg_n, len(neg_ids))

    val_ids = pos_ids[:val_pos_n] + neg_ids[:val_neg_n]
    val_set = set(val_ids)

    train_ids = [i for i in ids if i not in val_set]
    stats = {"train": len(train_ids), "val": len(val_ids), "val_pos": val_pos_n, "val_neg": val_neg_n}
    return train_ids, val_ids, stats

# -------------------------
# Simple augmentations (no albumentations)
# -------------------------
class DetAugment:
    """
    Basic augmentations for detection/instance seg:
    - random hflip/vflip
    - color jitter (brightness/contrast)
    - gaussian blur sometimes
    - small random affine (rotation/scale)
    """
    def __init__(self, p_flip=0.5, p_color=0.5, p_blur=0.2, p_affine=0.2):
        self.p_flip = p_flip
        self.p_color = p_color
        self.p_blur = p_blur
        self.p_affine = p_affine

    def __call__(self, img: torch.Tensor, target: Optional[dict]) -> Tuple[torch.Tensor, Optional[dict]]:
        # img: (3,H,W) float [0,1]
        _, H, W = img.shape
        # flips
        if random.random() < self.p_flip:
            img = torch.flip(img, dims=[2])
            if target is not None and "boxes" in target:
                boxes = target["boxes"].clone()
                boxes[:, [0, 2]] = W - boxes[:, [2, 0]]
                target["boxes"] = boxes
            if target is not None and "masks" in target:
                target["masks"] = torch.flip(target["masks"], dims=[2])

        if random.random() < self.p_flip:
            img = torch.flip(img, dims=[1])
            if target is not None and "boxes" in target:
                boxes = target["boxes"].clone()
                boxes[:, [1, 3]] = H - boxes[:, [3, 1]]
                target["boxes"] = boxes
            if target is not None and "masks" in target:
                target["masks"] = torch.flip(target["masks"], dims=[1])

        # color jitter
        if random.random() < self.p_color:
            b = 0.8 + 0.4 * random.random()
            c = 0.8 + 0.4 * random.random()
            img = TF.adjust_brightness(img, b)
            img = TF.adjust_contrast(img, c)

        # blur
        if random.random() < self.p_blur:
            # approximate motion blur with gaussian blur
            k = random.choice([3, 5])
            img = TF.gaussian_blur(img, kernel_size=[k, k], sigma=[0.1, 2.0])

        # affine (small)
        if random.random() < self.p_affine:
            angle = random.uniform(-10, 10)
            scale = random.uniform(0.9, 1.1)
            translate = [random.uniform(-0.02, 0.02) * W, random.uniform(-0.02, 0.02) * H]
            shear = [0.0, 0.0]
            # For detection, affine transform on masks/boxes is annoying without heavy code.
            # We keep it image-only to avoid annotation mismatch.
            # (This is conservative; the 10th-place used stronger aug. This is a safe baseline.)
            img = TF.affine(img, angle=angle, translate=translate, scale=scale, shear=shear)

        return img, target

