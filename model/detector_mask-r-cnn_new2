# Dataset
# ============================================================

def masks_to_boxes_xyxy(masks: np.ndarray) -> np.ndarray:
    n = masks.shape[0]
    boxes = np.zeros((n, 4), dtype=np.float32)
    for i in range(n):
        ys, xs = np.where(masks[i] > 0)
        if len(xs) == 0:
            boxes[i] = 0
        else:
            x1 = float(xs.min()); x2 = float(xs.max())
            y1 = float(ys.min()); y2 = float(ys.max())
            boxes[i] = np.array([x1, y1, x2, y2], dtype=np.float32)
    return boxes

class AirbusMaskRcnnDataset(Dataset):
    """
    IMPORTANT: no resize here. All resizing is delegated to model.transform.
    """
    def __init__(self, img_dir: str, id2rles: Dict[str, List[str]], image_ids: List[str],
                 min_instance_area: int = 8,
                 min_box_hw: int = 2,
                 augment: int = 1,
                 max_fallback_tries: int = 10):
        self.img_dir = img_dir
        self.id2rles = id2rles
        self.ids = list(image_ids)
        self.min_instance_area = int(min_instance_area)
        self.min_box_hw = int(min_box_hw)
        self.augment = int(augment)
        self.max_fallback_tries = int(max_fallback_tries)
        self._bad_ids = set()

    def __len__(self) -> int:
        return len(self.ids)

    def _try_load(self, image_id: str):
        path = os.path.join(self.img_dir, image_id)
        img = Image.open(path).convert("RGB")
        w0, h0 = img.size
        img_t = img_to_tensor01(img)

        rles = self.id2rles.get(image_id, [])
        masks = []
        for rle in rles:
            m = rle_decode(rle, (h0, w0))
            if int(m.sum()) < self.min_instance_area:
                continue
            masks.append(m)

        if len(masks) == 0:
            target = {
                "boxes": torch.zeros((0, 4), dtype=torch.float32),
                "labels": torch.zeros((0,), dtype=torch.int64),
                "masks": torch.zeros((0, img_t.shape[1], img_t.shape[2]), dtype=torch.uint8),
                "image_id": torch.tensor([0], dtype=torch.int64),
            }
        else:
            mstack = np.stack(masks, axis=0).astype(np.uint8)
            boxes = masks_to_boxes_xyxy(mstack)
            keep = []
            for i in range(mstack.shape[0]):
                x1, y1, x2, y2 = boxes[i]
                if (x2 - x1 + 1) < self.min_box_hw or (y2 - y1 + 1) < self.min_box_hw:
                    continue
                keep.append(i)
            if len(keep) == 0:
                target = {
                    "boxes": torch.zeros((0, 4), dtype=torch.float32),
                    "labels": torch.zeros((0,), dtype=torch.int64),
                    "masks": torch.zeros((0, img_t.shape[1], img_t.shape[2]), dtype=torch.uint8),
                    "image_id": torch.tensor([0], dtype=torch.int64),
                }
            else:
                mstack = mstack[keep]
                boxes = boxes[keep]
                target = {
                    "boxes": torch.from_numpy(boxes).float(),
                    "labels": torch.ones((mstack.shape[0],), dtype=torch.int64),
                    "masks": torch.from_numpy(mstack).to(torch.uint8),
                    "image_id": torch.tensor([0], dtype=torch.int64),
                }

        if self.augment:
            if random.random() < 0.5:
                img_t = TF.hflip(img_t)
                if target["boxes"].numel() > 0:
                    W = img_t.shape[2]
                    boxes = target["boxes"]
                    x1 = W - 1 - boxes[:, 2]
                    x2 = W - 1 - boxes[:, 0]
                    boxes[:, 0] = x1
                    boxes[:, 2] = x2
                    target["boxes"] = boxes
                    target["masks"] = torch.flip(target["masks"], dims=[2])
            if random.random() < 0.5:
                img_t = TF.vflip(img_t)
                if target["boxes"].numel() > 0:
                    H = img_t.shape[1]
                    boxes = target["boxes"]
                    y1 = H - 1 - boxes[:, 3]
                    y2 = H - 1 - boxes[:, 1]
                    boxes[:, 1] = y1
                    boxes[:, 3] = y2
                    target["boxes"] = boxes
                    target["masks"] = torch.flip(target["masks"], dims=[1])

        return img_t, target

    def __getitem__(self, idx: int):
        for t in range(self.max_fallback_tries):
            image_id = self.ids[idx] if t == 0 else random.choice(self.ids)
            try:
                img_t, target = self._try_load(image_id)
                target["image_id"] = torch.tensor([idx], dtype=torch.int64)
                return img_t, target, image_id
            except Exception:
                if image_id not in self._bad_ids:
                    self._bad_ids.add(image_id)
                    log(f"[data] WARNING: failed to read/parse image_id={image_id} -> fallback")
                continue

        H = W = 768
        img_t = torch.zeros((3, H, W), dtype=torch.float32)
        target = {
            "boxes": torch.zeros((0, 4), dtype=torch.float32),
            "labels": torch.zeros((0,), dtype=torch.int64),
            "masks": torch.zeros((0, H, W), dtype=torch.uint8),
            "image_id": torch.tensor([idx], dtype=torch.int64),
        }
        return img_t, target, self.ids[idx]

def collate_fn(batch):
    imgs = [b[0] for b in batch]
    targets = [b[1] for b in batch]
    ids = [b[2] for b in batch]
    return imgs, targets, ids


# ============================================================
# Metrics (pixel-level on union mask)
# ============================================================

def union_from_target(target: Dict[str, torch.Tensor], shape_hw: Tuple[int,int]) -> np.ndarray:
    if "masks" not in target or target["masks"].numel() == 0:
        H, W = shape_hw
        return np.zeros((H, W), dtype=np.uint8)
    m = target["masks"].cpu().numpy().astype(np.uint8)
    u = (m.sum(axis=0) > 0).astype(np.uint8)
    return u

def union_from_instances(insts: List[np.ndarray], shape_hw: Tuple[int, int]) -> np.ndarray:
    H, W = shape_hw
    if insts is None or len(insts) == 0:
        return np.zeros((H, W), dtype=np.uint8)
    u = np.zeros((H, W), dtype=np.uint8)
    for m in insts:
        if m.shape != (H, W):
            m_img = Image.fromarray((m * 255).astype(np.uint8))
            m_img = m_img.resize((W, H), resample=Image.NEAREST)
            m = (np.asarray(m_img) > 0).astype(np.uint8)
        u = np.maximum(u, m.astype(np.uint8))
    return u

def accumulate_counts(gt: np.ndarray, pr: np.ndarray) -> Tuple[int, int, int]:
    gt = (gt > 0).astype(np.uint8)
    pr = (pr > 0).astype(np.uint8)
    tp = int(((gt == 1) & (pr == 1)).sum())
    fp = int(((gt == 0) & (pr == 1)).sum())
    fn = int(((gt == 1) & (pr == 0)).sum())
    return tp, fp, fn

def compute_metrics(tp: int, fp: int, fn: int, beta: float = 2.0) -> Dict[str, float]:
    eps = 1e-12
    prec = tp / (tp + fp + eps)
    rec  = tp / (tp + fn + eps)
    f1   = (2 * prec * rec) / (prec + rec + eps)
    b2 = beta * beta
    fbeta = (1 + b2) * prec * rec / (b2 * prec + rec + eps)
    iou = tp / (tp + fp + fn + eps)
    return {"precision": float(prec), "recall": float(rec), "f1": float(f1), "f2": float(fbeta), "iou": float(iou)}


# ============================================================
# Inference helper (single image -> instance masks)
# ============================================================

@torch.no_grad()
def infer_raw_outputs(model: nn.Module, img_t: torch.Tensor, device: torch.device) -> Dict[str, torch.Tensor]:
    """
    Return:
      scores: [N] (0..1)
      mask_probs: [N,1,H,W] in 0..1 (sigmoid applied at most once)
    """
    model.eval()
    x = img_t.to(device)
    out = model([x])[0]
    scores = out.get("scores", torch.zeros((0,), device=device)).detach()
    masks  = out.get("masks", torch.zeros((0,1,x.shape[1],x.shape[2]), device=device)).detach()

    if masks.numel() == 0:
        mask_probs = masks
    else:
        mn = float(masks.min().item())
        mx = float(masks.max().item())
        if (mn >= -1e-6) and (mx <= 1.0 + 1e-6):
            mask_probs = masks.float()
        else:
            mask_probs = masks.float().sigmoid()

    return {"scores": scores, "mask_probs": mask_probs}

def insts_from_cached(scores: torch.Tensor, mask_probs: torch.Tensor,
                      score_thr: float, mask_thr: float) -> List[np.ndarray]:
    if scores.numel() == 0:
        return []
    keep = scores >= float(score_thr)
    if keep.sum().item() == 0:
        return []
    mp = mask_probs[keep]  # [K,1,H,W]
    probs = mp[:, 0].float()  # [K,H,W]
    insts: List[np.ndarray] = []
    for k in range(probs.shape[0]):
        mk = (probs[k].detach().cpu().numpy() >= float(mask_thr)).astype(np.uint8)
        if mk.sum() > 0:
            insts.append(mk)
    return insts

def seg_evidence_from_scores(scores: torch.Tensor) -> float:
    """
    A simple scalar evidence from Mask R-CNN:
    - use max score in [0,1]
    - if empty => 0
    This is intentionally simple and stable for fusion tuning.
    """
    if scores is None or scores.numel() == 0:
        return 0.0
    return float(scores.max().item())

def fuse_det_seg_prob(det_p: float, seg_p: float, w_det: float, w_seg: float, bias: float) -> float:
    """
    Fuse in logit-space:
      fused_logit = w_det*logit(det_p) + w_seg*logit(seg_p) + bias
      fused_prob  = sigmoid(fused_logit)
    """
    ld = safe_logit(det_p)
    ls = safe_logit(seg_p)
    return sigmoid(float(w_det)*ld + float(w_seg)*ls + float(bias))


# ============================================================
# Threshold + Fusion tuning (共同意思決定)
# ============================================================

@torch.no_grad()
def tune_joint_fusion(
    model: nn.Module,
    det_model: nn.Module,
    dl: DataLoader,
    img_dir: str,
    device: torch.device,
    det_img_size: int,
    # grids
    score_thrs: np.ndarray,
    mask_thrs: np.ndarray,
    w_det_grid: List[float],
    w_seg_grid: List[float],
    bias_grid: List[float],
    tau_grid: List[float],
    limit: int,
    beta: float = 2.0,
) -> Dict[str, Any]:
    """
    Jointly tune:
      - score_thr, mask_thr
      - fusion weights/bias and final decision threshold tau
    Decision rule per image:
      seg evidence seg_p = max(scores_above_score_thr?)  (we use raw max(scores))
      fused_p = fuse(det_p, seg_p; w_det,w_seg,bias)
      if fused_p < tau: predict empty (all zeros)
      else: predict union mask from insts (score_thr, mask_thr)
    """

    model.eval()
    det_model.eval()

    # Cache a subset
    cache = []  # (gt_union, scores_cpu, mask_probs_cpu, det_p, (H,W))
    seen = 0
    for imgs, targets, ids in dl:
        for img_t, tgt, image_id in zip(imgs, targets, ids):
            H, W = img_t.shape[1], img_t.shape[2]
            gt_u = union_from_target(tgt, (H, W))

            out = infer_raw_outputs(model, img_t, device)
            scores = out["scores"].detach().cpu()
            mprob  = out["mask_probs"].detach().cpu()

            det_p = detector_prob_for_id(det_model, os.path.join(img_dir, image_id), det_img_size, device)

            cache.append((gt_u, scores, mprob, float(det_p), (H, W)))
            seen += 1
            if seen >= int(limit):
                break
        if seen >= int(limit):
            break

    if len(cache) == 0:
        return {
            "best_f2": -1.0,
            "score_thr": float(score_thrs[0]) if len(score_thrs) else 0.5,
            "mask_thr": float(mask_thrs[0]) if len(mask_thrs) else 0.5,
            "w_det": float(w_det_grid[0]) if len(w_det_grid) else 1.0,
            "w_seg": float(w_seg_grid[0]) if len(w_seg_grid) else 1.0,
            "bias": float(bias_grid[0]) if len(bias_grid) else 0.0,
            "tau": float(tau_grid[0]) if len(tau_grid) else 0.5,
        }

    best = {"f2": -1.0}

    # Main grid search
    for st in score_thrs:
        st = float(st)
        for mt in mask_thrs:
            mt = float(mt)

            # For this (st,mt), we can precompute per-image:
            #   seg_p (from raw scores) and union prediction (from insts)
            per_img = []
            for gt_u, scores, mprob, det_p, shape_hw in cache:
                seg_p = seg_evidence_from_scores(scores)  # stable: raw max score
                insts = insts_from_cached(scores, mprob, st, mt)
                pr_u = union_from_instances(insts, shape_hw)
                per_img.append((gt_u, pr_u, det_p, seg_p))

            for w_det in w_det_grid:
                for w_seg in w_seg_grid:
                    for bias in bias_grid:
                        # optionally precompute fused_p per image (depends only on det_p, seg_p)
                        fused_ps = []
                        for (_gt_u, _pr_u, det_p, seg_p) in per_img:
                            fused_ps.append(fuse_det_seg_prob(det_p, seg_p, w_det, w_seg, bias))

                        for tau in tau_grid:
                            tau = float(tau)
                            tp = fp = fn = 0
                            for (gt_u, pr_u, _det_p, _seg_p), fprob in zip(per_img, fused_ps):
                                if float(fprob) < tau:
                                    pr = np.zeros_like(gt_u, dtype=np.uint8)
                                else:
                                    pr = pr_u
                                a, b, c = accumulate_counts(gt_u, pr)
                                tp += a; fp += b; fn += c
                            m = compute_metrics(tp, fp, fn, beta=beta)
                            if m["f2"] > best["f2"]:
                                best = {
                                    "f2": float(m["f2"]),
                                    "precision": float(m["precision"]),
                                    "recall": float(m["recall"]),
                                    "f1": float(m["f1"]),
                                    "iou": float(m["iou"]),
                                    "score_thr": float(st),
                                    "mask_thr": float(mt),
                                    "w_det": float(w_det),
                                    "w_seg": float(w_seg),
                                    "bias": float(bias),
                                    "tau": float(tau),
                                }

    return best


# ============================================================
# Detector-informed sampling (training)
# ============================================================

def rank_by_detector(det_model: nn.Module, img_dir: str, ids: List[str],
                     det_img_size: int, device: torch.device,
                     score_all_limit: int, log_every: int = 200) -> List[Tuple[str, float]]:
    ids = list(ids)
    if score_all_limit > 0 and len(ids) > score_all_limit:
        ids_scoring = random.sample(ids, int(score_all_limit))
    else:
        ids_scoring = ids

    scored: List[Tuple[str, float]] = []
    for k, img_id in enumerate(ids_scoring):
        p = detector_prob_for_id(det_model, os.path.join(img_dir, img_id), det_img_size, device)
        scored.append((img_id, float(p)))
        if (k + 1) % int(max(1, log_every)) == 0:
            log(f"[det-rank] scored {k+1}/{len(ids_scoring)}")
    scored.sort(key=lambda x: x[1], reverse=True)
    return scored

def build_pos_rich_train_ids(candidates: List[str], scored: List[Tuple[str, float]],
                             train_n: int, pos_rich_frac: float) -> List[str]:
    candidates_set = set(candidates)
    scored_ids = [i for i, _p in scored if i in candidates_set]
    top_n = int(round(train_n * float(pos_rich_frac)))
    top_n = max(0, min(top_n, len(scored_ids), train_n))
    top = scored_ids[:top_n]

    remain_pool = list(candidates_set.difference(set(top)))
    random.shuffle(remain_pool)
    need = train_n - len(top)
    if need > 0:
        top += remain_pool[:need]
    random.shuffle(top)
    return top


# ============================================================
# Train / Eval
# ============================================================

def train_one_epoch(model: nn.Module, dl: DataLoader, device: torch.device,
                    optimizer: optim.Optimizer, epoch: int, log_every: int = 50) -> Dict[str, float]:
    model.train()
    running = []
    for step, (imgs, targets, _ids) in enumerate(dl, start=1):
        imgs = [x.to(device) for x in imgs]
        targets2 = []
        for t in targets:
            t2 = {}
            for k, v in t.items():
                if isinstance(v, torch.Tensor):
                    t2[k] = v.to(device)
                else:
                    t2[k] = v
            targets2.append(t2)

        loss_dict = model(imgs, targets2)
        losses = sum(loss for loss in loss_dict.values())

        if not torch.isfinite(losses):
            log(f"[TRAIN] non-finite loss at epoch={epoch} step={step} -> skip")
            optimizer.zero_grad(set_to_none=True)
            continue

        optimizer.zero_grad(set_to_none=True)
        losses.backward()
        optimizer.step()

        d = {k: float(v.item()) for k, v in loss_dict.items()}
        running.append(float(losses.item()))
        if step % int(max(1, log_every)) == 0:
            log(f"[TRAIN] epoch={epoch} step={step}/{len(dl)} loss={float(losses.item()):.6f} detail={d}")

    avg = float(np.mean(running)) if len(running) else 0.0
    return {"loss": avg}

@torch.no_grad()
def eval_joint_fusion_pixel_union(
    model: nn.Module,
    det_model: nn.Module,
    dl: DataLoader,
    img_dir: str,
    device: torch.device,
    det_img_size: int,
    score_thr: float,
    mask_thr: float,
    w_det: float,
    w_seg: float,
    bias: float,
    tau: float,
    limit: int,
    beta: float = 2.0,
) -> Dict[str, float]:
    model.eval()
    det_model.eval()
    tp = fp = fn = 0
    seen = 0
    for imgs, targets, ids in dl:
        for img_t, tgt, image_id in zip(imgs, targets, ids):
            H, W = img_t.shape[1], img_t.shape[2]
            gt_u = union_from_target(tgt, (H, W))

            out = infer_raw_outputs(model, img_t, device)
            scores_cpu = out["scores"].detach().cpu()
            mprob_cpu  = out["mask_probs"].detach().cpu()
            seg_p = seg_evidence_from_scores(scores_cpu)

            det_p = detector_prob_for_id(det_model, os.path.join(img_dir, image_id), det_img_size, device)
            fused_p = fuse_det_seg_prob(det_p, seg_p, w_det, w_seg, bias)

            if float(fused_p) < float(tau):
                pr_u = np.zeros((H, W), dtype=np.uint8)
            else:
                insts = insts_from_cached(scores_cpu, mprob_cpu, float(score_thr), float(mask_thr))
                pr_u = union_from_instances(insts, (H, W))

            a, b, c = accumulate_counts(gt_u, pr_u)
            tp += a; fp += b; fn += c
            seen += 1
            if seen >= int(limit):
                break
        if seen >= int(limit):
            break
    return compute_metrics(tp, fp, fn, beta=beta)


