def parse_csv_floats(s: str) -> List[float]:
    s2 = str(s).strip()
    if s2 == "":
        return []
    return [float(x.strip()) for x in s2.split(",") if x.strip() != ""]

def main():
    global LOG_FH
    args = build_argparser().parse_args()
    set_seed(args.seed)

    if ("cuda" in args.device) and (not torch.cuda.is_available()):
        device = torch.device("cpu")
    else:
        device = torch.device(args.device)

    data_dir = args.data_dir
    train_img_dir = os.path.join(data_dir, "train_v2")
    test_img_dir  = os.path.join(data_dir, "test_v2")
    train_csv = os.path.join(data_dir, "train_ship_segmentations_v2.csv")
    sample_sub = os.path.join(data_dir, "sample_submission_v2.csv")

    assert os.path.isdir(train_img_dir), f"missing: {train_img_dir}"
    assert os.path.isdir(test_img_dir),  f"missing: {test_img_dir}"
    assert os.path.isfile(train_csv),    f"missing: {train_csv}"
    assert os.path.isfile(sample_sub),   f"missing: {sample_sub}"

    run_name = f"run__maskrcnn_detfuse__seed{args.seed}__train{args.train_n}__val{args.val_n}__ptest{args.ptest_n}__pos{int(args.pos_frac*100)}__{int(time.time())}"
    run_dir = os.path.join(args.out_dir, run_name)
    ensure_dir(run_dir)

    LOG_FH = open(os.path.join(run_dir, "run.log"), "w", encoding="utf-8")

    log(f"[run] mode={args.mode}")
    log(f"[run] run_dir={run_dir}")
    log(f"[run] device={device}")
    log(f"[run] data_dir={data_dir}")

    id2rles = load_id2rles(train_csv)
    all_train_ids = list_image_ids(train_img_dir)
    all_test_ids = list_image_ids(test_img_dir)
    template_ids = read_template_ids(sample_sub)

    pos_set = set(id2rles.keys())
    pos_ids_all = [i for i in all_train_ids if i in pos_set]
    neg_ids_all = [i for i in all_train_ids if i not in pos_set]
    log(f"[data] train images={len(all_train_ids)} test images={len(all_test_ids)} pos_ids(csv)={len(pos_ids_all)} neg_ids={len(neg_ids_all)}")

    # split train/val/ptest with target pos_frac
    def sample_split(train_n: int, val_n: int, ptest_n: int, pos_frac: float) -> Dict[str, List[str]]:
        pos_frac = float(pos_frac)
        pos_n_train = int(round(train_n * pos_frac))
        neg_n_train = train_n - pos_n_train
        pos_n_val   = int(round(val_n * pos_frac))
        neg_n_val   = val_n - pos_n_val
        pos_n_pt    = int(round(ptest_n * pos_frac))
        neg_n_pt    = ptest_n - pos_n_pt

        pos_pool = pos_ids_all.copy()
        neg_pool = neg_ids_all.copy()
        random.shuffle(pos_pool)
        random.shuffle(neg_pool)

        def take(lst, n):
            out = lst[:n]
            del lst[:n]
            return out

        val = take(pos_pool, pos_n_val) + take(neg_pool, neg_n_val)
        ptest = take(pos_pool, pos_n_pt) + take(neg_pool, neg_n_pt)
        train = take(pos_pool, pos_n_train) + take(neg_pool, neg_n_train)

        random.shuffle(train); random.shuffle(val); random.shuffle(ptest)
        return {"train": train, "val": val, "ptest": ptest}

    splits = sample_split(args.train_n, args.val_n, args.ptest_n, args.pos_frac)
    save_json(os.path.join(run_dir, "splits.json"), splits)
    log(f"[split] train={len(splits['train'])} val={len(splits['val'])} ptest={len(splits['ptest'])} (disjoint)")

    # build detector
    det_model = EffNetV2Binary(variant=args.det_variant, pretrained_backbone=int(args.det_pretrained_backbone)).to(device)
    det_model.eval()
    load_ckpt_flexible(det_model, args.detector_ckpt, device)
    log(f"[det] loaded ckpt: {args.detector_ckpt}")

    # detector-informed sampling (pos-rich)
    train_ids = splits["train"]
    if int(args.use_detector_rank_train) == 1:
        log("[train-rank] enabled: building pos-rich train set via detector ranking")
        cand = splits["train"]
        scored = rank_by_detector(det_model, train_img_dir, cand, args.det_img_size, device,
                                  score_all_limit=args.train_rank_score_all_limit,
                                  log_every=max(50, int(args.log_every)))
        if len(scored) == 0:
            log("[train-rank] WARNING: scored empty. fallback to original split.")
        else:
            kshow = min(int(args.debug_rank_first_k), len(scored))
            log("[train-rank] top probs: " + ", ".join([f"{p:.3f}" for _i, p in scored[:min(10, kshow)]]))
            log("[train-rank] bot probs: " + ", ".join([f"{p:.3f}" for _i, p in scored[-min(10, kshow):]]))
            train_ids = build_pos_rich_train_ids(cand, scored, args.train_n, args.train_rank_pos_rich_frac)
            save_json(os.path.join(run_dir, "train_ranked.json"), [{"id": i, "p": p} for i, p in scored])
            save_json(os.path.join(run_dir, "train_ids_after_rank.json"), train_ids)
            log(f"[train-rank] built train_ids={len(train_ids)} pos_rich_frac={args.train_rank_pos_rich_frac}")

    # datasets
    ds_train = AirbusMaskRcnnDataset(train_img_dir, id2rles, train_ids,
                                    min_instance_area=args.min_instance_area,
                                    min_box_hw=args.min_box_hw,
                                    augment=1)
    ds_val = AirbusMaskRcnnDataset(train_img_dir, id2rles, splits["val"],
                                   min_instance_area=args.min_instance_area,
                                   min_box_hw=args.min_box_hw,
                                   augment=0)
    ds_ptest = AirbusMaskRcnnDataset(train_img_dir, id2rles, splits["ptest"],
                                     min_instance_area=args.min_instance_area,
                                     min_box_hw=args.min_box_hw,
                                     augment=0)

    dl_train = DataLoader(ds_train, batch_size=args.batch_train, shuffle=True,
                          num_workers=args.num_workers, pin_memory=True,
                          collate_fn=collate_fn)
    dl_val = DataLoader(ds_val, batch_size=args.batch_eval, shuffle=False,
                        num_workers=args.num_workers, pin_memory=True,
                        collate_fn=collate_fn)
    dl_ptest = DataLoader(ds_ptest, batch_size=args.batch_eval, shuffle=False,
                          num_workers=args.num_workers, pin_memory=True,
                          collate_fn=collate_fn)

    # model
    model = build_maskrcnn(num_classes=2,
                           pretrained_backbone=int(args.maskrcnn_pretrained_backbone),
                           init_min_size=int(args.train_size),
                           init_max_size=int(args.train_size)).to(device)
    optimizer = optim.AdamW(model.parameters(), lr=args.lr, weight_decay=args.weight_decay)

    ckpt_path = os.path.join(run_dir, "best_model.pt")
    meta_path = os.path.join(run_dir, "best_meta.json")

    best_f2 = -1.0
    best_epoch = -1
    best_joint = {
        "score_thr": 0.5,
        "mask_thr": 0.5,
        "w_det": 1.0,
        "w_seg": 1.0,
        "bias": 0.0,
        "tau": 0.5,
    }
    patience_left = int(args.patience)

    history = []

    # grids for joint tuning
    score_thrs = np.linspace(float(args.score_thr_min), float(args.score_thr_max), int(args.joint_tune_grid_n))
    mask_thrs  = np.linspace(float(args.mask_thr_min),  float(args.mask_thr_max),  int(args.joint_tune_grid_n))
    w_det_grid = parse_csv_floats(args.joint_tune_wdet)
    w_seg_grid = parse_csv_floats(args.joint_tune_wseg)
    bias_grid  = parse_csv_floats(args.joint_tune_bias)
    tau_grid   = parse_csv_floats(args.joint_tune_tau)

    if args.mode in ["train", "train_infer"]:
        set_maskrcnn_transform_size(model, int(args.train_size), int(args.train_size))
        log(f"[maskrcnn] train transform size: min=max={int(args.train_size)}")

        for epoch in range(int(args.max_epochs)):
            tr = train_one_epoch(model, dl_train, device, optimizer, epoch, log_every=int(args.log_every))

            # tune on infer_size to match deployment
            set_maskrcnn_transform_size(model, int(args.infer_size), int(args.infer_size))

            joint = tune_joint_fusion(
                model=model,
                det_model=det_model,
                dl=dl_val,
                img_dir=train_img_dir,
                device=device,
                det_img_size=int(args.det_img_size),
                score_thrs=score_thrs,
                mask_thrs=mask_thrs,
                w_det_grid=w_det_grid,
                w_seg_grid=w_seg_grid,
                bias_grid=bias_grid,
                tau_grid=tau_grid,
                limit=int(args.joint_tune_limit),
                beta=2.0
            )

            valm = eval_joint_fusion_pixel_union(
                model=model,
                det_model=det_model,
                dl=dl_val,
                img_dir=train_img_dir,
                device=device,
                det_img_size=int(args.det_img_size),
                score_thr=float(joint["score_thr"]),
                mask_thr=float(joint["mask_thr"]),
                w_det=float(joint["w_det"]),
                w_seg=float(joint["w_seg"]),
                bias=float(joint["bias"]),
                tau=float(joint["tau"]),
                limit=int(args.joint_tune_limit),
                beta=2.0
            )

            hist = {
                "epoch": int(epoch),
                "train_loss": float(tr["loss"]),
                "val_f2": float(valm["f2"]),
                "val_precision": float(valm["precision"]),
                "val_recall": float(valm["recall"]),
                "val_iou": float(valm["iou"]),
                "joint": joint
            }
            history.append(hist)
            save_json(os.path.join(run_dir, "history.json"), history)

            log(
                f"[VAL-JOINT] epoch={epoch} f2={valm['f2']:.6f} prec={valm['precision']:.4f} rec={valm['recall']:.4f} "
                f"iou={valm['iou']:.4f} "
                f"score_thr={joint['score_thr']:.3f} mask_thr={joint['mask_thr']:.3f} "
                f"w_det={joint['w_det']:.2f} w_seg={joint['w_seg']:.2f} bias={joint['bias']:.2f} tau={joint['tau']:.2f}"
            )

            if valm["f2"] > best_f2:
                best_f2 = float(valm["f2"])
                best_epoch = int(epoch)
                best_joint = {
                    "score_thr": float(joint["score_thr"]),
                    "mask_thr": float(joint["mask_thr"]),
                    "w_det": float(joint["w_det"]),
                    "w_seg": float(joint["w_seg"]),
                    "bias": float(joint["bias"]),
                    "tau": float(joint["tau"]),
                }
                torch.save(model.state_dict(), ckpt_path)
                save_json(meta_path, {"best_epoch": best_epoch, "best_val_f2": best_f2, **best_joint})
                log(f"[CKPT] saved best_model.pt (epoch={best_epoch}, f2={best_f2:.6f})")
                patience_left = int(args.patience)
            else:
                patience_left -= 1
                log(f"[ES] no improve. patience_left={patience_left}/{args.patience}")
                if patience_left <= 0:
                    log("[ES] early stop")
                    break

            # back to train size
            set_maskrcnn_transform_size(model, int(args.train_size), int(args.train_size))

        # load best
        if os.path.isfile(ckpt_path):
            model.load_state_dict(torch.load(ckpt_path, map_location=device))
            log("[CKPT] loaded best_model.pt for evaluation/inference")
        if os.path.isfile(meta_path):
            meta = load_json(meta_path)
            best_joint = {
                "score_thr": float(meta.get("score_thr", best_joint["score_thr"])),
                "mask_thr": float(meta.get("mask_thr", best_joint["mask_thr"])),
                "w_det": float(meta.get("w_det", best_joint["w_det"])),
                "w_seg": float(meta.get("w_seg", best_joint["w_seg"])),
                "bias": float(meta.get("bias", best_joint["bias"])),
                "tau": float(meta.get("tau", best_joint["tau"])),
            }
            best_f2 = float(meta.get("best_val_f2", best_f2))
            best_epoch = int(meta.get("best_epoch", best_epoch))

    else:
        # infer-only
        assert os.path.isfile(ckpt_path), f"missing ckpt: {ckpt_path}"
        model.load_state_dict(torch.load(ckpt_path, map_location=device))
        if os.path.isfile(meta_path):
            meta = load_json(meta_path)
            best_joint = {
                "score_thr": float(meta.get("score_thr", 0.5)),
                "mask_thr": float(meta.get("mask_thr", 0.5)),
                "w_det": float(meta.get("w_det", 1.0)),
                "w_seg": float(meta.get("w_seg", 1.0)),
                "bias": float(meta.get("bias", 0.0)),
                "tau": float(meta.get("tau", 0.5)),
            }
        log("[infer] loaded ckpt/meta")

    # inference size
    set_maskrcnn_transform_size(model, int(args.infer_size), int(args.infer_size))
    log(f"[maskrcnn] infer transform size: min=max={int(args.infer_size)}")

    log(
        f"[best] epoch={best_epoch} best_val_f2={best_f2:.6f} "
        f"score_thr={best_joint['score_thr']:.3f} mask_thr={best_joint['mask_thr']:.3f} "
        f"w_det={best_joint['w_det']:.2f} w_seg={best_joint['w_seg']:.2f} bias={best_joint['bias']:.2f} tau={best_joint['tau']:.2f}"
    )

    # ptest eval
    ptest_metrics = eval_joint_fusion_pixel_union(
        model=model,
        det_model=det_model,
        dl=dl_ptest,
        img_dir=train_img_dir,
        device=device,
        det_img_size=int(args.det_img_size),
        score_thr=float(best_joint["score_thr"]),
        mask_thr=float(best_joint["mask_thr"]),
        w_det=float(best_joint["w_det"]),
        w_seg=float(best_joint["w_seg"]),
        bias=float(best_joint["bias"]),
        tau=float(best_joint["tau"]),
        limit=int(args.ptest_n),
        beta=2.0
    )
    log(f"[PTEST-JOINT] pixel F2={ptest_metrics['f2']:.6f} prec={ptest_metrics['precision']:.4f} rec={ptest_metrics['recall']:.4f} iou={ptest_metrics['iou']:.4f}")

    # Kaggle test inference + submission
    if args.mode in ["infer", "train_infer"]:
        id2inst: Dict[str, List[np.ndarray]] = {}

        log(f"[infer] start kaggle test inference (template_n={len(template_ids)})")
        n_pos_written = 0

        for k, img_id in enumerate(template_ids):
            img_path = os.path.join(test_img_dir, img_id)
            if not os.path.isfile(img_path):
                id2inst[img_id] = []
                continue

            try:
                img = Image.open(img_path).convert("RGB")
            except Exception:
                id2inst[img_id] = []
                continue

            img_t = img_to_tensor01(img)  # no resize here

            # detector prob
            det_p = detector_prob_for_id(det_model, img_path, int(args.det_img_size), device)

            # maskrcnn outputs
            out = infer_raw_outputs(model, img_t, device)
            scores_cpu = out["scores"].detach().cpu()
            mprob_cpu  = out["mask_probs"].detach().cpu()
            seg_p = seg_evidence_from_scores(scores_cpu)

            fused_p = fuse_det_seg_prob(
                det_p=det_p,
                seg_p=seg_p,
                w_det=float(best_joint["w_det"]),
                w_seg=float(best_joint["w_seg"]),
                bias=float(best_joint["bias"])
            )

            if float(fused_p) < float(best_joint["tau"]):
                id2inst[img_id] = []
            else:
                insts = insts_from_cached(
                    scores_cpu,
                    mprob_cpu,
                    float(best_joint["score_thr"]),
                    float(best_joint["mask_thr"])
                )
                id2inst[img_id] = insts
                if len(insts) > 0:
                    n_pos_written += 1

            if (k + 1) % 500 == 0:
                log(f"[infer] done {k+1}/{len(template_ids)} pos_images={n_pos_written}")

        sub_path = os.path.join(run_dir, "submission.csv")
        n_images, n_inst_rows = write_submission_instance_rows(sub_path, template_ids, id2inst)
        log(f"[submit] wrote: {sub_path} images={n_images} inst_rows={n_inst_rows}")

        summary = {
            "run_dir": run_dir,
            "best_epoch": int(best_epoch),
            "best_val_f2": float(best_f2),
            "best_joint": best_joint,
            "ptest_pixel_metrics_joint": ptest_metrics,
            "infer_template_n": int(len(template_ids)),
            "infer_pos_images": int(n_pos_written),
            "submission": sub_path,
        }
        save_json(os.path.join(run_dir, "summary.json"), summary)
        log("[done] summary.json saved")

    if LOG_FH is not None:
        try:
            LOG_FH.close()
        except Exception:
            pass

if __name__ == "__main__":
    main()
