# Sampling / splitting
# -------------------------
def stratified_sample_ids(all_ids: List[str], pos_ids: List[str], n: int, pos_frac: float, seed: int) -> List[str]:
    rnd = random.Random(seed)
    pos_set = set(pos_ids)
    neg_ids = [i for i in all_ids if i not in pos_set]

    n_pos = int(round(n * pos_frac))
    n_neg = n - n_pos
    n_pos = min(n_pos, len(pos_ids))
    n_neg = min(n_neg, len(neg_ids))

    samp_pos = rnd.sample(pos_ids, n_pos) if n_pos > 0 else []
    samp_neg = rnd.sample(neg_ids, n_neg) if n_neg > 0 else []
    out = samp_pos + samp_neg
    rnd.shuffle(out)
    return out


def split_ids(ids: List[str], r_train: float, r_calib: float, r_ptest: float, seed: int) -> Dict[str, List[str]]:
    assert abs((r_train + r_calib + r_ptest) - 1.0) < 1e-6
    rnd = random.Random(seed)
    ids2 = ids[:]
    rnd.shuffle(ids2)
    n = len(ids2)
    n_train = int(round(n * r_train))
    n_calib = int(round(n * r_calib))
    n_train = min(n_train, n)
    n_calib = min(n_calib, n - n_train)
    n_ptest = n - n_train - n_calib
    return {
        "train": ids2[:n_train],
        "calib": ids2[n_train:n_train + n_calib],
        "ptest": ids2[n_train + n_calib:],
    }


