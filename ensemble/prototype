def read_sample_submission_order(sample_csv_path: str) -> List[str]:
    order: List[str] = []
    with open(sample_csv_path, "r", encoding="utf-8", newline="") as f:
        r = csv.DictReader(f)
        if "ImageId" not in (r.fieldnames or []):
            raise ValueError(f"sample_submission missing ImageId header: {sample_csv_path}")
        for row in r:
            img_id = (row.get("ImageId") or "").strip()
            if img_id:
                order.append(img_id)
    return order


def build_id2rles(train_csv_path: str) -> Dict[str, List[str]]:
    id2r: Dict[str, List[str]] = {}
    with open(train_csv_path, "r", encoding="utf-8", newline="") as f:
        r = csv.DictReader(f)
        if "ImageId" not in (r.fieldnames or []) or "EncodedPixels" not in (r.fieldnames or []):
            raise ValueError(f"train_csv headers invalid (need ImageId,EncodedPixels): {train_csv_path}")
        for row in r:
            img_id = (row.get("ImageId") or "").strip()
            enc = row.get("EncodedPixels")
            enc = (enc or "").strip()
            if img_id not in id2r:
                id2r[img_id] = []
            if enc != "":
                id2r[img_id].append(enc)
    return id2r


