def parse_args():
    ap = argparse.ArgumentParser()

    ap.add_argument("--data_dir", type=str, required=True)
    ap.add_argument("--zoo_dir", type=str, required=True)
    ap.add_argument("--run_dir", type=str, required=True)

    ap.add_argument("--train_csv", type=str, default="")
    ap.add_argument("--sample_csv", type=str, default="")
    ap.add_argument("--train_dir", type=str, default="")
    ap.add_argument("--test_dir", type=str, default="")

    ap.add_argument("--detector_arch", type=str, default="efficientnet_v2_s")
    ap.add_argument("--sem_arch", type=str, default="deeplabv3_resnet50")
    ap.add_argument("--inst_arch", type=str, default="maskrcnn_resnet50_fpn")

    ap.add_argument("--det_models", type=str, default="")
    ap.add_argument("--sem_models", type=str, default="")
    ap.add_argument("--inst_models", type=str, default="")

    # Compatibility filter
    ap.add_argument("--compat_strict", type=int, default=1, help="1: keep only ckpts with missing=0 & unexpected=0")
    ap.add_argument("--max_det_models", type=int, default=3)
    ap.add_argument("--max_sem_models", type=int, default=8)
    ap.add_argument("--max_inst_models", type=int, default=3)

    # Sampling for tree training
    ap.add_argument("--n_images", type=int, default=10000)
    ap.add_argument("--pos_frac", type=float, default=0.40)
    ap.add_argument("--split_train", type=float, default=0.70)
    ap.add_argument("--split_calib", type=float, default=0.15)
    ap.add_argument("--split_ptest", type=float, default=0.15)
    ap.add_argument("--seed", type=int, default=42)

    # Inference
    ap.add_argument("--infer_size", type=int, default=768)
    ap.add_argument("--tta_hflip", type=int, default=1)
    ap.add_argument("--tta_vflip", type=int, default=0)

    # Detector gate thresholds
    ap.add_argument("--det_t_low", type=float, default=0.002)
    ap.add_argument("--det_t_high", type=float, default=0.01)

    # Sem/Inst thresholds by gate
    ap.add_argument("--sem_thr_low", type=float, default=0.07)
    ap.add_argument("--sem_thr_mid", type=float, default=0.10)
    ap.add_argument("--sem_thr_high", type=float, default=0.13)

    ap.add_argument("--inst_score_thr_low", type=float, default=0.10)
    ap.add_argument("--inst_score_thr_mid", type=float, default=0.20)
    ap.add_argument("--inst_score_thr_high", type=float, default=0.30)

    ap.add_argument("--inst_mask_thr", type=float, default=0.50)
    ap.add_argument("--inst_min_area", type=int, default=40)

    # Sem CC candidates
    ap.add_argument("--sem_cc_min_area", type=int, default=60)
    ap.add_argument("--sem_cc_topk", type=int, default=20)
    ap.add_argument("--sem_cc_score_scale", type=float, default=1.0)

    # Final constraints
    ap.add_argument("--final_min_area", type=int, default=50)
    ap.add_argument("--max_inst_low", type=int, default=30)
    ap.add_argument("--max_inst_mid", type=int, default=20)
    ap.add_argument("--max_inst_high", type=int, default=12)

    # Candidate labeling / evaluation
    ap.add_argument("--match_iou_thr", type=float, default=0.30)
    ap.add_argument("--eval_iou", type=float, default=0.50)
    ap.add_argument("--beta", type=float, default=2.0)

    # Negative subsampling
    ap.add_argument("--max_neg_per_image", type=int, default=50)

    # Threshold search for tree proba
    ap.add_argument("--thr_grid_n", type=int, default=41)

    # Logging intervals
    ap.add_argument("--log_every_train_imgs", type=int, default=200)
    ap.add_argument("--log_every_calib_imgs", type=int, default=100)
    ap.add_argument("--log_every_test_imgs", type=int, default=200)

    # Output
    ap.add_argument("--submit_name", type=str, default="submission_tree.csv")

    return ap.parse_args()


def resolve_dataset_paths(args) -> Tuple[str, str, str, str]:
    train_csv = args.train_csv.strip() if args.train_csv.strip() else ""
    sample_csv = args.sample_csv.strip() if args.sample_csv.strip() else ""
    train_dir = args.train_dir.strip() if args.train_dir.strip() else ""
    test_dir = args.test_dir.strip() if args.test_dir.strip() else ""

    cur = os.path.abspath(args.data_dir)
    roots = [cur, os.path.dirname(cur), os.path.dirname(os.path.dirname(cur))]

    def pick_file(name: str) -> str:
        for r in roots:
            cand = os.path.join(r, name)
            if os.path.isfile(cand):
                return cand
        return ""

    def pick_dir(name: str) -> str:
        for r in roots:
            cand = os.path.join(r, name)
            if os.path.isdir(cand):
                return cand
        return ""

    if not train_csv:
        train_csv = pick_file("train_ship_segmentations_v2.csv")
    if not sample_csv:
        sample_csv = pick_file("sample_submission_v2.csv")
    if not train_dir:
        train_dir = pick_dir("train_v2")
    if not test_dir:
        test_dir = pick_dir("test_v2")

    missing = []
    if not (train_csv and os.path.isfile(train_csv)):
        missing.append("train_ship_segmentations_v2.csv")
    if not (sample_csv and os.path.isfile(sample_csv)):
        missing.append("sample_submission_v2.csv")
    if not (train_dir and os.path.isdir(train_dir)):
        missing.append("train_v2/")
    if not (test_dir and os.path.isdir(test_dir)):
        missing.append("test_v2/")

    if missing:
        msg = (
            "Dataset path resolution failed. Missing: " + ", ".join(missing) + "\n"
            f"  data_dir={args.data_dir}\n"
            f"  tried_roots={roots}\n"
            f"  resolved train_csv={train_csv}\n"
            f"  resolved sample_csv={sample_csv}\n"
            f"  resolved train_dir={train_dir}\n"
            f"  resolved test_dir={test_dir}\n"
            "Fix: pass explicit --train_csv/--sample_csv/--train_dir/--test_dir or set correct --data_dir."
        )
        raise AssertionError(msg)

    return train_csv, sample_csv, train_dir, test_dir


def main():
    args = parse_args()

    if HistGradientBoostingClassifier is None:
        raise RuntimeError(
            "scikit-learn is missing or broken. Install/repair it first.\n"
            "Example: python3 -m pip install -U scikit-learn"
        )

    set_seed(args.seed)
    ensure_dir(args.run_dir)

    log_path = os.path.join(args.run_dir, "log_global.txt")
    with open(log_path, "w", encoding="utf-8") as fp:
        log("=== infer_fusion_tree_3way_strictcache_nopandas START ===", fp)
        log(f"data_dir={args.data_dir}", fp)
        log(f"zoo_dir={args.zoo_dir}", fp)
        log(f"run_dir={args.run_dir}", fp)
        log(f"cuda_visible={os.environ.get('CUDA_VISIBLE_DEVICES','')}", fp)
        log(f"torch={torch.__version__} torchvision={torchvision.__version__}", fp)
        log(f"cv2={_HAS_CV2} scipy={_HAS_SCIPY}", fp)
        log(f"compat_strict={args.compat_strict}", fp)

        train_csv, sample_csv, train_dir, test_dir = resolve_dataset_paths(args)
        log(f"resolved train_csv={train_csv}", fp)
        log(f"resolved sample_csv={sample_csv}", fp)
        log(f"resolved train_dir={train_dir}", fp)
        log(f"resolved test_dir={test_dir}", fp)

        train_map = list_images_in_dir(train_dir)
        test_map = list_images_in_dir(test_dir)
        test_order = read_sample_submission_order(sample_csv)
        log(f"train_images={len(train_map)} test_images={len(test_map)} template_rows={len(test_order)}", fp)

        id2rles = build_id2rles(train_csv)
        pos_ids = sorted([k for k, v in id2rles.items() if len(v) > 0])
        all_train_ids = sorted(list(train_map.keys()))
        log(f"pos_ids_from_csv={len(pos_ids)} all_train_ids_from_dir={len(all_train_ids)}", fp)

        sampled = stratified_sample_ids(all_train_ids, pos_ids, args.n_images, args.pos_frac, args.seed)
        splits = split_ids(sampled, args.split_train, args.split_calib, args.split_ptest, args.seed)

        with open(os.path.join(args.run_dir, "splits.json"), "w", encoding="utf-8") as f:
            json.dump(splits, f, ensure_ascii=False, indent=2)
        log(f"sampled={len(sampled)} | train={len(splits['train'])} calib={len(splits['calib'])} ptest={len(splits['ptest'])}", fp)

        # Candidate model paths (explicit > auto)
        det_paths_all = [p.strip() for p in args.det_models.split(",") if p.strip()] if args.det_models else auto_select_models(args.zoo_dir, "det")
        sem_paths_all = [p.strip() for p in args.sem_models.split(",") if p.strip()] if args.sem_models else auto_select_models(args.zoo_dir, "sem")
        inst_paths_all = [p.strip() for p in args.inst_models.split(",") if p.strip()] if args.inst_models else auto_select_models(args.zoo_dir, "inst")

        log(f"det_paths_all={len(det_paths_all)} sem_paths_all={len(sem_paths_all)} inst_paths_all={len(inst_paths_all)}", fp)

        device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
        log(f"device={device}", fp)

        strict_compat = bool(args.compat_strict)

        # Filter compatible checkpoints BEFORE building final models
        det_paths, det_reports = filter_compatible_checkpoints(
            det_paths_all,
            builder_fn=lambda: build_detector(args.detector_arch),
            device=device,
            strict_compat=strict_compat,
            fp=fp,
            max_models=args.max_det_models,
            tag="DET_CKPT",
        )
        sem_paths, sem_reports = filter_compatible_checkpoints(
            sem_paths_all,
            builder_fn=lambda: build_semseg(args.sem_arch),
            device=device,
            strict_compat=strict_compat,
            fp=fp,
            max_models=args.max_sem_models,
            tag="SEM_CKPT",
        )
        inst_paths, inst_reports = filter_compatible_checkpoints(
            inst_paths_all,
            builder_fn=lambda: build_instseg(args.inst_arch),
            device=device,
            strict_compat=strict_compat,
            fp=fp,
            max_models=args.max_inst_models,
            tag="INS_CKPT",
        )

        log(f"kept det_paths={len(det_paths)} sem_paths={len(sem_paths)} inst_paths={len(inst_paths)}", fp)

        # Build and load final models (now safe: compatible)
        det_models: List[nn.Module] = []
        for p in det_paths:
            m = build_detector(args.detector_arch)
            ok, msg, mc, uc = load_state_dict_with_report(m, p, strict=False)
            if ok:
                det_models.append(m.to(device))
            log(f"[DET] {msg}", fp)

        sem_models: List[nn.Module] = []
        for p in sem_paths:
            m = build_semseg(args.sem_arch)
            ok, msg, mc, uc = load_state_dict_with_report(m, p, strict=False)
            if ok:
                sem_models.append(m.to(device))
            log(f"[SEM] {msg}", fp)

        inst_models: List[nn.Module] = []
        for p in inst_paths:
            m = build_instseg(args.inst_arch)
            ok, msg, mc, uc = load_state_dict_with_report(m, p, strict=False)
            if ok:
                inst_models.append(m.to(device))
            log(f"[INS] {msg}", fp)

        if len(sem_models) == 0:
            raise RuntimeError(
                "sem_models is empty after compatibility filtering.\n"
                "Fix: provide a correct --sem_models path matching torchvision deeplabv3_* with num_classes=1."
            )
        if len(det_models) == 0:
            log("WARNING: det_models empty: p_det=0.0 will be used (gate fixed to lvl=0).", fp)
        if len(inst_models) == 0:
            log("WARNING: inst_models empty: only semCC candidates will be used.", fp)

        # -----------------------------------------
        # Helper: process one image (inference + GT)
        # -----------------------------------------
        def process_one_image(img_path: str, img_id: str, is_train: bool) -> Tuple[List[np.ndarray], List[float], List[np.ndarray], float, int, np.ndarray]:
            pil0 = pil_open_rgb(img_path)
            orig_w, orig_h = pil0.size  # (W,H)
            pil = pil0.resize((args.infer_size, args.infer_size), resample=Image.BILINEAR)

            x_norm = to_tensor_imagenet_norm(pil).unsqueeze(0).to(device)
            x_det  = to_tensor_01(pil).to(device)

            p_det = infer_detector_ensemble(det_models, x_norm, bool(args.tta_hflip), bool(args.tta_vflip)) if det_models else 0.0
            lvl = gate_level(p_det, args.det_t_low, args.det_t_high)

            P_sem = infer_semseg_ensemble(sem_models, x_norm, bool(args.tta_hflip), bool(args.tta_vflip))

            sem_thr = choose_by_gate(lvl, args.sem_thr_low, args.sem_thr_mid, args.sem_thr_high)
            inst_score_thr = choose_by_gate(lvl, args.inst_score_thr_low, args.inst_score_thr_mid, args.inst_score_thr_high)

            inst_cand = infer_instseg_ensemble(
                inst_models, x_det,
                score_thr=inst_score_thr,
                mask_thr=args.inst_mask_thr,
                min_area=args.inst_min_area,
                tta_hflip=bool(args.tta_hflip),
                tta_vflip=bool(args.tta_vflip),
            ) if inst_models else []

            sem_cc = build_sem_cc_candidates(P_sem, sem_thr, args.sem_cc_min_area, args.sem_cc_topk, args.sem_cc_score_scale)

            pred_masks: List[np.ndarray] = []
            pred_scores: List[float] = []
            for c in inst_cand:
                pred_masks.append(c["mask"].astype(bool))
                pred_scores.append(float(c["score"]))
            for c in sem_cc:
                pred_masks.append(c["mask"].astype(bool))
                pred_scores.append(float(c["score"]))

            gt_masks: List[np.ndarray] = []
            if is_train:
                gt_rles = id2rles.get(img_id, [])
                for rle in gt_rles:
                    gm = rle_decode_airbus(rle, (orig_h, orig_w))  # (H,W)
                    if gm.shape[0] != args.infer_size or gm.shape[1] != args.infer_size:
                        gm_pil = Image.fromarray((gm * 255).astype(np.uint8)).resize((args.infer_size, args.infer_size), resample=Image.NEAREST)
                        gm = (np.array(gm_pil) > 127).astype(np.uint8)
                    gt_masks.append(gm.astype(bool))

            return pred_masks, pred_scores, gt_masks, float(p_det), int(lvl), P_sem

        def label_candidates(pred_masks: List[np.ndarray], gt_masks: List[np.ndarray], thr: float) -> List[int]:
            if len(gt_masks) == 0:
                return [0] * len(pred_masks)
            y: List[int] = []
            for pm in pred_masks:
                best = 0.0
                for gm in gt_masks:
                    v = iou_mask(pm, gm)
                    if v > best:
                        best = v
                y.append(1 if best >= thr else 0)
            return y

        # -----------------------------------------
        # Build training samples for tree
        # -----------------------------------------
        X_train: List[np.ndarray] = []
        y_train: List[int] = []

        log("Building tree training samples...", fp)
        for i, img_id in enumerate(splits["train"]):
            img_path = train_map[img_id]
            pred_masks, pred_scores, gt_masks, p_det, lvl, P_sem = process_one_image(img_path, img_id, is_train=True)
            y = label_candidates(pred_masks, gt_masks, args.match_iou_thr)

            pos_idx = [k for k, yy in enumerate(y) if yy == 1]
            neg_idx = [k for k, yy in enumerate(y) if yy == 0]
            if len(neg_idx) > args.max_neg_per_image:
                neg_idx = random.sample(neg_idx, args.max_neg_per_image)
            use_idx = pos_idx + neg_idx

            for k in use_idx:
                feats = extract_features_for_candidate(pred_masks[k], pred_scores[k], p_det, lvl, P_sem)
                X_train.append(feats)
                y_train.append(int(y[k]))

            if (i + 1) % args.log_every_train_imgs == 0:
                log(f"tree_train progress {i+1}/{len(splits['train'])} | X={len(X_train)}", fp)

        if len(X_train) == 0:
            raise RuntimeError("No training samples collected. Check candidate generation thresholds and model loading.")

        X_train_np = np.stack(X_train, 0)
        y_train_np = np.asarray(y_train, dtype=np.int32)
        log(f"Tree train samples: X={X_train_np.shape} y_pos={int(y_train_np.sum())} y_neg={int((y_train_np==0).sum())}", fp)

        # Train tree
        log("Training HistGradientBoostingClassifier...", fp)
        tree = HistGradientBoostingClassifier(
            max_depth=6,
            learning_rate=0.08,
            max_iter=300,
            random_state=args.seed,
        )
        tree.fit(X_train_np, y_train_np)
        log("Tree trained.", fp)

        tree_path = os.path.join(args.run_dir, "tree_model.pkl")
        with open(tree_path, "wb") as f:
            pickle.dump(tree, f)
        log(f"Saved tree: {tree_path}", fp)

        # -----------------------------------------
        # Calibration cache (NO re-inference per threshold)
        # -----------------------------------------
        log("Building calibration cache (single-pass inference + proba)...", fp)
        calib_cache_path = os.path.join(args.run_dir, "calib_cache_preview.json")

        calib_items: List[Dict[str, Any]] = []
        t0_cache = time.time()
        for ii, img_id in enumerate(splits["calib"]):
            img_path = train_map[img_id]
            pred_masks, pred_scores, gt_masks, p_det, lvl, P_sem = process_one_image(img_path, img_id, is_train=True)

            # build feats for all candidates, get proba once
            feats_list: List[np.ndarray] = []
            for pm, sc in zip(pred_masks, pred_scores):
                feats_list.append(extract_features_for_candidate(pm, sc, p_det, lvl, P_sem))

            if len(feats_list) > 0:
                Xc = np.stack(feats_list, 0)
                proba = tree.predict_proba(Xc)[:, 1].astype(np.float32)
            else:
                proba = np.zeros((0,), dtype=np.float32)

            # pack masks to bytes for memory efficiency
            H = W = args.infer_size
            cand_packed: List[bytes] = [pack_bool_mask(pm) for pm in pred_masks]
            gt_packed: List[bytes] = [pack_bool_mask(gm) for gm in gt_masks]

            calib_items.append({
                "img_id": img_id,
                "shape": (H, W),
                "cand_proba": proba,                 # np.float32
                "cand_masks_packed": cand_packed,    # list[bytes]
                "gt_masks_packed": gt_packed,        # list[bytes]
            })

            if (ii + 1) % args.log_every_calib_imgs == 0:
                log(f"calib_cache {ii+1}/{len(splits['calib'])} elapsed={(time.time()-t0_cache)/60:.1f}m", fp)

        # tiny preview file (not storing bytes) to confirm cache size
        try:
            preview = {
                "n_items": len(calib_items),
                "avg_cands": float(np.mean([len(it["cand_proba"]) for it in calib_items])) if calib_items else 0.0,
                "avg_gt": float(np.mean([len(it["gt_masks_packed"]) for it in calib_items])) if calib_items else 0.0,
            }
            with open(calib_cache_path, "w", encoding="utf-8") as f:
                json.dump(preview, f, ensure_ascii=False, indent=2)
            log(f"Wrote calib cache preview: {calib_cache_path} {preview}", fp)
        except Exception as e:
            log(f"WARNING: failed to write cache preview: {repr(e)}", fp)

        # -----------------------------------------
        # Calibrate threshold on calib split (instance-level F2), using cache
        # -----------------------------------------
        log("Calibrating threshold on calib cache...", fp)
        thr_grid = np.linspace(0.01, 0.99, args.thr_grid_n).tolist()
        best_thr = 0.50
        best_f2 = -1.0
        best_info = None

        t0_cal = time.time()
        for ti, thr in enumerate(thr_grid):
            all_tp = all_fp = all_fn = 0
            for ii, it in enumerate(calib_items):
                H, W = it["shape"]
                proba: np.ndarray = it["cand_proba"]
                cand_packed: List[bytes] = it["cand_masks_packed"]
                gt_packed: List[bytes] = it["gt_masks_packed"]

                gt_masks = [unpack_bool_mask(b, (H, W)) for b in gt_packed]
                if proba.shape[0] == 0:
                    all_fn += len(gt_masks)
                    continue

                keep_idx = [k for k, p in enumerate(proba.tolist()) if float(p) >= float(thr)]
                if len(keep_idx) == 0:
                    all_fn += len(gt_masks)
                    continue

                keep_masks = [unpack_bool_mask(cand_packed[k], (H, W)) for k in keep_idx]
                keep_scores = [float(proba[k]) for k in keep_idx]

                _, info = greedy_match_f2(keep_masks, keep_scores, gt_masks, score_thr=0.0, iou_thr=args.eval_iou, beta=args.beta)
                all_tp += int(info["tp"])
                all_fp += int(info["fp"])
                all_fn += int(info["fn"])

                if (ii + 1) % args.log_every_calib_imgs == 0 and ti in (0, len(thr_grid)//2, len(thr_grid)-1):
                    log(f"calib_scan thr[{ti+1}/{len(thr_grid)}]={thr:.3f} img[{ii+1}/{len(calib_items)}] tp={all_tp} fp={all_fp} fn={all_fn}", fp)

            prec = all_tp / (all_tp + all_fp + 1e-9)
            rec  = all_tp / (all_tp + all_fn + 1e-9)
            b2 = args.beta * args.beta
            f2_all = (1 + b2) * prec * rec / (b2 * prec + rec + 1e-9)

            if float(f2_all) > float(best_f2):
                best_f2 = float(f2_all)
                best_thr = float(thr)
                best_info = {"tp": all_tp, "fp": all_fp, "fn": all_fn, "precision": prec, "recall": rec}

            if (ti + 1) % max(1, len(thr_grid)//8) == 0:
                log(f"calib_thr_progress {ti+1}/{len(thr_grid)} best_thr={best_thr:.3f} best_f2={best_f2:.6f} elapsed={(time.time()-t0_cal)/60:.1f}m", fp)

        log(f"Best tree_thr={best_thr:.4f} best_f2={best_f2:.6f} info={best_info}", fp)

        # -----------------------------------------
        # Pseudo-test evaluation (single pass; with logs)
        # -----------------------------------------
        log("Pseudo-test evaluation...", fp)
        t0_pt = time.time()
        all_tp = all_fp = all_fn = 0
        for ii, img_id in enumerate(splits["ptest"]):
            img_path = train_map[img_id]
            pred_masks, pred_scores, gt_masks, p_det, lvl, P_sem = process_one_image(img_path, img_id, is_train=True)

            feats_list: List[np.ndarray] = []
            for pm, sc in zip(pred_masks, pred_scores):
                feats_list.append(extract_features_for_candidate(pm, sc, p_det, lvl, P_sem))

            if len(feats_list) == 0:
                all_fn += len(gt_masks)
            else:
                Xc = np.stack(feats_list, 0)
                proba = tree.predict_proba(Xc)[:, 1]
                keep_idx = [k for k, p in enumerate(proba) if float(p) >= float(best_thr)]
                keep_masks = [pred_masks[k] for k in keep_idx]
                keep_scores = [float(proba[k]) for k in keep_idx]
                _, info = greedy_match_f2(keep_masks, keep_scores, gt_masks, score_thr=0.0, iou_thr=args.eval_iou, beta=args.beta)
                all_tp += int(info["tp"]); all_fp += int(info["fp"]); all_fn += int(info["fn"])

            if (ii + 1) % args.log_every_calib_imgs == 0:
                log(f"ptest {ii+1}/{len(splits['ptest'])} tp={all_tp} fp={all_fp} fn={all_fn} elapsed={(time.time()-t0_pt)/60:.1f}m", fp)

        prec = all_tp / (all_tp + all_fp + 1e-9)
        rec  = all_tp / (all_tp + all_fn + 1e-9)
        b2 = args.beta * args.beta
        f2_ptest = (1 + b2) * prec * rec / (b2 * prec + rec + 1e-9)
        log(f"Pseudo-test: f2={f2_ptest:.6f} precision={prec:.6f} recall={rec:.6f} tp={all_tp} fp={all_fp} fn={all_fn}", fp)

        # -----------------------------------------
        # Test inference -> submission
        # -----------------------------------------
        log("Running test inference and building submission...", fp)
        out_rows: List[Tuple[str, str]] = []
        shipless = 0
        inst_rows = 0
        t0_test = time.time()

        for idx, img_id in enumerate(test_order):
            if img_id not in test_map:
                out_rows.append((img_id, ""))
                shipless += 1
                continue

            pil0 = pil_open_rgb(test_map[img_id])
            pil = pil0.resize((args.infer_size, args.infer_size), resample=Image.BILINEAR)

            x_norm = to_tensor_imagenet_norm(pil).unsqueeze(0).to(device)
            x_det  = to_tensor_01(pil).to(device)

            p_det = infer_detector_ensemble(det_models, x_norm, bool(args.tta_hflip), bool(args.tta_vflip)) if det_models else 0.0
            lvl = gate_level(p_det, args.det_t_low, args.det_t_high)

            P_sem = infer_semseg_ensemble(sem_models, x_norm, bool(args.tta_hflip), bool(args.tta_vflip))

            sem_thr = choose_by_gate(lvl, args.sem_thr_low, args.sem_thr_mid, args.sem_thr_high)
            inst_score_thr = choose_by_gate(lvl, args.inst_score_thr_low, args.inst_score_thr_mid, args.inst_score_thr_high)
            max_inst = choose_int_by_gate(lvl, args.max_inst_low, args.max_inst_mid, args.max_inst_high)

            inst_cand = infer_instseg_ensemble(
                inst_models, x_det,
                score_thr=inst_score_thr,
                mask_thr=args.inst_mask_thr,
                min_area=args.inst_min_area,
                tta_hflip=bool(args.tta_hflip),
                tta_vflip=bool(args.tta_vflip),
            ) if inst_models else []

            sem_cc = build_sem_cc_candidates(P_sem, sem_thr, args.sem_cc_min_area, args.sem_cc_topk, args.sem_cc_score_scale)

            pred_masks = [c["mask"].astype(bool) for c in inst_cand] + [c["mask"].astype(bool) for c in sem_cc]
            pred_scores = [float(c["score"]) for c in inst_cand] + [float(c["score"]) for c in sem_cc]

            if len(pred_masks) == 0:
                out_rows.append((img_id, ""))
                shipless += 1
                continue

            feats: List[np.ndarray] = []
            for pm, sc in zip(pred_masks, pred_scores):
                feats.append(extract_features_for_candidate(pm, sc, p_det, lvl, P_sem))
            X = np.stack(feats, 0)
            proba = tree.predict_proba(X)[:, 1]

            keep: List[Tuple[float, np.ndarray]] = []
            for pm, pb in zip(pred_masks, proba):
                if float(pb) >= float(best_thr):
                    keep.append((float(pb), pm))
            keep.sort(key=lambda x: x[0], reverse=True)

            final_masks = enforce_non_overlap(keep, min_area=args.final_min_area, max_inst=max_inst)

            if len(final_masks) == 0:
                out_rows.append((img_id, ""))
                shipless += 1
            else:
                for m in final_masks:
                    out_rows.append((img_id, rle_encode_airbus(m)))
                inst_rows += len(final_masks)

            if (idx + 1) % args.log_every_test_imgs == 0:
                log(f"test {idx+1}/{len(test_order)} shipless={shipless} inst_rows={inst_rows} elapsed={(time.time()-t0_test)/60:.1f}m", fp)

        submit_path = os.path.join(args.run_dir, args.submit_name)
        with open(submit_path, "w", newline="", encoding="utf-8") as f:
            w = csv.writer(f)
            w.writerow(["ImageId", "EncodedPixels"])
            for img_id, enc in out_rows:
                w.writerow([img_id, enc])

        meta = {
            "time": now_ts(),
            "data_dir": args.data_dir,
            "zoo_dir": args.zoo_dir,
            "resolved_paths": {
                "train_csv": train_csv,
                "sample_csv": sample_csv,
                "train_dir": train_dir,
                "test_dir": test_dir,
            },
            "infer_size": args.infer_size,
            "tta_hflip": int(args.tta_hflip),
            "tta_vflip": int(args.tta_vflip),
            "n_images": args.n_images,
            "pos_frac": args.pos_frac,
            "splits": {k: len(v) for k, v in splits.items()},
            "compat_strict": int(args.compat_strict),
            "tree": {
                "model": "HistGradientBoostingClassifier",
                "tree_path": tree_path,
                "best_thr": best_thr,
                "best_f2_calib": best_f2,
                "ptest_f2": f2_ptest,
            },
            "thresholds": {
                "det_t_low": args.det_t_low,
                "det_t_high": args.det_t_high,
                "sem_thr": {"low": args.sem_thr_low, "mid": args.sem_thr_mid, "high": args.sem_thr_high},
                "inst_score_thr": {"low": args.inst_score_thr_low, "mid": args.inst_score_thr_mid, "high": args.inst_score_thr_high},
                "inst_mask_thr": args.inst_mask_thr,
                "inst_min_area": args.inst_min_area,
                "sem_cc": {"min_area": args.sem_cc_min_area, "topk": args.sem_cc_topk, "score_scale": args.sem_cc_score_scale},
                "final": {"min_area": args.final_min_area, "max_inst": {"low": args.max_inst_low, "mid": args.max_inst_mid, "high": args.max_inst_high}},
            },
            "models": {
                "detector_arch": args.detector_arch,
                "sem_arch": args.sem_arch,
                "inst_arch": args.inst_arch,
                "det_paths_kept": det_paths,
                "sem_paths_kept": sem_paths,
                "inst_paths_kept": inst_paths,
                "det_loaded": len(det_models),
                "sem_loaded": len(sem_models),
                "inst_loaded": len(inst_models),
            },
            "result": {
                "submission_path": submit_path,
                "rows": len(out_rows),
                "shipless_rows": shipless,
                "instance_rows": inst_rows,
            }
        }
        with open(os.path.join(args.run_dir, "meta.json"), "w", encoding="utf-8") as f:
            json.dump(meta, f, ensure_ascii=False, indent=2)

        log("=== DONE ===", fp)
        log(f"submission_path={submit_path}", fp)
        log(f"rows={len(out_rows)} shipless_rows={shipless} instance_rows={inst_rows}", fp)

    print(f"[OK] submission written: {os.path.join(args.run_dir, args.submit_name)}")


if __name__ == "__main__":
    main()
