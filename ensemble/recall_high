    ap.add_argument("--thr_coarse_n", type=int, default=21)
    ap.add_argument("--thr_refine_n", type=int, default=11)
    ap.add_argument("--thr_refine_span", type=float, default=0.05)

    # Output
    ap.add_argument("--submit_name", type=str, default="submission_tree.csv")

    return ap.parse_args()


def resolve_dataset_paths(args) -> Tuple[str, str, str, str]:
    train_csv = args.train_csv.strip() if args.train_csv.strip() else ""
    sample_csv = args.sample_csv.strip() if args.sample_csv.strip() else ""
    train_dir = args.train_dir.strip() if args.train_dir.strip() else ""
    test_dir = args.test_dir.strip() if args.test_dir.strip() else ""

    cur = os.path.abspath(args.data_dir)
    roots = [cur, os.path.dirname(cur), os.path.dirname(os.path.dirname(cur))]

    def pick_file(name: str) -> str:
        for r in roots:
            cand = os.path.join(r, name)
            if os.path.isfile(cand):
                return cand
        return ""

    def pick_dir(name: str) -> str:
        for r in roots:
            cand = os.path.join(r, name)
            if os.path.isdir(cand):
                return cand
        return ""

    if not train_csv:
        train_csv = pick_file("train_ship_segmentations_v2.csv")
    if not sample_csv:
        sample_csv = pick_file("sample_submission_v2.csv")
    if not train_dir:
        train_dir = pick_dir("train_v2")
    if not test_dir:
        test_dir = pick_dir("test_v2")

    missing = []
    if not (train_csv and os.path.isfile(train_csv)):
        missing.append("train_ship_segmentations_v2.csv")
    if not (sample_csv and os.path.isfile(sample_csv)):
        missing.append("sample_submission_v2.csv")
    if not (train_dir and os.path.isdir(train_dir)):
        missing.append("train_v2/")
    if not (test_dir and os.path.isdir(test_dir)):
        missing.append("test_v2/")

    if missing:
        msg = (
            "Dataset path resolution failed. Missing: " + ", ".join(missing) + "\n"
            f"  data_dir={args.data_dir}\n"
            f"  tried_roots={roots}\n"
            f"  resolved train_csv={train_csv}\n"
            f"  resolved sample_csv={sample_csv}\n"
            f"  resolved train_dir={train_dir}\n"
            f"  resolved test_dir={test_dir}\n"
            "Fix: pass explicit --train_csv/--sample_csv/--train_dir/--test_dir or set correct --data_dir."
        )
        raise AssertionError(msg)

    return train_csv, sample_csv, train_dir, test_dir


# -------------------------
# Cache helpers
# -------------------------
def cache_paths(cache_dir: str, img_id: str) -> str:
    # make filesystem-safe key
    key = sha1_str(img_id)
    return os.path.join(cache_dir, f"{key}.npz")


def save_cache_npz(path: str, data: Dict[str, Any]) -> None:
    # convert lists to arrays carefully
    # masks are stored as uint8 to compress well
    np_data: Dict[str, Any] = {}
    for k, v in data.items():
        if isinstance(v, np.ndarray):
            np_data[k] = v
        elif isinstance(v, (float, int, np.float32, np.float64, np.int32, np.int64)):
            np_data[k] = np.array([v], dtype=np.float32)
        elif isinstance(v, list):
            # lists of masks or scores
            if len(v) == 0:
                np_data[k] = np.zeros((0,), dtype=np.float32)
            else:
                if isinstance(v[0], np.ndarray):
                    # stack masks as [N,H,W] uint8
                    arr = np.stack([(vv.astype(np.uint8)) for vv in v], 0)
                    np_data[k] = arr
                else:
                    np_data[k] = np.asarray(v, dtype=np.float32)
        else:
            # fallback: json-serialize
            np_data[k] = np.array([json.dumps(v)], dtype=object)
    np.savez_compressed(path, **np_data)


def load_cache_npz(path: str) -> Dict[str, Any]:
    d: Dict[str, Any] = {}
    with np.load(path, allow_pickle=True) as z:
        for k in z.files:
            d[k] = z[k]
    # unwrap scalars that were stored as [1]
    for k in list(d.keys()):
        v = d[k]
        if isinstance(v, np.ndarray) and v.shape == (1,) and v.dtype != object:
            d[k] = float(v[0])
    return d


# -------------------------
# Main pipeline
# -------------------------
def main():
    args = parse_args()

    if HistGradientBoostingClassifier is None:
        raise RuntimeError("scikit-learn missing/broken. Install: python3 -m pip install -U scikit-learn")

    set_seed(args.seed)
    ensure_dir(args.run_dir)
    cache_dir = os.path.join(args.run_dir, "cache")
    ensure_dir(cache_dir)

    # parse eval_iou_list
    eval_iou_list = []
    for s in args.eval_iou_list.split(","):
        s = s.strip()
        if not s:
            continue
        eval_iou_list.append(float(s))
    if not eval_iou_list:
        eval_iou_list = [0.50, 0.60, 0.70, 0.80, 0.90]

    log_path = os.path.join(args.run_dir, "log_global.txt")
    with open(log_path, "w", encoding="utf-8") as fp:
        log("=== infer_fusion_tree_3way_stack_cache_miou START ===", fp)
        log(f"data_dir={args.data_dir}", fp)
        log(f"zoo_dir={args.zoo_dir}", fp)
        log(f"run_dir={args.run_dir}", fp)
        log(f"cache_dir={cache_dir} use_cache={args.use_cache} rebuild_cache={args.rebuild_cache}", fp)
        log(f"cuda_visible={os.environ.get('CUDA_VISIBLE_DEVICES','')}", fp)
        log(f"torch={torch.__version__} torchvision={torchvision.__version__}", fp)
        log(f"cv2={_HAS_CV2} scipy={_HAS_SCIPY}", fp)
        log(f"eval_iou_list={eval_iou_list} beta={args.beta}", fp)

        train_csv, sample_csv, train_dir, test_dir = resolve_dataset_paths(args)
        log(f"resolved train_csv={train_csv}", fp)
        log(f"resolved sample_csv={sample_csv}", fp)
        log(f"resolved train_dir={train_dir}", fp)
        log(f"resolved test_dir={test_dir}", fp)

        # dataset maps
        train_map = list_images_in_dir(train_dir)
        test_map = list_images_in_dir(test_dir)
        test_order = read_sample_submission_order(sample_csv)
        log(f"train_images={len(train_map)} test_images={len(test_map)} template_rows={len(test_order)}", fp)

        # pos from csv only (important fix)
        id2rles = build_id2rles(train_csv)
        pos_ids = sorted([k for k, v in id2rles.items() if len(v) > 0])
        all_train_ids = sorted(list(train_map.keys()))
        log(f"pos_ids_from_csv={len(pos_ids)} all_train_ids_from_dir={len(all_train_ids)}", fp)

        # sample & split
        sampled = stratified_sample_ids(all_train_ids, pos_ids, args.n_images, args.pos_frac, args.seed)
        splits = split_ids(sampled, args.split_train, args.split_calib, args.split_ptest, args.seed)
        with open(os.path.join(args.run_dir, "splits.json"), "w", encoding="utf-8") as f:
            json.dump(splits, f, ensure_ascii=False, indent=2)
        log(f"sampled={len(sampled)} | train={len(splits['train'])} calib={len(splits['calib'])} ptest={len(splits['ptest'])}", fp)

        # select models
        det_paths = [p.strip() for p in args.det_models.split(",") if p.strip()] if args.det_models else auto_select_models(args.zoo_dir, "det")
        sem_paths = [p.strip() for p in args.sem_models.split(",") if p.strip()] if args.sem_models else auto_select_models(args.zoo_dir, "sem")
        inst_paths = [p.strip() for p in args.inst_models.split(",") if p.strip()] if args.inst_models else auto_select_models(args.zoo_dir, "inst")

        log(f"auto det_paths={len(det_paths)}", fp)
        log(f"auto sem_paths={len(sem_paths)}", fp)
        log(f"auto inst_paths={len(inst_paths)}", fp)

        device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
        log(f"device={device}", fp)

        # build/load models
        det_models: List[nn.Module] = []
        for p in det_paths:
            m = build_detector(args.detector_arch)
            ok, msg = safe_load_state_dict(m, p, strict=False)
            log(f"[DET] {msg}", fp)
            if ok:
                det_models.append(m.to(device))

        sem_models: List[nn.Module] = []
        for p in sem_paths:
            m = build_semseg(args.sem_arch)
            ok, msg = safe_load_state_dict(m, p, strict=False)
            log(f"[SEM] {msg}", fp)
            if ok:
                sem_models.append(m.to(device))

        inst_models: List[nn.Module] = []
        for p in inst_paths:
            m = build_instseg(args.inst_arch)
            ok, msg = safe_load_state_dict(m, p, strict=False)
            log(f"[INS] {msg}", fp)
            if ok:
                inst_models.append(m.to(device))

        if len(sem_models) == 0:
            raise RuntimeError("sem_models is empty: cannot proceed.")
        if len(det_models) == 0:
            log("WARNING: det_models empty: p_det=0.0 will be used.", fp)
        if len(inst_models) == 0:
            log("WARNING: inst_models empty: only semCC candidates will be used.", fp)

        # -------------------------
        # Per-image processing with cache
        # -------------------------
        def process_one(img_id: str, mode: str) -> Dict[str, Any]:
            """
            mode: "train" (has GT) or "test"
            return dict:
              p_det(float), lvl(int),
              P_sem(float32 HxW),
              pred_masks(uint8 NxHxW), pred_scores(float32 N), pred_src_id(int32 N)
              gt_masks(uint8 MxHxW) only when mode="train"
            """
            cpath = cache_paths(cache_dir, f"{mode}:{img_id}:{args.infer_size}:{args.tta_hflip}:{args.tta_vflip}:{args.det_t_low}:{args.det_t_high}")
            if args.use_cache == 1 and args.rebuild_cache == 0 and os.path.isfile(cpath):
                d = load_cache_npz(cpath)
                out: Dict[str, Any] = {}

                out["p_det"] = float(d.get("p_det", 0.0))
                out["lvl"]   = int(float(d.get("lvl", 0.0)))

                P = d["P_sem"].astype(np.float32)
                out["P_sem"] = P

                pm = d.get("pred_masks", np.zeros((0,), dtype=np.uint8))
                if isinstance(pm, np.ndarray) and pm.ndim == 3:
                    out["pred_masks"] = [pm[i].astype(bool) for i in range(pm.shape[0])]
                else:
                    out["pred_masks"] = []

                ps = d.get("pred_scores", np.zeros((0,), dtype=np.float32)).astype(np.float32)
                out["pred_scores"] = [float(x) for x in ps.tolist()] if ps.ndim == 1 else []

                src = d.get("pred_src_id", np.zeros((0,), dtype=np.float32))
                if isinstance(src, np.ndarray) and src.ndim == 1:
                    out["pred_src_id"] = [int(x) for x in src.astype(np.int32).tolist()]
                else:
                    out["pred_src_id"] = []

                if mode == "train":
                    gm = d.get("gt_masks", np.zeros((0,), dtype=np.uint8))
                    if isinstance(gm, np.ndarray) and gm.ndim == 3:
                        out["gt_masks"] = [gm[i].astype(bool) for i in range(gm.shape[0])]
                    else:
                        out["gt_masks"] = []
                return out

            # build from scratch
            if mode == "train":
                img_path = train_map[img_id]
            else:
                img_path = test_map[img_id]

            pil0 = pil_open_rgb(img_path)
            orig_w, orig_h = pil0.size
            pil = pil0.resize((args.infer_size, args.infer_size), resample=Image.BILINEAR)

            x_norm = to_tensor_imagenet_norm(pil).unsqueeze(0).to(device)
            x_det  = to_tensor_01(pil).to(device)

            p_det = infer_detector_ensemble(det_models, x_norm, bool(args.tta_hflip), bool(args.tta_vflip)) if det_models else 0.0
            lvl = gate_level(p_det, args.det_t_low, args.det_t_high)

            P_sem = infer_semseg_ensemble(sem_models, x_norm, bool(args.tta_hflip), bool(args.tta_vflip))

            sem_thr = choose_by_gate(lvl, args.sem_thr_low, args.sem_thr_mid, args.sem_thr_high)
            inst_score_thr = choose_by_gate(lvl, args.inst_score_thr_low, args.inst_score_thr_mid, args.inst_score_thr_high)

            inst_cand = infer_instseg_ensemble(
                inst_models, x_det,
                score_thr=inst_score_thr,
                mask_thr=args.inst_mask_thr,
                min_area=args.inst_min_area,
                tta_hflip=bool(args.tta_hflip),
                tta_vflip=bool(args.tta_vflip),
            ) if inst_models else []

            sem_cc = build_sem_cc_candidates(P_sem, sem_thr, args.sem_cc_min_area, args.sem_cc_topk, args.sem_cc_score_scale)

            pred_masks: List[np.ndarray] = []
            pred_scores: List[float] = []
            pred_src_id: List[int] = []
            for c in inst_cand:
                pred_masks.append(c["mask"].astype(bool))
                pred_scores.append(float(c["score"]))
                pred_src_id.append(int(c.get("src_id", 1)))
            for c in sem_cc:
                pred_masks.append(c["mask"].astype(bool))
                pred_scores.append(float(c["score"]))
                pred_src_id.append(int(c.get("src_id", 0)))

            out: Dict[str, Any] = {
                "p_det": float(p_det),
                "lvl": int(lvl),
                "P_sem": P_sem.astype(np.float16),  # compress
                "pred_masks": pred_masks,
                "pred_scores": pred_scores,
                "pred_src_id": pred_src_id,
            }

            if mode == "train":
                gt_rles = id2rles.get(img_id, [])
                gt_masks: List[np.ndarray] = []
                for rle in gt_rles:
                    gm = rle_decode_airbus(rle, (orig_h, orig_w))  # HxW
                    if gm.shape[0] != args.infer_size or gm.shape[1] != args.infer_size:
                        gm_pil = Image.fromarray((gm * 255).astype(np.uint8)).resize((args.infer_size, args.infer_size), resample=Image.NEAREST)
                        gm = (np.array(gm_pil) > 127).astype(np.uint8)
                    gt_masks.append(gm.astype(bool))
                out["gt_masks"] = gt_masks

            # save cache
            if args.use_cache == 1:
                to_save: Dict[str, Any] = {
                    "p_det": float(p_det),
                    "lvl": float(lvl),
                    "P_sem": out["P_sem"].astype(np.float16),
                    "pred_scores": np.asarray(pred_scores, dtype=np.float32),
                    "pred_src_id": np.asarray(pred_src_id, dtype=np.int32),
                }
                if len(pred_masks) > 0:
                    to_save["pred_masks"] = np.stack([m.astype(np.uint8) for m in pred_masks], 0)
                else:
                    to_save["pred_masks"] = np.zeros((0,), dtype=np.uint8)
                if mode == "train":
                    gtm = out["gt_masks"]
                    if len(gtm) > 0:
                        to_save["gt_masks"] = np.stack([m.astype(np.uint8) for m in gtm], 0)
                    else:
                        to_save["gt_masks"] = np.zeros((0,), dtype=np.uint8)

                save_cache_npz(cpath, to_save)

            # restore P_sem to float32 for computation
            out["P_sem"] = P_sem.astype(np.float32)
            return out

        # -------------------------
        # Build tree training samples
        # -------------------------
        X_train: List[np.ndarray] = []
        y_train: List[int] = []

        def label_candidates_by_iou(pred_masks: List[np.ndarray], gt_masks: List[np.ndarray], thr: float) -> List[int]:
            if len(gt_masks) == 0:
                return [0] * len(pred_masks)
            y: List[int] = []
            for pm in pred_masks:
                best = 0.0
                for gm in gt_masks:
                    v = iou_mask(pm, gm)
                    if v > best:
                        best = v
                y.append(1 if best >= thr else 0)
            return y

        log("Building tree training samples...", fp)
        for i, img_id in enumerate(splits["train"]):
            d = process_one(img_id, mode="train")
            pred_masks = d["pred_masks"]
            pred_scores = d["pred_scores"]
            pred_src_id = d["pred_src_id"]
            gt_masks = d.get("gt_masks", [])
            p_det = float(d["p_det"])
            lvl = int(d["lvl"])
            P_sem = d["P_sem"]

            y = label_candidates_by_iou(pred_masks, gt_masks, args.match_iou_thr)

            pos_idx = [k for k, yy in enumerate(y) if yy == 1]
            neg_idx = [k for k, yy in enumerate(y) if yy == 0]
            if len(neg_idx) > args.max_neg_per_image:
                neg_idx = random.sample(neg_idx, args.max_neg_per_image)

            use_idx = pos_idx + neg_idx
            for k in use_idx:
                feats = extract_features_for_candidate(
                    pred_masks[k], float(pred_scores[k]), p_det, lvl, P_sem, int(pred_src_id[k])
                )
                X_train.append(feats)
                y_train.append(int(y[k]))

            if (i + 1) % 200 == 0:
                log(f"tree_train progress {i+1}/{len(splits['train'])} | X={len(X_train)}", fp)

        if len(X_train) == 0:
            raise RuntimeError("No training samples collected. Check thresholds/models.")

        X_train_np = np.stack(X_train, 0)
        y_train_np = np.asarray(y_train, dtype=np.int32)
        log(f"Tree train samples: X={X_train_np.shape} y_pos={int(y_train_np.sum())} y_neg={int((y_train_np==0).sum())}", fp)

        # Train tree (stacking)
        log("Training HistGradientBoostingClassifier (stacking) ...", fp)
        tree = HistGradientBoostingClassifier(
            max_depth=6,
            learning_rate=0.08,
            max_iter=300,
            random_state=args.seed,
        )
        tree.fit(X_train_np, y_train_np)
        log("Tree trained.", fp)

        tree_path = os.path.join(args.run_dir, "tree_model.pkl")
        with open(tree_path, "wb") as f:
            pickle.dump(tree, f)
        log(f"Saved tree: {tree_path}", fp)

        # -------------------------
        # Calibrate threshold on calib split (multi-IoU average F2)
        # -------------------------
        def score_calib_at_thr(thr: float) -> Tuple[float, Dict[str, Any]]:
            all_tp = all_fp = all_fn = 0
            # for multi-iou average: accumulate F2 per threshold then average
            f2_list: List[float] = []

            for img_id in splits["calib"]:
                d = process_one(img_id, mode="train")
                pred_masks = d["pred_masks"]
                pred_scores = d["pred_scores"]
                pred_src_id = d["pred_src_id"]
                gt_masks = d.get("gt_masks", [])
                p_det = float(d["p_det"])
                lvl = int(d["lvl"])
                P_sem = d["P_sem"]

                if len(pred_masks) == 0:
                    # no preds => counts depend on gt
                    # for multi iou, tp=0 fp=0 fn=len(gt)
                    # f2 computed later from counts; but here do per-iou direct
                    pass

                feats_list: List[np.ndarray] = []
                for pm, sc, sid in zip(pred_masks, pred_scores, pred_src_id):
                    feats_list.append(extract_features_for_candidate(pm, float(sc), p_det, lvl, P_sem, int(sid)))

                if len(feats_list) == 0:
                    # per-iou f2 is 0 when fn>0, else 1? but gt empty case f2 should be 1.
                    # We handle via counts.
                    if len(gt_masks) == 0:
                        # perfect shipless
                        for _ in eval_iou_list:
                            f2_list.append(1.0)
                    else:
                        for _ in eval_iou_list:
                            f2_list.append(0.0)
                    continue

                Xc = np.stack(feats_list, 0)
                proba = tree.predict_proba(Xc)[:, 1].astype(np.float32)

                keep_idx = [k for k, p in enumerate(proba) if float(p) >= float(thr)]
                keep_masks = [pred_masks[k] for k in keep_idx]
                keep_scores = [float(proba[k]) for k in keep_idx]

                # IoU matrix once
                M = iou_matrix(keep_masks, gt_masks)

                # multi iou average
                for iou_thr in eval_iou_list:
                    tp, fp_, fn = greedy_match_counts_from_iou(M, keep_scores, score_thr=0.0, iou_thr=float(iou_thr))
                    f2 = fbeta_from_counts(tp, fp_, fn, beta=float(args.beta))
                    f2_list.append(f2)

            f2_avg = float(np.mean(f2_list)) if len(f2_list) > 0 else 0.0
            info = {"f2_avg": f2_avg, "eval_iou_list": eval_iou_list, "beta": args.beta}
            return f2_avg, info

        log("Calibrating threshold on calib split (multi-IoU average F2)...", fp)

        # two-stage thr search
        coarse = np.linspace(0.05, 0.95, args.thr_coarse_n).tolist()
        best_thr = 0.50
        best_f2 = -1.0
        best_info: Dict[str, Any] = {}

        for thr in coarse:
            f2, info = score_calib_at_thr(float(thr))
            if f2 > best_f2:
                best_f2 = f2
                best_thr = float(thr)
                best_info = info

        # refine around best
        lo = max(0.01, best_thr - float(args.thr_refine_span))
        hi = min(0.99, best_thr + float(args.thr_refine_span))
        refine = np.linspace(lo, hi, args.thr_refine_n).tolist()
        for thr in refine:
            f2, info = score_calib_at_thr(float(thr))
            if f2 > best_f2:
                best_f2 = f2
                best_thr = float(thr)
                best_info = info

        log(f"Best tree_thr={best_thr:.4f} best_multiIoU_F2={best_f2:.6f} info={best_info}", fp)

        # -------------------------
        # Pseudo-test evaluation (same multi-IoU average)
        # -------------------------
        log("Pseudo-test evaluation (multi-IoU average F2)...", fp)
        f2_list_pt: List[float] = []

        for img_id in splits["ptest"]:
            d = process_one(img_id, mode="train")
            pred_masks = d["pred_masks"]
            pred_scores = d["pred_scores"]
            pred_src_id = d["pred_src_id"]
            gt_masks = d.get("gt_masks", [])
            p_det = float(d["p_det"])
            lvl = int(d["lvl"])
            P_sem = d["P_sem"]

            feats_list: List[np.ndarray] = []
            for pm, sc, sid in zip(pred_masks, pred_scores, pred_src_id):
                feats_list.append(extract_features_for_candidate(pm, float(sc), p_det, lvl, P_sem, int(sid)))

            if len(feats_list) == 0:
                if len(gt_masks) == 0:
                    for _ in eval_iou_list:
                        f2_list_pt.append(1.0)
                else:
                    for _ in eval_iou_list:
                        f2_list_pt.append(0.0)
                continue

            Xc = np.stack(feats_list, 0)
            proba = tree.predict_proba(Xc)[:, 1].astype(np.float32)

            keep_idx = [k for k, p in enumerate(proba) if float(p) >= float(best_thr)]
            keep_masks = [pred_masks[k] for k in keep_idx]
            keep_scores = [float(proba[k]) for k in keep_idx]

            M = iou_matrix(keep_masks, gt_masks)
            for iou_thr in eval_iou_list:
                tp, fp_, fn = greedy_match_counts_from_iou(M, keep_scores, score_thr=0.0, iou_thr=float(iou_thr))
                f2_list_pt.append(fbeta_from_counts(tp, fp_, fn, beta=float(args.beta)))

        f2_ptest = float(np.mean(f2_list_pt)) if len(f2_list_pt) > 0 else 0.0
        log(f"Pseudo-test: multiIoU_F2={f2_ptest:.6f}", fp)

        # -------------------------
        # Test inference -> submission
        # -------------------------
        log("Running test inference and building submission...", fp)
        out_rows: List[Tuple[str, str]] = []
        shipless = 0
        inst_rows = 0
        t0_test = time.time()

        for idx, img_id in enumerate(test_order):
            if img_id not in test_map:
                out_rows.append((img_id, ""))
                shipless += 1
                continue

            d = process_one(img_id, mode="test")
            pred_masks = d["pred_masks"]
            pred_scores = d["pred_scores"]
            pred_src_id = d["pred_src_id"]
            p_det = float(d["p_det"])
            lvl = int(d["lvl"])
            P_sem = d["P_sem"]

            max_inst = choose_int_by_gate(lvl, args.max_inst_low, args.max_inst_mid, args.max_inst_high)

            if len(pred_masks) == 0:
                out_rows.append((img_id, ""))
                shipless += 1
                continue

            feats: List[np.ndarray] = []
            for pm, sc, sid in zip(pred_masks, pred_scores, pred_src_id):
                feats.append(extract_features_for_candidate(pm, float(sc), p_det, lvl, P_sem, int(sid)))
            X = np.stack(feats, 0)
            proba = tree.predict_proba(X)[:, 1].astype(np.float32)

            keep: List[Tuple[float, np.ndarray]] = []
            for pm, pb in zip(pred_masks, proba.tolist()):
                if float(pb) >= float(best_thr):
                    keep.append((float(pb), pm))
            keep.sort(key=lambda x: x[0], reverse=True)

            final_masks = enforce_non_overlap_cut(keep, min_area=args.final_min_area, max_inst=max_inst)

            if len(final_masks) == 0:
                out_rows.append((img_id, ""))
                shipless += 1
            else:
                for m in final_masks:
                    out_rows.append((img_id, rle_encode_airbus(m)))
                inst_rows += len(final_masks)

            if (idx + 1) % 200 == 0:
                log(f"test progress {idx+1}/{len(test_order)} | shipless={shipless} inst_rows={inst_rows} elapsed={(time.time()-t0_test)/60:.1f}m", fp)

        submit_path = os.path.join(args.run_dir, args.submit_name)
        with open(submit_path, "w", newline="", encoding="utf-8") as f:
            w = csv.writer(f)
            w.writerow(["ImageId", "EncodedPixels"])
            for img_id, enc in out_rows:
                w.writerow([img_id, enc])

        meta = {
            "time": now_ts(),
            "data_dir": args.data_dir,
            "zoo_dir": args.zoo_dir,
            "resolved_paths": {
                "train_csv": train_csv,
                "sample_csv": sample_csv,
                "train_dir": train_dir,
                "test_dir": test_dir,
            },
            "infer_size": args.infer_size,
            "tta_hflip": int(args.tta_hflip),
            "tta_vflip": int(args.tta_vflip),
            "use_cache": int(args.use_cache),
            "rebuild_cache": int(args.rebuild_cache),
            "n_images": args.n_images,
            "pos_frac": args.pos_frac,
            "splits": {k: len(v) for k, v in splits.items()},
            "tree": {
                "model": "HistGradientBoostingClassifier",
                "tree_path": tree_path,
                "best_thr": best_thr,
                "best_multi_iou_f2_calib": best_f2,
                "ptest_multi_iou_f2": f2_ptest,
                "eval_iou_list": eval_iou_list,
                "beta": args.beta,
            },
            "thresholds": {
                "det_t_low": args.det_t_low,
                "det_t_high": args.det_t_high,
                "sem_thr": {"low": args.sem_thr_low, "mid": args.sem_thr_mid, "high": args.sem_thr_high},
                "inst_score_thr": {"low": args.inst_score_thr_low, "mid": args.inst_score_thr_mid, "high": args.inst_score_thr_high},
                "inst_mask_thr": args.inst_mask_thr,
                "inst_min_area": args.inst_min_area,
                "sem_cc": {"min_area": args.sem_cc_min_area, "topk": args.sem_cc_topk, "score_scale": args.sem_cc_score_scale},
                "final": {"min_area": args.final_min_area, "max_inst": {"low": args.max_inst_low, "mid": args.max_inst_mid, "high": args.max_inst_high}},
            },
            "models": {
                "detector_arch": args.detector_arch,
                "sem_arch": args.sem_arch,
                "inst_arch": args.inst_arch,
                "det_paths": det_paths,
                "sem_paths": sem_paths,
                "inst_paths": inst_paths,
                "det_loaded": len(det_models),
                "sem_loaded": len(sem_models),
                "inst_loaded": len(inst_models),
            },
            "result": {
                "submission_path": submit_path,
                "rows": len(out_rows),
                "shipless_rows": shipless,
                "instance_rows": inst_rows,
            }
        }
        with open(os.path.join(args.run_dir, "meta.json"), "w", encoding="utf-8") as f:
            json.dump(meta, f, ensure_ascii=False, indent=2)

        log("=== DONE ===", fp)
        log(f"submission_path={submit_path}", fp)
        log(f"rows={len(out_rows)} shipless_rows={shipless} instance_rows={inst_rows}", fp)

    print(f"[OK] submission written: {os.path.join(args.run_dir, args.submit_name)}")


if __name__ == "__main__":
    main()
