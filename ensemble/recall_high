# -------------------------
# Airbus RLE
# -------------------------
def rle_decode_airbus(rle: str, shape: Tuple[int, int]) -> np.ndarray:
    """
    Decode Airbus RLE (column-major) into mask HxW uint8
    shape: (H, W)
    """
    h, w = shape
    mask = np.zeros(h * w, dtype=np.uint8)
    if rle is None:
        return mask.reshape((w, h)).T
    if isinstance(rle, str):
        rle = rle.strip()
    else:
        rle = str(rle).strip()
    if rle == "" or rle.lower() == "nan":
        return mask.reshape((w, h)).T

    s = rle.split()
    if len(s) < 2:
        return mask.reshape((w, h)).T
    starts = np.asarray(s[0::2], dtype=np.int64) - 1
    lengths = np.asarray(s[1::2], dtype=np.int64)
    ends = starts + lengths
    for st, en in zip(starts, ends):
        if st < 0:
            st = 0
        if en > mask.size:
            en = mask.size
        mask[st:en] = 1

    return mask.reshape((w, h)).T


def rle_encode_airbus(mask: np.ndarray) -> str:
    if mask.dtype != np.uint8:
        mask = mask.astype(np.uint8)
    pixels = mask.T.flatten()  # column-major
    pixels = np.concatenate([[0], pixels, [0]])
    runs = np.where(pixels[1:] != pixels[:-1])[0] + 1
    runs[1::2] -= runs[::2]
    if len(runs) == 0:
        return ""
    return " ".join(str(x) for x in runs)


# -------------------------
# Connected components
# -------------------------
def connected_components(mask_bin: np.ndarray) -> Tuple[int, np.ndarray]:
    if mask_bin.dtype != np.uint8:
        mask_u8 = mask_bin.astype(np.uint8)
    else:
        mask_u8 = mask_bin

    if _HAS_CV2:
        num, labels = cv2.connectedComponents(mask_u8, connectivity=8)
        return int(num), labels.astype(np.int32)
    if _HAS_SCIPY:
        labels, num = ndimage.label(mask_u8)
        return int(num + 1), labels.astype(np.int32)

    # naive fallback (slow)
    h, w = mask_u8.shape
    labels = np.zeros((h, w), dtype=np.int32)
    cur = 0
    for y in range(h):
        for x in range(w):
            if mask_u8[y, x] == 1 and labels[y, x] == 0:
                cur += 1
                stack = [(y, x)]
                labels[y, x] = cur
                while stack:
                    cy, cx = stack.pop()
                    for dy in (-1, 0, 1):
                        for dx in (-1, 0, 1):
                            if dy == 0 and dx == 0:
                                continue
                            ny, nx = cy + dy, cx + dx
                            if 0 <= ny < h and 0 <= nx < w:
                                if mask_u8[ny, nx] == 1 and labels[ny, nx] == 0:
                                    labels[ny, nx] = cur
                                    stack.append((ny, nx))
    return int(cur + 1), labels


def mean_over_mask(arr: np.ndarray, mask: np.ndarray) -> float:
    s = int(mask.sum())
    if s <= 0:
        return 0.0
    return float(arr[mask].mean())


def p90_over_mask(arr: np.ndarray, mask: np.ndarray) -> float:
    s = int(mask.sum())
    if s <= 0:
        return 0.0
    return float(np.percentile(arr[mask], 90))


def bbox_from_mask(mask: np.ndarray) -> Tuple[int, int, int, int]:
    ys, xs = np.where(mask)
    if len(xs) == 0:
        return 0, 0, 0, 0
    x0 = int(xs.min()); x1 = int(xs.max()) + 1
    y0 = int(ys.min()); y1 = int(ys.max()) + 1
    return x0, y0, x1, y1


def iou_mask(a: np.ndarray, b: np.ndarray) -> float:
    inter = np.logical_and(a, b).sum()
    if inter <= 0:
        return 0.0
    uni = np.logical_or(a, b).sum()
    if uni <= 0:
        return 0.0
    return float(inter / uni)


def gate_level(p_det: float, t_low: float, t_high: float) -> int:
    if p_det < t_low:
        return 0
    if p_det < t_high:
        return 1
    return 2


def choose_by_gate(level: int, low: float, mid: float, high: float) -> float:
    return low if level == 0 else (mid if level == 1 else high)


def choose_int_by_gate(level: int, low: int, mid: int, high: int) -> int:
    return low if level == 0 else (mid if level == 1 else high)


