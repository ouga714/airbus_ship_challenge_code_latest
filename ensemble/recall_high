def auto_select_models(zoo_dir: str, kind: str) -> List[str]:
    all_pt = sorted(glob.glob(os.path.join(zoo_dir, "*.pt")))
    if kind == "det":
        keys = ["detector", "detfuse", "cls"]
    elif kind == "sem":
        keys = ["deeplab", "seg", "semantic", "tversky", "iou"]
    elif kind == "inst":
        keys = ["maskrcnn", "mask_r_cnn", "inst"]
    else:
        raise ValueError(kind)
    out: List[str] = []
    for p in all_pt:
        n = os.path.basename(p).lower()
        if any(k in n for k in keys):
            out.append(p)
    return out


@torch.no_grad()
def infer_detector_ensemble(models: List[nn.Module], x: torch.Tensor, tta_hflip: bool, tta_vflip: bool) -> float:
    probs: List[float] = []
    for m in models:
        m.eval()
        z = m(x).view(-1)
        probs.append(float(torch.sigmoid(z).item()))
        if tta_hflip:
            x2 = torch.flip(x, dims=[3])
            z2 = m(x2).view(-1)
            probs.append(float(torch.sigmoid(z2).item()))
        if tta_vflip:
            x3 = torch.flip(x, dims=[2])
            z3 = m(x3).view(-1)
            probs.append(float(torch.sigmoid(z3).item()))
    return float(np.mean(probs)) if probs else 0.0


@torch.no_grad()
def infer_semseg_ensemble(models: List[nn.Module], x: torch.Tensor, tta_hflip: bool, tta_vflip: bool) -> np.ndarray:
    logits: List[np.ndarray] = []
    for m in models:
        m.eval()
        out = m(x)["out"][0, 0].detach().cpu().numpy()
        logits.append(out)

        if tta_hflip:
            x2 = torch.flip(x, dims=[3])
            out2 = m(x2)["out"][0, 0].detach().cpu().numpy()
            logits.append(np.flip(out2, axis=1))

        if tta_vflip:
            x3 = torch.flip(x, dims=[2])
            out3 = m(x3)["out"][0, 0].detach().cpu().numpy()
            logits.append(np.flip(out3, axis=0))

    if not logits:
        h, w = int(x.shape[2]), int(x.shape[3])
        return np.zeros((h, w), dtype=np.float32)

    z = np.mean(np.stack(logits, 0), 0)
    return sigmoid_np(z).astype(np.float32)


@torch.no_grad()
def infer_instseg_ensemble(
    models: List[nn.Module],
    img01: torch.Tensor,   # (3,H,W) [0,1]
    score_thr: float,
    mask_thr: float,
    min_area: int,
    tta_hflip: bool,
    tta_vflip: bool,
) -> List[Dict[str, Any]]:
    cands: List[Dict[str, Any]] = []

    def run_one(m: nn.Module, img: torch.Tensor, tag: str) -> None:
        m.eval()
        out = m([img])[0]
        scores = out.get("scores", torch.zeros((0,), device=img.device)).detach().cpu().numpy()
        masks  = out.get("masks", torch.zeros((0, 1, img.shape[1], img.shape[2]), device=img.device)).detach().cpu().numpy()

        for i in range(int(scores.shape[0])):
            sc = float(scores[i])
            if sc < score_thr:
                continue
            pm = masks[i, 0]  # already prob [0,1] in torchvision
            mb = (pm >= mask_thr)
            if int(mb.sum()) < min_area:
                continue
            cands.append({"mask": mb, "score": sc, "src": tag, "src_id": 1})

    for mi, m in enumerate(models):
        run_one(m, img01, f"inst_m{mi}_base")

        if tta_hflip:
            img2 = torch.flip(img01, dims=[2])  # flip W
            before = len(cands)
            run_one(m, img2, f"inst_m{mi}_hflip")
            for j in range(before, len(cands)):
                cands[j]["mask"] = np.flip(cands[j]["mask"], axis=1)

        if tta_vflip:
            img3 = torch.flip(img01, dims=[1])  # flip H
            before = len(cands)
            run_one(m, img3, f"inst_m{mi}_vflip")
            for j in range(before, len(cands)):
                cands[j]["mask"] = np.flip(cands[j]["mask"], axis=0)

    return cands


def build_sem_cc_candidates(P_sem: np.ndarray, sem_thr: float, cc_min_area: int, topk: int, score_scale: float) -> List[Dict[str, Any]]:
    sem_bin = (P_sem >= sem_thr).astype(np.uint8)
    _, labels = connected_components(sem_bin)

    comp: List[Tuple[float, np.ndarray]] = []
    max_lab = int(labels.max())
    for lab in range(1, max_lab + 1):
        m = (labels == lab)
        a = int(m.sum())
        if a < cc_min_area:
            continue
        sc = mean_over_mask(P_sem, m)
        comp.append((sc, m))

    comp.sort(key=lambda x: x[0], reverse=True)
    comp = comp[:topk]

    out: List[Dict[str, Any]] = []
    for sc, m in comp:
        out.append({"mask": m.astype(bool), "score": float(sc) * score_scale, "src": f"semcc_thr{sem_thr:.3f}", "src_id": 0})
    return out


def extract_features_for_candidate(
    mask: np.ndarray,
    inst_score: float,
    p_det: float,
    lvl: int,
    P_sem: np.ndarray,
    src_id: int,     # 1: inst, 0: semcc
) -> np.ndarray:
    area = int(mask.sum())
    x0, y0, x1, y1 = bbox_from_mask(mask)
    bw = max(1, x1 - x0)
    bh = max(1, y1 - y0)
    aspect = float(bw / bh)
    solidity = float(area / (bw * bh))

    sup_mean = mean_over_mask(P_sem, mask)
    sup_p90 = p90_over_mask(P_sem, mask)

    sem_area_ratio = float((P_sem >= 0.5).mean())

    # lightweight source indicator (improves stacking separation)
    src_is_inst = 1.0 if src_id == 1 else 0.0
    src_is_semc = 1.0 if src_id == 0 else 0.0

    feats = np.array([
        float(p_det),
        float(lvl),
        float(inst_score),
        float(area),
        float(bw),
        float(bh),
        float(aspect),
        float(solidity),
        float(sup_mean),
        float(sup_p90),
        float(sem_area_ratio),
        float(src_is_inst),
        float(src_is_semc),
    ], dtype=np.float32)
    return feats


def iou_matrix(pred_masks: List[np.ndarray], gt_masks: List[np.ndarray]) -> np.ndarray:
    """
    Compute IoU matrix M [n_pred, n_gt] once, reuse for multi IoU thresholds.
    """
    nP = len(pred_masks)
    nG = len(gt_masks)
    if nP == 0 or nG == 0:
        return np.zeros((nP, nG), dtype=np.float32)
    M = np.zeros((nP, nG), dtype=np.float32)
    for i in range(nP):
        pm = pred_masks[i]
        for j in range(nG):
            gm = gt_masks[j]
            inter = np.logical_and(pm, gm).sum()
            if inter <= 0:
                M[i, j] = 0.0
                continue
            uni = np.logical_or(pm, gm).sum()
            if uni <= 0:
                M[i, j] = 0.0
            else:
                M[i, j] = float(inter / uni)
    return M


def greedy_match_counts_from_iou(
    iou_mat: np.ndarray,
    pred_scores: List[float],
    score_thr: float,
    iou_thr: float,
) -> Tuple[int, int, int]:
    """
    Given IoU matrix and pred scores, compute TP/FP/FN with greedy matching at iou_thr.
    """
    nP, nG = iou_mat.shape
    idxs = [i for i, s in enumerate(pred_scores) if s >= score_thr]
    idxs.sort(key=lambda i: pred_scores[i], reverse=True)

    used_gt = set()
    tp = 0
    fp = 0

    for i in idxs:
        best_j = -1
        best_iou = 0.0
        for j in range(nG):
            if j in used_gt:
                continue
            v = float(iou_mat[i, j])
            if v > best_iou:
                best_iou = v
                best_j = j
        if best_j >= 0 and best_iou >= iou_thr:
            tp += 1
            used_gt.add(best_j)
        else:
            fp += 1

    fn = nG - len(used_gt)
    return tp, fp, fn


def fbeta_from_counts(tp: int, fp: int, fn: int, beta: float) -> float:
    prec = tp / (tp + fp + 1e-9)
    rec  = tp / (tp + fn + 1e-9)
    b2 = beta * beta
    return float((1 + b2) * prec * rec / (b2 * prec + rec + 1e-9))


def enforce_non_overlap_cut(cands: List[Tuple[float, np.ndarray]], min_area: int, max_inst: int) -> List[np.ndarray]:
    """
    Kept as original cut-based ownership enforcement (hard constraint).
    NOTE: you previously saw score drop with aggressive postprocess; this is a hard constraint mode.
    """
    final: List[np.ndarray] = []
    if not cands:
        return final

    H, W = cands[0][1].shape
    occ = np.zeros((H, W), dtype=bool)

    for sc, m in cands:
        if len(final) >= max_inst:
            break
        mm = m & (~occ)
        if int(mm.sum()) < min_area:
            continue
        occ |= mm
        final.append(mm)
    return final


