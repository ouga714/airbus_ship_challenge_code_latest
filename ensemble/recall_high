    ap.add_argument("--det_models", type=str, default="")
    ap.add_argument("--sem_models", type=str, default="")
    ap.add_argument("--inst_models", type=str, default="")

    # tree sampling
    ap.add_argument("--n_images", type=int, default=8000)
