def build_detector(arch: str) -> nn.Module:
    arch = arch.lower().strip()
    if arch == "efficientnet_v2_s":
        m = torchvision.models.efficientnet_v2_s(weights=None)
        in_f = m.classifier[-1].in_features
        m.classifier[-1] = nn.Linear(in_f, 1)
        return m
    if arch == "efficientnet_v2_m":
        m = torchvision.models.efficientnet_v2_m(weights=None)
        in_f = m.classifier[-1].in_features
        m.classifier[-1] = nn.Linear(in_f, 1)
        return m
    raise ValueError(f"Unsupported detector_arch: {arch}")


def build_semseg(arch: str) -> nn.Module:
    arch = arch.lower().strip()
    if arch == "deeplabv3_resnet50":
        return torchvision.models.segmentation.deeplabv3_resnet50(
            weights=None, weights_backbone=None, num_classes=1, aux_loss=False
        )
    if arch == "deeplabv3_resnet101":
        return torchvision.models.segmentation.deeplabv3_resnet101(
            weights=None, weights_backbone=None, num_classes=1, aux_loss=False
        )
    raise ValueError(f"Unsupported sem_arch: {arch}")


def build_instseg(arch: str) -> nn.Module:
