def sigmoid_np(x: np.ndarray) -> np.ndarray:
    x = np.clip(x, -50, 50)
    return 1.0 / (1.0 + np.exp(-x))


def strip_module_prefix(state_dict: Dict[str, torch.Tensor]) -> Dict[str, torch.Tensor]:
    if not state_dict:
        return state_dict
    if not any(k.startswith("module.") for k in state_dict.keys()):
        return state_dict
    out: Dict[str, torch.Tensor] = {}
    for k, v in state_dict.items():
        if k.startswith("module."):
            out[k[len("module."):]] = v
        else:
            out[k] = v
    return out


def safe_load_state_dict(model: nn.Module, ckpt_path: str, strict: bool = False) -> Tuple[bool, str]:
    try:
        obj = torch.load(ckpt_path, map_location="cpu")
        if isinstance(obj, dict) and "state_dict" in obj and isinstance(obj["state_dict"], dict):
            sd = obj["state_dict"]
        elif isinstance(obj, dict):
            sd = obj
        else:
            return False, f"Unsupported checkpoint format: {type(obj)}"
        sd = strip_module_prefix(sd)
        missing, unexpected = model.load_state_dict(sd, strict=strict)
        msg = f"loaded: {os.path.basename(ckpt_path)} | missing={len(missing)} unexpected={len(unexpected)}"
        return True, msg
    except Exception as e:
        return False, f"load failed: {os.path.basename(ckpt_path)} | {repr(e)}"


