# Main
# =========================================================
def main():
    ap = argparse.ArgumentParser()

    ap.add_argument("--data_dir", type=str, required=True)
    ap.add_argument("--run_dir", type=str, required=True)
    ap.add_argument("--init_weights", type=str, required=True, help="Path to last.pt to initialize fine-tune")

    ap.add_argument("--seed", type=int, default=42)

    # Phase1 pos crop settings
    ap.add_argument("--pos_total", type=int, default=10000)
    ap.add_argument("--val_total", type=int, default=1000)
    ap.add_argument("--crop_size", type=int, default=512)
    ap.add_argument("--margin", type=float, default=0.25)
    ap.add_argument("--imgsz", type=int, default=640)

    # label polygons
    ap.add_argument("--poly_eps", type=float, default=1.0)
    ap.add_argument("--poly_min_area", type=int, default=5)

    # training
    ap.add_argument("--epochs", type=int, default=50)
    ap.add_argument("--batch", type=int, default=2)
    ap.add_argument("--workers", type=int, default=0)
    ap.add_argument("--amp", type=int, default=0, help="0=FP32 only (recommended), 1=AMP")
    ap.add_argument("--nbs", type=int, default=16)
    ap.add_argument("--save_period", type=int, default=1)
    ap.add_argument("--bn_freeze", type=int, default=1)

    # early stopping (val loss saturation)
    ap.add_argument("--es_min_epochs", type=int, default=5)
    ap.add_argument("--es_patience", type=int, default=10)
    ap.add_argument("--es_min_delta", type=float, default=1e-4)
    ap.add_argument("--es_nan_patience", type=int, default=3)

    # evaluation settings
    ap.add_argument("--eval_conf", type=float, default=0.01)
    ap.add_argument("--eval_iou", type=float, default=0.7)
    ap.add_argument("--match_iou", type=float, default=0.5)
    ap.add_argument("--pred_mask_thr", type=float, default=0.50)
    ap.add_argument("--min_area_pred", type=int, default=1)
    ap.add_argument("--eval_max", type=int, default=0, help="0=all val, else evaluate first N")

    args = ap.parse_args()

    set_seed(args.seed)

    data_dir = Path(args.data_dir)
    run_dir = Path(args.run_dir)
    init_weights = Path(args.init_weights)

    run_dir.mkdir(parents=True, exist_ok=True)

    csv_path = data_dir / "train_ship_segmentations_v2.csv"
    train_img_dir = data_dir / "train_v2"
    assert csv_path.exists(), f"Missing: {csv_path}"
    assert train_img_dir.exists(), f"Missing: {train_img_dir}"
    assert init_weights.exists(), f"Missing init_weights: {init_weights}"

    print("[INIT] Loading RLE CSV...")
    rles = load_airbus_rles(csv_path)

    print("[INIT] Listing train images...")
    all_ids = list_train_images(train_img_dir)
    if len(all_ids) == 0:
        raise RuntimeError(f"No images found in: {train_img_dir}")

    pos_ids = build_pos_ids(all_ids, rles)
    pos_rate = len(pos_ids) / max(1, len(all_ids))
    print(f"[STAT] train all={len(all_ids)} pos={len(pos_ids)} pos_rate={pos_rate:.4f}")

    # 1) Build Phase1 crop dataset (POS only)
    data_yaml, splits_dir, gt_val_dir = build_phase1_crop_dataset(
        data_dir=data_dir,
        run_dir=run_dir,
        pos_ids=pos_ids,
        rles=rles,
        pos_total=int(args.pos_total),
        val_total=int(args.val_total),
        seed=int(args.seed),
        crop_size=int(args.crop_size),
        margin=float(args.margin),
        imgsz=int(args.imgsz),
        poly_eps=float(args.poly_eps),
        poly_min_area=int(args.poly_min_area),
        expect_square=True,
        fail_fast_ratio=0.01,
    )
    print(f"[YAML] data.yaml -> {data_yaml}")

    # 2) Train YOLO seg (fine-tune from init_weights=last.pt)
    print("[TRAIN] Starting Ultralytics training...")
    model = YOLO(init_weights.as_posix())

    # callbacks
    if int(args.bn_freeze) == 1:
        model.add_callback("on_train_epoch_start", freeze_bn_callback)

    stopper = ValLossEarlyStopper(
        min_epochs=int(args.es_min_epochs),
        patience=int(args.es_patience),
        min_delta=float(args.es_min_delta),
        nan_patience=int(args.es_nan_patience),
    )
    model.add_callback("on_fit_epoch_end", stopper)

    # Save meta
    meta = {
        "time": time.strftime("%Y-%m-%d %H:%M:%S"),
        "phase": "phase1_pos10k_crop_only",
        "data_dir": data_dir.as_posix(),
        "init_weights": init_weights.as_posix(),
        "pos_total": int(args.pos_total),
        "val_total": int(args.val_total),
        "crop_size": int(args.crop_size),
        "margin": float(args.margin),
        "imgsz": int(args.imgsz),
        "poly_eps": float(args.poly_eps),
        "poly_min_area": int(args.poly_min_area),
        "seed": int(args.seed),
        "train": {
            "epochs": int(args.epochs),
            "batch": int(args.batch),
            "workers": int(args.workers),
            "amp": bool(int(args.amp)),
            "nbs": int(args.nbs),
            "save_period": int(args.save_period),
            "bn_freeze": bool(int(args.bn_freeze)),
        },
        "earlystop_val_loss": {
            "min_epochs": int(args.es_min_epochs),
            "patience": int(args.es_patience),
            "min_delta": float(args.es_min_delta),
            "nan_patience": int(args.es_nan_patience),
        },
        "eval": {
            "eval_conf": float(args.eval_conf),
            "eval_iou": float(args.eval_iou),
            "match_iou": float(args.match_iou),
            "pred_mask_thr": float(args.pred_mask_thr),
            "min_area_pred": int(args.min_area_pred),
        }
    }
    (run_dir / "meta.json").write_text(json.dumps(meta, indent=2) + "\n")

    # Ultralytics train
    exp_name = "yolo26_phase1_pos10k_crop"
    results = model.train(
        data=data_yaml.as_posix(),
        epochs=int(args.epochs),
        imgsz=int(args.imgsz),
        batch=int(args.batch),
        workers=int(args.workers),
        device=0,  # CUDA_VISIBLE_DEVICES remap
        amp=bool(int(args.amp)),
        project=run_dir.as_posix(),
        name=exp_name,
        exist_ok=True,
        save=True,
        save_period=int(args.save_period),
        nbs=int(args.nbs),
        patience=0,  # disable built-in ES
        verbose=True,
    )

    # 3) Locate weights
    exp_dir = run_dir / exp_name
    weights_dir = exp_dir / "weights"
    best_pt = weights_dir / "best.pt"
    last_pt = weights_dir / "last.pt"

    print(f"[DONE] exp_dir={exp_dir}")
    print(f"[DONE] best={best_pt} exists={best_pt.exists()}")
    print(f"[DONE] last={last_pt} exists={last_pt.exists()}")

    (run_dir / "earlystop_history.json").write_text(json.dumps(stopper.history, indent=2) + "\n")

    # Create run_dir shortcuts (replace-safe)
    if best_pt.exists():
        safe_link_or_copy(best_pt, run_dir / "best.pt")
    if last_pt.exists():
        safe_link_or_copy(last_pt, run_dir / "last.pt")

    # Save model_paths.json (absolute paths)
    model_paths = {
        "phase": "phase1_pos10k_crop_only",
        "init_weights": init_weights.as_posix(),
        "run_dir": run_dir.resolve().as_posix(),
        "exp_dir": exp_dir.resolve().as_posix(),
        "data_yaml": data_yaml.resolve().as_posix(),
        "splits_dir": splits_dir.resolve().as_posix(),
        "gt_val_dir": gt_val_dir.resolve().as_posix(),
        "results_csv": (exp_dir / "results.csv").resolve().as_posix() if (exp_dir / "results.csv").exists() else "",
        "best_pt": best_pt.resolve().as_posix() if best_pt.exists() else "",
        "last_pt": last_pt.resolve().as_posix() if last_pt.exists() else "",
        "shortcut_best_pt": (run_dir / "best.pt").resolve().as_posix() if (run_dir / "best.pt").exists() else "",
        "shortcut_last_pt": (run_dir / "last.pt").resolve().as_posix() if (run_dir / "last.pt").exists() else "",
    }
    (run_dir / "model_paths.json").write_text(json.dumps(model_paths, indent=2) + "\n")

    # 4) Evaluate on VAL crops
    eval_root = run_dir / "val_eval"
    ds_root = run_dir / "dataset_phase1_pos10k_crop"

    eval_summaries = {}

    if best_pt.exists():
        eval_summaries["best"] = eval_on_val_crops(
            model_pt=best_pt,
            ds_root=ds_root,
            gt_val_dir=gt_val_dir,
            out_dir=eval_root / "best",
            imgsz=int(args.imgsz),
            conf=float(args.eval_conf),
            iou=float(args.eval_iou),
            match_iou=float(args.match_iou),
            pred_mask_thr=float(args.pred_mask_thr),
            min_area_pred=int(args.min_area_pred),
            seed=int(args.seed),
            max_eval=int(args.eval_max),
        )

    if last_pt.exists():
        eval_summaries["last"] = eval_on_val_crops(
            model_pt=last_pt,
            ds_root=ds_root,
            gt_val_dir=gt_val_dir,
            out_dir=eval_root / "last",
            imgsz=int(args.imgsz),
            conf=float(args.eval_conf),
            iou=float(args.eval_iou),
            match_iou=float(args.match_iou),
            pred_mask_thr=float(args.pred_mask_thr),
            min_area_pred=int(args.min_area_pred),
            seed=int(args.seed),
            max_eval=int(args.eval_max),
        )

    (run_dir / "val_eval_summary_all.json").write_text(json.dumps(eval_summaries, indent=2) + "\n")

    print("[FIN] Phase1 training done.")
    print(f"  run_dir         = {run_dir}")
    print(f"  model_paths.json= {run_dir / 'model_paths.json'}")
    print(f"  best.pt shortcut= {run_dir / 'best.pt'}")
    print(f"  last.pt shortcut= {run_dir / 'last.pt'}")
    print(f"  val_eval_summary= {run_dir / 'val_eval_summary_all.json'}")


if __name__ == "__main__":
    main()
