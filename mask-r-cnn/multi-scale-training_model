def main():
    args = build_argparser().parse_args()
    set_seed(args.seed)

    device = torch.device(args.device if (torch.cuda.is_available() or args.device == "cpu") else "cpu")

    data_dir = args.data_dir
    train_img_dir = os.path.join(data_dir, "train_v2")
    test_img_dir = os.path.join(data_dir, "test_v2")
    csv_train = os.path.join(data_dir, "train_ship_segmentations_v2.csv")
    csv_sub = os.path.join(data_dir, "sample_submission_v2.csv")

    if not os.path.isdir(train_img_dir):
        raise FileNotFoundError(train_img_dir)
    if not os.path.isdir(test_img_dir):
        raise FileNotFoundError(test_img_dir)
    if not os.path.isfile(csv_train):
        raise FileNotFoundError(csv_train)
    if not os.path.isfile(csv_sub):
        raise FileNotFoundError(csv_sub)

    run_name = args.run_name.strip()
    if run_name == "":
        run_name = f"run__maskrcnn_single_1to3__seed{args.seed}__train{args.train_n}__pos{args.pos_neg_ratio.replace(':','_')}__valr{int(args.val_ratio*100)}__{int(time.time())}"

    run_dir = os.path.join(args.out_dir, run_name)
    ensure_dir(run_dir)

    log_global = Logger(os.path.join(run_dir, "log_global.txt"))
    log_detail = Logger(os.path.join(run_dir, "log_detail.txt"))

    log_global.log(f"[run] run_dir={run_dir}")
    log_global.log(f"[run] device={device}")
    log_global.log(f"[run] args={vars(args)}")

    atomic_write_json(os.path.join(run_dir, "config.json"), vars(args))

    # integrity scan
    integrity_json = os.path.join(run_dir, "image_integrity_cache.json")
    integ = integrity_scan(train_img_dir, test_img_dir, integrity_json, log_global, force=bool(args.force_integrity))
    train_valid = set(integ["train_valid"])
    test_valid = set(integ["test_valid"])

    # load id2rles
    log_global.log("[csv] loading id2rles ...")
    id2rles = load_id2rles(csv_train)
    log_global.log(f"[csv] id2rles pos_images={len(id2rles)}")

    # ALL_TRAIN_IDS from directory (ship-negative included)
    all_train_files = list_image_files(train_img_dir)
    all_train_ids = [strip_ext(fn) for fn in all_train_files if strip_ext(fn) in train_valid]
    log_global.log(f"[ids] all_train_ids(from dir)={len(all_train_ids)}")

    # pos/neg split
    pos_ids, neg_ids = [], []
    for img_id in all_train_ids:
        rles = id2rles.get(img_id + ".jpg", None)
        if rles is None:
            rles = id2rles.get(img_id, [])
        if rles and len(rles) > 0:
            pos_ids.append(img_id)
        else:
            neg_ids.append(img_id)
    log_global.log(f"[ids] pos={len(pos_ids)} neg={len(neg_ids)} pos_rate={len(pos_ids)/max(1,len(all_train_ids)):.4f}")

    # detector probs (train + test template)
    det_probs = {}
    det_csv_train = os.path.join(run_dir, "detector_probs_train.csv")
    det_csv_test = os.path.join(run_dir, "detector_probs_test.csv")

    if args.detector_ckpt.strip() != "":
        det_probs = compute_detector_probs(
            detector_ckpt=args.detector_ckpt,
            img_dir=train_img_dir,
            image_ids=all_train_ids,
            out_csv=det_csv_train,
            device=device,
            logger=log_global,
            det_img_size=args.det_img_size,
            limit=args.rank_score_all_limit
        )
        test_template_ids = [strip_ext(x) for x in read_sample_submission_ids(csv_sub)]
        test_template_ids = [i for i in test_template_ids if i in test_valid]
        _ = compute_detector_probs(
            detector_ckpt=args.detector_ckpt,
            img_dir=test_img_dir,
            image_ids=test_template_ids,
            out_csv=det_csv_test,
            device=device,
            logger=log_global,
            det_img_size=args.det_img_size,
            limit=-1
        )
    else:
        with open(det_csv_train, "w", encoding="utf-8", newline="") as f:
            w = csv.writer(f); w.writerow(["ImageId", "prob"])
        with open(det_csv_test, "w", encoding="utf-8", newline="") as f:
            w = csv.writer(f); w.writerow(["ImageId", "prob"])
        log_global.log("[detector] no detector_ckpt; wrote empty prob csvs")

    # optional detector prioritized pool
    pos_ids_use, neg_ids_use = pos_ids, neg_ids
    if det_probs:
        pool_ids = detector_prioritized_pool(all_train_ids, det_probs, topk=args.det_topk_pool, logger=log_global)
        pool_set = set(pool_ids)
        pos_ids_use = [i for i in pos_ids if i in pool_set]
        neg_ids_use = [i for i in neg_ids if i in pool_set]
        log_global.log(f"[sample] pool_pos={len(pos_ids_use)} pool_neg={len(neg_ids_use)}")

    pos_frac = parse_pos_frac(args.pos_frac, args.pos_neg_ratio)
    used_ids = stratified_sample(pos_ids_use, neg_ids_use, args.train_n, pos_frac, args.seed)
    train_ids, val_ids = split_train_val(used_ids, args.val_ratio, args.seed)

    log_global.log(f"[split] used={len(used_ids)} train={len(train_ids)} val={len(val_ids)} pos_frac={pos_frac:.3f}")

    splits = {
        "all_train_ids": len(all_train_ids),
        "pos_ids": len(pos_ids),
        "neg_ids": len(neg_ids),
        "used_ids": used_ids,
        "train_ids": train_ids,
        "val_ids": val_ids,
        "created_at": now_str(),
    }
    atomic_write_json(os.path.join(run_dir, "splits.json"), splits)

    # parse tune grids
    score_thr_grid = [float(x) for x in args.score_thr_grid.split(",") if x.strip() != ""]
    mask_thr_grid = [float(x) for x in args.mask_thr_grid.split(",") if x.strip() != ""]
    min_area_grid = [int(x) for x in args.min_area_grid.split(",") if x.strip() != ""]

    # model / optimizer
    model = build_maskrcnn(pretrained=args.pretrained)
    model.to(device)
    optimizer = optim.AdamW(model.parameters(), lr=args.lr, weight_decay=args.weight_decay)

    summary = {
        "run_dir": run_dir,
        "device": str(device),
        "seed": args.seed,
        "phases": {},
        "created_at": now_str(),
    }
    atomic_write_json(os.path.join(run_dir, "summary.json"), summary)

    def make_loaders(train_size: int, augment: bool):
        ds_tr = AirbusMaskRCNNDataset(train_img_dir, train_ids, id2rles, train_size=train_size, augment=augment)
        ds_va = AirbusMaskRCNNDataset(train_img_dir, val_ids, id2rles, train_size=train_size, augment=False)

        dl_tr = DataLoader(ds_tr, batch_size=args.batch_train, shuffle=True,
                           num_workers=args.num_workers, pin_memory=True, collate_fn=collate_fn)
        dl_va = DataLoader(ds_va, batch_size=args.batch_eval, shuffle=False,
                           num_workers=args.num_workers, pin_memory=True, collate_fn=collate_fn)
        return dl_tr, dl_va

    def run_phase(phase_name: str, epochs: int, fixed_size: Optional[int] = None, multiscale_sizes: Optional[List[int]] = None):
        nonlocal summary, model, optimizer

        phase_dir = os.path.join(run_dir, phase_name)
        ensure_dir(phase_dir)

        best_path = os.path.join(phase_dir, "best_model.pt")
        last_path = os.path.join(phase_dir, "last_model.pt")
        meta_path = os.path.join(phase_dir, "meta.json")

        es = EarlyStopping(patience=args.patience, min_delta=args.min_delta)

        cur_score_thr = float(args.score_thr)
        cur_mask_thr = float(args.mask_thr)
        cur_min_area = int(args.min_area)

        best_epoch = -1
        best_metric = -1e18
        last_saved_once = False
        best_tune = None

        for epoch in range(epochs):
            if multiscale_sizes is not None and len(multiscale_sizes) > 0:
                ts = random.choice(multiscale_sizes)
            else:
                ts = int(fixed_size)

            dl_tr, dl_va = make_loaders(ts, augment=True)

            log_global.log(f"[{phase_name}] epoch={epoch} train_size={ts}")

            tr_stat = train_one_epoch(model, dl_tr, optimizer, device, log_global, log_detail, epoch)

            ev = eval_on_loader(model, dl_va, device, cur_score_thr, cur_mask_thr, cur_min_area,
                                beta=args.beta, logger=log_global, max_batches=-1)
            metric = float(ev.get(f"f{int(args.beta)}", -1e18))

            if args.tune:
                tune = tune_thresholds(model, dl_va, device, beta=args.beta,
                                       score_thr_grid=score_thr_grid,
                                       mask_thr_grid=mask_thr_grid,
                                       min_area_grid=min_area_grid,
                                       tune_limit=args.tune_limit,
                                       logger=log_global)
                cur_score_thr = float(tune["score_thr"])
                cur_mask_thr = float(tune["mask_thr"])
                cur_min_area = int(tune["min_area"])
                best_tune = tune

                ev_tuned = eval_on_loader(model, dl_va, device, cur_score_thr, cur_mask_thr, cur_min_area,
                                          beta=args.beta, logger=log_global, max_batches=-1)
                metric = float(ev_tuned.get(f"f{int(args.beta)}", metric))

            is_best, stop = es.step(metric)
            if is_best:
                best_epoch = epoch
                best_metric = metric
                save_model(best_path, model, log_global)

            # ALWAYS save last each epoch
            save_model(last_path, model, log_global)
            last_saved_once = True

            meta = {
                "phase": phase_name,
                "epoch": epoch,
                "train_size": ts,
                "metric": metric,
                "best_metric": es.best,
                "best_epoch": best_epoch,
                "score_thr": cur_score_thr,
                "mask_thr": cur_mask_thr,
                "min_area": cur_min_area,
                "train_stat": tr_stat,
                "eval": ev,
                "tune": best_tune,
                "created_at": now_str(),
            }
            atomic_write_json(meta_path, meta)

            if stop:
                log_global.log(f"[{phase_name}] early stop at epoch={epoch} best_epoch={best_epoch} best_metric={best_metric:.6f}")
                break

        if not last_saved_once:
            save_model(last_path, model, log_global)

        summary["phases"][phase_name] = {
            "best_model": best_path if os.path.exists(best_path) else "",
            "last_model": last_path if os.path.exists(last_path) else "",
            "best_epoch": best_epoch,
            "best_metric": float(best_metric),
            "final_score_thr": float(cur_score_thr),
            "final_mask_thr": float(cur_mask_thr),
            "final_min_area": int(cur_min_area),
        }
        atomic_write_json(os.path.join(run_dir, "summary.json"), summary)

        # load best for next phase if exists
        if os.path.exists(best_path):
            load_model(best_path, model, device, log_global)
        else:
            if os.path.exists(last_path):
                load_model(last_path, model, device, log_global)

    # ---------------------------
    # Phase1 -> Phase2 -> Phase3
    # ---------------------------
    run_phase("phase1", epochs=args.epochs1, fixed_size=args.phase1_train_size, multiscale_sizes=None)
    run_phase("phase2", epochs=args.epochs2, fixed_size=args.phase2_train_size, multiscale_sizes=None)

    ms_sizes = [int(x) for x in args.phase3_sizes.split(",") if x.strip() != ""]
    if len(ms_sizes) == 0:
        raise ValueError("phase3_sizes must not be empty")
    run_phase("phase3_multiscale", epochs=args.epochs3, fixed_size=None, multiscale_sizes=ms_sizes)

    log_global.log("[done] phase1->phase2->phase3 finished")
    log_global.close()
    log_detail.close()


if __name__ == "__main__":
    main()
