def set_seed(seed: int) -> None:
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)
    torch.backends.cudnn.deterministic = True
    torch.backends.cudnn.benchmark = False


def is_ddp() -> bool:
    return "RANK" in os.environ and "WORLD_SIZE" in os.environ


def ddp_rank() -> int:
    return int(os.environ.get("RANK", "0"))


def ddp_world_size() -> int:
    return int(os.environ.get("WORLD_SIZE", "1"))


def ddp_local_rank() -> int:
    return int(os.environ.get("LOCAL_RANK", "0"))


def ddp_init() -> Tuple[torch.device, int, int, int]:
    if is_ddp():
        dist.init_process_group(backend="nccl", init_method="env://")
        rank = ddp_rank()
        local_rank = ddp_local_rank()
        world = ddp_world_size()
        torch.cuda.set_device(local_rank)
        device = torch.device(f"cuda:{local_rank}")
    else:
        rank = 0
        local_rank = 0
        world = 1
        device = torch.device("cuda:0" if torch.cuda.is_available() else "cpu")
    return device, rank, local_rank, world


def ddp_barrier():
    if is_ddp():
        dist.barrier()


def ddp_all_reduce_sum(x: torch.Tensor) -> torch.Tensor:
    if is_ddp():
        dist.all_reduce(x, op=dist.ReduceOp.SUM)
    return x


def mkdir_p(path: str) -> None:
    os.makedirs(path, exist_ok=True)


def save_json(path: str, obj) -> None:
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(obj, f, ensure_ascii=False, indent=2)
    os.replace(tmp, path)


def load_json(path: str):
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)


def now_ts() -> int:
    return int(time.time())


def human_time() -> str:
    return datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")


def parse_ratio_str(s: str) -> Optional[float]:
    """
    Parse "pos:neg" like "1:3" into pos_frac = pos / (pos+neg).
    Returns None if s empty.
    """
    if s is None:
        return None
    s = str(s).strip()
    if s == "":
        return None
    m = re.match(r"^\s*(\d+)\s*:\s*(\d+)\s*$", s)
    if not m:
        raise ValueError(f"Invalid --pos_neg_ratio '{s}'. Expected like '1:3'.")
    pos = int(m.group(1))
    neg = int(m.group(2))
    if pos < 0 or neg < 0:
        raise ValueError("pos and neg must be >=0 in ratio.")
    tot = pos + neg
    if tot <= 0:
        raise ValueError("pos+neg must be > 0.")
    if pos == 0:
        return 0.0
    return float(pos) / float(tot)


