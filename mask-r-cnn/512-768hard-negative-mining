@torch.no_grad()
def infer_probs_to_csv(
    stage_dir: str,
    tag: str,
    model: nn.Module,
    device: torch.device,
    rank: int,
    world: int,
    ds: AirbusDetDataset,
    batch: int,
    num_workers: int,
    ckpt_path: str,
) -> str:
    """
    Write probs CSV:
      ImageId,Label,Prob
    """
    mkdir_p(stage_dir)

    map_loc = {"cuda:0": str(device)}
    sd = torch.load(ckpt_path, map_location=map_loc)
    model.load_state_dict(sd, strict=True)
    model = model.to(device)
    model.eval()

    sampler = None
    if is_ddp():
        sampler = DistributedSampler(ds, num_replicas=world, rank=rank, shuffle=False, drop_last=False)

    loader = DataLoader(
        ds, batch_size=int(batch), shuffle=False, sampler=sampler,
        num_workers=int(num_workers), pin_memory=True, drop_last=False
    )

    tmp_csv = os.path.join(stage_dir, f"_tmp_probs_{tag}_rank{rank}.csv")
    with open(tmp_csv, "w", newline="", encoding="utf-8") as f:
        w = csv.writer(f)
        w.writerow(["ImageId", "Label", "Prob"])
        for names, x, y in loader:
            x = x.to(device, non_blocking=True)
            logits = model(x).detach().float().cpu().numpy().reshape(-1)
            prob = sigmoid_np(logits)
            y_np = y.detach().float().cpu().numpy().reshape(-1)
            for nm, yy, pp in zip(names, y_np, prob):
                w.writerow([nm, int(yy >= 0.5), float(pp)])

    ddp_barrier()

    out_csv = os.path.join(stage_dir, f"probs_{tag}.csv")
    if rank == 0:
        with open(out_csv, "w", newline="", encoding="utf-8") as fo:
            wout = csv.writer(fo)
            wout.writerow(["ImageId", "Label", "Prob"])
            for r in range(int(world)):
                p = os.path.join(stage_dir, f"_tmp_probs_{tag}_rank{r}.csv")
                with open(p, "r", encoding="utf-8") as fi:
                    rr = csv.reader(fi)
                    _ = next(rr, None)
                    for row in rr:
                        wout.writerow(row)
        for r in range(int(world)):
            p = os.path.join(stage_dir, f"_tmp_probs_{tag}_rank{r}.csv")
            try:
                os.remove(p)
            except Exception:
                pass

    ddp_barrier()
    return out_csv


def read_probs_csv(path: str) -> Dict[str, Tuple[int, float]]:
    """
    Return map: ImageId -> (Label, Prob)
    """
    m = {}
    with open(path, "r", encoding="utf-8") as f:
        rr = csv.DictReader(f)
        for row in rr:
            img = (row.get("ImageId") or "").strip()
            if img == "":
                continue
            lab = int(float(row.get("Label", "0")))
            prob = float(row.get("Prob", "nan"))
            m[img] = (lab, prob)
    return m


# ============================================================
# Hard Example Mining for Stage2
# ============================================================

def build_stage2_train_ids_hem(
    train_ids_base: List[str],
    pos_set: set,
    probs_map: Dict[str, Tuple[int, float]],
    train_n: int,
    pos_frac: float,
    seed: int,
    hem_enable: int,
    hem_pos_k: int,
    hem_neg_k: int,
    hem_pos_frac: float,
    hem_neg_frac: float,
    hem_keep_hard_always: int,
) -> Tuple[List[str], Dict[str, Any]]:
    """
    HEM:
      - hard_pos: label=1 and low prob (ascending)
      - hard_neg: label=0 and high prob (descending)
    Then fill remaining to match pos_frac on the final stage2 train set.

    Returns: (stage2_train_ids, info)
    """
    rng = np.random.RandomState(seed)

    # split pos/neg from base
    pos_ids = [i for i in train_ids_base if i in pos_set]
    neg_ids = [i for i in train_ids_base if i not in pos_set]

    # if HEM disabled: just stratified sample from base
    if int(hem_enable) != 1:
        rng.shuffle(pos_ids)
        rng.shuffle(neg_ids)
        n_pos = int(round(train_n * pos_frac))
        n_pos = max(1, min(n_pos, len(pos_ids)))
        n_neg = train_n - n_pos
        n_neg = max(1, min(n_neg, len(neg_ids)))
        if n_pos + n_neg != train_n:
            n_neg = train_n - n_pos
            if n_neg <= 0:
                n_neg = 1
                n_pos = train_n - 1
        out = pos_ids[:n_pos] + neg_ids[:n_neg]
        rng.shuffle(out)
        info = {
            "hem_enable": 0,
            "train_n": int(train_n),
            "pos_frac_target": float(pos_frac),
            "selected_pos": int(sum([1 for x in out if x in pos_set])),
            "selected_neg": int(sum([1 for x in out if x not in pos_set])),
        }
        return out, info

    # build (id, prob)
    pos_pairs, neg_pairs = [], []
    missing = 0
    for i in train_ids_base:
        if i not in probs_map:
            missing += 1
            continue
        lab, p = probs_map[i]
        if i in pos_set:
            pos_pairs.append((i, float(p)))
        else:
            neg_pairs.append((i, float(p)))

    # sort for hardness
    pos_pairs.sort(key=lambda x: x[1])      # low prob = hard pos
    neg_pairs.sort(key=lambda x: x[1], reverse=True)  # high prob = hard neg

    # determine k
    if int(hem_pos_k) > 0:
        k_pos = min(int(hem_pos_k), len(pos_pairs))
    else:
        k_pos = int(round(len(pos_pairs) * float(hem_pos_frac)))
        k_pos = max(0, min(k_pos, len(pos_pairs)))

    if int(hem_neg_k) > 0:
        k_neg = min(int(hem_neg_k), len(neg_pairs))
    else:
        k_neg = int(round(len(neg_pairs) * float(hem_neg_frac)))
        k_neg = max(0, min(k_neg, len(neg_pairs)))

    hard_pos = [i for (i, _p) in pos_pairs[:k_pos]]
    hard_neg = [i for (i, _p) in neg_pairs[:k_neg]]
    hard_set = set(hard_pos + hard_neg)

    # if hard exceeds train_n, we must cut (prefer keep_hard_always=1 -> cut by hardness ordering)
    if len(hard_set) > int(train_n):
        # keep most hard among pos (lowest) and neg (highest)
        hp = hard_pos
        hn = hard_neg
        keep = []
        # interleave to avoid single-class domination
        a = 0
        b = 0
        while len(keep) < int(train_n) and (a < len(hp) or b < len(hn)):
            if a < len(hp):
                keep.append(hp[a]); a += 1
                if len(keep) >= int(train_n):
                    break
            if b < len(hn):
                keep.append(hn[b]); b += 1
        hard_set = set(keep)

    # fill remaining to match pos_frac
    n_pos_target = int(round(train_n * pos_frac))
    n_pos_target = max(0, min(n_pos_target, len(pos_ids)))
    n_neg_target = train_n - n_pos_target
    n_neg_target = max(0, min(n_neg_target, len(neg_ids)))
    if n_pos_target + n_neg_target != train_n:
        n_neg_target = train_n - n_pos_target
        if n_neg_target < 0:
            n_neg_target = 0
            n_pos_target = train_n

    # count hard already
    hard_pos_cnt = sum([1 for x in hard_set if x in pos_set])
    hard_neg_cnt = sum([1 for x in hard_set if x not in pos_set])

    # required additional
    need_pos = max(0, n_pos_target - hard_pos_cnt)
    need_neg = max(0, n_neg_target - hard_neg_cnt)

    # pools excluding hard
    pos_pool = [x for x in pos_ids if x not in hard_set]
    neg_pool = [x for x in neg_ids if x not in hard_set]
    rng.shuffle(pos_pool)
    rng.shuffle(neg_pool)

    add_pos = pos_pool[:need_pos]
    add_neg = neg_pool[:need_neg]

    stage2 = list(hard_set) + add_pos + add_neg
    # if still short (due to lack), fill from remaining any class
    if len(stage2) < int(train_n):
        rem = [x for x in (pos_pool[need_pos:] + neg_pool[need_neg:]) if x not in set(stage2)]
        rng.shuffle(rem)
        stage2.extend(rem[:(int(train_n) - len(stage2))])

    # if overshoot, cut (prefer keep hard)
    if len(stage2) > int(train_n):
        if int(hem_keep_hard_always) == 1:
            # keep hard + trim extras
            hard_list = [x for x in stage2 if x in hard_set]
            other_list = [x for x in stage2 if x not in hard_set]
            rng.shuffle(other_list)
            stage2 = hard_list + other_list
            stage2 = stage2[:int(train_n)]
        else:
            rng.shuffle(stage2)
            stage2 = stage2[:int(train_n)]

    rng.shuffle(stage2)

    info = {
        "hem_enable": 1,
        "missing_in_probs": int(missing),
        "train_n": int(train_n),
        "pos_frac_target": float(pos_frac),
        "base_train_ids": int(len(train_ids_base)),
        "base_pos": int(len(pos_ids)),
        "base_neg": int(len(neg_ids)),
        "k_pos": int(k_pos),
        "k_neg": int(k_neg),
        "hard_pos_cnt": int(hard_pos_cnt),
        "hard_neg_cnt": int(hard_neg_cnt),
        "selected_pos": int(sum([1 for x in stage2 if x in pos_set])),
        "selected_neg": int(sum([1 for x in stage2 if x not in pos_set])),
    }
    hard_info = {
        "hard_pos": hard_pos,
        "hard_neg": hard_neg,
    }
    return stage2, {"info": info, "hard": hard_info}


# ============================================================
# Platt scaling calibration (rank0)
# ============================================================

def platt_fit(y_true: np.ndarray, y_prob: np.ndarray, max_iter: int = 2000, lr: float = 0.05) -> Dict[str, float]:
    """
    Fit Platt scaling: calibrated = sigmoid(A * logit(p) + B)
    We optimize A,B with torch on CPU for simplicity.
    """
    # clip to avoid inf
    eps = 1e-6
    p = np.clip(y_prob.astype(np.float32), eps, 1.0 - eps)
    logit = np.log(p / (1.0 - p)).astype(np.float32)
    y = (y_true >= 0.5).astype(np.float32)

    X = torch.tensor(logit, dtype=torch.float32)
    Y = torch.tensor(y, dtype=torch.float32)

    A = torch.tensor(1.0, dtype=torch.float32, requires_grad=True)
    B = torch.tensor(0.0, dtype=torch.float32, requires_grad=True)

    opt = torch.optim.Adam([A, B], lr=float(lr))

    for _ in range(int(max_iter)):
        opt.zero_grad(set_to_none=True)
        z = A * X + B
        loss = nn.functional.binary_cross_entropy_with_logits(z, Y)
        loss.backward()
        opt.step()

    return {"A": float(A.detach().item()), "B": float(B.detach().item())}


def platt_apply(prob: np.ndarray, A: float, B: float) -> np.ndarray:
    eps = 1e-6
    p = np.clip(prob.astype(np.float32), eps, 1.0 - eps)
    logit = np.log(p / (1.0 - p)).astype(np.float32)
    z = A * logit + B
    return sigmoid_np(z.astype(np.float32))


def write_probs_calibrated_csv(in_csv: str, out_csv: str, A: float, B: float) -> None:
    with open(in_csv, "r", encoding="utf-8") as fi:
        rr = csv.DictReader(fi)
        rows = []
        for row in rr:
            img = (row.get("ImageId") or "").strip()
            lab = row.get("Label", "")
            p = float(row.get("Prob", "nan"))
            pc = float(platt_apply(np.array([p], dtype=np.float32), A, B)[0])
            rows.append((img, lab, p, pc))

    with open(out_csv, "w", newline="", encoding="utf-8") as fo:
        w = csv.writer(fo)
        w.writerow(["ImageId", "Label", "Prob", "ProbCal"])
        for (img, lab, p, pc) in rows:
            w.writerow([img, lab, p, pc])


