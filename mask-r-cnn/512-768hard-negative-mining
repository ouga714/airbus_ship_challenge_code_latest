def build_model(model_name: str, pretrained: bool) -> nn.Module:
    name = model_name.lower().strip()

    if name in ["effnetv2_s", "efficientnet_v2_s", "efficientnetv2_s"]:
        weights = torchvision.models.EfficientNet_V2_S_Weights.DEFAULT if pretrained else None
        m = torchvision.models.efficientnet_v2_s(weights=weights)
        in_f = m.classifier[1].in_features
        m.classifier[1] = nn.Linear(in_f, 1)
        return m

    if name in ["effnetv2_m", "efficientnet_v2_m", "efficientnetv2_m"]:
        weights = torchvision.models.EfficientNet_V2_M_Weights.DEFAULT if pretrained else None
        m = torchvision.models.efficientnet_v2_m(weights=weights)
        in_f = m.classifier[1].in_features
        m.classifier[1] = nn.Linear(in_f, 1)
        return m

    if name in ["resnet50"]:
        weights = torchvision.models.ResNet50_Weights.DEFAULT if pretrained else None
        m = torchvision.models.resnet50(weights=weights)
        in_f = m.fc.in_features
        m.fc = nn.Linear(in_f, 1)
        return m

    raise ValueError(f"Unknown model_name='{model_name}'. Try effnetv2_s / effnetv2_m / resnet50.")


# ============================================================
# Metrics
# ============================================================

def sigmoid_np(x: np.ndarray) -> np.ndarray:
    x = np.clip(x, -60, 60)
    return 1.0 / (1.0 + np.exp(-x))


def auroc_fast(y_true: np.ndarray, y_prob: np.ndarray) -> float:
    y = (y_true >= 0.5).astype(np.int32)
    n_pos = int(np.sum(y == 1))
    n_neg = int(np.sum(y == 0))
    if n_pos == 0 or n_neg == 0:
        return 0.5

    order = np.argsort(y_prob)
    sorted_prob = y_prob[order]
    sorted_y = y[order]

    i = 0
    rank_sum_pos = 0.0
    while i < len(sorted_prob):
        j = i + 1
        while j < len(sorted_prob) and sorted_prob[j] == sorted_prob[i]:
            j += 1
        avg_rank = 0.5 * (i + (j - 1))
        pos_in_block = int(np.sum(sorted_y[i:j] == 1))
        rank_sum_pos += float(pos_in_block) * float(avg_rank)
        i = j

    u = rank_sum_pos - (n_pos * (n_pos - 1) / 2.0)
    auc = u / float(n_pos * n_neg)
    return float(auc)


def compute_confusion(y_true: np.ndarray, y_prob: np.ndarray, thr: float) -> Dict[str, int]:
    y_pred = (y_prob >= thr).astype(np.int32)
    y_true_i = (y_true >= 0.5).astype(np.int32)
    tp = int(np.sum((y_pred == 1) & (y_true_i == 1)))
    fp = int(np.sum((y_pred == 1) & (y_true_i == 0)))
    fn = int(np.sum((y_pred == 0) & (y_true_i == 1)))
    tn = int(np.sum((y_pred == 0) & (y_true_i == 0)))
    return {"TP": tp, "FP": fp, "FN": fn, "TN": tn}


def fbeta_from_conf(tp: int, fp: int, fn: int, beta: float) -> float:
    beta2 = beta * beta
    denom = (1 + beta2) * tp + beta2 * fn + fp
    if denom <= 0:
        return 0.0
    return float((1 + beta2) * tp) / float(denom)


def precision_recall_f1_from_conf(tp: int, fp: int, fn: int) -> Tuple[float, float, float]:
    prec = float(tp) / float(tp + fp) if (tp + fp) > 0 else 0.0
    rec  = float(tp) / float(tp + fn) if (tp + fn) > 0 else 0.0
    f1   = (2 * prec * rec / (prec + rec)) if (prec + rec) > 0 else 0.0
    return prec, rec, f1


def tune_threshold_max_fbeta(y_true: np.ndarray, y_prob: np.ndarray, beta: float, grid_n: int) -> Dict[str, Any]:
    best_thr = 0.5
    best_f = -1.0
    best_conf = None

    if grid_n <= 1:
        grid = [0.5]
    else:
        grid = [k / float(grid_n - 1) for k in range(grid_n)]

    for thr in grid:
        conf = compute_confusion(y_true, y_prob, thr)
        f = fbeta_from_conf(conf["TP"], conf["FP"], conf["FN"], beta)
        if f > best_f:
            best_f = f
            best_thr = thr
            best_conf = conf

    prec, rec, f1 = precision_recall_f1_from_conf(best_conf["TP"], best_conf["FP"], best_conf["FN"])
    return {
        "best_thr": float(best_thr),
        "best_fbeta": float(best_f),
        "best_precision": float(prec),
        "best_recall": float(rec),
        "best_f1": float(f1),
        "conf": best_conf,
    }


# ============================================================
# Losses (BCE / Focal)
# ============================================================

def bce_with_logits_loss(logits: torch.Tensor, targets: torch.Tensor, pos_weight: float = 1.0) -> torch.Tensor:
    """
    logits: [B,1], targets: [B,1]
    pos_weight: >1.0 increases positive loss weight
    """
    if pos_weight is not None and float(pos_weight) != 1.0:
        pw = torch.tensor([float(pos_weight)], device=logits.device, dtype=logits.dtype)
        return nn.functional.binary_cross_entropy_with_logits(logits, targets, pos_weight=pw)
    return nn.functional.binary_cross_entropy_with_logits(logits, targets)


def focal_bce_with_logits(
    logits: torch.Tensor,
    targets: torch.Tensor,
    gamma: float = 2.0,
    alpha: float = 0.25,
    pos_weight: float = 1.0
) -> torch.Tensor:
    """
    Focal loss (binary) on logits.
    alpha: weight for positive class (common default 0.25)
    gamma: focusing parameter
    """
    # base BCE (per-sample)
    if pos_weight is not None and float(pos_weight) != 1.0:
        pw = torch.tensor([float(pos_weight)], device=logits.device, dtype=logits.dtype)
        bce = nn.functional.binary_cross_entropy_with_logits(logits, targets, pos_weight=pw, reduction="none")
    else:
        bce = nn.functional.binary_cross_entropy_with_logits(logits, targets, reduction="none")

    p = torch.sigmoid(logits)
    pt = p * targets + (1.0 - p) * (1.0 - targets)  # prob of true class
    w = (alpha * targets + (1.0 - alpha) * (1.0 - targets)) * torch.pow((1.0 - pt).clamp_min(1e-8), gamma)
    loss = (w * bce).mean()
    return loss


# ============================================================
# Train / Eval
# ============================================================

@dataclass
class EpochResult:
    loss: float
    auroc: float
    tuned_thr: float
    tuned_fbeta: float
    tuned_precision: float
    tuned_recall: float
    tuned_f1: float
    conf: Dict[str, int]


@torch.no_grad()
def eval_one_epoch(
    model: nn.Module,
    loader: DataLoader,
    device: torch.device,
    beta: float,
    thr_grid_n: int,
    rank: int
) -> Tuple[EpochResult, np.ndarray, np.ndarray, List[str]]:
    model.eval()

    all_logits = []
    all_targets = []
    all_names = []
    loss_sum = 0.0
    n_sum = 0

    for names, x, y in loader:
        x = x.to(device, non_blocking=True)
        y = y.to(device, non_blocking=True)

        logits = model(x)
        loss = bce_with_logits_loss(logits, y)

        bs = x.size(0)
        loss_sum += float(loss.item()) * bs
        n_sum += bs

        all_logits.append(logits.detach().float().cpu().numpy().reshape(-1))
        all_targets.append(y.detach().float().cpu().numpy().reshape(-1))
        all_names.extend(list(names))

    local_loss = torch.tensor([loss_sum, n_sum], dtype=torch.float64, device=device)
    ddp_all_reduce_sum(local_loss)
    global_loss = float(local_loss[0].item() / max(1.0, local_loss[1].item()))

    y_logit = np.concatenate(all_logits, axis=0) if len(all_logits) else np.zeros((0,), dtype=np.float32)
    y_true  = np.concatenate(all_targets, axis=0) if len(all_targets) else np.zeros((0,), dtype=np.float32)
    y_prob  = sigmoid_np(y_logit)

    if is_ddp():
        gathered = [None for _ in range(ddp_world_size())]
        dist.all_gather_object(gathered, (all_names, y_true, y_prob))
        if rank == 0:
            names_m, ytrue_m, yprob_m = [], [], []
            for (nm, yt, yp) in gathered:
                names_m.extend(nm)
                ytrue_m.append(yt)
                yprob_m.append(yp)
            y_true = np.concatenate(ytrue_m, axis=0) if len(ytrue_m) else np.zeros((0,), dtype=np.float32)
            y_prob = np.concatenate(yprob_m, axis=0) if len(yprob_m) else np.zeros((0,), dtype=np.float32)
            all_names = names_m
        ddp_barrier()

    if (not is_ddp()) or rank == 0:
        auc = auroc_fast(y_true, y_prob)
        tune = tune_threshold_max_fbeta(y_true, y_prob, beta=beta, grid_n=thr_grid_n)
        res = EpochResult(
            loss=global_loss,
            auroc=float(auc),
            tuned_thr=float(tune["best_thr"]),
            tuned_fbeta=float(tune["best_fbeta"]),
            tuned_precision=float(tune["best_precision"]),
            tuned_recall=float(tune["best_recall"]),
            tuned_f1=float(tune["best_f1"]),
            conf=tune["conf"],
        )
    else:
        res = EpochResult(
            loss=global_loss,
            auroc=0.0,
            tuned_thr=0.5,
            tuned_fbeta=0.0,
            tuned_precision=0.0,
            tuned_recall=0.0,
            tuned_f1=0.0,
            conf={"TP": 0, "FP": 0, "FN": 0, "TN": 0},
        )

    return res, y_true, y_prob, all_names


def train_one_stage(
    stage_dir: str,
    model: nn.Module,
    train_loader: DataLoader,
    val_loader: DataLoader,
    device: torch.device,
    rank: int,
    world: int,
    max_epochs: int,
    patience: int,
    lr: float,
    weight_decay: float,
    beta: float,
    thr_grid_n: int,
    log_every: int,
    clip_grad: float,
    warmup_epochs: int,
    pretrained_ckpt: Optional[str] = None,
    use_focal: int = 0,
    focal_gamma: float = 2.0,
    focal_alpha: float = 0.25,
    pos_weight: float = 1.0,
) -> Dict[str, Any]:
    mkdir_p(stage_dir)

    global_logger = None
    detail_logger = SimpleLogger(os.path.join(stage_dir, f"detail_rank{rank}.log"), also_stdout=False)
    if rank == 0:
        global_logger = SimpleLogger(os.path.join(stage_dir, "global_rank0.log"), also_stdout=True)

    if pretrained_ckpt is not None and pretrained_ckpt.strip() != "":
        map_loc = {"cuda:0": str(device)}
        sd = torch.load(pretrained_ckpt, map_location=map_loc)
        model.load_state_dict(sd, strict=True)
        if rank == 0:
            global_logger.log(f"[init] loaded pretrained_ckpt={pretrained_ckpt}")

    model = model.to(device)
    if is_ddp():
        model = nn.parallel.DistributedDataParallel(
            model, device_ids=[ddp_local_rank()], output_device=ddp_local_rank(), find_unused_parameters=False
        )

    opt = optim.AdamW(model.parameters(), lr=lr, weight_decay=weight_decay)

    def lr_lambda(epoch: int):
        if warmup_epochs > 0 and epoch < warmup_epochs:
            return float(epoch + 1) / float(warmup_epochs)
        t = (epoch - warmup_epochs) / float(max(1, (max_epochs - warmup_epochs)))
        return 0.5 * (1.0 + math.cos(math.pi * min(1.0, max(0.0, t))))

    scheduler = optim.lr_scheduler.LambdaLR(opt, lr_lambda=lr_lambda)

    best_metric = -1e9
    best_epoch = -1
    best_path = os.path.join(stage_dir, "best_model.pt")
    last_path = os.path.join(stage_dir, "last_model.pt")

    bad_epochs = 0
    history = []

    if rank == 0:
        global_logger.log(f"[train] stage_dir={stage_dir}")
        global_logger.log(f"[train] max_epochs={max_epochs} patience={patience} beta={beta} thr_grid_n={thr_grid_n}")
        global_logger.log(f"[train] lr={lr} weight_decay={weight_decay} clip_grad={clip_grad} warmup_epochs={warmup_epochs}")
        global_logger.log(f"[train] ddp=({is_ddp()}) world={world}")
        global_logger.log(f"[loss] use_focal={use_focal} focal_gamma={focal_gamma} focal_alpha={focal_alpha} pos_weight={pos_weight}")

    for epoch in range(int(max_epochs)):
        if is_ddp():
            assert isinstance(train_loader.sampler, DistributedSampler)
            train_loader.sampler.set_epoch(epoch)

        model.train()
        t0 = time.time()
        loss_sum = 0.0
        n_sum = 0

        for step, (names, x, y) in enumerate(train_loader):
            x = x.to(device, non_blocking=True)
            y = y.to(device, non_blocking=True)

            opt.zero_grad(set_to_none=True)

            logits = model(x)

            if int(use_focal) == 1:
                loss = focal_bce_with_logits(
                    logits, y,
                    gamma=float(focal_gamma),
                    alpha=float(focal_alpha),
                    pos_weight=float(pos_weight)
                )
            else:
                loss = bce_with_logits_loss(logits, y, pos_weight=float(pos_weight))

            if not torch.isfinite(loss):
                detail_logger.log(f"[WARN] non-finite loss at epoch={epoch} step={step} loss={loss.item()}")
                continue

            loss.backward()
            if clip_grad and float(clip_grad) > 0:
                nn.utils.clip_grad_norm_(model.parameters(), max_norm=float(clip_grad))
            opt.step()

            bs = x.size(0)
            loss_sum += float(loss.item()) * bs
            n_sum += bs

            if (step % max(1, int(log_every)) == 0) or (step + 1 == len(train_loader)):
                cur_lr = opt.param_groups[0]["lr"]
                detail_logger.log(f"[TRAIN] epoch={epoch} step={step}/{len(train_loader)} loss={loss.item():.6f} lr={cur_lr:.3e}")

        scheduler.step()

        tr_local = torch.tensor([loss_sum, n_sum], dtype=torch.float64, device=device)
        ddp_all_reduce_sum(tr_local)
        tr_loss = float(tr_local[0].item() / max(1.0, tr_local[1].item()))

        val_res, y_true, y_prob, y_names = eval_one_epoch(
            model.module if hasattr(model, "module") else model,
            val_loader, device, beta=float(beta), thr_grid_n=int(thr_grid_n), rank=rank
        )

        metric = val_res.auroc if rank == 0 else 0.0

        if rank == 0:
            dt = time.time() - t0
            global_logger.log(
                f"[EPOCH] epoch={epoch} "
                f"train_loss={tr_loss:.6f} val_loss={val_res.loss:.6f} "
                f"val_auroc={val_res.auroc:.6f} "
                f"tuned_thr={val_res.tuned_thr:.4f} tuned_fbeta={val_res.tuned_fbeta:.6f} "
                f"prec={val_res.tuned_precision:.6f} rec={val_res.tuned_recall:.6f} f1={val_res.tuned_f1:.6f} "
                f"conf={val_res.conf} time={dt:.1f}s"
            )

            history.append({
                "epoch": int(epoch),
                "train_loss": float(tr_loss),
                "val_loss": float(val_res.loss),
                "val_auroc": float(val_res.auroc),
                "tuned_thr": float(val_res.tuned_thr),
                "tuned_fbeta": float(val_res.tuned_fbeta),
                "tuned_precision": float(val_res.tuned_precision),
                "tuned_recall": float(val_res.tuned_recall),
                "tuned_f1": float(val_res.tuned_f1),
                "conf": dict(val_res.conf),
                "lr": float(opt.param_groups[0]["lr"]),
            })

            if metric > best_metric:
                best_metric = metric
                best_epoch = int(epoch)
                bad_epochs = 0

                sd = (model.module if hasattr(model, "module") else model).state_dict()
                torch.save(sd, best_path)
                global_logger.log(f"[CKPT] saved best_model.pt at epoch={epoch} best_auroc={best_metric:.6f}")
            else:
                bad_epochs += 1

            sd = (model.module if hasattr(model, "module") else model).state_dict()
            torch.save(sd, last_path)

            if bad_epochs >= int(patience):
                global_logger.log(f"[ES] early stopping at epoch={epoch} (best_epoch={best_epoch} best_auroc={best_metric:.6f})")
                break

        ddp_barrier()

    stage_summary = {}
    if rank == 0:
        stage_summary = {
            "stage_dir": stage_dir,
            "best_epoch": int(best_epoch),
            "best_metric_auroc": float(best_metric),
            "best_model_path": best_path,
            "last_model_path": last_path,
            "history": history,
        }
        save_json(os.path.join(stage_dir, "summary_stage.json"), stage_summary)

    ddp_barrier()
    if global_logger is not None:
        global_logger.close()
    detail_logger.close()
    return stage_summary


