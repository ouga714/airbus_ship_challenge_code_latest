def read_airbus_csv_pos_set(csv_path: str) -> set:
    """
    train_ship_segmentations_v2.csv contains only ship-positive rows typically.
    Return set of ImageId that have non-empty EncodedPixels.
    """
    pos = set()
    with open(csv_path, "r", encoding="utf-8") as f:
        reader = csv.DictReader(f)
        for row in reader:
            img_id = (row.get("ImageId") or "").strip()
            rle = row.get("EncodedPixels", "")
            if img_id == "":
                continue
            if rle is None:
                continue
            rle_s = str(rle).strip()
            if rle_s != "" and rle_s.lower() != "nan":
                pos.add(img_id)
    return pos


def list_images(dir_path: str) -> List[str]:
    exts = (".jpg", ".jpeg", ".png", ".bmp", ".tif", ".tiff")
    files = []
    for name in os.listdir(dir_path):
        if name.lower().endswith(exts):
            files.append(name)
    files.sort()
    return files


def integrity_scan_image_dir(img_dir: str, cache_path: str, limit: int = 0) -> Dict[str, Any]:
    """
    Decode-scan images; return dict with keys: valid, bad, scanned.
    Cache to json. If cache exists, reuse it.
    """
    if os.path.isfile(cache_path):
        return load_json(cache_path)

    names = list_images(img_dir)
    if limit and limit > 0:
        names = names[:limit]

    valid, bad = [], []
    for fn in names:
        p = os.path.join(img_dir, fn)
        try:
            with Image.open(p) as im:
                im.verify()
            with Image.open(p) as im2:
                im2.convert("RGB")
            valid.append(fn)
        except Exception:
            bad.append(fn)

    out = {"valid": valid, "bad": bad, "scanned": len(names)}
    save_json(cache_path, out)
    return out


def build_splits(
    all_ids: List[str],
    pos_set: set,
    train_n: int,
    val_n: int,
    pos_frac: float,
    seed: int
) -> Dict[str, Any]:
    """
    Stratified splits from directory-enumerated IDs.
    """
    rng = np.random.RandomState(seed)

    pos_ids = [x for x in all_ids if x in pos_set]
    neg_ids = [x for x in all_ids if x not in pos_set]

    if len(pos_ids) == 0:
        raise RuntimeError("No positive ids found. Check CSV path and train_v2 dir.")
    if len(neg_ids) == 0:
        raise RuntimeError("No negative ids found. Check train_v2 dir and CSV path.")

    rng.shuffle(pos_ids)
    rng.shuffle(neg_ids)

    def sample_strat(n_total: int, pos_pool: List[str], neg_pool: List[str]) -> Tuple[List[str], List[str]]:
        n_pos = int(round(n_total * pos_frac))
        n_pos = max(1, min(n_pos, len(pos_pool)))
        n_neg = n_total - n_pos
        n_neg = max(1, min(n_neg, len(neg_pool)))

        if n_pos + n_neg != n_total:
            n_neg = n_total - n_pos
            if n_neg <= 0:
                n_neg = 1
                n_pos = n_total - 1

        if n_pos > len(pos_pool) or n_neg > len(neg_pool):
            raise RuntimeError(
                f"Not enough samples: need pos={n_pos}/{len(pos_pool)} neg={n_neg}/{len(neg_pool)}. "
                f"Reduce train_n/val_n or change pos_frac."
            )
        return pos_pool[:n_pos], neg_pool[:n_neg]

    tr_pos, tr_neg = sample_strat(train_n, pos_ids, neg_ids)
    used_pos = set(tr_pos)
    used_neg = set(tr_neg)

    rem_pos = [x for x in pos_ids if x not in used_pos]
    rem_neg = [x for x in neg_ids if x not in used_neg]

    va_pos, va_neg = sample_strat(val_n, rem_pos, rem_neg)

    train_ids = tr_pos + tr_neg
    val_ids = va_pos + va_neg
    rng.shuffle(train_ids)
    rng.shuffle(val_ids)

    stats = {
        "all": len(all_ids),
        "pos_all": len(pos_ids),
        "neg_all": len(neg_ids),
        "train": len(train_ids),
        "train_pos": sum([1 for x in train_ids if x in pos_set]),
        "train_neg": sum([1 for x in train_ids if x not in pos_set]),
        "val": len(val_ids),
        "val_pos": sum([1 for x in val_ids if x in pos_set]),
        "val_neg": sum([1 for x in val_ids if x not in pos_set]),
        "pos_frac_target": pos_frac,
    }

    return {"train": train_ids, "val": val_ids, "stats": stats}


