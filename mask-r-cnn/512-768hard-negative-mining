        f"__{ts}"
    )


def main():
    ap = argparse.ArgumentParser()

    ap.add_argument("--mode", type=str, default="two_stage",
                    choices=["two_stage", "stage1_only", "stage2_only", "infer_only"])

    ap.add_argument("--data_dir", type=str, required=True)
    ap.add_argument("--out_dir", type=str, required=True)

    # model
    ap.add_argument("--model_name", type=str, default="effnetv2_s")
    ap.add_argument("--pretrained", type=int, default=1)

    # sampling
    ap.add_argument("--train_n", type=int, default=20000)
    ap.add_argument("--val_n", type=int, default=3000)
    ap.add_argument("--pos_frac", type=float, default=0.35,
                    help="Target pos fraction in splits / stage2 strat fill (ignored if pos_neg_ratio set)")
    ap.add_argument("--pos_neg_ratio", type=str, default="",
                    help="Override pos_frac by ratio like '1:3'")

    # stage sizes
    ap.add_argument("--stage1_img_size", type=int, default=512)
    ap.add_argument("--stage2_img_size", type=int, default=712)

    # stage2 multi-scale (optional)
    ap.add_argument("--stage2_multiscale", type=int, default=0,
                    help="1 enables random resize in [ms_min, ms_max] for stage2 training")
    ap.add_argument("--stage2_ms_min", type=int, default=640)
    ap.add_argument("--stage2_ms_max", type=int, default=768)

    # training
    ap.add_argument("--seed", type=int, default=42)
    ap.add_argument("--batch_train", type=int, default=32)
    ap.add_argument("--batch_eval", type=int, default=64)
    ap.add_argument("--num_workers", type=int, default=4)
    ap.add_argument("--lr", type=float, default=3e-4)
    ap.add_argument("--weight_decay", type=float, default=1e-4)
    ap.add_argument("--max_epochs1", type=int, default=30)
    ap.add_argument("--patience1", type=int, default=6)
    ap.add_argument("--max_epochs2", type=int, default=20)
    ap.add_argument("--patience2", type=int, default=6)
    ap.add_argument("--warmup_epochs", type=int, default=2)
    ap.add_argument("--clip_grad", type=float, default=1.0)
    ap.add_argument("--log_every", type=int, default=50)

    # threshold tuning log (not training objective)
    ap.add_argument("--beta", type=float, default=1.0)
    ap.add_argument("--thr_grid_n", type=int, default=101)

    # integrity scan
    ap.add_argument("--integrity_limit", type=int, default=0)

    # Stage2 HEM
    ap.add_argument("--hem_enable", type=int, default=1,
                    help="1 enables hard example mining to build stage2 train set")
    ap.add_argument("--hem_pos_k", type=int, default=0,
                    help="Number of hard positives (label=1 low prob). If 0, use hem_pos_frac.")
    ap.add_argument("--hem_neg_k", type=int, default=0,
                    help="Number of hard negatives (label=0 high prob). If 0, use hem_neg_frac.")
    ap.add_argument("--hem_pos_frac", type=float, default=0.20,
                    help="Fraction of pos in base train_ids to include as hard positives (if hem_pos_k=0).")
    ap.add_argument("--hem_neg_frac", type=float, default=0.20,
                    help="Fraction of neg in base train_ids to include as hard negatives (if hem_neg_k=0).")
    ap.add_argument("--hem_keep_hard_always", type=int, default=1,
                    help="If hard_set exceeds train_n, keep hardest first rather than random cut.")

    # Stage2 focal loss (optional)
    ap.add_argument("--stage2_use_focal", type=int, default=0)
    ap.add_argument("--focal_gamma", type=float, default=2.0)
    ap.add_argument("--focal_alpha", type=float, default=0.25)

    # loss weight (optional)
    ap.add_argument("--pos_weight", type=float, default=1.0,
                    help="pos_weight for BCE/focal. >1 boosts positives.")

    # calibration (optional)
    ap.add_argument("--calibrate_platt", type=int, default=0,
                    help="1 fits Platt scaling on stage2 val probs and writes calibrated CSVs")

    args = ap.parse_args()

    device, rank, local_rank, world = ddp_init()
    set_seed(int(args.seed) + int(rank))

    # ratio override
    ratio_pf = parse_ratio_str(args.pos_neg_ratio)
    if ratio_pf is not None:
        args.pos_frac = float(ratio_pf)

    # paths
    train_dir = os.path.join(args.data_dir, "train_v2")
    test_dir = os.path.join(args.data_dir, "test_v2")
    csv_path = os.path.join(args.data_dir, "train_ship_segmentations_v2.csv")

    if not os.path.isdir(train_dir):
        raise FileNotFoundError(f"train_v2 dir not found: {train_dir}")
    if not os.path.isfile(csv_path):
        raise FileNotFoundError(f"train_ship_segmentations_v2.csv not found: {csv_path}")

    run_name = build_run_name(args)
    run_dir = os.path.join(args.out_dir, run_name)
    stage1_dir = os.path.join(run_dir, "stage1")
    stage2_dir = os.path.join(run_dir, "stage2")

    if rank == 0:
        mkdir_p(run_dir)
        save_json(os.path.join(run_dir, "config.json"), vars(args))

    # integrity scan cache in data_dir (shared across runs)
    integrity_cache_train = os.path.join(args.data_dir, "_integrity_cache_train_v2.json")
    if rank == 0:
        scan = integrity_scan_image_dir(train_dir, integrity_cache_train, limit=int(args.integrity_limit))
        save_json(os.path.join(run_dir, "integrity_train_v2.json"), scan)
    ddp_barrier()

    scan = load_json(integrity_cache_train)
    valid_train_files = scan["valid"]

    # label set
    pos_set = read_airbus_csv_pos_set(csv_path)

    # splits (rank0 decides)
    splits_path = os.path.join(run_dir, "splits.json")
    if rank == 0:
        splits = build_splits(
            all_ids=valid_train_files,
            pos_set=pos_set,
            train_n=int(args.train_n),
            val_n=int(args.val_n),
            pos_frac=float(args.pos_frac),
            seed=int(args.seed)
        )
        save_json(splits_path, splits)
    ddp_barrier()
    splits = load_json(splits_path)

    train_ids = splits["train"]
    val_ids = splits["val"]

    overall_summary = {
        "run_dir": run_dir,
        "data_dir": args.data_dir,
        "device": str(device),
        "ddp": bool(is_ddp()),
        "world_size": int(world),
        "local_rank": int(local_rank),
        "splits_stats": splits.get("stats", {}),
        "stage1": {},
        "stage2": {},
    }

    # -------------------------
    # Stage1 train + infer
    # -------------------------
    if args.mode in ["two_stage", "stage1_only"]:
        ds_tr1 = AirbusDetDataset(train_dir, train_ids, pos_set, img_size=int(args.stage1_img_size), augment=True)
        ds_va1 = AirbusDetDataset(train_dir, val_ids,   pos_set, img_size=int(args.stage1_img_size), augment=False)

        sampler_tr1 = None
        if is_ddp():
            sampler_tr1 = DistributedSampler(ds_tr1, num_replicas=world, rank=rank, shuffle=True, drop_last=False)

        dl_tr1 = DataLoader(
            ds_tr1, batch_size=int(args.batch_train), shuffle=(sampler_tr1 is None),
            sampler=sampler_tr1, num_workers=int(args.num_workers), pin_memory=True, drop_last=False
        )
        dl_va1 = DataLoader(
            ds_va1, batch_size=int(args.batch_eval), shuffle=False,
            num_workers=int(args.num_workers), pin_memory=True, drop_last=False
        )

        model1 = build_model(args.model_name, pretrained=(int(args.pretrained) == 1))

        stage1_summary = train_one_stage(
            stage_dir=stage1_dir,
            model=model1,
            train_loader=dl_tr1,
            val_loader=dl_va1,
            device=device,
            rank=rank,
            world=world,
            max_epochs=int(args.max_epochs1),
            patience=int(args.patience1),
            lr=float(args.lr),
            weight_decay=float(args.weight_decay),
            beta=float(args.beta),
            thr_grid_n=int(args.thr_grid_n),
            log_every=int(args.log_every),
            clip_grad=float(args.clip_grad),
            warmup_epochs=int(args.warmup_epochs),
            pretrained_ckpt=None,
            use_focal=0,
            focal_gamma=float(args.focal_gamma),
            focal_alpha=float(args.focal_alpha),
            pos_weight=float(args.pos_weight),
        )

        if rank == 0:
            overall_summary["stage1"] = stage1_summary

        ddp_barrier()

        # inference stage1
        inf_model1 = build_model(args.model_name, pretrained=False)
        ckpt1 = os.path.join(stage1_dir, "best_model.pt")

        ds_train_inf1 = AirbusDetDataset(train_dir, train_ids, pos_set, img_size=int(args.stage1_img_size), augment=False)
        ds_val_inf1   = AirbusDetDataset(train_dir, val_ids,   pos_set, img_size=int(args.stage1_img_size), augment=False)

        p_train1 = infer_probs_to_csv(stage1_dir, "train", inf_model1, device, rank, world, ds_train_inf1,
                                      int(args.batch_eval), int(args.num_workers), ckpt1)
        p_val1   = infer_probs_to_csv(stage1_dir, "val",   inf_model1, device, rank, world, ds_val_inf1,
                                      int(args.batch_eval), int(args.num_workers), ckpt1)

        if os.path.isdir(test_dir):
            test_ids = list_images(test_dir)
            ds_test_inf1 = AirbusDetDataset(test_dir, test_ids, set(), img_size=int(args.stage1_img_size), augment=False)
            _ = infer_probs_to_csv(stage1_dir, "test", inf_model1, device, rank, world, ds_test_inf1,
                                   int(args.batch_eval), int(args.num_workers), ckpt1)

        ddp_barrier()

    # -------------------------
    # Stage2 build train ids by HEM + train + infer (+ optional calibration)
    # -------------------------
    if args.mode in ["two_stage", "stage2_only"]:
        # stage1 ckpt must exist for stage2 init
        stage1_best = os.path.join(stage1_dir, "best_model.pt")
        if not os.path.isfile(stage1_best):
            raise FileNotFoundError(f"Stage1 best_model.pt not found: {stage1_best}")

        # stage1 train probs must exist (for HEM)
        stage1_probs_train_csv = os.path.join(stage1_dir, "probs_train.csv")
        if not os.path.isfile(stage1_probs_train_csv):
            raise FileNotFoundError(
                f"Stage1 probs_train.csv not found: {stage1_probs_train_csv}. "
                f"Run stage1 (mode=two_stage or stage1_only) first."
            )

        # rank0 builds stage2_train_ids.json
        stage2_train_ids_path = os.path.join(stage2_dir, "stage2_train_ids.json")
        hard_sets_path = os.path.join(stage2_dir, "hard_sets.json")
        if rank == 0:
            mkdir_p(stage2_dir)
            probs_map = read_probs_csv(stage1_probs_train_csv)
            stage2_train_ids, hem_pack = build_stage2_train_ids_hem(
                train_ids_base=train_ids,
                pos_set=pos_set,
                probs_map=probs_map,
                train_n=int(args.train_n),
                pos_frac=float(args.pos_frac),
                seed=int(args.seed),
                hem_enable=int(args.hem_enable),
                hem_pos_k=int(args.hem_pos_k),
                hem_neg_k=int(args.hem_neg_k),
                hem_pos_frac=float(args.hem_pos_frac),
                hem_neg_frac=float(args.hem_neg_frac),
                hem_keep_hard_always=int(args.hem_keep_hard_always),
            )
            save_json(stage2_train_ids_path, stage2_train_ids)
            save_json(hard_sets_path, hem_pack)
        ddp_barrier()

        stage2_train_ids = load_json(stage2_train_ids_path)
        hem_pack = load_json(hard_sets_path) if os.path.isfile(hard_sets_path) else {}

        # stage2 datasets
        if int(args.stage2_multiscale) == 1:
            ms_min = int(args.stage2_ms_min)
            ms_max = int(args.stage2_ms_max)
        else:
            ms_min = 0
            ms_max = 0

        ds_tr2 = AirbusDetDataset(
            train_dir, stage2_train_ids, pos_set,
            img_size=int(args.stage2_img_size),
            augment=True,
            multiscale_min=ms_min,
            multiscale_max=ms_max,
        )
        ds_va2 = AirbusDetDataset(
            train_dir, val_ids, pos_set,
            img_size=int(args.stage2_img_size),
            augment=False
        )

        sampler_tr2 = None
        if is_ddp():
            sampler_tr2 = DistributedSampler(ds_tr2, num_replicas=world, rank=rank, shuffle=True, drop_last=False)

        dl_tr2 = DataLoader(
            ds_tr2, batch_size=int(args.batch_train), shuffle=(sampler_tr2 is None),
            sampler=sampler_tr2, num_workers=int(args.num_workers), pin_memory=True, drop_last=False
        )
        dl_va2 = DataLoader(
            ds_va2, batch_size=int(args.batch_eval), shuffle=False,
            num_workers=int(args.num_workers), pin_memory=True, drop_last=False
        )

        model2 = build_model(args.model_name, pretrained=False)

        # a bit smaller warmup for stage2 is usually fine
        warm2 = max(0, int(args.warmup_epochs) // 2)

        stage2_summary = train_one_stage(
            stage_dir=stage2_dir,
            model=model2,
            train_loader=dl_tr2,
            val_loader=dl_va2,
            device=device,
            rank=rank,
            world=world,
            max_epochs=int(args.max_epochs2),
            patience=int(args.patience2),
            lr=float(args.lr),
            weight_decay=float(args.weight_decay),
            beta=float(args.beta),
            thr_grid_n=int(args.thr_grid_n),
            log_every=int(args.log_every),
            clip_grad=float(args.clip_grad),
            warmup_epochs=warm2,
            pretrained_ckpt=stage1_best,
            use_focal=int(args.stage2_use_focal),
            focal_gamma=float(args.focal_gamma),
            focal_alpha=float(args.focal_alpha),
            pos_weight=float(args.pos_weight),
        )

        if rank == 0:
            stage2_summary["hem"] = hem_pack.get("info", hem_pack)
            stage2_summary["stage2_train_ids_path"] = stage2_train_ids_path
            stage2_summary["hard_sets_path"] = hard_sets_path
            overall_summary["stage2"] = stage2_summary

        ddp_barrier()

        # inference stage2
        inf_model2 = build_model(args.model_name, pretrained=False)
        ckpt2 = os.path.join(stage2_dir, "best_model.pt")

        ds_train_inf2 = AirbusDetDataset(train_dir, stage2_train_ids, pos_set, img_size=int(args.stage2_img_size), augment=False)
        ds_val_inf2   = AirbusDetDataset(train_dir, val_ids,         pos_set, img_size=int(args.stage2_img_size), augment=False)

        p_train2 = infer_probs_to_csv(stage2_dir, "train", inf_model2, device, rank, world, ds_train_inf2,
                                      int(args.batch_eval), int(args.num_workers), ckpt2)
        p_val2   = infer_probs_to_csv(stage2_dir, "val",   inf_model2, device, rank, world, ds_val_inf2,
                                      int(args.batch_eval), int(args.num_workers), ckpt2)

        p_test2 = ""
        if os.path.isdir(test_dir):
            test_ids = list_images(test_dir)
            ds_test_inf2 = AirbusDetDataset(test_dir, test_ids, set(), img_size=int(args.stage2_img_size), augment=False)
            p_test2 = infer_probs_to_csv(stage2_dir, "test", inf_model2, device, rank, world, ds_test_inf2,
                                         int(args.batch_eval), int(args.num_workers), ckpt2)

        ddp_barrier()

        # optional calibration (rank0 only)
        if rank == 0 and int(args.calibrate_platt) == 1:
            probs_val_map = read_probs_csv(os.path.join(stage2_dir, "probs_val.csv"))
            y_true = []
            y_prob = []
            for img, (lab, prob) in probs_val_map.items():
                if not math.isfinite(prob):
                    continue
                y_true.append(float(lab))
                y_prob.append(float(prob))
            y_true = np.array(y_true, dtype=np.float32)
            y_prob = np.array(y_prob, dtype=np.float32)
            calib = platt_fit(y_true, y_prob, max_iter=2000, lr=0.05)
            save_json(os.path.join(stage2_dir, "calib_platt.json"), calib)

            A, B = float(calib["A"]), float(calib["B"])
            write_probs_calibrated_csv(os.path.join(stage2_dir, "probs_train.csv"),
                                       os.path.join(stage2_dir, "probs_train_calibrated.csv"),
                                       A, B)
            write_probs_calibrated_csv(os.path.join(stage2_dir, "probs_val.csv"),
                                       os.path.join(stage2_dir, "probs_val_calibrated.csv"),
                                       A, B)
            if p_test2 and os.path.isfile(os.path.join(stage2_dir, "probs_test.csv")):
                write_probs_calibrated_csv(os.path.join(stage2_dir, "probs_test.csv"),
                                           os.path.join(stage2_dir, "probs_test_calibrated.csv"),
                                           A, B)

        ddp_barrier()

    # infer_only
    if args.mode == "infer_only":
        # use stage2 best if exists else stage1 best
        ckpt2 = os.path.join(stage2_dir, "best_model.pt")
        ckpt1 = os.path.join(stage1_dir, "best_model.pt")
        if os.path.isfile(ckpt2):
            ckpt = ckpt2
            img_size = int(args.stage2_img_size)
            out_stage = stage2_dir
            ids_for_train = load_json(os.path.join(stage2_dir, "stage2_train_ids.json")) if os.path.isfile(os.path.join(stage2_dir, "stage2_train_ids.json")) else train_ids
        elif os.path.isfile(ckpt1):
            ckpt = ckpt1
            img_size = int(args.stage1_img_size)
            out_stage = stage1_dir
            ids_for_train = train_ids
        else:
            raise FileNotFoundError("No best_model.pt found under stage1/ or stage2/.")

        inf_model = build_model(args.model_name, pretrained=False)
        ds_train_inf = AirbusDetDataset(train_dir, ids_for_train, pos_set, img_size=img_size, augment=False)
        ds_val_inf   = AirbusDetDataset(train_dir, val_ids,      pos_set, img_size=img_size, augment=False)
        _ = infer_probs_to_csv(out_stage, "train_inferonly", inf_model, device, rank, world, ds_train_inf,
                               int(args.batch_eval), int(args.num_workers), ckpt)
        _ = infer_probs_to_csv(out_stage, "val_inferonly", inf_model, device, rank, world, ds_val_inf,
                               int(args.batch_eval), int(args.num_workers), ckpt)
        if os.path.isdir(test_dir):
            test_ids = list_images(test_dir)
            ds_test_inf = AirbusDetDataset(test_dir, test_ids, set(), img_size=img_size, augment=False)
            _ = infer_probs_to_csv(out_stage, "test_inferonly", inf_model, device, rank, world, ds_test_inf,
                                   int(args.batch_eval), int(args.num_workers), ckpt)
        ddp_barrier()

    # overall summary
    if rank == 0:
        save_json(os.path.join(run_dir, "summary.json"), overall_summary)
        print(f"\n[DONE] run_dir={run_dir}", flush=True)
        if overall_summary.get("stage1"):
            print(f"[DONE] stage1_best={os.path.join(stage1_dir,'best_model.pt')}", flush=True)
        if overall_summary.get("stage2"):
            print(f"[DONE] stage2_best={os.path.join(stage2_dir,'best_model.pt')}", flush=True)

    ddp_barrier()
    if is_ddp():
        dist.destroy_process_group()


if __name__ == "__main__":
    main()
