class MultiScaleResize:
    """
    Randomly choose size in [min_size, max_size] per call and resize to square.
    """
    def __init__(self, min_size: int, max_size: int):
        self.min_size = int(min_size)
        self.max_size = int(max_size)
        assert self.min_size > 0 and self.max_size >= self.min_size

    def __call__(self, img: Image.Image) -> Image.Image:
        s = random.randint(self.min_size, self.max_size)
        return img.resize((s, s), resample=Image.BILINEAR)


# ============================================================
# Torch Dataset
# ============================================================

class AirbusDetDataset(Dataset):
    def __init__(
        self,
        img_dir: str,
        ids: List[str],
        pos_set: set,
        img_size: int,
        augment: bool,
        multiscale_min: int = 0,
        multiscale_max: int = 0,
    ):
        self.img_dir = img_dir
        self.ids = ids
        self.pos_set = pos_set
        self.img_size = int(img_size)
        self.augment = bool(augment)
        self.ms_min = int(multiscale_min)
        self.ms_max = int(multiscale_max)

        mean = [0.485, 0.456, 0.406]
        std  = [0.229, 0.224, 0.225]

        # resize op
        if self.ms_min > 0 and self.ms_max >= self.ms_min:
            resize_op = MultiScaleResize(self.ms_min, self.ms_max)
        else:
            resize_op = transforms.Resize((self.img_size, self.img_size))

        if self.augment:
            self.tf = transforms.Compose([
                resize_op,
                transforms.RandomHorizontalFlip(p=0.5),
                transforms.RandomVerticalFlip(p=0.5),
                transforms.ColorJitter(brightness=0.15, contrast=0.15, saturation=0.10, hue=0.02),
                transforms.ToTensor(),
                transforms.Normalize(mean=mean, std=std),
            ])
        else:
            self.tf = transforms.Compose([
                resize_op,
                transforms.ToTensor(),
                transforms.Normalize(mean=mean, std=std),
            ])

    def __len__(self) -> int:
        return len(self.ids)

    def __getitem__(self, i: int):
        fn = self.ids[i]
        path = os.path.join(self.img_dir, fn)
        with Image.open(path) as im:
            im = im.convert("RGB")
        x = self.tf(im)
        y = 1.0 if fn in self.pos_set else 0.0
        y = torch.tensor([y], dtype=torch.float32)
        return fn, x, y


