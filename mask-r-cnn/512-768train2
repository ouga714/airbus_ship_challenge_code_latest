# ============================================================
# RLE (Kaggle Airbus format: column-major)
# ============================================================

def rle_decode(rle: str, shape_hw: Tuple[int, int]) -> np.ndarray:
    h, w = shape_hw
    s = str(rle).strip()
    if s == "" or s.lower() == "nan":
        return np.zeros((h, w), dtype=np.uint8)
    parts = s.split()
    if len(parts) % 2 != 0:
        return np.zeros((h, w), dtype=np.uint8)
    starts = np.asarray([int(x) for x in parts[0::2]], dtype=np.int64) - 1
    lengths = np.asarray([int(x) for x in parts[1::2]], dtype=np.int64)
    ends = starts + lengths
    img = np.zeros((h * w,), dtype=np.uint8)
    for lo, hi in zip(starts, ends):
        lo2 = max(0, int(lo))
        hi2 = min(int(hi), h * w)
        if hi2 > lo2:
            img[lo2:hi2] = 1
    img = img.reshape((w, h)).T
    return img

def load_id2rles(train_csv: str) -> Dict[str, List[str]]:
    id2rles: Dict[str, List[str]] = {}
    with open(train_csv, "r", encoding="utf-8") as f:
        r = csv.DictReader(f)
        for row in r:
            img_id = row["ImageId"]
            rle = row["EncodedPixels"]
            if rle is None:
                continue
            s = str(rle).strip()
            if s == "" or s.lower() == "nan":
                continue
            id2rles.setdefault(img_id, []).append(s)
    return id2rles


# ============================================================
# Detector (EfficientNetV2) — image-level binary classifier
# ============================================================

class EffNetV2Binary(nn.Module):
    def __init__(self, variant: str = "s", pretrained_backbone: int = 0):
        super().__init__()
        variant = str(variant).lower()
        if variant == "s":
            weights = torchvision.models.EfficientNet_V2_S_Weights.DEFAULT if pretrained_backbone else None
            m = torchvision.models.efficientnet_v2_s(weights=weights)
        elif variant == "m":
            weights = torchvision.models.EfficientNet_V2_M_Weights.DEFAULT if pretrained_backbone else None
            m = torchvision.models.efficientnet_v2_m(weights=weights)
        elif variant == "l":
            weights = torchvision.models.EfficientNet_V2_L_Weights.DEFAULT if pretrained_backbone else None
            m = torchvision.models.efficientnet_v2_l(weights=weights)
        else:
            raise ValueError(f"unknown det_variant: {variant}")

        in_f = m.classifier[1].in_features
        m.classifier[1] = nn.Linear(in_f, 1)
        self.net = m

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return self.net(x)

def imagenet_normalize(x: torch.Tensor) -> torch.Tensor:
    # NOTE: creating new tensors repeatedly is fine here because detector runs limited times.
    mean = torch.tensor([0.485, 0.456, 0.406], device=x.device, dtype=x.dtype).view(1, 3, 1, 1)
    std  = torch.tensor([0.229, 0.224, 0.225], device=x.device, dtype=x.dtype).view(1, 3, 1, 1)
    return (x - mean) / std

def load_ckpt_flexible(model: nn.Module, ckpt_path: str, device: torch.device) -> None:
    sd = torch.load(ckpt_path, map_location=device)
    if isinstance(sd, dict) and "state_dict" in sd and isinstance(sd["state_dict"], dict):
        sd = sd["state_dict"]
    new_sd = {}
    for k, v in sd.items():
        if k.startswith("module."):
            new_sd[k[len("module."):]] = v
        else:
            new_sd[k] = v
    model.load_state_dict(new_sd, strict=False)

@torch.no_grad()
def detector_prob_for_path(det_model: nn.Module, img_path: str, det_img_size: int, device: torch.device) -> float:
    det_model.eval()
    try:
        img = Image.open(img_path).convert("RGB")
    except Exception:
        return 0.0
    if int(det_img_size) > 0:
        img = img.resize((int(det_img_size), int(det_img_size)), resample=Image.BILINEAR)
    x = img_to_tensor01(img).unsqueeze(0).to(device)
    x = imagenet_normalize(x)
    logit = det_model(x)
    p = torch.sigmoid(logit).item()
    return float(p)


# ============================================================
# Mask R-CNN build
# ============================================================

def set_maskrcnn_transform_size(model: nn.Module, min_size: int, max_size: int) -> None:
    """
    Fixed-size training/inference:
      model.transform.min_size = (min_size,)
      model.transform.max_size = max_size
    """
    min_size = int(min_size)
    max_size = int(max_size)
    if min_size <= 0 or max_size <= 0:
        return
    model.transform.min_size = (min_size,)
    model.transform.max_size = max_size

def set_maskrcnn_transform_multiscale(model: nn.Module, min_sizes: List[int], max_size: int) -> None:
    """
    Multi-scale training:
      model.transform.min_size = tuple(min_sizes)
      model.transform.max_size = max_size

    torchvision detection will randomly pick one min_size at each forward during training.
    """
    ms = [int(x) for x in min_sizes if int(x) > 0]
    if len(ms) == 0:
        return
    model.transform.min_size = tuple(ms)
    model.transform.max_size = int(max_size)

def build_maskrcnn(
    num_classes: int = 2,
    pretrained_coco: int = 0,
    pretrained_backbone: int = 0,
    trainable_backbone_layers: int = 3,
    init_min_size: int = 768,
    init_max_size: int = 768
) -> nn.Module:
    """
    - pretrained_coco=1: start from COCO pretrained Mask R-CNN weights
    - pretrained_backbone=1: ImageNet backbone only (ResNet50 weights)
    If both are 1, COCO weights take precedence.
    """
    weights = None
    weights_backbone = None
    if int(pretrained_coco) == 1:
        weights = torchvision.models.detection.MaskRCNN_ResNet50_FPN_Weights.DEFAULT
        weights_backbone = None
    else:
        if int(pretrained_backbone) == 1:
            weights_backbone = torchvision.models.ResNet50_Weights.DEFAULT

    model = torchvision.models.detection.maskrcnn_resnet50_fpn(
        weights=weights,
        weights_backbone=weights_backbone,
        trainable_backbone_layers=int(trainable_backbone_layers),
    )

    # Replace box head
    in_features = model.roi_heads.box_predictor.cls_score.in_features
    model.roi_heads.box_predictor = FastRCNNPredictor(in_features, num_classes)

    # Replace mask head
    in_features_mask = model.roi_heads.mask_predictor.conv5_mask.in_channels
    hidden = 256
    model.roi_heads.mask_predictor = MaskRCNNPredictor(in_features_mask, hidden, num_classes)

    # Init transform size
    set_maskrcnn_transform_size(model, int(init_min_size), int(init_max_size))
    return model


# ============================================================
# Integrity scan (rank0 -> json -> all ranks use)
# ============================================================

def integrity_scan_image_ids(img_dir: str, image_ids: List[str], logger: RunLogger,
                             out_json: str, limit: int = 0) -> Dict[str, Any]:
    """
    Decode-scan images to exclude broken files.
    rank0 executes and saves JSON; other ranks wait and load.
    """
    if not is_main_process():
        ddp_barrier()
        return load_json(out_json)

    t0 = time.time()
    ok = []
    bad = []
    ids = list(image_ids)
    if int(limit) > 0 and len(ids) > int(limit):
        ids = random.sample(ids, int(limit))

    for i, fn in enumerate(ids, start=1):
        p = os.path.join(img_dir, fn)
        try:
            im = Image.open(p).convert("RGB")
            _ = im.size
            ok.append(fn)
        except Exception:
            bad.append(fn)
        if i % 5000 == 0:
            logger.g(f"[integrity] scanned {i}/{len(ids)} ok={len(ok)} bad={len(bad)}")

    res = {
        "img_dir": img_dir,
        "scanned_n": len(ids),
        "total_ids_n": len(image_ids),
        "bad_ids": sorted(list(set(bad))),
        "elapsed_sec": float(time.time() - t0),
        "note": "If scanned_n < total_ids_n, only bad_ids are authoritative; others assumed ok."
    }
    save_json(out_json, res)
    logger.g(f"[integrity] saved {out_json} scanned_n={res['scanned_n']} bad={len(res['bad_ids'])} elapsed={res['elapsed_sec']:.1f}s")
    ddp_barrier()
    return res


# ============================================================
# Dataset (no resize; resize only via model.transform)
# ============================================================

def masks_to_boxes_xyxy(masks: np.ndarray) -> np.ndarray:
    n = masks.shape[0]
    boxes = np.zeros((n, 4), dtype=np.float32)
    for i in range(n):
        ys, xs = np.where(masks[i] > 0)
        if len(xs) == 0:
            boxes[i] = 0
        else:
            x1 = float(xs.min()); x2 = float(xs.max())
            y1 = float(ys.min()); y2 = float(ys.max())
            boxes[i] = np.array([x1, y1, x2, y2], dtype=np.float32)
    return boxes

class AirbusMaskRcnnDataset(Dataset):
    """
    IMPORTANT:
    - no resize here (keep raw size); Mask R-CNN transform handles resizing.
    - augmentations are basic flips with sync for image/boxes/masks.
    """
    def __init__(
        self,
        img_dir: str,
        id2rles: Dict[str, List[str]],
        image_ids: List[str],
        bad_ids: Optional[set] = None,
        min_instance_area: int = 8,
        min_box_hw: int = 2,
        augment: int = 1,
        max_fallback_tries: int = 10
    ):
        self.img_dir = img_dir
        self.id2rles = id2rles
        self.ids = list(image_ids)
        self.bad_ids = bad_ids if bad_ids is not None else set()
        self.min_instance_area = int(min_instance_area)
        self.min_box_hw = int(min_box_hw)
        self.augment = int(augment)
        self.max_fallback_tries = int(max_fallback_tries)

    def __len__(self) -> int:
        return len(self.ids)

    def _try_load(self, image_id: str):
        if image_id in self.bad_ids:
            raise ValueError("bad image_id (integrity)")

        path = os.path.join(self.img_dir, image_id)
        img = Image.open(path).convert("RGB")
        w0, h0 = img.size
        img_t = img_to_tensor01(img)

        rles = self.id2rles.get(image_id, [])
        masks = []
        for rle in rles:
            m = rle_decode(rle, (h0, w0))
            if int(m.sum()) < self.min_instance_area:
                continue
            masks.append(m)

        if len(masks) == 0:
            target = {
                "boxes": torch.zeros((0, 4), dtype=torch.float32),
                "labels": torch.zeros((0,), dtype=torch.int64),
                "masks": torch.zeros((0, img_t.shape[1], img_t.shape[2]), dtype=torch.uint8),
                "image_id": torch.tensor([0], dtype=torch.int64),
            }
        else:
            mstack = np.stack(masks, axis=0).astype(np.uint8)
            boxes = masks_to_boxes_xyxy(mstack)

            keep = []
            for i in range(mstack.shape[0]):
                x1, y1, x2, y2 = boxes[i]
                if (x2 - x1 + 1) < self.min_box_hw or (y2 - y1 + 1) < self.min_box_hw:
                    continue
                keep.append(i)

            if len(keep) == 0:
                target = {
                    "boxes": torch.zeros((0, 4), dtype=torch.float32),
                    "labels": torch.zeros((0,), dtype=torch.int64),
                    "masks": torch.zeros((0, img_t.shape[1], img_t.shape[2]), dtype=torch.uint8),
                    "image_id": torch.tensor([0], dtype=torch.int64),
                }
            else:
                mstack = mstack[keep]
                boxes = boxes[keep]
                target = {
                    "boxes": torch.from_numpy(boxes).float(),
                    "labels": torch.ones((mstack.shape[0],), dtype=torch.int64),
                    "masks": torch.from_numpy(mstack).to(torch.uint8),
                    "image_id": torch.tensor([0], dtype=torch.int64),
                }

        # basic augmentations (sync)
        if self.augment:
            if random.random() < 0.5:
                img_t = TF.hflip(img_t)
                if target["boxes"].numel() > 0:
                    W = img_t.shape[2]
                    boxes_t = target["boxes"]
                    x1 = W - 1 - boxes_t[:, 2]
                    x2 = W - 1 - boxes_t[:, 0]
                    boxes_t[:, 0] = x1
                    boxes_t[:, 2] = x2
                    target["boxes"] = boxes_t
                    target["masks"] = torch.flip(target["masks"], dims=[2])
            if random.random() < 0.5:
                img_t = TF.vflip(img_t)
                if target["boxes"].numel() > 0:
                    H = img_t.shape[1]
                    boxes_t = target["boxes"]
                    y1 = H - 1 - boxes_t[:, 3]
                    y2 = H - 1 - boxes_t[:, 1]
                    boxes_t[:, 1] = y1
                    boxes_t[:, 3] = y2
                    target["boxes"] = boxes_t
                    target["masks"] = torch.flip(target["masks"], dims=[1])

        return img_t, target

    def __getitem__(self, idx: int):
        for t in range(self.max_fallback_tries):
            image_id = self.ids[idx] if t == 0 else random.choice(self.ids)
            try:
                img_t, target = self._try_load(image_id)
                target["image_id"] = torch.tensor([idx], dtype=torch.int64)
                return img_t, target, image_id
            except Exception:
                continue

        # ultimate fallback
        H = W = 768
        img_t = torch.zeros((3, H, W), dtype=torch.float32)
        target = {
            "boxes": torch.zeros((0, 4), dtype=torch.float32),
            "labels": torch.zeros((0,), dtype=torch.int64),
            "masks": torch.zeros((0, H, W), dtype=torch.uint8),
            "image_id": torch.tensor([idx], dtype=torch.int64),
        }
        return img_t, target, self.ids[idx]

def collate_fn(batch):
    imgs = [b[0] for b in batch]
    targets = [b[1] for b in batch]
    ids = [b[2] for b in batch]
    return imgs, targets, ids


# ============================================================
# Metrics (pixel-level union F2)
# ============================================================

def union_from_target(target: Dict[str, torch.Tensor], shape_hw: Tuple[int, int]) -> np.ndarray:
    if "masks" not in target or target["masks"].numel() == 0:
        H, W = shape_hw
        return np.zeros((H, W), dtype=np.uint8)
    m = target["masks"].cpu().numpy().astype(np.uint8)
    u = (m.sum(axis=0) > 0).astype(np.uint8)
    return u

def accumulate_counts(gt: np.ndarray, pr: np.ndarray) -> Tuple[int, int, int]:
    gt = (gt > 0).astype(np.uint8)
    pr = (pr > 0).astype(np.uint8)
    tp = int(((gt == 1) & (pr == 1)).sum())
    fp = int(((gt == 0) & (pr == 1)).sum())
    fn = int(((gt == 1) & (pr == 0)).sum())
    return tp, fp, fn

def compute_metrics(tp: int, fp: int, fn: int, beta: float = 2.0) -> Dict[str, float]:
    eps = 1e-12
    prec = tp / (tp + fp + eps)
    rec  = tp / (tp + fn + eps)
    f1   = (2 * prec * rec) / (prec + rec + eps)
    b2 = beta * beta
    fbeta = (1 + b2) * prec * rec / (b2 * prec + rec + eps)
    iou = tp / (tp + fp + fn + eps)
    return {"precision": float(prec), "recall": float(rec), "f1": float(f1), "f2": float(fbeta), "iou": float(iou)}


# ============================================================
# Inference helper (single image -> instance masks)
# NOTE: "no double sigmoid" invariant here.
# ============================================================

def safe_logit(p: float, eps: float = 1e-6) -> float:
    p2 = min(1.0 - eps, max(eps, float(p)))
    return float(math.log(p2 / (1.0 - p2)))

def sigmoid(x: float) -> float:
    if x >= 0:
        z = math.exp(-x)
        return 1.0 / (1.0 + z)
    else:
        z = math.exp(x)
        return z / (1.0 + z)

@torch.no_grad()
def infer_raw_outputs(model: nn.Module, img_t: torch.Tensor, device: torch.device) -> Dict[str, torch.Tensor]:
    """
    Return:
      scores: [N] (0..1)
      mask_probs: [N,1,H,W] in 0..1 (sigmoid applied at most once)
    """
    model.eval()
    x = img_t.to(device)
    out = model([x])[0]
    scores = out.get("scores", torch.zeros((0,), device=device)).detach()
    masks  = out.get("masks", torch.zeros((0, 1, x.shape[1], x.shape[2]), device=device)).detach()

    if masks.numel() == 0:
        mask_probs = masks
    else:
        mn = float(masks.min().item())
        mx = float(masks.max().item())
        if (mn >= -1e-6) and (mx <= 1.0 + 1e-6):
            mask_probs = masks.float()
        else:
            mask_probs = masks.float().sigmoid()

    return {"scores": scores, "mask_probs": mask_probs}

def insts_union_from_cached(
    scores: torch.Tensor,
    mask_probs: torch.Tensor,
    score_thr: float,
    mask_thr: float,
    shape_hw: Tuple[int, int]
) -> np.ndarray:
    H, W = shape_hw
    if scores.numel() == 0:
        return np.zeros((H, W), dtype=np.uint8)

    keep = scores >= float(score_thr)
    if keep.sum().item() == 0:
        return np.zeros((H, W), dtype=np.uint8)

    mp = mask_probs[keep]  # [K,1,H,W]
    probs = mp[:, 0].float()  # [K,H,W]
    u = np.zeros((H, W), dtype=np.uint8)
    for k in range(probs.shape[0]):
        mk = (probs[k].detach().cpu().numpy() >= float(mask_thr)).astype(np.uint8)
        if mk.sum() > 0:
            u = np.maximum(u, mk)
    return u

def seg_evidence_from_scores(scores: torch.Tensor) -> float:
    if scores is None or scores.numel() == 0:
        return 0.0
    return float(scores.max().item())

def fuse_det_seg_prob(det_p: float, seg_p: float, w_det: float, w_seg: float, bias: float) -> float:
    ld = safe_logit(det_p)
    ls = safe_logit(seg_p)
    return sigmoid(float(w_det) * ld + float(w_seg) * ls + float(bias))


