def img_to_tensor01(img: Image.Image) -> torch.Tensor:
    arr = np.asarray(img, dtype=np.float32) / 255.0
    if arr.ndim != 3 or arr.shape[2] != 3:
        raise ValueError(f"bad image shape: {arr.shape}")
    t = torch.from_numpy(arr).permute(2, 0, 1).contiguous()
    return t

def list_image_ids(img_dir: str) -> List[str]:
    out = []
    for fn in os.listdir(img_dir):
        if fn.lower().endswith(".jpg") or fn.lower().endswith(".jpeg") or fn.lower().endswith(".png"):
            out.append(fn)
    out.sort()
    return out

