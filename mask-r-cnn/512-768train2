def compute_detector_probs_rank0(
    det_model: nn.Module,
    img_dir: str,
    ids: List[str],
    det_img_size: int,
    device: torch.device,
    score_all_limit: int,
    logger: RunLogger
) -> List[Tuple[str, float]]:
    if not is_main_process():
        return []

    ids = list(ids)
    if int(score_all_limit) > 0 and len(ids) > int(score_all_limit):
        ids_scoring = random.sample(ids, int(score_all_limit))
    else:
        ids_scoring = ids

    scored: List[Tuple[str, float]] = []
    for k, img_id in enumerate(ids_scoring):
        p = detector_prob_for_path(det_model, os.path.join(img_dir, img_id), det_img_size, device)
        scored.append((img_id, float(p)))
        if (k + 1) % 200 == 0:
            logger.g(f"[det-prob] scored {k+1}/{len(ids_scoring)}")
    scored.sort(key=lambda x: x[1], reverse=True)
    return scored

def build_train_ids_from_rank(
    candidates: List[str],
    scored: List[Tuple[str, float]],
    train_n: int,
    top_frac: float,
    bottom_frac: float
) -> List[str]:
    """
    Sampling bias:
    - take top_frac * train_n from top of ranking
    - take bottom_frac * train_n from bottom
    - fill remaining from the rest uniformly at random
    """
    candidates_set = set(candidates)
    scored_ids = [i for i, _p in scored if i in candidates_set]

    train_n = int(train_n)
    top_n = int(round(train_n * float(top_frac)))
    bot_n = int(round(train_n * float(bottom_frac)))
    top_n = max(0, min(top_n, len(scored_ids), train_n))
    bot_n = max(0, min(bot_n, len(scored_ids) - top_n, train_n - top_n))

    top = scored_ids[:top_n]
    bot = scored_ids[-bot_n:] if bot_n > 0 else []

    chosen = list(top) + list(bot)
    chosen_set = set(chosen)

    remain_pool = [x for x in candidates if x not in chosen_set]
    random.shuffle(remain_pool)
    need = train_n - len(chosen)
    if need > 0:
        chosen += remain_pool[:need]
    random.shuffle(chosen)
    return chosen


