# Train (DDP)
# ============================================================

def to_device_targets(targets: List[Dict[str, Any]], device: torch.device) -> List[Dict[str, Any]]:
    out = []
    for t in targets:
        t2 = {}
        for k, v in t.items():
            if isinstance(v, torch.Tensor):
                t2[k] = v.to(device, non_blocking=True)
            else:
                t2[k] = v
        out.append(t2)
    return out

def ddp_wrap(model: nn.Module, device: torch.device) -> nn.Module:
    if is_dist_avail_and_initialized():
        local_rank = int(os.environ.get("LOCAL_RANK", "0"))
        model = torch.nn.parallel.DistributedDataParallel(
            model,
            device_ids=[local_rank],
            output_device=local_rank,
            broadcast_buffers=False,
            find_unused_parameters=False
        )
    return model

def get_model_to_save(model: nn.Module) -> nn.Module:
    return model.module if hasattr(model, "module") else model

def train_one_epoch_ddp(
    model: nn.Module,
    dl: DataLoader,
    device: torch.device,
    optimizer: optim.Optimizer,
    epoch: int,
    logger: RunLogger,
    log_every: int = 50
) -> Dict[str, float]:
    model.train()
    running = []
    steps = 0

    for step, (imgs, targets, _ids) in enumerate(dl, start=1):
        steps += 1
        imgs = [x.to(device, non_blocking=True) for x in imgs]
        targets2 = to_device_targets(targets, device)

        loss_dict = model(imgs, targets2)
        losses = sum(loss for loss in loss_dict.values())

        if not torch.isfinite(losses):
            if is_main_process():
                logger.d(f"[TRAIN] non-finite loss epoch={epoch} step={step} -> skip")
            optimizer.zero_grad(set_to_none=True)
            continue

        optimizer.zero_grad(set_to_none=True)
        losses.backward()
        optimizer.step()

        running.append(float(losses.item()))

        if is_main_process() and (step % int(max(1, log_every)) == 0):
            d = {k: float(v.item()) for k, v in loss_dict.items()}
            lr = float(optimizer.param_groups[0]["lr"])
            logger.d(f"[TRAIN] epoch={epoch} step={step}/{len(dl)} lr={lr:.6g} loss={float(losses.item()):.6f} detail={d}")

    avg = float(np.mean(running)) if len(running) else 0.0
    return {"loss": avg, "steps": steps}


# ============================================================
# Joint tuning + evaluation (rank0 only)
# - To reduce "val overfit", we split VAL into:
#   val_tune (used for tune_joint_fusion_rank0)
#   val_es   (used for early stopping decisions)
# ============================================================

def _collect_eval_cache_rank0(
    model: nn.Module,
    det_model: nn.Module,
    dl: DataLoader,
    img_dir: str,
    device: torch.device,
    det_img_size: int,
    limit: int,
    logger: RunLogger
) -> Dict[str, Any]:
    """
    Collect per-image cache (rank0 only):
      - gt union
      - det_p
      - seg_p (max score)
      - raw outputs (scores, mask_probs) for union computation later
    Returns dict of arrays and lists.
    """
    assert is_main_process(), "rank0 only"
    model.eval()
    det_model.eval()

    gts = []
    det_ps = []
    seg_ps = []
    raws = []  # list of (scores_cpu, mask_probs_cpu)
    ids = []

    n_seen = 0
    for (imgs, targets, image_ids) in dl:
        for j in range(len(imgs)):
            img_t = imgs[j]
            tgt = targets[j]
            image_id = image_ids[j]
            H, W = int(img_t.shape[1]), int(img_t.shape[2])

            # GT union
            gt_u = union_from_target(tgt, (H, W))

            # Detector prob (file-based)
            pth = os.path.join(img_dir, image_id)
            if os.path.isfile(pth):
                det_p = detector_prob_for_path(det_model, pth, det_img_size, device)
            else:
                det_p = 0.0

            # Mask R-CNN raw
            raw = infer_raw_outputs(model, img_t, device)
            scores = raw["scores"].detach().cpu()
            mask_probs = raw["mask_probs"].detach().cpu()
            seg_p = seg_evidence_from_scores(raw["scores"])

            gts.append(gt_u)
            det_ps.append(float(det_p))
            seg_ps.append(float(seg_p))
            raws.append((scores, mask_probs))
            ids.append(image_id)

            n_seen += 1
            if int(limit) > 0 and n_seen >= int(limit):
                break
        if int(limit) > 0 and n_seen >= int(limit):
            break

    logger.g(f"[cache] collected n={len(ids)} for tuning/eval")
    gt_pos = np.asarray([int(x.sum()) for x in gts], dtype=np.int64)

    return {
        "ids": ids,
        "gts": gts,
        "gt_pos": gt_pos,
        "det_ps": np.asarray(det_ps, dtype=np.float64),
        "seg_ps": np.asarray(seg_ps, dtype=np.float64),
        "raws": raws,
    }

def tune_joint_fusion_rank0(
    model: nn.Module,
    det_model: nn.Module,
    dl: DataLoader,
    img_dir: str,
    device: torch.device,
    det_img_size: int,
    score_thrs: np.ndarray,
    mask_thrs: np.ndarray,
    w_det_grid: List[float],
    w_seg_grid: List[float],
    bias_grid: List[float],
    tau_grid: List[float],
    limit: int,
    logger: RunLogger,
    beta: float = 2.0
) -> Dict[str, Any]:
    """
    Efficient joint tuning strategy:

    1) Collect per-image cache: det_p, seg_p, gt union, raw outputs.
    2) Precompute per-image confusion counts (tp,fp,fn) for EACH (score_thr, mask_thr) assuming "accepted".
       Also store gt_pos per image for the "rejected => empty prediction" case.
    3) For each fusion combo (w_det,w_seg,bias,tau), compute accept mask A_i (based only on det_p, seg_p),
       then compute total counts for each (score_thr,mask_thr) fast using dot products, and pick best.

    This prevents the combinatorial explosion that would happen if we recomputed unions for every hyperparam tuple.
    """
    assert is_main_process(), "rank0 only"

    cache = _collect_eval_cache_rank0(
        model=model,
        det_model=det_model,
        dl=dl,
        img_dir=img_dir,
        device=device,
        det_img_size=int(det_img_size),
        limit=int(limit),
        logger=logger
    )
    N = len(cache["ids"])
    if N == 0:
        return {"score_thr": 0.5, "mask_thr": 0.5, "w_det": 1.0, "w_seg": 1.0, "bias": 0.0, "tau": 0.5, "best_f2": 0.0}

    det_ps = cache["det_ps"]
    seg_ps = cache["seg_ps"]
    gt_pos = cache["gt_pos"]
    gts = cache["gts"]
    raws = cache["raws"]

    # Precompute per-(score_thr, mask_thr) confusion counts per image
    score_thrs = np.asarray(score_thrs, dtype=np.float64)
    mask_thrs = np.asarray(mask_thrs, dtype=np.float64)
    P = int(len(score_thrs) * len(mask_thrs))

    tp_mat = np.zeros((P, N), dtype=np.int64)
    fp_mat = np.zeros((P, N), dtype=np.int64)
    fn_mat = np.zeros((P, N), dtype=np.int64)

    # Build pair index mapping
    pairs = []
    for s in score_thrs:
        for m in mask_thrs:
            pairs.append((float(s), float(m)))

    # Compute unions + counts (heavy part, but only P*N once)
    t0 = time.time()
    for i in range(N):
        gt_u = gts[i]
        H, W = gt_u.shape
        scores_cpu, mask_probs_cpu = raws[i]
        # For speed: convert to torch tensors on CPU once
        scores_t = scores_cpu
        mask_probs_t = mask_probs_cpu
        for pidx, (s_thr, m_thr) in enumerate(pairs):
            pr_u = insts_union_from_cached(scores_t, mask_probs_t, s_thr, m_thr, (H, W))
            tp, fp, fn = accumulate_counts(gt_u, pr_u)
            tp_mat[pidx, i] = tp
            fp_mat[pidx, i] = fp
            fn_mat[pidx, i] = fn

        if (i + 1) % 50 == 0:
            logger.d(f"[tune-pre] precomputed {i+1}/{N} images for {P} thr-pairs")

    logger.g(f"[tune-pre] done precompute: N={N} P={P} elapsed={time.time()-t0:.1f}s")

    # Now scan fusion params (fast-ish)
    best = {
        "score_thr": 0.5,
        "mask_thr": 0.5,
        "w_det": 1.0,
        "w_seg": 1.0,
        "bias": 0.0,
        "tau": 0.5,
        "best_f2": -1.0
    }

    # Vectorize fusion acceptance
    # fused_p = sigmoid(w_det*logit(det_p) + w_seg*logit(seg_p) + bias)
    # accept = fused_p >= tau
    det_logits = np.asarray([safe_logit(x) for x in det_ps], dtype=np.float64)
    seg_logits = np.asarray([safe_logit(x) for x in seg_ps], dtype=np.float64)

    gt_pos_sum_all = int(gt_pos.sum())

    for w_det in w_det_grid:
        for w_seg in w_seg_grid:
            for bias in bias_grid:
                lin = float(w_det) * det_logits + float(w_seg) * seg_logits + float(bias)
                # sigmoid in numpy
                fused = 1.0 / (1.0 + np.exp(-lin))
                for tau in tau_grid:
                    A = (fused >= float(tau)).astype(np.int64)  # [N]
                    A0 = 1 - A
                    # totals for each pair:
                    # tp = tp_mat @ A
                    # fp = fp_mat @ A
                    # fn = fn_mat @ A + gt_pos @ (1-A)
                    tp = tp_mat.dot(A)
                    fp = fp_mat.dot(A)
                    fn = fn_mat.dot(A) + int(gt_pos.dot(A0))

                    # compute f2 vectorized
                    eps = 1e-12
                    prec = tp / (tp + fp + eps)
                    rec  = tp / (tp + fn + eps)
                    b2 = beta * beta
                    f2 = (1 + b2) * prec * rec / (b2 * prec + rec + eps)

                    p_best = int(np.argmax(f2))
                    f2_best = float(f2[p_best])

                    if f2_best > float(best["best_f2"]):
                        s_thr, m_thr = pairs[p_best]
                        best = {
                            "score_thr": float(s_thr),
                            "mask_thr": float(m_thr),
                            "w_det": float(w_det),
                            "w_seg": float(w_seg),
                            "bias": float(bias),
                            "tau": float(tau),
                            "best_f2": float(f2_best),
                            "accepted_frac": float(A.mean()),
                            "gt_pos_sum": int(gt_pos_sum_all),
                        }

    logger.g(
        f"[tune] best_f2={best['best_f2']:.6f} "
        f"score_thr={best['score_thr']:.3f} mask_thr={best['mask_thr']:.3f} "
        f"w_det={best['w_det']:.2f} w_seg={best['w_seg']:.2f} bias={best['bias']:.2f} tau={best['tau']:.2f} "
        f"accepted_frac={best.get('accepted_frac',0.0):.3f}"
    )
    return best

def eval_joint_pixel_union_rank0(
    model: nn.Module,
    det_model: nn.Module,
    dl: DataLoader,
    img_dir: str,
    device: torch.device,
    det_img_size: int,
    joint: Dict[str, Any],
    limit: int,
    logger: RunLogger,
    beta: float = 2.0
) -> Dict[str, float]:
    """
    Evaluate using the fixed joint params (rank0 only).
    """
    assert is_main_process(), "rank0 only"

    model.eval()
    det_model.eval()

    tp = fp = fn = 0
    n_seen = 0

    score_thr = float(joint.get("score_thr", 0.5))
    mask_thr  = float(joint.get("mask_thr", 0.5))
    w_det     = float(joint.get("w_det", 1.0))
    w_seg     = float(joint.get("w_seg", 1.0))
    bias      = float(joint.get("bias", 0.0))
    tau       = float(joint.get("tau", 0.5))

    for (imgs, targets, image_ids) in dl:
        for j in range(len(imgs)):
            img_t = imgs[j]
            tgt = targets[j]
            image_id = image_ids[j]
            H, W = int(img_t.shape[1]), int(img_t.shape[2])

            gt_u = union_from_target(tgt, (H, W))

            pth = os.path.join(img_dir, image_id)
            det_p = detector_prob_for_path(det_model, pth, det_img_size, device) if os.path.isfile(pth) else 0.0

            raw = infer_raw_outputs(model, img_t, device)
            seg_p = seg_evidence_from_scores(raw["scores"])
            fused_p = fuse_det_seg_prob(det_p, seg_p, w_det, w_seg, bias)

            if fused_p < tau:
                pr_u = np.zeros((H, W), dtype=np.uint8)
            else:
                scores = raw["scores"].detach().cpu()
                mask_probs = raw["mask_probs"].detach().cpu()
                pr_u = insts_union_from_cached(scores, mask_probs, score_thr, mask_thr, (H, W))

            a, b, c = accumulate_counts(gt_u, pr_u)
            tp += a; fp += b; fn += c

            n_seen += 1
            if int(limit) > 0 and n_seen >= int(limit):
                break
        if int(limit) > 0 and n_seen >= int(limit):
            break

    m = compute_metrics(tp, fp, fn, beta=beta)
    m["n_eval"] = float(n_seen)
    return m


# ============================================================
# Split sampling (rank0 decides, broadcast via json)
# - VAL is split into val_tune and val_es to reduce "val overfit".
# ============================================================

def sample_split_stratified_4way(
    pos_ids: List[str],
    neg_ids: List[str],
    train_n: int,
    val_n: int,
    ptest_n: int,
    pos_frac: float,
    val_tune_frac: float,
    seed: int
) -> Dict[str, List[str]]:
    rnd = random.Random(int(seed))
    pos_pool = pos_ids.copy()
    neg_pool = neg_ids.copy()
    rnd.shuffle(pos_pool)
    rnd.shuffle(neg_pool)

    def take(lst, n):
        n = max(0, min(int(n), len(lst)))
        out = lst[:n]
        del lst[:n]
        return out

    pos_frac = float(pos_frac)

    # split val into tune + es
    val_tune_frac = float(val_tune_frac)
    val_tune_n = int(round(val_n * val_tune_frac))
    val_es_n = int(val_n) - int(val_tune_n)

    pos_n_train = int(round(train_n * pos_frac))
    neg_n_train = train_n - pos_n_train

    pos_n_vt = int(round(val_tune_n * pos_frac))
    neg_n_vt = val_tune_n - pos_n_vt

    pos_n_ve = int(round(val_es_n * pos_frac))
    neg_n_ve = val_es_n - pos_n_ve

    pos_n_pt = int(round(ptest_n * pos_frac))
    neg_n_pt = ptest_n - pos_n_pt

    val_tune = take(pos_pool, pos_n_vt) + take(neg_pool, neg_n_vt)
    val_es   = take(pos_pool, pos_n_ve) + take(neg_pool, neg_n_ve)
    ptest    = take(pos_pool, pos_n_pt) + take(neg_pool, neg_n_pt)
    train    = take(pos_pool, pos_n_train) + take(neg_pool, neg_n_train)

    rnd.shuffle(train)
    rnd.shuffle(val_tune)
    rnd.shuffle(val_es)
    rnd.shuffle(ptest)

    return {"train": train, "val_tune": val_tune, "val_es": val_es, "ptest": ptest}


