def parse_csv_floats(s: str) -> List[float]:
    out = []
    for x in str(s).split(","):
        x = x.strip()
        if x == "":
            continue
        out.append(float(x))
    return out

def parse_ratio_to_pos_frac(pos_neg_ratio: str) -> Optional[float]:
    """
    "40:60" -> 0.4
    """
    if pos_neg_ratio is None:
        return None
    s = str(pos_neg_ratio).strip()
    if s == "":
        return None
    if ":" not in s:
        return None
    a, b = s.split(":")
    a = float(a.strip())
    b = float(b.strip())
    den = a + b
    if den <= 0:
        return None
    return float(a / den)


