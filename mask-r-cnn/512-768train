def run_phase(
    phase_name: str,
    model_ddp: nn.Module,
    det_model: nn.Module,
    optimizer: optim.Optimizer,
    device: torch.device,
    train_img_dir: str,
    id2rles: Dict[str, List[str]],
    train_ids: List[str],
    val_ids: List[str],
    ptest_ids: List[str],
    bad_ids_set: set,
    train_size: int,
    max_epochs: int,
    patience: int,
    joint_grids: Dict[str, Any],
    eval_limits: Dict[str, int],
    run_dir: str,
    logger: RunLogger,
) -> Dict[str, Any]:
    """
    Train one phase with early stopping on rank0 joint F2.
    Returns: best info + best_joint.
    """
    # dataset/dataloader
    ds_train = AirbusMaskRcnnDataset(
        train_img_dir, id2rles, train_ids,
        bad_ids=bad_ids_set,
        min_instance_area=joint_grids["min_instance_area"],
        min_box_hw=joint_grids["min_box_hw"],
        augment=1
    )
    ds_val = AirbusMaskRcnnDataset(
        train_img_dir, id2rles, val_ids,
        bad_ids=bad_ids_set,
        min_instance_area=joint_grids["min_instance_area"],
        min_box_hw=joint_grids["min_box_hw"],
        augment=0
    )
    ds_ptest = AirbusMaskRcnnDataset(
        train_img_dir, id2rles, ptest_ids,
        bad_ids=bad_ids_set,
        min_instance_area=joint_grids["min_instance_area"],
        min_box_hw=joint_grids["min_box_hw"],
        augment=0
    )

    # DDP sampler for train
    train_sampler = DistributedSampler(ds_train, shuffle=True) if is_dist_avail_and_initialized() else None

    dl_train = DataLoader(
        ds_train,
        batch_size=joint_grids["batch_train"],
        shuffle=(train_sampler is None),
        sampler=train_sampler,
        num_workers=joint_grids["num_workers"],
        pin_memory=True,
        collate_fn=collate_fn,
        drop_last=False,
    )

    dl_val = DataLoader(
        ds_val,
        batch_size=joint_grids["batch_eval"],
        shuffle=False,
        num_workers=joint_grids["num_workers"],
        pin_memory=True,
        collate_fn=collate_fn,
        drop_last=False,
    )

    dl_ptest = DataLoader(
        ds_ptest,
        batch_size=joint_grids["batch_eval"],
        shuffle=False,
        num_workers=joint_grids["num_workers"],
        pin_memory=True,
        collate_fn=collate_fn,
        drop_last=False,
    )

    # set transform size
    set_maskrcnn_transform_size(get_model_to_save(model_ddp), int(train_size), int(train_size))
    logger.g(f"[{phase_name}] train transform size: min=max={int(train_size)}")

    # joint grid spec
    score_thrs = np.linspace(float(joint_grids["score_thr_min"]), float(joint_grids["score_thr_max"]), int(joint_grids["grid_n"]))
    mask_thrs  = np.linspace(float(joint_grids["mask_thr_min"]),  float(joint_grids["mask_thr_max"]),  int(joint_grids["grid_n"]))
    w_det_grid = joint_grids["w_det_grid"]
    w_seg_grid = joint_grids["w_seg_grid"]
    bias_grid  = joint_grids["bias_grid"]
    tau_grid   = joint_grids["tau_grid"]

    # best tracking
    best_f2 = -1.0
    best_epoch = -1
    best_joint = {"score_thr": 0.5, "mask_thr": 0.5, "w_det": 1.0, "w_seg": 1.0, "bias": 0.0, "tau": 0.5}
    patience_left = int(patience)
    history = []

    # ckpt paths
    ckpt_best = os.path.join(run_dir, f"{phase_name}_best_model.pt")
    ckpt_last = os.path.join(run_dir, f"{phase_name}_last_model.pt")
    meta_best = os.path.join(run_dir, f"{phase_name}_best_meta.json")

    for epoch in range(int(max_epochs)):
        if train_sampler is not None:
            train_sampler.set_epoch(epoch)

        tr = train_one_epoch_ddp(model_ddp, dl_train, device, optimizer, epoch, logger, log_every=int(joint_grids["log_every"]))

        # sync all ranks before eval/tune
        ddp_barrier()

        # rank0 tune+eval
        joint = tune_joint_fusion_rank0(
            model=get_model_to_save(model_ddp),
            det_model=det_model,
            dl=dl_val,
            img_dir=train_img_dir,
            device=device,
            det_img_size=int(joint_grids["det_img_size"]),
            score_thrs=score_thrs,
            mask_thrs=mask_thrs,
            w_det_grid=w_det_grid,
            w_seg_grid=w_seg_grid,
            bias_grid=bias_grid,
            tau_grid=tau_grid,
            limit=int(joint_grids["tune_limit"]),
            logger=logger,
            beta=2.0
        )

        # broadcast joint to other ranks (optional but keeps consistency)
        if is_dist_avail_and_initialized():
            # pack to tensor
            if is_main_process():
                arr = torch.tensor([
                    float(joint.get("score_thr", 0.5)),
                    float(joint.get("mask_thr", 0.5)),
                    float(joint.get("w_det", 1.0)),
                    float(joint.get("w_seg", 1.0)),
                    float(joint.get("bias", 0.0)),
                    float(joint.get("tau", 0.5)),
                ], device=device, dtype=torch.float32)
            else:
                arr = torch.zeros((6,), device=device, dtype=torch.float32)
            dist.broadcast(arr, src=0)
            joint = {
                "score_thr": float(arr[0].item()),
                "mask_thr": float(arr[1].item()),
                "w_det": float(arr[2].item()),
                "w_seg": float(arr[3].item()),
                "bias": float(arr[4].item()),
                "tau": float(arr[5].item()),
            }

        valm = eval_joint_pixel_union_rank0(
            model=get_model_to_save(model_ddp),
            det_model=det_model,
            dl=dl_val,
            img_dir=train_img_dir,
            device=device,
            det_img_size=int(joint_grids["det_img_size"]),
            joint=joint,
            limit=int(eval_limits["val_eval_limit"]),
            logger=logger,
            beta=2.0
        )

        # record history only on rank0
        if is_main_process():
            hist = {
                "epoch": int(epoch),
                "train_loss": float(tr["loss"]),
                "val_f2": float(valm.get("f2", 0.0)),
                "val_precision": float(valm.get("precision", 0.0)),
                "val_recall": float(valm.get("recall", 0.0)),
                "val_iou": float(valm.get("iou", 0.0)),
                "joint": dict(joint),
            }
            history.append(hist)
            save_json(os.path.join(run_dir, f"{phase_name}_history.json"), history)

            logger.g(
                f"[{phase_name}][VAL] epoch={epoch} train_loss={tr['loss']:.6f} "
                f"f2={valm.get('f2',0.0):.6f} prec={valm.get('precision',0.0):.4f} rec={valm.get('recall',0.0):.4f} "
                f"iou={valm.get('iou',0.0):.4f} "
                f"score_thr={joint['score_thr']:.3f} mask_thr={joint['mask_thr']:.3f} "
                f"w_det={joint['w_det']:.2f} w_seg={joint['w_seg']:.2f} bias={joint['bias']:.2f} tau={joint['tau']:.2f}"
            )

        # save last always (rank0)
        if is_main_process():
            torch.save(get_model_to_save(model_ddp).state_dict(), ckpt_last)

        # early stopping based on val f2 (rank0)
        improved = False
        if is_main_process():
            cur_f2 = float(valm.get("f2", -1.0))
            if cur_f2 > best_f2:
                best_f2 = cur_f2
                best_epoch = int(epoch)
                best_joint = dict(joint)
                torch.save(get_model_to_save(model_ddp).state_dict(), ckpt_best)
                save_json(meta_best, {
                    "phase": phase_name,
                    "best_epoch": best_epoch,
                    "best_val_f2": best_f2,
                    "best_joint": best_joint,
                })
                logger.g(f"[{phase_name}][CKPT] saved BEST -> {ckpt_best} (epoch={best_epoch}, f2={best_f2:.6f})")
                patience_left = int(patience)
                improved = True
            else:
                patience_left -= 1
                logger.g(f"[{phase_name}][ES] no improve. patience_left={patience_left}/{patience}")
                if patience_left <= 0:
                    logger.g(f"[{phase_name}][ES] early stop")
        # synchronize decision
        if is_dist_avail_and_initialized():
            flag = torch.tensor([1 if improved else 0], device=device, dtype=torch.int32) if is_main_process() else torch.tensor([0], device=device, dtype=torch.int32)
            dist.broadcast(flag, src=0)
            # patience_left sync
            pten = torch.tensor([patience_left], device=device, dtype=torch.int32) if is_main_process() else torch.tensor([0], device=device, dtype=torch.int32)
            dist.broadcast(pten, src=0)
            patience_left = int(pten.item())
        ddp_barrier()
        if patience_left <= 0:
            break

    # load best model for ptest summary (rank0 only)
    if is_main_process() and os.path.isfile(ckpt_best):
        get_model_to_save(model_ddp).load_state_dict(torch.load(ckpt_best, map_location=device))
        logger.g(f"[{phase_name}] loaded BEST for ptest eval")

    ptest_m = eval_joint_pixel_union_rank0(
        model=get_model_to_save(model_ddp),
        det_model=det_model,
        dl=dl_ptest,
        img_dir=train_img_dir,
        device=device,
        det_img_size=int(joint_grids["det_img_size"]),
        joint=best_joint,
        limit=int(eval_limits["ptest_eval_limit"]),
        logger=logger,
        beta=2.0
    )

    out = {
        "phase": phase_name,
        "train_size": int(train_size),
        "best_epoch": int(best_epoch),
        "best_val_f2": float(best_f2),
        "best_joint": dict(best_joint),
        "ckpt_best": ckpt_best,
        "ckpt_last": ckpt_last,
        "ptest_metrics": dict(ptest_m) if is_main_process() else {},
    }
    return out


# ============================================================
# Main
# ============================================================

def main():
    ddp_setup(backend="nccl")

    args = build_argparser().parse_args()

    # rank-aware seed
    set_seed(seed_for_rank(args.seed))

    # device
    if torch.cuda.is_available():
        device = torch.device(f"cuda:{int(os.environ.get('LOCAL_RANK','0'))}")
    else:
        device = torch.device("cpu")

    # paths
    data_dir = args.data_dir
    train_img_dir = os.path.join(data_dir, "train_v2")
    test_img_dir  = os.path.join(data_dir, "test_v2")
    train_csv = os.path.join(data_dir, "train_ship_segmentations_v2.csv")
    sample_sub = os.path.join(data_dir, "sample_submission_v2.csv")

    if is_main_process():
        assert os.path.isdir(train_img_dir), f"missing: {train_img_dir}"
        assert os.path.isdir(test_img_dir),  f"missing: {test_img_dir}"
        assert os.path.isfile(train_csv),    f"missing: {train_csv}"
        assert os.path.isfile(sample_sub),   f"missing: {sample_sub}"
    ddp_barrier()

    # run dir (rank0 creates and broadcasts name)
    if is_main_process():
        run_name = f"run__maskrcnn_detfuse_ddp__seed{args.seed}__train{args.train_n}__val{args.val_n}__ptest{args.ptest_n}__pos{int(args.pos_frac*100)}__{int(time.time())}"
        run_dir = os.path.join(args.out_dir, run_name)
        ensure_dir(run_dir)
    else:
        run_dir = ""
    if is_dist_avail_and_initialized():
        # broadcast run_dir length + bytes
        if is_main_process():
            b = run_dir.encode("utf-8")
            n = torch.tensor([len(b)], device=device, dtype=torch.int32)
        else:
            n = torch.tensor([0], device=device, dtype=torch.int32)
        dist.broadcast(n, src=0)
        n_int = int(n.item())
        if is_main_process():
            buf = torch.from_numpy(np.frombuffer(run_dir.encode("utf-8"), dtype=np.uint8)).to(device)
        else:
            buf = torch.zeros((n_int,), device=device, dtype=torch.uint8)
        dist.broadcast(buf, src=0)
        if not is_main_process():
            run_dir = bytes(buf.cpu().numpy().tolist()).decode("utf-8")

    logger = RunLogger(run_dir)

    # global meta logs (rank0)
    if is_main_process():
        logger.g(f"[run] run_dir={run_dir}")
        logger.g(f"[run] data_dir={data_dir}")
        logger.g(f"[run] world_size={get_world_size()} rank0_device={device}")
        if torch.cuda.is_available():
            for i in range(torch.cuda.device_count()):
                logger.g(f"[gpu] cuda:{i} name={torch.cuda.get_device_name(i)}")
        logger.g(f"[args] {vars(args)}")

    # load mappings and ids (rank0 decides and saves files)
    id2rles = load_id2rles(train_csv)
    all_train_ids = list_image_ids(train_img_dir)
    template_ids = read_template_ids(sample_sub)

    pos_set = set(id2rles.keys())
    pos_ids_all = [i for i in all_train_ids if i in pos_set]
    neg_ids_all = [i for i in all_train_ids if i not in pos_set]

    if is_main_process():
        logger.g(f"[data] train_images={len(all_train_ids)} pos_ids(csv)={len(pos_ids_all)} neg_ids={len(neg_ids_all)} template_ids={len(template_ids)}")

    # integrity scan (rank0 -> json -> all ranks load)
    integrity_train_json = os.path.join(run_dir, "integrity_train.json")
    integrity_test_json  = os.path.join(run_dir, "integrity_test.json")

    integ_train = integrity_scan_image_ids(train_img_dir, all_train_ids, logger, integrity_train_json, limit=int(args.integrity_scan_limit))
    integ_test  = integrity_scan_image_ids(test_img_dir,  template_ids,  logger, integrity_test_json,  limit=int(args.integrity_scan_limit))
    bad_train = set(integ_train.get("bad_ids", []))
    bad_test  = set(integ_test.get("bad_ids", []))

    # split (rank0 saves to splits.json)
    splits_path = os.path.join(run_dir, "splits.json")
    if is_main_process():
        splits = sample_split_stratified(pos_ids_all, neg_ids_all, args.train_n, args.val_n, args.ptest_n, args.pos_frac, seed=args.seed)
        save_json(splits_path, splits)
        logger.g(f"[split] train={len(splits['train'])} val={len(splits['val'])} ptest={len(splits['ptest'])} (disjoint by construction)")
    ddp_barrier()
    splits = load_json(splits_path)

    # build detector (each rank loads ckpt; forward will be on its own GPU)
    det_model = EffNetV2Binary(variant=args.det_variant, pretrained_backbone=int(args.det_pretrained_backbone)).to(device)
    load_ckpt_flexible(det_model, args.detector_ckpt, device)
    det_model.eval()
    if is_main_process():
        logger.g(f"[det] loaded ckpt={args.detector_ckpt} variant={args.det_variant} det_img_size={args.det_img_size}")

    # detector ranking & outputs (rank0 only)
    # Phase1 ranking
    det_rank_phase1_json = os.path.join(run_dir, "detector_probs_phase1_train_ranked.json")
    det_rank_phase1_csv  = os.path.join(run_dir, "detector_probs_phase1_train_ranked.csv")
    train_ids_phase1_json = os.path.join(run_dir, "train_ids_after_rank_phase1.json")
    train_ids_phase1_csv  = os.path.join(run_dir, "detector_probs_train_used_phase1.csv")

    if is_main_process():
        scored1 = compute_detector_probs_rank0(
            det_model, train_img_dir, splits["train"], int(args.det_img_size), device,
            score_all_limit=int(args.rank_score_all_limit),
            logger=logger
        )
        save_json(det_rank_phase1_json, [{"image_id": i, "det_prob": float(p)} for i, p in scored1])
        write_csv_rows(det_rank_phase1_csv, ["ImageId", "det_prob"], [[i, f"{p:.10f}"] for i, p in scored1])
        train_ids_phase1 = build_train_ids_from_rank(splits["train"], scored1, args.train_n, args.phase1_top_frac, args.phase1_bottom_frac)
        save_json(train_ids_phase1_json, train_ids_phase1)

        # also write det_prob for used ids (best-effort; if id not scored, det_prob=nan)
        score_map1 = {i: p for i, p in scored1}
        rows_used1 = [[i, f"{score_map1[i]:.10f}"] for i in train_ids_phase1 if i in score_map1]
        write_csv_rows(train_ids_phase1_csv, ["ImageId", "det_prob"], rows_used1)

        logger.g(f"[rank][phase1] scored_n={len(scored1)} train_ids={len(train_ids_phase1)} top_frac={args.phase1_top_frac} bottom_frac={args.phase1_bottom_frac}")
        if len(scored1) > 0:
            tops = ", ".join([f"{p:.3f}" for _i, p in scored1[:10]])
            bots = ", ".join([f"{p:.3f}" for _i, p in scored1[-10:]])
            logger.g(f"[rank][phase1] top10={tops}")
            logger.g(f"[rank][phase1] bot10={bots}")
    ddp_barrier()
    train_ids_phase1 = load_json(train_ids_phase1_json)

    # Phase2 ranking (optional recompute; otherwise reuse phase1 order)
    det_rank_phase2_json = os.path.join(run_dir, "detector_probs_phase2_train_ranked.json")
    det_rank_phase2_csv  = os.path.join(run_dir, "detector_probs_phase2_train_ranked.csv")
    train_ids_phase2_json = os.path.join(run_dir, "train_ids_after_rank_phase2.json")
    train_ids_phase2_csv  = os.path.join(run_dir, "detector_probs_train_used_phase2.csv")

    if is_main_process():
        if int(args.re_rank_phase2) == 1:
            scored2 = compute_detector_probs_rank0(
                det_model, train_img_dir, splits["train"], int(args.det_img_size), device,
                score_all_limit=int(args.rank_score_all_limit),
                logger=logger
            )
        else:
            # reuse phase1 scored list if exists, else compute
            if os.path.isfile(det_rank_phase1_json):
                tmp = load_json(det_rank_phase1_json)
                scored2 = [(d["image_id"], float(d["det_prob"])) for d in tmp]
                scored2.sort(key=lambda x: x[1], reverse=True)
            else:
                scored2 = compute_detector_probs_rank0(
                    det_model, train_img_dir, splits["train"], int(args.det_img_size), device,
                    score_all_limit=int(args.rank_score_all_limit),
                    logger=logger
                )

        save_json(det_rank_phase2_json, [{"image_id": i, "det_prob": float(p)} for i, p in scored2])
        write_csv_rows(det_rank_phase2_csv, ["ImageId", "det_prob"], [[i, f"{p:.10f}"] for i, p in scored2])
        train_ids_phase2 = build_train_ids_from_rank(splits["train"], scored2, args.train_n, args.phase2_top_frac, args.phase2_bottom_frac)
        save_json(train_ids_phase2_json, train_ids_phase2)

        score_map2 = {i: p for i, p in scored2}
        rows_used2 = [[i, f"{score_map2[i]:.10f}"] for i in train_ids_phase2 if i in score_map2]
        write_csv_rows(train_ids_phase2_csv, ["ImageId", "det_prob"], rows_used2)

        logger.g(f"[rank][phase2] re_rank={args.re_rank_phase2} scored_n={len(scored2)} train_ids={len(train_ids_phase2)} top_frac={args.phase2_top_frac} bottom_frac={args.phase2_bottom_frac}")
    ddp_barrier()
    train_ids_phase2 = load_json(train_ids_phase2_json)

    # Build Mask R-CNN + DDP
    model = build_maskrcnn(
        num_classes=2,
        pretrained_backbone=int(args.maskrcnn_pretrained_backbone),
        init_min_size=int(args.phase1_size),
        init_max_size=int(args.phase1_size)
    ).to(device)

    model_ddp = ddp_wrap(model, device)

    optimizer = optim.AdamW(get_model_to_save(model_ddp).parameters(), lr=float(args.lr), weight_decay=float(args.weight_decay))

    # joint grids / config
    joint_grids = {
        "grid_n": int(args.joint_tune_grid_n),
        "tune_limit": int(args.joint_tune_limit),
        "w_det_grid": parse_csv_floats(args.joint_tune_wdet),
        "w_seg_grid": parse_csv_floats(args.joint_tune_wseg),
        "bias_grid":  parse_csv_floats(args.joint_tune_bias),
        "tau_grid":   parse_csv_floats(args.joint_tune_tau),
        "score_thr_min": float(args.score_thr_min),
        "score_thr_max": float(args.score_thr_max),
        "mask_thr_min":  float(args.mask_thr_min),
        "mask_thr_max":  float(args.mask_thr_max),
        "det_img_size": int(args.det_img_size),
        "batch_train": int(args.batch_train),
        "batch_eval": int(args.batch_eval),
        "num_workers": int(args.num_workers),
        "log_every": int(args.log_every),
        "min_instance_area": int(args.min_instance_area),
        "min_box_hw": int(args.min_box_hw),
    }
    eval_limits = {"val_eval_limit": int(args.val_eval_limit), "ptest_eval_limit": int(args.ptest_eval_limit)}

    # Phase1
    if is_main_process():
        logger.g("[phase1] start")
    ddp_barrier()

    phase1_info = run_phase(
        phase_name="phase1",
        model_ddp=model_ddp,
        det_model=det_model,
        optimizer=optimizer,
        device=device,
        train_img_dir=train_img_dir,
        id2rles=id2rles,
        train_ids=train_ids_phase1,
        val_ids=splits["val"],
        ptest_ids=splits["ptest"],
        bad_ids_set=bad_train,
        train_size=int(args.phase1_size),
        max_epochs=int(args.phase1_max_epochs),
        patience=int(args.phase1_patience),
        joint_grids=joint_grids,
        eval_limits=eval_limits,
        run_dir=run_dir,
        logger=logger,
    )
    ddp_barrier()

    # load phase1 best as init for phase2 (rank0 loads then broadcast weights implicitly by DDP sync on next forward;
    # to be explicit, rank0 loads and then broadcast state_dict tensors is heavy; simplest: all ranks load same file path.)
    ckpt_phase1_best = phase1_info.get("ckpt_best", os.path.join(run_dir, "phase1_best_model.pt"))
    ddp_barrier()
    if os.path.isfile(ckpt_phase1_best):
        get_model_to_save(model_ddp).load_state_dict(torch.load(ckpt_phase1_best, map_location=device))
    ddp_barrier()

    # Adjust LR for phase2
    for pg in optimizer.param_groups:
        pg["lr"] = float(args.lr) * float(args.lr_phase2_scale)
    if is_main_process():
        logger.g(f"[phase2] set lr = lr * {args.lr_phase2_scale} -> {optimizer.param_groups[0]['lr']:.6g}")

    # Phase2
    if is_main_process():
        logger.g("[phase2] start")
    ddp_barrier()

    phase2_info = run_phase(
        phase_name="phase2",
        model_ddp=model_ddp,
        det_model=det_model,
        optimizer=optimizer,
        device=device,
        train_img_dir=train_img_dir,
        id2rles=id2rles,
        train_ids=train_ids_phase2,
        val_ids=splits["val"],
        ptest_ids=splits["ptest"],
        bad_ids_set=bad_train,
        train_size=int(args.phase2_size),
        max_epochs=int(args.phase2_max_epochs),
        patience=int(args.phase2_patience),
        joint_grids=joint_grids,
        eval_limits=eval_limits,
        run_dir=run_dir,
        logger=logger,
    )
    ddp_barrier()

    # detector probs for infer(test template all ids)
    det_probs_infer_test_csv = os.path.join(run_dir, "detector_probs_infer_test.csv")
    if is_main_process():
        logger.g("[infer] compute detector probs for test template ids (submission order)")
    ddp_barrier()
    write_detector_probs_infer_test_rank0(
        det_model=det_model,
        test_img_dir=test_img_dir,
        template_ids=template_ids,
        det_img_size=int(args.det_img_size),
        device=device,
        out_csv=det_probs_infer_test_csv,
        logger=logger
    )
    ddp_barrier()

    # summary.json (rank0 only)
    if is_main_process():
        summary = {
            "run_dir": run_dir,
            "data_dir": data_dir,
            "seed": int(args.seed),
            "world_size": int(get_world_size()),
            "ddp_backend": "nccl",
            "phase1": phase1_info,
            "phase2": phase2_info,
            "best_joint_phase2": phase2_info.get("best_joint", {}),
            "logs": {
                "global": os.path.join(run_dir, "log_global.txt"),
                "detail": os.path.join(run_dir, "log_detail.txt"),
            },
            "detector_probs": {
                "train_phase1_ranked_json": det_rank_phase1_json,
                "train_phase1_ranked_csv": det_rank_phase1_csv,
                "train_phase1_used_csv": train_ids_phase1_csv,
                "train_phase2_ranked_json": det_rank_phase2_json,
                "train_phase2_ranked_csv": det_rank_phase2_csv,
                "train_phase2_used_csv": train_ids_phase2_csv,
                "infer_test_csv": det_probs_infer_test_csv,
            },
            "artifacts": {
                "splits_json": splits_path,
                "integrity_train_json": integrity_train_json,
                "integrity_test_json": integrity_test_json,
                "phase1_best_model": phase1_info.get("ckpt_best", ""),
                "phase1_last_model": phase1_info.get("ckpt_last", ""),
                "phase2_best_model": phase2_info.get("ckpt_best", ""),
                "phase2_last_model": phase2_info.get("ckpt_last", ""),
            }
        }
        save_json(os.path.join(run_dir, "summary.json"), summary)
        logger.g("[done] summary.json saved")
        logger.g(f"[done] phase1_best={summary['artifacts']['phase1_best_model']}")
        logger.g(f"[done] phase2_best={summary['artifacts']['phase2_best_model']}")
        logger.g(f"[done] detector_probs_infer_test={det_probs_infer_test_csv}")

    ddp_barrier()
    logger.close()

    # finalize
    if is_dist_avail_and_initialized():
        dist.destroy_process_group()


if __name__ == "__main__":
    main()
