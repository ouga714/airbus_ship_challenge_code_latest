@torch.no_grad()
def tune_joint_fusion_rank0(
    model: nn.Module,
    det_model: nn.Module,
    dl: DataLoader,
    img_dir: str,
    device: torch.device,
    det_img_size: int,
    score_thrs: np.ndarray,
    mask_thrs: np.ndarray,
    w_det_grid: List[float],
    w_seg_grid: List[float],
    bias_grid: List[float],
    tau_grid: List[float],
    limit: int,
    logger: RunLogger,
    beta: float = 2.0,
) -> Dict[str, Any]:
    """
    rank0-only joint grid search on a val subset.
    """
    if not is_main_process():
        return {}

    model.eval()
    det_model.eval()

    cache = []  # (gt_union, scores_cpu, mask_probs_cpu, det_p, (H,W))
    seen = 0

    for imgs, targets, ids in dl:
        for img_t, tgt, image_id in zip(imgs, targets, ids):
            H, W = img_t.shape[1], img_t.shape[2]
            gt_u = union_from_target(tgt, (H, W))

            out = infer_raw_outputs(model, img_t, device)
            scores = out["scores"].detach().cpu()
            mprob  = out["mask_probs"].detach().cpu()

            det_p = detector_prob_for_path(det_model, os.path.join(img_dir, image_id), det_img_size, device)

            cache.append((gt_u, scores, mprob, float(det_p), (H, W)))
            seen += 1
            if seen >= int(limit):
                break
        if seen >= int(limit):
            break

    if len(cache) == 0:
        return {
            "f2": -1.0,
            "score_thr": float(score_thrs[0]) if len(score_thrs) else 0.5,
            "mask_thr": float(mask_thrs[0]) if len(mask_thrs) else 0.5,
            "w_det": float(w_det_grid[0]) if len(w_det_grid) else 1.0,
            "w_seg": float(w_seg_grid[0]) if len(w_seg_grid) else 1.0,
            "bias": float(bias_grid[0]) if len(bias_grid) else 0.0,
            "tau": float(tau_grid[0]) if len(tau_grid) else 0.5,
        }

    best = {"f2": -1.0}

    logger.d(f"[tune] cache_n={len(cache)} grid: score={len(score_thrs)} mask={len(mask_thrs)} "
             f"wdet={len(w_det_grid)} wseg={len(w_seg_grid)} bias={len(bias_grid)} tau={len(tau_grid)}")

    for st in score_thrs:
        st = float(st)
        for mt in mask_thrs:
            mt = float(mt)

            per_img = []
            for gt_u, scores, mprob, det_p, shape_hw in cache:
                seg_p = seg_evidence_from_scores(scores)
                pr_u = insts_union_from_cached(scores, mprob, st, mt, shape_hw)
                per_img.append((gt_u, pr_u, det_p, seg_p))

            for w_det in w_det_grid:
                for w_seg in w_seg_grid:
                    for bias in bias_grid:
                        fused_ps = []
                        for (_gt_u, _pr_u, det_p, seg_p) in per_img:
                            fused_ps.append(fuse_det_seg_prob(det_p, seg_p, w_det, w_seg, bias))

                        for tau in tau_grid:
                            tau = float(tau)
                            tp = fp = fn = 0
                            for (gt_u, pr_u, _det_p, _seg_p), fprob in zip(per_img, fused_ps):
                                if float(fprob) < tau:
                                    pr = np.zeros_like(gt_u, dtype=np.uint8)
                                else:
                                    pr = pr_u
                                a, b, c = accumulate_counts(gt_u, pr)
                                tp += a; fp += b; fn += c
                            m = compute_metrics(tp, fp, fn, beta=beta)
                            if m["f2"] > best["f2"]:
                                best = {
                                    "f2": float(m["f2"]),
                                    "precision": float(m["precision"]),
                                    "recall": float(m["recall"]),
                                    "f1": float(m["f1"]),
                                    "iou": float(m["iou"]),
                                    "score_thr": float(st),
                                    "mask_thr": float(mt),
                                    "w_det": float(w_det),
                                    "w_seg": float(w_seg),
                                    "bias": float(bias),
                                    "tau": float(tau),
                                }

    return best

@torch.no_grad()
def eval_joint_pixel_union_rank0(
    model: nn.Module,
    det_model: nn.Module,
    dl: DataLoader,
    img_dir: str,
    device: torch.device,
    det_img_size: int,
    joint: Dict[str, float],
    limit: int,
    logger: RunLogger,
    beta: float = 2.0,
) -> Dict[str, float]:
    """
    rank0-only evaluation (simplifies DDP + keeps logs clean).
    """
    if not is_main_process():
        return {}

    model.eval()
    det_model.eval()

    tp = fp = fn = 0
    seen = 0

    for imgs, targets, ids in dl:
        for img_t, tgt, image_id in zip(imgs, targets, ids):
            H, W = img_t.shape[1], img_t.shape[2]
            gt_u = union_from_target(tgt, (H, W))

            out = infer_raw_outputs(model, img_t, device)
            scores_cpu = out["scores"].detach().cpu()
            mprob_cpu  = out["mask_probs"].detach().cpu()
            seg_p = seg_evidence_from_scores(scores_cpu)

            det_p = detector_prob_for_path(det_model, os.path.join(img_dir, image_id), det_img_size, device)
            fused_p = fuse_det_seg_prob(det_p, seg_p, joint["w_det"], joint["w_seg"], joint["bias"])

            if float(fused_p) < float(joint["tau"]):
                pr_u = np.zeros((H, W), dtype=np.uint8)
            else:
                pr_u = insts_union_from_cached(scores_cpu, mprob_cpu,
                                               joint["score_thr"], joint["mask_thr"], (H, W))

            a, b, c = accumulate_counts(gt_u, pr_u)
            tp += a; fp += b; fn += c

            seen += 1
            if int(limit) > 0 and seen >= int(limit):
                break

        if int(limit) > 0 and seen >= int(limit):
            break

    m = compute_metrics(tp, fp, fn, beta=beta)
    logger.d(f"[eval] seen={seen} tp={tp} fp={fp} fn={fn} -> f2={m['f2']:.6f}")
    return m


