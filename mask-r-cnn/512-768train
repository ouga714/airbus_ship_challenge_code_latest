def set_seed(seed: int) -> None:
    seed = int(seed)
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)
    # reproducibility-leaning
    torch.backends.cudnn.deterministic = True
    torch.backends.cudnn.benchmark = False

def seed_for_rank(seed: int) -> int:
    # rank-shifted seed for per-rank augmentation randomness, while keeping run reproducible
    return int(seed) + 1000 * int(get_rank())


