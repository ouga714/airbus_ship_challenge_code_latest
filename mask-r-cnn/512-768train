def write_detector_probs_infer_test_rank0(det_model: nn.Module, test_img_dir: str, template_ids: List[str],
                                         det_img_size: int, device: torch.device,
                                         out_csv: str, logger: RunLogger) -> None:
    if not is_main_process():
        return
    rows = []
    n = len(template_ids)
    for i, img_id in enumerate(template_ids, start=1):
        pth = os.path.join(test_img_dir, img_id)
        if not os.path.isfile(pth):
            p = 0.0
        else:
            p = detector_prob_for_path(det_model, pth, det_img_size, device)
        rows.append([img_id, f"{p:.10f}"])
        if i % 500 == 0:
            logger.g(f"[infer-det] {i}/{n}")
    write_csv_rows(out_csv, ["ImageId", "det_prob"], rows)
    logger.g(f"[infer-det] saved {out_csv} rows={len(rows)}")


