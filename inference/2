#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
infer_maskrcnn_morph_merge_nms_submit_tta.py

Mask R-CNN inference with TTA(flip4) -> morphology -> merge same-instance candidates (IoU clustering)
-> mask IoU NMS -> optional split -> final ownership -> submission.csv

Common requirements included:
- Morphology BEFORE NMS
- NMS uses mask IoU (with bbox IoU gate)
- Final overlap safety: pixel ownership enforcement (no pixel belongs to 2 instances)
- Submission in sample_submission_v2.csv order (variable rows allowed)

Example:
python3 infer_maskrcnn_morph_merge_nms_submit_tta.py \
  --data_dir /workspace/kaggle_competition/dataset/airbus_ship_detection \
  --out_csv  /workspace/kaggle_competition/submission_tta_merge.csv \
  --device cuda:0 \
  --score_thr 0.35 \
  --mask_thr 0.50 \
  --opening_radius 2 \
  --closing_radius 1 \
  --min_area 120 \
  --merge_iou_thr 0.70 \
  --mask_iou_thr 0.60 \
  --split_components 1 \
  --component_topk 15 \
  --max_instances_per_image 25
"""

