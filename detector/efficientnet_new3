def build_argparser():
    ap = argparse.ArgumentParser()
    ap.add_argument("--phase", type=int, required=True, choices=[1, 2], help="1 or 2")
    ap.add_argument("--data_dir", type=str, required=True)
    ap.add_argument("--out_dir", type=str, required=True)

    # model
    ap.add_argument("--model", type=str, default="efficientnet_v2_s")
    ap.add_argument("--img_size", type=int, default=768)
    ap.add_argument("--pretrained", type=int, default=1)

    # split
    ap.add_argument("--seed", type=int, default=42)
    ap.add_argument("--val_ratio", type=float, default=0.15)
    ap.add_argument("--splits_json", type=str, default="", help="Phase-2 must point to Phase-1 splits.json")

    # phase-2 init
    ap.add_argument("--init_ckpt", type=str, default="", help="Phase-2 must point to Phase-1 best_model.pt")

    # training
    ap.add_argument("--epochs", type=int, default=20)
    ap.add_argument("--batch", type=int, default=8)
    ap.add_argument("--num_workers", type=int, default=4)
    ap.add_argument("--lr", type=float, default=2e-4)
    ap.add_argument("--weight_decay", type=float, default=1e-4)
    ap.add_argument("--grad_clip", type=float, default=0.0)
    ap.add_argument("--early_stop_patience", type=int, default=5)

    # sampler for 4:6 exposure
    ap.add_argument("--use_weighted_sampler", type=int, default=1)
    ap.add_argument("--target_pos_frac", type=float, default=0.40)

    # threshold tuning
    ap.add_argument("--thr_grid_n", type=int, default=101)

    # scheduler
    ap.add_argument("--cosine_eta_min_ratio", type=float, default=0.05)
    ap.add_argument("--warmup_steps", type=int, default=0)

    # multi-scale (Phase-2 train only)
    ap.add_argument("--ms_min", type=int, default=672)
    ap.add_argument("--ms_max", type=int, default=832)
    ap.add_argument("--pos_bbox_crop_prob", type=float, default=1.0, help="Phase-2 POS bbox-guided crop prob (1.0 recommended)")
    ap.add_argument("--bbox_margin_min", type=float, default=1.8)
    ap.add_argument("--bbox_margin_max", type=float, default=4.0)

    # logs
    ap.add_argument("--log_every", type=int, default=50)

    return ap


def main():
    args = build_argparser().parse_args()

    # Sanity checks for requirements
    if args.img_size != 768:
        raise ValueError("This script is specialized for img_size=768 as per your requirement.")
    if not (0.0 <= args.val_ratio < 0.5):
        raise ValueError("--val_ratio must be in [0,0.5)")
    if not (0.0 < args.target_pos_frac < 1.0):
        raise ValueError("--target_pos_frac must be in (0,1)")
    if args.phase == 2:
        if args.init_ckpt.strip() == "":
            raise ValueError("Phase-2 requires --init_ckpt (Phase-1 best_model.pt)")
        if args.splits_json.strip() == "":
            raise ValueError("Phase-2 requires --splits_json (Phase-1 splits.json)")
    if args.phase == 1 and args.splits_json.strip() != "":
        # not forbidden, but irrelevant
        pass

    seed_everything(int(args.seed))

    train_img_dir = os.path.join(args.data_dir, "train_v2")
    train_csv = os.path.join(args.data_dir, "train_ship_segmentations_v2.csv")
    if not os.path.exists(train_img_dir):
        raise RuntimeError(f"train_v2 not found: {train_img_dir}")
    if not os.path.exists(train_csv):
        raise RuntimeError(f"train_ship_segmentations_v2.csv not found: {train_csv}")

    # Run dir naming (timestamp included to avoid collisions)
    ts = int(time.time())
    if args.phase == 1:
        run_name = (
            f"run__P1__detector__{args.model}__img{args.img_size}"
            f"__seed{args.seed}__valr{args.val_ratio:.2f}__tpos{args.target_pos_frac:.2f}__ts{ts}"
        )
    else:
        run_name = (
            f"run__P2__detector__{args.model}__img{args.img_size}"
            f"__seed{args.seed}__valr{args.val_ratio:.2f}__tpos{args.target_pos_frac:.2f}"
            f"__ms{args.ms_min}-{args.ms_max}__bboxp{args.pos_bbox_crop_prob:.2f}__ts{ts}"
        )

    run_dir = os.path.join(args.out_dir, run_name)
    safe_mkdir(run_dir)
    log = DualLogger(run_dir, also_stdout=True)

    log.g("==== START: Airbus Detector Two-Phase Training ====")
    log.g(f"phase={args.phase}")
    log.g(f"run_dir={run_dir}")
    log.g(f"data_dir={args.data_dir}")
    log.g(f"train_img_dir={train_img_dir}")
    log.g(f"train_csv={train_csv}")
    log.g(f"CUDA_VISIBLE_DEVICES={os.environ.get('CUDA_VISIBLE_DEVICES','(not set)')}")
    log.g(f"sklearn_available={_HAS_SKLEARN}")

    # device (use CUDA_VISIBLE_DEVICES to force cuda2)
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    log.g(f"device={device}")

    # bbox/pos cache path (in run_dir to keep it self-contained)
    cache_path = os.path.join(run_dir, "bbox_cache.json")
    build_bbox = (args.phase == 2)  # bbox needed only in phase-2 train for ship-preserving crop
    pos_set, bbox_map = load_pos_set_and_bbox_map_with_cache(train_csv, cache_path, build_bbox=build_bbox, log=log)

    all_ids = list_train_ids(train_img_dir)

    log.g(f"ALL images={len(all_ids)} POS={len(pos_set)} POS_rate={len(pos_set)/len(all_ids):.6f}")
    if args.phase == 2:
        log.g(f"bbox_map size={len(bbox_map)} (POS with bbox parsed)")

    # splits
    if args.phase == 1:
        splits = stratified_split(all_ids, pos_set, val_ratio=float(args.val_ratio), seed=int(args.seed))
        train_ids = splits["train"]
        val_ids = splits["val"]

        splits_obj = {
            "seed": int(args.seed),
            "val_ratio": float(args.val_ratio),
            "train_n": len(train_ids),
            "val_n": len(val_ids),
            "train_ids": train_ids,
            "val_ids": val_ids,
        }
        with open(os.path.join(run_dir, "splits.json"), "w", encoding="utf-8") as f:
            json.dump(splits_obj, f, indent=2, ensure_ascii=False)
        log.g(f"[SPLIT] Phase-1 created split: train={len(train_ids)} val={len(val_ids)}")
    else:
        # Phase-2: MUST reuse Phase-1 split exactly
        with open(args.splits_json, "r", encoding="utf-8") as f:
            splits_obj = json.load(f)
        train_ids = splits_obj["train_ids"]
        val_ids = splits_obj["val_ids"]
        # Save a copy for traceability
        with open(os.path.join(run_dir, "splits.json"), "w", encoding="utf-8") as f:
            json.dump(splits_obj, f, indent=2, ensure_ascii=False)
        log.g(f"[SPLIT] Phase-2 reused split from: {args.splits_json}")
        log.g(f"[SPLIT] train={len(train_ids)} val={len(val_ids)} (MUST match Phase-1)")

    # config save
    with open(os.path.join(run_dir, "config.json"), "w", encoding="utf-8") as f:
        json.dump(vars(args), f, indent=2, ensure_ascii=False)

    # transforms (VAL always fixed 768)
    tfm_pos_fixed = build_tfm_fixed768(train=True, strong=True, img_size=args.img_size)
    tfm_neg_fixed = build_tfm_fixed768(train=True, strong=False, img_size=args.img_size)
    tfm_val_fixed = build_tfm_fixed768(train=False, strong=False, img_size=args.img_size)

    ms_params = None
    if args.phase == 2:
        if args.ms_min <= 0 or args.ms_max <= 0 or args.ms_max < args.ms_min:
            raise ValueError("Invalid ms_min/ms_max")
        if not (0.0 <= args.pos_bbox_crop_prob <= 1.0):
            raise ValueError("pos_bbox_crop_prob must be in [0,1]")
        if args.bbox_margin_min <= 1.0 or args.bbox_margin_max <= 1.0 or args.bbox_margin_max < args.bbox_margin_min:
            raise ValueError("Invalid bbox_margin range")
        ms_params = MultiScaleParams(
            ms_min=int(args.ms_min),
            ms_max=int(args.ms_max),
            bbox_margin_min=float(args.bbox_margin_min),
            bbox_margin_max=float(args.bbox_margin_max),
            pos_bbox_crop_prob=float(args.pos_bbox_crop_prob),
        )

    ds_train = AirbusDetectorDataset(
        img_dir=train_img_dir,
        image_ids=train_ids,
        pos_set=pos_set,
        train=True,
        tfm_pos_fixed=tfm_pos_fixed,
        tfm_neg_fixed=tfm_neg_fixed,
        tfm_val_fixed=tfm_val_fixed,
        phase=int(args.phase),
        bbox_map=bbox_map if args.phase == 2 else None,
        ms_params=ms_params,
        img_size=args.img_size,
    )
    ds_val = AirbusDetectorDataset(
        img_dir=train_img_dir,
        image_ids=val_ids,
        pos_set=pos_set,
        train=False,
        tfm_pos_fixed=tfm_pos_fixed,
        tfm_neg_fixed=tfm_neg_fixed,
        tfm_val_fixed=tfm_val_fixed,
        phase=int(args.phase),
        bbox_map=None,
        ms_params=None,
        img_size=args.img_size,
    )

    # sampler to enforce exposure ratio 4:6 (target_pos_frac=0.40)
    sampler = None
    shuffle = True
    if int(args.use_weighted_sampler) == 1:
        sampler, shuffle = build_weighted_sampler(train_ids, pos_set, float(args.target_pos_frac), log)
    else:
        labels = np.array([1 if i in pos_set else 0 for i in train_ids], dtype=np.int64)
        log.g(f"[SAMPLER] disabled: train_pos_rate={labels.mean():.6f}")

    num_workers = int(args.num_workers)
    dl_train = DataLoader(
        ds_train,
        batch_size=int(args.batch),
        shuffle=shuffle,
        sampler=sampler,
        num_workers=num_workers,
        pin_memory=True,
        drop_last=True,
        persistent_workers=(num_workers > 0),
    )
    dl_val = DataLoader(
        ds_val,
        batch_size=max(1, int(args.batch)),
        shuffle=False,
        num_workers=num_workers,
        pin_memory=True,
        drop_last=False,
        persistent_workers=(num_workers > 0),
    )

    # model
    model = build_model(args.model, pretrained=(int(args.pretrained) == 1), log=log).to(device)

    # Phase-2: load init checkpoint strictly
    if args.phase == 2:
        if not os.path.exists(args.init_ckpt):
            raise RuntimeError(f"init_ckpt not found: {args.init_ckpt}")
        ckpt = torch.load(args.init_ckpt, map_location="cpu")
        state = ckpt["model"] if isinstance(ckpt, dict) and "model" in ckpt else ckpt
        missing, unexpected = model.load_state_dict(state, strict=False)
        log.g(f"[INIT] loaded init_ckpt={args.init_ckpt}")
        log.d(f"[INIT] missing_keys={len(missing)} unexpected_keys={len(unexpected)}")
        # you can enforce strict=True if you prefer:
        # model.load_state_dict(state, strict=True)

    # loss (plain BCEWithLogitsLoss; class exposure is controlled by sampler)
    bce = nn.BCEWithLogitsLoss()

    def criterion(logit, y):
        return bce(logit, y)

    optimizer = torch.optim.AdamW(model.parameters(), lr=float(args.lr), weight_decay=float(args.weight_decay))

    # scheduler: cosine per-iteration
    total_steps = max(1, int(args.epochs) * max(1, len(dl_train)))
    eta_min = float(args.lr) * float(args.cosine_eta_min_ratio)
    cosine = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=total_steps, eta_min=eta_min)
    warmup_steps = int(args.warmup_steps)
    global_step = 0

    def warmup_adjust_lr(step: int):
        if warmup_steps <= 0:
            return
        if step <= warmup_steps:
            scale = float(step) / float(max(1, warmup_steps))
            for pg in optimizer.param_groups:
                pg["lr"] = float(args.lr) * scale

    log.g(f"[SCHED] cosine T_max={total_steps} eta_min={eta_min:.6e} warmup_steps={warmup_steps}")
    log.g(f"[THR] select by F2 on VAL grid_n={int(args.thr_grid_n)} (VAL always fixed 768)")

    # early stopping on best F2
    best_score = -1.0
    best_epoch = -1
    best_thr = 0.5
    best_val_metrics = {}
    no_improve = 0

    for epoch in range(1, int(args.epochs) + 1):
        # train
        if warmup_steps > 0:
            model.train()
            loss_sum = 0.0
            n = 0
            t0 = time.time()
            for it, (x, y, _) in enumerate(dl_train, start=1):
                global_step += 1
                warmup_adjust_lr(global_step)

                x = x.to(device, non_blocking=True)
                y = y.to(device, non_blocking=True)

                optimizer.zero_grad(set_to_none=True)
                logit = model(x)
                loss = criterion(logit, y)
                loss.backward()

                if args.grad_clip and float(args.grad_clip) > 0:
                    torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=float(args.grad_clip))

                optimizer.step()
                cosine.step()

                bs = int(y.shape[0])
                loss_sum += float(loss.item()) * bs
                n += bs

                if int(args.log_every) > 0 and (it % int(args.log_every) == 0):
                    lr_now = optimizer.param_groups[0]["lr"]
                    log.d(f"[TRAIN] epoch={epoch} iter={it}/{len(dl_train)} loss={loss.item():.6f} lr={lr_now:.6e}")

            tr = {"train_loss": float(loss_sum / max(1, n)), "train_n": float(n), "sec": float(time.time() - t0)}
        else:
            tr = train_one_epoch(
                model=model,
                loader=dl_train,
                device=device,
                optimizer=optimizer,
                criterion=criterion,
                scheduler=cosine,
                epoch=epoch,
                log=log,
                log_every=int(args.log_every),
                grad_clip=float(args.grad_clip),
            )
            global_step += len(dl_train)

        # val
        y_prob, y_true = predict_probs(model, dl_val, device=device)
        thr, pack = select_threshold_by_f2_grid(y_prob, y_true, thr_grid_n=int(args.thr_grid_n))
        val_metrics = dict(pack)

        score = float(val_metrics["f2"])  # early-stop target

        lr_now = optimizer.param_groups[0]["lr"]
        log.g(
            f"[EPOCH] {epoch}/{int(args.epochs)} "
            f"train_loss={tr['train_loss']:.6f} sec={tr['sec']:.1f} lr={lr_now:.6e} "
            f"VAL: thr={thr:.3f} "
            f"acc={val_metrics['acc']:.5f} "
            f"p={val_metrics['precision']:.5f} r={val_metrics['recall']:.5f} "
            f"f1={val_metrics['f1']:.5f} f2={val_metrics['f2']:.5f} "
            f"auroc={val_metrics['auroc']:.5f}"
        )

        # save last
        last_path = os.path.join(run_dir, "last_model.pt")
        torch.save({
            "epoch": epoch,
            "global_step": global_step,
            "model": model.state_dict(),
            "config": vars(args),
            "val_thr": float(thr),
            "val_metrics": val_metrics,
        }, last_path)

        # update best
        if score > best_score + 1e-12:
            best_score = float(score)
            best_epoch = int(epoch)
            best_thr = float(thr)
            best_val_metrics = dict(val_metrics)
            no_improve = 0

            best_path = os.path.join(run_dir, "best_model.pt")
            torch.save({
                "epoch": epoch,
                "global_step": global_step,
                "model": model.state_dict(),
                "config": vars(args),
                "best_thr": float(best_thr),
                "val_metrics": best_val_metrics,
            }, best_path)

            # keep best val probs for auditing
            np.savez_compressed(os.path.join(run_dir, "val_probs_best.npz"), y_prob=y_prob, y_true=y_true)

            log.g(f"[BEST] epoch={best_epoch} best_f2={best_score:.6f} best_thr={best_thr:.3f} saved={best_path}")
        else:
            no_improve += 1
            log.g(f"[EARLYSTOP] no_improve={no_improve}/{int(args.early_stop_patience)}")

        if int(args.early_stop_patience) > 0 and no_improve >= int(args.early_stop_patience):
            log.g("[EARLYSTOP] triggered. stop training.")
            break

    # write summary
    best_model_path = os.path.join(run_dir, "best_model.pt")
    head_sha1 = sha1_of_file_head(best_model_path) if os.path.exists(best_model_path) else "NA"
    out_json = os.path.join(run_dir, "metrics_val_best.json")
    with open(out_json, "w", encoding="utf-8") as f:
        json.dump({
            "phase": int(args.phase),
            "run_dir": run_dir,
            "best_epoch": best_epoch,
            "best_f2": best_score,
            "best_thr": best_thr,
            "best_val_metrics": best_val_metrics,
            "best_model_path": best_model_path,
            "best_model_sha1_head_1mb": head_sha1,
            "splits_json": os.path.join(run_dir, "splits.json"),
            "init_ckpt": args.init_ckpt if args.phase == 2 else "",
            "notes": {
                "val_is_fixed_768": True,
                "phase2_train_is_multiscale": (args.phase == 2),
                "phase2_pos_crop_guarantees_ship_included": (args.phase == 2),
                "pos_exposure_control_target_pos_frac": float(args.target_pos_frac),
            }
        }, f, indent=2, ensure_ascii=False)

    log.g("==== DONE ====")
    log.g(f"run_dir={run_dir}")
    log.g(f"best_epoch={best_epoch} best_f2={best_score:.6f} best_thr={best_thr:.3f}")
    log.g(f"best_model.pt sha1(first1MB)={head_sha1}")
    log.g(f"metrics_val_best.json={out_json}")
    log.close()


if __name__ == "__main__":
    main()
