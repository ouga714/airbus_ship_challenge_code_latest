_IMNET_MEAN = (0.485, 0.456, 0.406)
_IMNET_STD  = (0.229, 0.224, 0.225)


class AddGaussianNoise:
    def __init__(self, sigma_min: float = 0.0, sigma_max: float = 0.02, p: float = 0.3):
        self.sigma_min = float(sigma_min)
        self.sigma_max = float(sigma_max)
        self.p = float(p)

    def __call__(self, x: torch.Tensor) -> torch.Tensor:
        if random.random() > self.p:
            return x
        sigma = random.uniform(self.sigma_min, self.sigma_max)
        noise = torch.randn_like(x) * sigma
        return torch.clamp(x + noise, 0.0, 1.0)


def build_tfm_fixed768(train: bool, strong: bool, img_size: int = 768):
    """
    Fixed-size transform for Phase-1 (train/val both at 768).
    strong=True: POS augmentation (still moderate; avoid destroying ship evidence).
    """
    if not train:
        return transforms.Compose([
            transforms.Resize((img_size, img_size), interpolation=transforms.InterpolationMode.BILINEAR),
            transforms.ToTensor(),
            transforms.Normalize(mean=_IMNET_MEAN, std=_IMNET_STD),
        ])

    if strong:
        return transforms.Compose([
            transforms.Resize((img_size, img_size), interpolation=transforms.InterpolationMode.BILINEAR),
            transforms.RandomHorizontalFlip(p=0.5),
            transforms.RandomVerticalFlip(p=0.25),
            transforms.RandomRotation(degrees=10),
            transforms.ColorJitter(brightness=0.18, contrast=0.18, saturation=0.10, hue=0.02),
            transforms.ToTensor(),
            AddGaussianNoise(0.0, 0.025, p=0.30),
            transforms.RandomErasing(p=0.08, scale=(0.01, 0.04), ratio=(0.5, 2.0), value="random"),
            transforms.Normalize(mean=_IMNET_MEAN, std=_IMNET_STD),
        ])
    else:
        return transforms.Compose([
            transforms.Resize((img_size, img_size), interpolation=transforms.InterpolationMode.BILINEAR),
            transforms.RandomHorizontalFlip(p=0.35),
            transforms.RandomVerticalFlip(p=0.10),
            transforms.ColorJitter(brightness=0.08, contrast=0.08, saturation=0.05, hue=0.01),
            transforms.ToTensor(),
            transforms.Normalize(mean=_IMNET_MEAN, std=_IMNET_STD),
        ])


def clamp_int(v: int, lo: int, hi: int) -> int:
    return max(lo, min(hi, int(v)))


def make_square_crop_containing_bbox(
    bbox: Tuple[int, int, int, int],
    H: int,
    W: int,
    side: int,
    jitter: int = 0,
) -> Tuple[int, int, int, int]:
    """
    Build a square crop (left, top, right, bottom) inclusive that MUST contain bbox.
    side: crop side length in pixels.
    jitter: allow random shift of crop window while still containing bbox (<= jitter pixels).
    """
    x0, y0, x1, y1 = bbox
    bw = x1 - x0 + 1
    bh = y1 - y0 + 1
    side = max(int(side), max(bw, bh), 32)

    # feasible range for left/top such that bbox is contained:
    # left <= x0 and left + side - 1 >= x1  => left in [x1 - side + 1, x0]
    left_min = x1 - side + 1
    left_max = x0
    top_min = y1 - side + 1
    top_max = y0

    # clamp to image
    left_min = clamp_int(left_min, 0, W - side)
    left_max = clamp_int(left_max, 0, W - side)
    top_min  = clamp_int(top_min,  0, H - side)
    top_max  = clamp_int(top_max,  0, H - side)

    if left_min > left_max:
        left_min, left_max = left_max, left_min
    if top_min > top_max:
        top_min, top_max = top_max, top_min

    if jitter > 0:
        # expand selection range a bit (still must be valid)
        left_min2 = max(0, left_min - jitter)
        left_max2 = min(W - side, left_max + jitter)
        top_min2  = max(0, top_min - jitter)
        top_max2  = min(H - side, top_max + jitter)
        left_min, left_max = left_min2, left_max2
        top_min, top_max   = top_min2, top_max2

    left = random.randint(left_min, left_max) if left_min <= left_max else left_min
    top  = random.randint(top_min, top_max) if top_min <= top_max else top_min
    right = left + side - 1
    bottom = top + side - 1
    return (left, top, right, bottom)


def pad_to_square(img: Image.Image, fill: Tuple[int, int, int] = (0, 0, 0)) -> Image.Image:
    w, h = img.size
    if w == h:
        return img
    side = max(w, h)
    new_img = Image.new("RGB", (side, side), fill)
    left = (side - w) // 2
    top = (side - h) // 2
    new_img.paste(img, (left, top))
    return new_img


@dataclass
class MultiScaleParams:
    ms_min: int
    ms_max: int
    bbox_margin_min: float
    bbox_margin_max: float
    pos_bbox_crop_prob: float


class Phase2PosBBoxCropThenResize:
    """
    Phase-2 POS transform: explicit ship-preserving bbox-guided crop + multi-scale jitter.
    Guarantees: crop contains union bbox (ship included).
    """
    def __init__(self, img_size: int, ms: MultiScaleParams):
        self.img_size = int(img_size)
        self.ms = ms

    def __call__(self, img: Image.Image, bbox: Tuple[int, int, int, int]) -> torch.Tensor:
        # original Airbus images are 768x768, but be robust:
        img = pad_to_square(img)
        W, H = img.size  # PIL: (W,H)
        if H != W:
            # after pad_to_square, should be square
            side0 = max(H, W)
            img = img.resize((side0, side0), resample=Image.BILINEAR)
            W, H = img.size

        # choose a "virtual" scale target for crop side computation
        # ms_min..ms_max are interpreted as target side lengths in pixels (on original scale)
        tgt = random.randint(int(self.ms.ms_min), int(self.ms.ms_max))
        # bbox side
        x0, y0, x1, y1 = bbox
        bw = x1 - x0 + 1
        bh = y1 - y0 + 1
        bside = max(bw, bh)

        # margin: enlarge crop relative to bbox
        m = random.uniform(float(self.ms.bbox_margin_min), float(self.ms.bbox_margin_max))
        # side is at least bbox*m but also allowed to follow tgt (bounded)
        side = int(max(bside * m, 32))
        # constrain by tgt to realize multi-scale behavior
        # if tgt < side, keep side (must contain bbox), else allow increasing up to tgt
        side = min(max(side, 32), max(tgt, side))
        side = min(side, W)  # cannot exceed image

        crop = make_square_crop_containing_bbox(bbox, H=H, W=W, side=side, jitter=16)
        left, top, right, bottom = crop
        img2 = img.crop((left, top, right + 1, bottom + 1))

        # moderate appearance aug on cropped ship-centered view
        tfm = transforms.Compose([
            transforms.Resize((self.img_size, self.img_size), interpolation=transforms.InterpolationMode.BILINEAR),
            transforms.RandomHorizontalFlip(p=0.5),
            transforms.RandomVerticalFlip(p=0.25),
            transforms.RandomRotation(degrees=10),
            transforms.ColorJitter(brightness=0.18, contrast=0.18, saturation=0.10, hue=0.02),
            transforms.ToTensor(),
            AddGaussianNoise(0.0, 0.025, p=0.30),
            transforms.RandomErasing(p=0.08, scale=(0.01, 0.04), ratio=(0.5, 2.0), value="random"),
            transforms.Normalize(mean=_IMNET_MEAN, std=_IMNET_STD),
        ])
        return tfm(img2)


class Phase2NegMultiScaleNoShipCut:
    """
    Phase-2 NEG transform: multi-scale jitter without random crop that could mimic ship-preserving constraints.
    We jitter scale by resizing to [ms_min..ms_max], then pad/crop to square, then resize to final 768.
    """
    def __init__(self, img_size: int, ms_min: int, ms_max: int):
        self.img_size = int(img_size)
        self.ms_min = int(ms_min)
        self.ms_max = int(ms_max)

    def __call__(self, img: Image.Image) -> torch.Tensor:
        img = pad_to_square(img)
        side = random.randint(self.ms_min, self.ms_max)
        img2 = img.resize((side, side), resample=Image.BILINEAR)
        # optional mild aug (avoid too strong)
        tfm = transforms.Compose([
            transforms.Resize((self.img_size, self.img_size), interpolation=transforms.InterpolationMode.BILINEAR),
            transforms.RandomHorizontalFlip(p=0.35),
            transforms.RandomVerticalFlip(p=0.10),
            transforms.ColorJitter(brightness=0.08, contrast=0.08, saturation=0.05, hue=0.01),
            transforms.ToTensor(),
            transforms.Normalize(mean=_IMNET_MEAN, std=_IMNET_STD),
        ])
        return tfm(img2)


