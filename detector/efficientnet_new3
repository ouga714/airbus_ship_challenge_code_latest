class AirbusDetectorDataset(Dataset):
    """
    Phase-1: fixed transforms.
    Phase-2: POS uses bbox-guided ship-preserving crop transform.
    """
    def __init__(
        self,
        img_dir: str,
        image_ids: List[str],
        pos_set: set,
        train: bool,
        tfm_pos_fixed,
        tfm_neg_fixed,
        tfm_val_fixed,
        phase: int,
        bbox_map: Optional[Dict[str, Tuple[int, int, int, int]]] = None,
        ms_params: Optional[MultiScaleParams] = None,
        img_size: int = 768,
    ):
        self.img_dir = img_dir
        self.ids = image_ids
        self.pos_set = pos_set
        self.train = bool(train)
        self.tfm_pos_fixed = tfm_pos_fixed
        self.tfm_neg_fixed = tfm_neg_fixed
        self.tfm_val_fixed = tfm_val_fixed
        self.phase = int(phase)
        self.bbox_map = bbox_map or {}
        self.ms_params = ms_params
        self.img_size = int(img_size)

        if self.phase == 2 and self.train:
            assert self.ms_params is not None, "Phase-2 train requires ms_params"
            self.tfm_pos_ms = Phase2PosBBoxCropThenResize(self.img_size, self.ms_params)
            self.tfm_neg_ms = Phase2NegMultiScaleNoShipCut(self.img_size, self.ms_params.ms_min, self.ms_params.ms_max)
        else:
            self.tfm_pos_ms = None
            self.tfm_neg_ms = None

    def __len__(self):
        return len(self.ids)

    def __getitem__(self, idx: int):
        img_id = self.ids[idx]
        path = os.path.join(self.img_dir, img_id)
        img = Image.open(path).convert("RGB")

        is_pos = (img_id in self.pos_set)
        y = torch.tensor([1.0 if is_pos else 0.0], dtype=torch.float32)

        if not self.train:
            x = self.tfm_val_fixed(img)  # VAL always fixed 768
            return x, y, img_id

        # train
        if self.phase == 1:
            if is_pos:
                x = self.tfm_pos_fixed(img)
            else:
                x = self.tfm_neg_fixed(img)
            return x, y, img_id

        # phase == 2
        if is_pos:
            use_bbox_crop = (random.random() < float(self.ms_params.pos_bbox_crop_prob))
            if use_bbox_crop and (img_id in self.bbox_map):
                bbox = self.bbox_map[img_id]
                x = self.tfm_pos_ms(img, bbox=bbox)
            else:
                # fallback: fixed POS transform (still safe)
                x = self.tfm_pos_fixed(img)
        else:
            x = self.tfm_neg_ms(img)

        return x, y, img_id


